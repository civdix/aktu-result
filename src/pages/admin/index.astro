---
import Layout from '../../layouts/Layout.astro';

export const prerender = false;

const pageTitle = "Article Manager Dashboard | AKTU Admin";
const pageDescription = "Administrative content management portal for Dr. A.P.J. Abdul Kalam Technical University news, circulars, and updates.";
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonicalUrl="https://akturesult.bond/admin"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-14 text-left">

    <!-- Screen 1: Admin Passcode Login Card (shown when unauthenticated) -->
    <div id="admin-auth-view" class="max-w-md mx-auto my-12 p-6 sm:p-8 rounded-3xl bg-[#0e1117] light:bg-white border border-white/10 light:border-black/10 shadow-2xl space-y-6 text-center">
      <div class="w-16 h-16 rounded-2xl bg-brand-blue/15 text-brand-blue flex items-center justify-center mx-auto text-3xl border border-brand-blue/25 shadow-inner">
        🔐
      </div>

      <div class="space-y-2">
        <h1 class="text-2xl font-black tracking-tight text-white light:text-ink">
          Admin Portal Login
        </h1>
        <p class="text-xs text-gray-400 light:text-gray-500 leading-relaxed">
          Enter the administrative master passcode to manage articles, trigger AI synthesis, and perform deletions.
        </p>
      </div>

      <form id="admin-login-form" class="space-y-4 text-left">
        <div>
          <label for="admin-passcode-input" class="block text-xs font-semibold text-gray-300 light:text-gray-700 mb-1.5">
            Admin Master Passcode
          </label>
          <div class="relative">
            <input 
              id="admin-passcode-input" 
              type="password" 
              required
              autocomplete="current-password"
              placeholder="Enter passcode"
              class="w-full px-4 py-3 rounded-xl bg-black/40 light:bg-gray-50 border border-white/15 light:border-gray-300 text-white light:text-ink text-sm focus:outline-none focus:ring-2 focus:ring-brand-blue transition-all"
            />
          </div>
        </div>

        <div id="admin-auth-error" class="hidden p-3 rounded-xl bg-rose-500/10 border border-rose-500/20 text-rose-400 text-xs font-medium text-center"></div>

        <button 
          id="admin-auth-submit-btn" 
          type="submit" 
          class="w-full py-3 rounded-xl bg-gradient-to-r from-brand-blue to-purple-600 hover:from-brand-blue-hover hover:to-purple-700 text-white text-xs font-bold transition-all shadow-lg shadow-brand-blue/25 cursor-pointer transform hover:scale-[1.01] active:scale-[0.99] flex items-center justify-center gap-2"
        >
          <span>Unlock Article Manager</span>
          <span>&rarr;</span>
        </button>
      </form>

      <div class="pt-2 text-[11px] text-gray-500 border-t border-white/5 light:border-black/5">
        <span>Protected administrative route • CDN caching bypassed</span>
      </div>
    </div>

    <!-- Screen 2: Article Manager Dashboard (shown when authenticated) -->
    <div id="admin-dashboard-view" class="hidden space-y-8">
      
      <!-- Dashboard Top Header Bar -->
      <header class="flex flex-col md:flex-row md:items-center justify-between gap-4 p-6 rounded-3xl bg-gradient-to-r from-[#0e1117] via-slate-900/50 to-[#0e1117] light:from-white light:via-slate-50 light:to-white border border-white/10 light:border-black/10 shadow-xl">
        <div class="space-y-1">
          <div class="flex items-center gap-2.5 flex-wrap">
            <h1 class="text-xl sm:text-2xl font-black text-white light:text-ink tracking-tight flex items-center gap-2">
              <span>📰</span>
              <span>Article Manager</span>
            </h1>
            <span class="px-2.5 py-0.5 rounded-full text-[10px] font-bold uppercase tracking-wider bg-emerald-500/15 text-emerald-400 border border-emerald-500/25 flex items-center gap-1">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
              <span>Authenticated</span>
            </span>
          </div>
          <p class="text-xs text-gray-400 light:text-gray-500">
            Publish, inspect, and delete university news circulars with automatic CDN cache invalidation.
          </p>
        </div>

        <div class="flex items-center gap-2.5 flex-wrap">
          <button 
            id="admin-generate-btn" 
            type="button" 
            class="px-4 py-2.5 rounded-xl bg-gradient-to-r from-emerald-600 to-teal-600 hover:from-emerald-500 hover:to-teal-500 text-white font-bold text-xs shadow-lg shadow-emerald-600/25 transition-all transform hover:scale-105 active:scale-95 flex items-center gap-1.5 cursor-pointer"
            title="Scan latest official videos and synthesize new article"
          >
            <span>⚡</span>
            <span id="admin-generate-btn-text">Generate New Article</span>
          </button>

          <a 
            href="/news" 
            target="_blank" 
            rel="noopener noreferrer" 
            class="px-3.5 py-2.5 rounded-xl bg-white/5 hover:bg-white/10 light:bg-black/5 light:hover:bg-black/10 text-white light:text-ink text-xs font-semibold border border-white/10 light:border-black/10 transition-all flex items-center gap-1.5"
            title="Open public news feed in new tab"
          >
            <span>🌐</span>
            <span>View Public Feed</span>
          </a>

          <button 
            id="admin-logout-btn" 
            type="button" 
            class="px-3.5 py-2.5 rounded-xl bg-rose-500/10 hover:bg-rose-500/20 text-rose-400 border border-rose-500/25 text-xs font-semibold transition-all cursor-pointer flex items-center gap-1.5"
            title="End admin session"
          >
            <span>🚪</span>
            <span>Logout</span>
          </button>
        </div>
      </header>

      <!-- Toast Feedback Notification -->
      <div id="admin-toast" class="hidden p-4 rounded-2xl border text-xs font-medium transition-all duration-300"></div>

      <!-- KPI Summary Cards -->
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
        <div class="p-5 rounded-2xl bg-white/[0.02] light:bg-white border border-white/10 light:border-black/10 space-y-1">
          <span class="text-[11px] font-semibold text-gray-400 light:text-gray-500 uppercase tracking-wider block">Total Articles</span>
          <div id="stat-total-articles" class="text-2xl font-black text-white light:text-ink">--</div>
        </div>

        <div class="p-5 rounded-2xl bg-white/[0.02] light:bg-white border border-white/10 light:border-black/10 space-y-1">
          <span class="text-[11px] font-semibold text-gray-400 light:text-gray-500 uppercase tracking-wider block">Total Views</span>
          <div id="stat-total-views" class="text-2xl font-black text-emerald-400">--</div>
        </div>

        <div class="p-5 rounded-2xl bg-white/[0.02] light:bg-white border border-white/10 light:border-black/10 space-y-1">
          <span class="text-[11px] font-semibold text-gray-400 light:text-gray-500 uppercase tracking-wider block">Categories</span>
          <div id="stat-categories" class="text-2xl font-black text-brand-blue">--</div>
        </div>

        <div class="p-5 rounded-2xl bg-white/[0.02] light:bg-white border border-white/10 light:border-black/10 space-y-1">
          <span class="text-[11px] font-semibold text-gray-400 light:text-gray-500 uppercase tracking-wider block">Filtered Count</span>
          <div id="stat-filtered-articles" class="text-2xl font-black text-purple-400">--</div>
        </div>
      </div>

      <!-- Search, Filter & Refresh Bar -->
      <div class="p-4 rounded-2xl bg-white/[0.02] light:bg-white border border-white/10 light:border-black/10 flex flex-col sm:flex-row items-center justify-between gap-3">
        <div class="relative w-full sm:w-96">
          <span class="absolute left-3.5 top-1/2 -translate-y-1/2 text-gray-500 text-xs">🔍</span>
          <input 
            id="admin-search-input" 
            type="text" 
            placeholder="Search articles by title, slug, or keywords..."
            class="w-full pl-9 pr-3.5 py-2.5 rounded-xl bg-black/40 light:bg-gray-50 border border-white/10 light:border-gray-200 text-white light:text-ink text-xs focus:outline-none focus:ring-2 focus:ring-brand-blue transition-all"
          />
        </div>

        <div class="flex items-center gap-2.5 w-full sm:w-auto justify-between sm:justify-end">
          <select 
            id="admin-category-select" 
            class="px-3.5 py-2.5 rounded-xl bg-black/40 light:bg-gray-50 border border-white/10 light:border-gray-200 text-white light:text-ink text-xs focus:outline-none focus:ring-2 focus:ring-brand-blue transition-all cursor-pointer"
          >
            <option value="All">All Categories</option>
            <option value="Results & Marksheets">Results &amp; Marksheets</option>
            <option value="Circulars & Updates">Circulars &amp; Updates</option>
            <option value="Exam Schedule">Exam Schedule</option>
            <option value="Student Services">Student Services</option>
          </select>

          <button 
            id="admin-refresh-btn" 
            type="button" 
            class="px-3.5 py-2.5 rounded-xl bg-white/5 hover:bg-white/10 light:bg-black/5 light:hover:bg-black/10 text-gray-300 light:text-gray-700 text-xs font-semibold border border-white/10 light:border-black/10 transition-all cursor-pointer flex items-center gap-1.5"
            title="Reload articles list"
          >
            <span>🔄</span>
            <span>Refresh</span>
          </button>
        </div>
      </div>

      <!-- Articles Management Table Container -->
      <div class="rounded-3xl border border-white/10 light:border-black/10 bg-white/[0.02] light:bg-white overflow-hidden shadow-xl">
        
        <!-- Loading State -->
        <div id="admin-table-loading" class="py-16 text-center space-y-3">
          <div class="w-10 h-10 border-2 border-brand-blue border-t-transparent rounded-full animate-spin mx-auto"></div>
          <p class="text-xs text-gray-400 light:text-gray-500">Loading articles from database...</p>
        </div>

        <!-- Empty State -->
        <div id="admin-table-empty" class="hidden py-16 text-center space-y-3">
          <span class="text-3xl block">📭</span>
          <h3 class="text-sm font-bold text-white light:text-ink">No Articles Found</h3>
          <p class="text-xs text-gray-400 light:text-gray-500">Try adjusting your search query or generate a new article.</p>
        </div>

        <!-- Articles Table -->
        <div class="overflow-x-auto">
          <table id="admin-articles-table" class="hidden w-full text-left border-collapse text-xs">
            <thead>
              <tr class="border-b border-white/10 light:border-black/10 bg-white/[0.03] light:bg-black/[0.02] text-gray-400 light:text-gray-500 font-bold uppercase tracking-wider text-[10px]">
                <th class="py-3.5 px-4">Article</th>
                <th class="py-3.5 px-4">Category</th>
                <th class="py-3.5 px-4">Views</th>
                <th class="py-3.5 px-4">Published</th>
                <th class="py-3.5 px-4">Source Video</th>
                <th class="py-3.5 px-4 text-right">Actions</th>
              </tr>
            </thead>
            <tbody id="admin-articles-tbody" class="divide-y divide-white/5 light:divide-black/5 text-gray-300 light:text-gray-700 font-normal">
              <!-- Dynamically populated via client script -->
            </tbody>
          </table>
        </div>

      </div>

    </div>

  </div>

  <!-- Delete Confirmation Modal -->
  <div id="admin-delete-modal" class="fixed inset-0 z-50 flex items-center justify-center hidden p-4">
    <div id="admin-delete-backdrop" class="absolute inset-0 bg-black/80 backdrop-blur-md cursor-pointer"></div>
    <div class="relative w-full max-w-md bg-[#0e1117] light:bg-white border border-red-500/30 rounded-3xl p-6 sm:p-7 shadow-2xl z-10 space-y-4 text-left">
      <div class="flex items-center gap-3">
        <div class="w-12 h-12 rounded-2xl bg-red-500/15 text-red-400 flex items-center justify-center text-2xl shrink-0 border border-red-500/25">
          🗑️
        </div>
        <div>
          <h3 class="text-base font-bold text-white light:text-ink">Delete Article?</h3>
          <p class="text-xs text-gray-400 light:text-gray-500">Permanent action • Cannot be reversed</p>
        </div>
      </div>

      <div class="p-3.5 rounded-2xl bg-black/30 light:bg-gray-100 border border-white/5 light:border-black/5 text-xs text-gray-300 light:text-gray-700 space-y-1">
        <span class="text-[10px] uppercase font-bold text-gray-400 block tracking-wider">Target Article</span>
        <strong id="admin-delete-article-title" class="text-white light:text-ink block text-xs leading-snug"></strong>
        <span id="admin-delete-article-slug" class="text-[11px] font-mono text-gray-400 light:text-gray-500 block truncate"></span>
      </div>

      <p class="text-xs text-gray-400 light:text-gray-600 leading-relaxed">
        This permanently deletes the JSON file from disk, drops the document from MongoDB, removes the URL from Google XML sitemaps, and purges the Cloudflare edge cache.
      </p>

      <div id="admin-delete-error" class="hidden text-xs text-rose-400 font-medium"></div>

      <div class="flex items-center justify-end gap-2.5 pt-2">
        <button 
          id="admin-delete-cancel-btn" 
          type="button" 
          class="px-4 py-2.5 rounded-xl border border-white/15 light:border-gray-300 text-xs font-semibold text-gray-300 light:text-gray-700 hover:bg-white/5 light:hover:bg-black/5 cursor-pointer transition-all"
        >
          Cancel
        </button>
        <button 
          id="admin-delete-confirm-btn" 
          type="button" 
          class="px-5 py-2.5 rounded-xl bg-gradient-to-r from-red-600 to-rose-600 hover:from-red-500 hover:to-rose-500 text-white text-xs font-bold transition-all shadow-lg shadow-red-600/30 cursor-pointer flex items-center gap-1.5"
        >
          <span>Confirm Delete</span>
        </button>
      </div>
    </div>
  </div>

  <!-- Edit Article Modal -->
  <div id="admin-edit-modal" class="fixed inset-0 z-50 flex items-center justify-center hidden p-3 sm:p-6 overflow-y-auto">
    <div id="admin-edit-backdrop" class="fixed inset-0 bg-black/80 backdrop-blur-md cursor-pointer"></div>
    <div class="relative w-full max-w-4xl bg-[#0e1117] light:bg-white border border-brand-blue/30 rounded-3xl p-5 sm:p-7 shadow-2xl z-10 space-y-5 text-left my-auto max-h-[92vh] flex flex-col">
      
      <!-- Modal Header -->
      <div class="flex items-start justify-between gap-4 border-b border-white/10 light:border-black/10 pb-4 shrink-0">
        <div class="flex items-center gap-3">
          <div class="w-12 h-12 rounded-2xl bg-brand-blue/15 text-brand-blue flex items-center justify-center text-2xl shrink-0 border border-brand-blue/25">
            ✏️
          </div>
          <div>
            <div class="flex items-center gap-2 flex-wrap">
              <h3 class="text-base sm:text-lg font-bold text-white light:text-ink">Edit Article Post</h3>
              <span id="edit-status-badge" class="px-2 py-0.5 rounded-full text-[10px] font-bold uppercase tracking-wider bg-emerald-500/15 text-emerald-400 border border-emerald-500/25">Published</span>
            </div>
            <p id="edit-slug-display" class="text-xs font-mono text-gray-400 light:text-gray-500 truncate max-w-md">/news/...</p>
          </div>
        </div>

        <div class="flex items-center gap-3 shrink-0">
          <div class="text-right hidden sm:block">
            <div class="text-[10px] uppercase font-bold text-gray-400 tracking-wider">Last Modified</div>
            <div id="edit-last-modified-display" class="text-xs font-mono font-semibold text-amber-400 light:text-amber-600">--</div>
          </div>
          <button 
            id="admin-edit-close-btn" 
            type="button" 
            class="w-8 h-8 rounded-xl bg-white/5 hover:bg-white/10 light:bg-black/5 light:hover:bg-black/10 text-gray-400 hover:text-white light:hover:text-ink flex items-center justify-center text-lg transition-colors cursor-pointer"
            title="Close without saving"
          >
            ✕
          </button>
        </div>
      </div>

      <!-- Modal Form (scrollable body) -->
      <div class="space-y-4 overflow-y-auto pr-1 flex-1 text-xs">
        
        <!-- Loading State for Modal -->
        <div id="edit-modal-loading" class="py-16 text-center space-y-3">
          <div class="w-10 h-10 border-2 border-brand-blue border-t-transparent rounded-full animate-spin mx-auto"></div>
          <p class="text-xs text-gray-400 light:text-gray-500">Loading article content from database...</p>
        </div>

        <form id="admin-edit-form" class="space-y-4 hidden">
          <input type="hidden" id="edit-article-slug" />

          <!-- Title -->
          <div>
            <label for="edit-article-title" class="block font-semibold text-gray-300 light:text-gray-700 mb-1">
              Article Title / Headline <span class="text-rose-400">*</span>
            </label>
            <input 
              id="edit-article-title" 
              type="text" 
              required
              class="w-full px-3.5 py-2.5 rounded-xl bg-black/40 light:bg-gray-50 border border-white/15 light:border-gray-300 text-white light:text-ink text-sm font-semibold focus:outline-none focus:ring-2 focus:ring-brand-blue transition-all"
              placeholder="Official Circular Title..."
            />
          </div>

          <!-- Meta row: Category, Status, Author -->
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
            <div>
              <label for="edit-article-category" class="block font-semibold text-gray-300 light:text-gray-700 mb-1">
                Category
              </label>
              <select 
                id="edit-article-category" 
                class="w-full px-3 py-2 rounded-xl bg-black/40 light:bg-gray-50 border border-white/15 light:border-gray-300 text-white light:text-ink text-xs focus:outline-none focus:ring-2 focus:ring-brand-blue transition-all cursor-pointer"
              >
                <option value="Results & Marksheets">Results &amp; Marksheets</option>
                <option value="Circulars & Updates">Circulars &amp; Updates</option>
                <option value="Exam Schedule">Exam Schedule</option>
                <option value="Student Services">Student Services</option>
                <option value="Admissions & Counseling">Admissions &amp; Counseling</option>
                <option value="General News">General News</option>
              </select>
            </div>

            <div>
              <label for="edit-article-status" class="block font-semibold text-gray-300 light:text-gray-700 mb-1">
                Publication Status
              </label>
              <select 
                id="edit-article-status" 
                class="w-full px-3 py-2 rounded-xl bg-black/40 light:bg-gray-50 border border-white/15 light:border-gray-300 text-white light:text-ink text-xs focus:outline-none focus:ring-2 focus:ring-brand-blue transition-all cursor-pointer"
              >
                <option value="published">Published (Live to public)</option>
                <option value="draft">Draft (Admin only)</option>
              </select>
            </div>

            <div>
              <label for="edit-article-author" class="block font-semibold text-gray-300 light:text-gray-700 mb-1">
                Author
              </label>
              <input 
                id="edit-article-author" 
                type="text" 
                class="w-full px-3 py-2 rounded-xl bg-black/40 light:bg-gray-50 border border-white/15 light:border-gray-300 text-white light:text-ink text-xs focus:outline-none focus:ring-2 focus:ring-brand-blue transition-all"
                placeholder="e.g. AKTU News Desk"
              />
            </div>
          </div>

          <!-- Excerpt -->
          <div>
            <label for="edit-article-excerpt" class="block font-semibold text-gray-300 light:text-gray-700 mb-1">
              Summary / Excerpt (Displayed in Key Takeaways &amp; Google Snippets) <span class="text-rose-400">*</span>
            </label>
            <textarea 
              id="edit-article-excerpt" 
              rows="2" 
              required
              class="w-full px-3.5 py-2.5 rounded-xl bg-black/40 light:bg-gray-50 border border-white/15 light:border-gray-300 text-white light:text-ink text-xs focus:outline-none focus:ring-2 focus:ring-brand-blue transition-all leading-relaxed"
              placeholder="Concise 1-2 sentence overview..."
            ></textarea>
          </div>

          <!-- Tags -->
          <div>
            <label for="edit-article-tags" class="block font-semibold text-gray-300 light:text-gray-700 mb-1">
              Tags (comma-separated)
            </label>
            <input 
              id="edit-article-tags" 
              type="text" 
              class="w-full px-3.5 py-2 rounded-xl bg-black/40 light:bg-gray-50 border border-white/15 light:border-gray-300 text-white light:text-ink text-xs focus:outline-none focus:ring-2 focus:ring-brand-blue transition-all"
              placeholder="AKTU, Odd Semester, Result, Carry Over"
            />
          </div>

          <!-- Markdown Content with Toolbar & Preview -->
          <div class="space-y-2">
            <div class="flex items-center justify-between gap-2 flex-wrap">
              <label class="block font-semibold text-gray-300 light:text-gray-700">
                Article Body Content (Markdown) <span class="text-rose-400">*</span>
              </label>
              <div class="flex items-center gap-2">
                <span id="edit-content-stats" class="text-[11px] text-gray-400 font-mono">0 words • ~1 min read</span>
                <div class="inline-flex rounded-lg border border-white/15 light:border-gray-300 p-0.5 bg-black/40 light:bg-gray-100">
                  <button type="button" id="tab-write-btn" class="px-2.5 py-1 rounded-md text-[11px] font-semibold bg-brand-blue text-white transition-all cursor-pointer">Write</button>
                  <button type="button" id="tab-preview-btn" class="px-2.5 py-1 rounded-md text-[11px] font-semibold text-gray-400 light:text-gray-600 hover:text-white light:hover:text-ink transition-all cursor-pointer">Preview</button>
                </div>
              </div>
            </div>

            <!-- Markdown quick-action toolbar -->
            <div id="edit-markdown-toolbar" class="flex items-center gap-1 p-1.5 rounded-xl bg-white/[0.03] light:bg-gray-100 border border-white/10 light:border-gray-200 overflow-x-auto">
              <button type="button" class="toolbar-btn px-2 py-1 rounded hover:bg-white/10 light:hover:bg-gray-200 text-gray-300 light:text-gray-700 font-bold text-[11px] cursor-pointer" data-prefix="**" data-suffix="**" title="Bold">B</button>
              <button type="button" class="toolbar-btn px-2 py-1 rounded hover:bg-white/10 light:hover:bg-gray-200 text-gray-300 light:text-gray-700 italic text-[11px] cursor-pointer" data-prefix="*" data-suffix="*" title="Italic">I</button>
              <span class="w-px h-4 bg-white/10 light:bg-gray-300 mx-1"></span>
              <button type="button" class="toolbar-btn px-2 py-1 rounded hover:bg-white/10 light:hover:bg-gray-200 text-gray-300 light:text-gray-700 font-bold text-[11px] cursor-pointer" data-prefix="## " data-suffix="" title="Heading 2">H2</button>
              <button type="button" class="toolbar-btn px-2 py-1 rounded hover:bg-white/10 light:hover:bg-gray-200 text-gray-300 light:text-gray-700 font-bold text-[11px] cursor-pointer" data-prefix="### " data-suffix="" title="Heading 3">H3</button>
              <span class="w-px h-4 bg-white/10 light:bg-gray-300 mx-1"></span>
              <button type="button" class="toolbar-btn px-2 py-1 rounded hover:bg-white/10 light:hover:bg-gray-200 text-gray-300 light:text-gray-700 text-[11px] cursor-pointer" data-prefix="- " data-suffix="" title="Bullet List">• List</button>
              <button type="button" class="toolbar-btn px-2 py-1 rounded hover:bg-white/10 light:hover:bg-gray-200 text-gray-300 light:text-gray-700 text-[11px] cursor-pointer" data-prefix="1. " data-suffix="" title="Numbered List">1. List</button>
              <button type="button" class="toolbar-btn px-2 py-1 rounded hover:bg-white/10 light:hover:bg-gray-200 text-gray-300 light:text-gray-700 text-[11px] cursor-pointer" data-prefix="> " data-suffix="" title="Quote">Quote</button>
              <span class="w-px h-4 bg-white/10 light:bg-gray-300 mx-1"></span>
              <button type="button" class="toolbar-btn px-2 py-1 rounded hover:bg-white/10 light:hover:bg-gray-200 text-gray-300 light:text-gray-700 text-[11px] cursor-pointer" data-snippet="table" title="Insert Table">📊 Table</button>
              <button type="button" class="toolbar-btn px-2 py-1 rounded hover:bg-white/10 light:hover:bg-gray-200 text-gray-300 light:text-gray-700 text-[11px] cursor-pointer" data-snippet="link" title="Insert Link">🔗 Link</button>
              <button type="button" class="toolbar-btn px-2 py-1 rounded hover:bg-white/10 light:hover:bg-gray-200 text-amber-400 font-semibold text-[11px] cursor-pointer" data-snippet="callout" title="Important Callout Box">⚠️ Callout</button>
            </div>

            <!-- Write Textarea -->
            <textarea 
              id="edit-article-content" 
              rows="12" 
              required
              class="w-full font-mono text-xs sm:text-sm p-4 rounded-xl bg-black/50 light:bg-gray-50 border border-white/15 light:border-gray-300 text-gray-200 light:text-ink focus:outline-none focus:ring-2 focus:ring-brand-blue resize-y transition-all leading-relaxed"
              placeholder="Type article content in Markdown format..."
            ></textarea>

            <!-- Live Preview Container -->
            <div 
              id="edit-article-preview" 
              class="hidden min-h-[280px] max-h-[380px] overflow-y-auto p-4 rounded-xl bg-black/30 light:bg-gray-50 border border-white/15 light:border-gray-300 text-gray-200 light:text-ink text-xs sm:text-sm leading-relaxed prose prose-invert light:prose-neutral max-w-none"
            ></div>
          </div>

          <div id="edit-modal-error" class="hidden p-3 rounded-xl bg-rose-500/10 border border-rose-500/20 text-rose-400 text-xs font-medium"></div>

          <div class="flex items-center justify-between gap-3 pt-3 border-t border-white/10 light:border-black/10 shrink-0">
            <div class="text-[11px] text-gray-400 light:text-gray-500">
              <span>💾 Saving will automatically update <strong class="text-amber-400">Last Modified</strong> &amp; invalidate CDN cache.</span>
            </div>

            <div class="flex items-center gap-2.5">
              <button 
                id="admin-edit-cancel-btn" 
                type="button" 
                class="px-4 py-2.5 rounded-xl border border-white/15 light:border-gray-300 text-xs font-semibold text-gray-300 light:text-gray-700 hover:bg-white/5 light:hover:bg-black/5 cursor-pointer transition-all"
              >
                Cancel
              </button>
              <button 
                id="admin-edit-save-btn" 
                type="submit" 
                class="px-5 py-2.5 rounded-xl bg-gradient-to-r from-brand-blue to-purple-600 hover:from-brand-blue-hover hover:to-purple-700 text-white text-xs font-bold transition-all shadow-lg shadow-brand-blue/30 cursor-pointer flex items-center gap-1.5"
              >
                <span>💾</span>
                <span id="admin-edit-save-text">Save Changes</span>
              </button>
            </div>
          </div>

        </form>
      </div>

    </div>
  </div>

  <script>
    import { marked } from 'marked';

    interface ArticleRow {
      slug: string;
      title: string;
      category: string;
      publishedAt: string;
      updatedAt?: string;
      readingTime?: number;
      views?: number;
      sourceVideoId?: string;
      sourceChannel?: string;
      status?: string;
    }

    let allArticles: ArticleRow[] = [];
    let pendingDeleteSlug = '';

    const authView = document.getElementById("admin-auth-view");
    const dashboardView = document.getElementById("admin-dashboard-view");
    const loginForm = document.getElementById("admin-login-form");
    const passcodeInput = document.getElementById("admin-passcode-input") as HTMLInputElement | null;
    const authSubmitBtn = document.getElementById("admin-auth-submit-btn");
    const authError = document.getElementById("admin-auth-error");

    const logoutBtn = document.getElementById("admin-logout-btn");
    const generateBtn = document.getElementById("admin-generate-btn");
    const generateBtnText = document.getElementById("admin-generate-btn-text");
    const refreshBtn = document.getElementById("admin-refresh-btn");
    const searchInput = document.getElementById("admin-search-input") as HTMLInputElement | null;
    const categorySelect = document.getElementById("admin-category-select") as HTMLSelectElement | null;
    const toastEl = document.getElementById("admin-toast");

    const statTotal = document.getElementById("stat-total-articles");
    const statTotalViews = document.getElementById("stat-total-views");
    const statCategories = document.getElementById("stat-categories");
    const statFiltered = document.getElementById("stat-filtered-articles");

    const tableLoading = document.getElementById("admin-table-loading");
    const tableEmpty = document.getElementById("admin-table-empty");
    const articlesTable = document.getElementById("admin-articles-table");
    const articlesTbody = document.getElementById("admin-articles-tbody");

    const deleteModal = document.getElementById("admin-delete-modal");
    const deleteBackdrop = document.getElementById("admin-delete-backdrop");
    const deleteCancelBtn = document.getElementById("admin-delete-cancel-btn");
    const deleteConfirmBtn = document.getElementById("admin-delete-confirm-btn") as HTMLButtonElement | null;
    const deleteTitleEl = document.getElementById("admin-delete-article-title");
    const deleteSlugEl = document.getElementById("admin-delete-article-slug");
    const deleteErrorEl = document.getElementById("admin-delete-error");

    // Edit Modal Elements
    const editModal = document.getElementById("admin-edit-modal");
    const editBackdrop = document.getElementById("admin-edit-backdrop");
    const editCloseBtn = document.getElementById("admin-edit-close-btn");
    const editCancelBtn = document.getElementById("admin-edit-cancel-btn");
    const editForm = document.getElementById("admin-edit-form") as HTMLFormElement | null;
    const editModalLoading = document.getElementById("edit-modal-loading");
    const editModalError = document.getElementById("edit-modal-error");
    const editSlugDisplay = document.getElementById("edit-slug-display");
    const editStatusBadge = document.getElementById("edit-status-badge");
    const editLastModifiedDisplay = document.getElementById("edit-last-modified-display");
    const editSaveBtn = document.getElementById("admin-edit-save-btn") as HTMLButtonElement | null;
    const editSaveText = document.getElementById("admin-edit-save-text");

    const editSlugInput = document.getElementById("edit-article-slug") as HTMLInputElement | null;
    const editTitleInput = document.getElementById("edit-article-title") as HTMLInputElement | null;
    const editCategorySelect = document.getElementById("edit-article-category") as HTMLSelectElement | null;
    const editStatusSelect = document.getElementById("edit-article-status") as HTMLSelectElement | null;
    const editAuthorInput = document.getElementById("edit-article-author") as HTMLInputElement | null;
    const editExcerptInput = document.getElementById("edit-article-excerpt") as HTMLTextAreaElement | null;
    const editTagsInput = document.getElementById("edit-article-tags") as HTMLInputElement | null;
    const editContentInput = document.getElementById("edit-article-content") as HTMLTextAreaElement | null;
    const editPreviewContainer = document.getElementById("edit-article-preview");
    const editContentStats = document.getElementById("edit-content-stats");
    const tabWriteBtn = document.getElementById("tab-write-btn");
    const tabPreviewBtn = document.getElementById("tab-preview-btn");

    const getLocalToken = (): string => {
      try {
        return localStorage.getItem("aktu_admin_token") || "";
      } catch {
        return "";
      }
    };

    const setLocalToken = (token: string): void => {
      try {
        if (token) localStorage.setItem("aktu_admin_token", token);
        else localStorage.removeItem("aktu_admin_token");
      } catch {}
    };

    const showToast = (message: string, isError: boolean = false) => {
      if (!toastEl) return;
      toastEl.textContent = message;
      toastEl.className = isError 
        ? "p-4 rounded-2xl border text-xs font-medium bg-rose-500/10 border-rose-500/20 text-rose-400 block"
        : "p-4 rounded-2xl border text-xs font-medium bg-emerald-500/10 border-emerald-500/20 text-emerald-400 block";
      setTimeout(() => {
        toastEl.classList.add("hidden");
      }, 5000);
    };

    // Render articles in table
    const renderArticlesTable = () => {
      if (!articlesTbody || !articlesTable || !tableEmpty || !tableLoading) return;
      tableLoading.classList.add("hidden");

      const query = (searchInput?.value || "").trim().toLowerCase();
      const selectedCategory = categorySelect?.value || "All";

      const filtered = allArticles.filter(art => {
        const matchesCat = selectedCategory === "All" || art.category === selectedCategory;
        const matchesQuery = !query || 
          art.title.toLowerCase().includes(query) || 
          art.slug.toLowerCase().includes(query);
        return matchesCat && matchesQuery;
      });

      if (statFiltered) {
        statFiltered.textContent = filtered.length.toString();
      }

      if (filtered.length === 0) {
        articlesTable.classList.add("hidden");
        tableEmpty.classList.remove("hidden");
        return;
      }

      tableEmpty.classList.add("hidden");
      articlesTable.classList.remove("hidden");

      articlesTbody.innerHTML = filtered.map(art => {
        const dateStr = new Date(art.publishedAt).toLocaleDateString("en-IN", {
          day: "numeric",
          month: "short",
          year: "numeric"
        });

        const thumbUrl = art.sourceVideoId 
          ? `https://i.ytimg.com/vi/${art.sourceVideoId}/hqdefault.jpg`
          : null;

        return `
          <tr id="row-${art.slug}" class="hover:bg-white/[0.02] light:hover:bg-black/[0.02] transition-colors">
            <td class="py-3.5 px-4">
              <div class="flex items-center gap-3">
                ${thumbUrl ? `
                  <img 
                    src="${thumbUrl}" 
                    alt="${art.title}" 
                    class="w-16 h-10 object-cover rounded-lg border border-white/10 shrink-0 bg-black" 
                    loading="lazy"
                  />
                ` : `
                  <div class="w-16 h-10 rounded-lg bg-brand-blue/10 border border-brand-blue/20 flex items-center justify-center text-xs shrink-0">📰</div>
                `}
                <div class="space-y-0.5 max-w-sm sm:max-w-md">
                  <a href="/news/${art.slug}" target="_blank" class="font-bold text-white light:text-ink hover:text-brand-blue transition-colors line-clamp-1">
                    ${art.title}
                  </a>
                  <span class="text-[11px] font-mono text-gray-500 truncate block">/${art.slug}</span>
                </div>
              </div>
            </td>
            <td class="py-3.5 px-4 whitespace-nowrap">
              <span class="px-2.5 py-0.5 rounded-full font-bold text-[10px] bg-brand-blue/15 text-brand-blue border border-brand-blue/25">
                ${art.category}
              </span>
            </td>
            <td class="py-3.5 px-4 whitespace-nowrap">
              <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-xl bg-white/5 light:bg-black/5 border border-white/10 light:border-black/10 text-white light:text-ink font-bold text-xs">
                <span>👁️</span>
                <span>${(art.views || 0).toLocaleString()}</span>
              </span>
            </td>
            <td class="py-3.5 px-4 whitespace-nowrap text-gray-400 light:text-gray-500 text-[11px]">
              <div>${dateStr}</div>
              ${art.updatedAt && (new Date(art.updatedAt).getTime() - new Date(art.publishedAt).getTime() > 60000) ? `
                <span class="text-[10px] text-amber-400 light:text-amber-600 font-semibold block" title="Last updated: ${new Date(art.updatedAt).toLocaleString('en-IN')}">
                  ✏️ ${new Date(art.updatedAt).toLocaleDateString("en-IN", { day: "numeric", month: "short" })}
                </span>
              ` : ''}
            </td>
            <td class="py-3.5 px-4 whitespace-nowrap text-[11px]">
              ${art.sourceVideoId ? `
                <a 
                  href="https://www.youtube.com/watch?v=${art.sourceVideoId}" 
                  target="_blank" 
                  rel="noopener noreferrer" 
                  class="text-red-400 hover:text-red-300 font-semibold inline-flex items-center gap-1"
                >
                  <span>📺</span>
                  <span>${art.sourceChannel || 'YouTube'}</span>
                </a>
              ` : `
                <span class="text-gray-500">—</span>
              `}
            </td>
            <td class="py-3.5 px-4 whitespace-nowrap text-right space-x-1.5">
              <a 
                href="/news/${art.slug}" 
                target="_blank" 
                class="px-2.5 py-1.5 rounded-lg border border-white/10 light:border-black/10 text-gray-300 light:text-gray-700 hover:text-white light:hover:text-ink hover:bg-white/5 light:hover:bg-black/5 transition-all text-xs font-semibold inline-flex items-center gap-1"
                title="View live article"
              >
                <span>👁️</span>
                <span>View</span>
              </a>
              <button 
                type="button" 
                class="edit-btn px-2.5 py-1.5 rounded-lg bg-brand-blue/10 hover:bg-brand-blue text-brand-blue-light hover:text-white border border-brand-blue/25 text-xs font-semibold transition-all inline-flex items-center gap-1 cursor-pointer"
                data-slug="${art.slug}"
                title="Edit article post"
              >
                <span>✏️</span>
                <span>Edit</span>
              </button>
              <button 
                type="button" 
                class="delete-btn px-2.5 py-1.5 rounded-lg bg-red-600/10 hover:bg-red-600 text-red-400 hover:text-white border border-red-500/20 text-xs font-semibold transition-all inline-flex items-center gap-1 cursor-pointer"
                data-slug="${art.slug}"
                data-title="${encodeURIComponent(art.title)}"
                title="Delete article"
              >
                <span>🗑️</span>
                <span>Delete</span>
              </button>
            </td>
          </tr>
        `;
      }).join("");

      // Attach edit click handlers
      document.querySelectorAll(".edit-btn").forEach(btn => {
        btn.addEventListener("click", (e) => {
          e.preventDefault();
          const slug = btn.getAttribute("data-slug") || "";
          openEditModal(slug);
        });
      });

      // Attach delete click handlers
      document.querySelectorAll(".delete-btn").forEach(btn => {
        btn.addEventListener("click", (e) => {
          e.preventDefault();
          const slug = btn.getAttribute("data-slug") || "";
          const title = decodeURIComponent(btn.getAttribute("data-title") || "");
          openDeleteModal(slug, title);
        });
      });
    };

    // Load articles from API
    const fetchArticles = async () => {
      const token = getLocalToken();
      if (!token) return;

      if (tableLoading) tableLoading.classList.remove("hidden");
      if (articlesTable) articlesTable.classList.add("hidden");
      if (tableEmpty) tableEmpty.classList.add("hidden");

      try {
        const res = await fetch(`/api/admin/articles?limit=200&_t=${Date.now()}`, {
          headers: { "Authorization": `Bearer ${token}` },
          cache: "no-store"
        });

        if (res.status === 401) {
          setLocalToken("");
          switchToAuthView();
          return;
        }

        const data = await res.json();
        if (data.success && Array.isArray(data.articles)) {
          allArticles = data.articles;
          if (statTotal) statTotal.textContent = allArticles.length.toString();

          const totalViews = allArticles.reduce((acc, a) => acc + (a.views || 0), 0);
          if (statTotalViews) statTotalViews.textContent = totalViews.toLocaleString();
          
          const uniqueCats = new Set(allArticles.map(a => a.category).filter(Boolean));
          if (statCategories) statCategories.textContent = uniqueCats.size.toString();

          renderArticlesTable();
        }
      } catch (err) {
        showToast("Failed to load articles list", true);
      } finally {
        if (tableLoading) tableLoading.classList.add("hidden");
      }
    };

    const switchToDashboardView = () => {
      authView?.classList.add("hidden");
      dashboardView?.classList.remove("hidden");
      fetchArticles();
    };

    const switchToAuthView = () => {
      dashboardView?.classList.add("hidden");
      authView?.classList.remove("hidden");
      if (passcodeInput) {
        passcodeInput.value = "";
        passcodeInput.focus();
      }
    };

    // Initial check
    const initAuthCheck = async () => {
      const token = getLocalToken();
      if (!token) {
        switchToAuthView();
        return;
      }

      // Optimistically show dashboard, verify in background
      switchToDashboardView();

      try {
        const res = await fetch(`/api/admin/status?_t=${Date.now()}`, {
          headers: { "Authorization": `Bearer ${token}` },
          cache: "no-store"
        });
        const data = await res.json();
        if (!data.authenticated) {
          setLocalToken("");
          switchToAuthView();
        }
      } catch {
        // network err
      }
    };

    initAuthCheck();

    // Login Form Submit
    loginForm?.addEventListener("submit", async (e) => {
      e.preventDefault();
      const pass = passcodeInput?.value?.trim() || "";
      if (!pass) return;

      if (authSubmitBtn) {
        authSubmitBtn.setAttribute("disabled", "true");
        authSubmitBtn.textContent = "Verifying Passcode...";
      }
      authError?.classList.add("hidden");

      try {
        const res = await fetch(`/api/admin/login?_t=${Date.now()}`, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ password: pass }),
          cache: "no-store"
        });
        const data = await res.json();

        if (res.ok && data.success) {
          if (data.token) {
            setLocalToken(data.token);
          }
          switchToDashboardView();
        } else {
          if (authError) {
            authError.textContent = data.message || "Invalid master passcode. Access denied.";
            authError.classList.remove("hidden");
          }
        }
      } catch (err) {
        if (authError) {
          authError.textContent = "Network error during authentication";
          authError.classList.remove("hidden");
        }
      } finally {
        if (authSubmitBtn) {
          authSubmitBtn.removeAttribute("disabled");
          authSubmitBtn.textContent = "Unlock Article Manager →";
        }
      }
    });

    // Logout
    logoutBtn?.addEventListener("click", async () => {
      setLocalToken("");
      switchToAuthView();
      await fetch(`/api/admin/logout?_t=${Date.now()}`, { method: "POST", cache: "no-store" });
    });

    // Search and Category Filters
    searchInput?.addEventListener("input", renderArticlesTable);
    categorySelect?.addEventListener("change", renderArticlesTable);
    refreshBtn?.addEventListener("click", fetchArticles);

    // Generate Article on Demand
    generateBtn?.addEventListener("click", async () => {
      const token = getLocalToken();
      if (!token) return;

      generateBtn.setAttribute("disabled", "true");
      if (generateBtnText) generateBtnText.textContent = "Synthesizing Article...";

      try {
        const res = await fetch(`/api/admin/generate?_t=${Date.now()}`, {
          method: "POST",
          headers: { "Authorization": `Bearer ${token}` },
          cache: "no-store"
        });
        const data = await res.json();

        if (res.ok && data.success) {
          showToast(`✨ Generated: "${data.title || data.article?.title || 'New Article'}"!`);
          fetchArticles();
        } else {
          showToast(data.message || data.error || "Article generation skipped or failed.", true);
        }
      } catch (err) {
        showToast("Network error while generating article", true);
      } finally {
        generateBtn.removeAttribute("disabled");
        if (generateBtnText) generateBtnText.textContent = "Generate New Article";
      }
    });

    // Delete Modal Handling
    const openDeleteModal = (slug: string, title: string) => {
      pendingDeleteSlug = slug;
      if (deleteTitleEl) deleteTitleEl.textContent = `"${title}"`;
      if (deleteSlugEl) deleteSlugEl.textContent = `/${slug}`;
      deleteErrorEl?.classList.add("hidden");
      deleteModal?.classList.remove("hidden");
    };

    const closeDeleteModal = () => {
      deleteModal?.classList.add("hidden");
      pendingDeleteSlug = '';
    };

    deleteBackdrop?.addEventListener("click", closeDeleteModal);
    deleteCancelBtn?.addEventListener("click", closeDeleteModal);

    // Confirm Delete
    deleteConfirmBtn?.addEventListener("click", async () => {
      if (!pendingDeleteSlug) return;
      const token = getLocalToken();

      deleteConfirmBtn.disabled = true;
      deleteConfirmBtn.textContent = "Deleting & Purging CDN...";

      try {
        const res = await fetch(`/api/admin/delete-article?_t=${Date.now()}`, {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
            ...(token ? { "Authorization": `Bearer ${token}` } : {})
          },
          body: JSON.stringify({ slug: pendingDeleteSlug }),
          cache: "no-store"
        });

        const data = await res.json();
        if (res.ok && data.success) {
          // Remove from local array
          allArticles = allArticles.filter(a => a.slug !== pendingDeleteSlug);
          if (statTotal) statTotal.textContent = allArticles.length.toString();
          const totalViews = allArticles.reduce((acc, a) => acc + (a.views || 0), 0);
          if (statTotalViews) statTotalViews.textContent = totalViews.toLocaleString();
          
          // Animate away
          const row = document.getElementById(`row-${pendingDeleteSlug}`);
          if (row) {
            row.style.transition = "all 0.3s ease-out";
            row.style.opacity = "0";
            setTimeout(() => {
              renderArticlesTable();
            }, 300);
          } else {
            renderArticlesTable();
          }

          showToast(`🗑️ Article "${pendingDeleteSlug}" deleted successfully!`);
          closeDeleteModal();
        } else {
          if (deleteErrorEl) {
            deleteErrorEl.textContent = data.message || "Failed to delete article";
            deleteErrorEl.classList.remove("hidden");
          }
        }
      } catch (err) {
        if (deleteErrorEl) {
          deleteErrorEl.textContent = "Network error during deletion";
          deleteErrorEl.classList.remove("hidden");
        }
      } finally {
        deleteConfirmBtn.disabled = false;
        deleteConfirmBtn.textContent = "Confirm Delete";
      }
    });

    // Edit Modal Handling
    const updateContentStats = () => {
      if (!editContentStats || !editContentInput) return;
      const text = editContentInput.value.trim();
      const words = text ? text.split(/\s+/).filter(Boolean).length : 0;
      const readTime = Math.max(1, Math.ceil(words / 200));
      editContentStats.textContent = `${words.toLocaleString()} words • ~${readTime} min read`;
    };

    const openEditModal = async (slug: string) => {
      const token = getLocalToken();
      if (!token) return;

      editModal?.classList.remove("hidden");
      editModalLoading?.classList.remove("hidden");
      editForm?.classList.add("hidden");
      editModalError?.classList.add("hidden");
      if (editSlugDisplay) editSlugDisplay.textContent = `/news/${slug}`;

      // Reset to write tab
      tabWriteBtn?.classList.add("bg-brand-blue", "text-white");
      tabWriteBtn?.classList.remove("text-gray-400");
      tabPreviewBtn?.classList.remove("bg-brand-blue", "text-white");
      tabPreviewBtn?.classList.add("text-gray-400");
      editContentInput?.classList.remove("hidden");
      editPreviewContainer?.classList.add("hidden");

      try {
        const res = await fetch(`/api/admin/article?slug=${encodeURIComponent(slug)}&_t=${Date.now()}`, {
          headers: { "Authorization": `Bearer ${token}` },
          cache: "no-store"
        });

        if (res.status === 401) {
          setLocalToken("");
          closeEditModal();
          switchToAuthView();
          return;
        }

        const data = await res.json();
        if (res.ok && data.success && data.article) {
          const art = data.article;
          if (editSlugInput) editSlugInput.value = art.slug || slug;
          if (editTitleInput) editTitleInput.value = art.title || "";
          if (editCategorySelect) editCategorySelect.value = art.category || "Circulars & Updates";
          if (editStatusSelect) editStatusSelect.value = art.status || "published";
          if (editAuthorInput) editAuthorInput.value = art.author || "AKTU Student News Desk";
          if (editExcerptInput) editExcerptInput.value = art.excerpt || "";
          if (editTagsInput) editTagsInput.value = Array.isArray(art.tags) ? art.tags.join(", ") : (art.tags || "");
          if (editContentInput) editContentInput.value = art.content || "";

          // Status badge
          if (editStatusBadge) {
            const isDraft = art.status === "draft";
            editStatusBadge.textContent = isDraft ? "Draft" : "Published";
            editStatusBadge.className = isDraft 
              ? "px-2 py-0.5 rounded-full text-[10px] font-bold uppercase tracking-wider bg-amber-500/15 text-amber-400 border border-amber-500/25"
              : "px-2 py-0.5 rounded-full text-[10px] font-bold uppercase tracking-wider bg-emerald-500/15 text-emerald-400 border border-emerald-500/25";
          }

          // Last modified timestamp display
          if (editLastModifiedDisplay) {
            const lastDate = art.updatedAt || art.publishedAt;
            editLastModifiedDisplay.textContent = lastDate 
              ? new Date(lastDate).toLocaleString("en-IN", {
                  day: "numeric",
                  month: "short",
                  year: "numeric",
                  hour: "2-digit",
                  minute: "2-digit"
                })
              : "--";
          }

          updateContentStats();
          editModalLoading?.classList.add("hidden");
          editForm?.classList.remove("hidden");
          editTitleInput?.focus();
        } else {
          if (editModalError) {
            editModalError.textContent = data.message || "Failed to load article from database.";
            editModalError.classList.remove("hidden");
          }
        }
      } catch (err) {
        if (editModalError) {
          editModalError.textContent = "Network error loading article details.";
          editModalError.classList.remove("hidden");
        }
      } finally {
        editModalLoading?.classList.add("hidden");
      }
    };

    const closeEditModal = () => {
      editModal?.classList.add("hidden");
      editModalError?.classList.add("hidden");
      if (editForm) editForm.reset();
    };

    editBackdrop?.addEventListener("click", closeEditModal);
    editCloseBtn?.addEventListener("click", closeEditModal);
    editCancelBtn?.addEventListener("click", closeEditModal);

    // Live word count listener
    editContentInput?.addEventListener("input", updateContentStats);

    // Write / Preview Tab Switching
    tabWriteBtn?.addEventListener("click", () => {
      tabPreviewBtn?.classList.remove("bg-brand-blue", "text-white");
      tabPreviewBtn?.classList.add("text-gray-400");
      tabWriteBtn?.classList.add("bg-brand-blue", "text-white");
      tabWriteBtn?.classList.remove("text-gray-400");
      editPreviewContainer?.classList.add("hidden");
      editContentInput?.classList.remove("hidden");
      editContentInput?.focus();
    });

    tabPreviewBtn?.addEventListener("click", () => {
      tabWriteBtn?.classList.remove("bg-brand-blue", "text-white");
      tabWriteBtn?.classList.add("text-gray-400");
      tabPreviewBtn?.classList.add("bg-brand-blue", "text-white");
      tabPreviewBtn?.classList.remove("text-gray-400");
      editContentInput?.classList.add("hidden");
      editPreviewContainer?.classList.remove("hidden");
      if (editPreviewContainer) {
        const rawContent = editContentInput?.value?.trim() || "*No article content written yet.*";
        editPreviewContainer.innerHTML = marked.parse(rawContent) as string;
      }
    });

    // Formatting Toolbar Buttons
    document.querySelectorAll(".toolbar-btn").forEach(btn => {
      btn.addEventListener("click", (e) => {
        e.preventDefault();
        if (!editContentInput) return;

        // If currently in preview mode, switch to write mode first
        if (!editPreviewContainer?.classList.contains("hidden")) {
          tabWriteBtn?.click();
        }

        const prefix = btn.getAttribute("data-prefix");
        const suffix = btn.getAttribute("data-suffix") || "";
        const snippet = btn.getAttribute("data-snippet");

        const start = editContentInput.selectionStart;
        const end = editContentInput.selectionEnd;
        const text = editContentInput.value;

        if (snippet) {
          let snippetText = "";
          if (snippet === "table") {
            snippetText = "\n\n| Item | Description | Status |\n|---|---|---|\n| Application Deadline | DD/MM/YYYY | Active |\n| Result Release | DD/MM/YYYY | Declared |\n\n";
          } else if (snippet === "link") {
            snippetText = "[AKTU Official Portal](https://erp.aktu.ac.in)";
          } else if (snippet === "callout") {
            snippetText = "\n\n> [!IMPORTANT]\n> Official Notice: Ensure all examination roll numbers and marksheets are verified through OneView.\n\n";
          }
          editContentInput.value = text.substring(0, start) + snippetText + text.substring(end);
          editContentInput.focus();
          editContentInput.setSelectionRange(start + snippetText.length, start + snippetText.length);
        } else if (prefix !== null) {
          const selected = text.substring(start, end);
          const replacement = prefix + (selected || "sample text") + suffix;
          editContentInput.value = text.substring(0, start) + replacement + text.substring(end);
          editContentInput.focus();
          const newStart = start + prefix.length;
          const newEnd = newStart + (selected ? selected.length : 11);
          editContentInput.setSelectionRange(newStart, newEnd);
        }

        updateContentStats();
      });
    });

    // Save Edited Article Form Submit
    editForm?.addEventListener("submit", async (e) => {
      e.preventDefault();
      const token = getLocalToken();
      if (!token) return;

      const slug = editSlugInput?.value.trim();
      if (!slug) return;

      if (editSaveBtn && editSaveText) {
        editSaveBtn.disabled = true;
        editSaveText.textContent = "Saving & Purging CDN...";
      }
      editModalError?.classList.add("hidden");

      try {
        const payload = {
          slug,
          title: editTitleInput?.value.trim(),
          category: editCategorySelect?.value,
          status: editStatusSelect?.value,
          author: editAuthorInput?.value.trim(),
          excerpt: editExcerptInput?.value.trim(),
          tags: editTagsInput?.value || "",
          content: editContentInput?.value || ""
        };

        const res = await fetch(`/api/admin/article?_t=${Date.now()}`, {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
            "Authorization": `Bearer ${token}`
          },
          body: JSON.stringify(payload),
          cache: "no-store"
        });

        const data = await res.json();
        if (res.ok && data.success && data.article) {
          const updated = data.article;
          // Update in-memory array
          const idx = allArticles.findIndex(a => a.slug === slug);
          if (idx !== -1) {
            allArticles[idx] = {
              ...allArticles[idx],
              title: updated.title,
              category: updated.category,
              updatedAt: updated.updatedAt,
              readingTime: updated.readingTime,
              status: updated.status
            };
          }
          renderArticlesTable();
          closeEditModal();
          const updatedTimeStr = new Date(updated.updatedAt).toLocaleTimeString("en-IN", { hour: "2-digit", minute: "2-digit" });
          showToast(`✨ Article "${updated.title}" saved! Last modified: ${updatedTimeStr}`);
        } else {
          if (editModalError) {
            editModalError.textContent = data.message || "Failed to save article changes.";
            editModalError.classList.remove("hidden");
          }
        }
      } catch (err) {
        if (editModalError) {
          editModalError.textContent = "Network error while saving article.";
          editModalError.classList.remove("hidden");
        }
      } finally {
        if (editSaveBtn && editSaveText) {
          editSaveBtn.disabled = false;
          editSaveText.textContent = "Save Changes";
        }
      }
    });

    // Close modals on Escape key
    window.addEventListener("keydown", (e) => {
      if (e.key === "Escape") {
        if (!editModal?.classList.contains("hidden")) {
          closeEditModal();
        } else if (!deleteModal?.classList.contains("hidden")) {
          closeDeleteModal();
        }
      }
    });
  </script>
</Layout>
