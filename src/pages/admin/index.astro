---
import Layout from '../../layouts/Layout.astro';

export const prerender = false;

// Force zero caching across Cloudflare edge, proxies, and client browsers
Astro.response.headers.set('Cache-Control', 'no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0, s-maxage=0');
Astro.response.headers.set('Pragma', 'no-cache');
Astro.response.headers.set('Expires', '0');
Astro.response.headers.set('Surrogate-Control', 'no-store');
Astro.response.headers.set('CDN-Cache-Control', 'no-store');
Astro.response.headers.set('Cloudflare-CDN-Cache-Control', 'no-store');

const pageTitle = "Administration Portal | AKTU Student Utility";
const pageDescription = "Administrative content management, CDN cache invalidation, and student fair-use rate limiting portal.";
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonicalUrl="https://akturesult.bond/admin"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-14 text-left">

    <!-- Screen 1: Admin Passcode Login Card (shown when unauthenticated) -->
    <div id="admin-auth-view" class="max-w-md mx-auto my-12 p-6 sm:p-8 rounded-3xl bg-[#0e1117] light:bg-white border border-white/10 light:border-black/10 shadow-2xl space-y-6 text-center">
      <div class="w-16 h-16 rounded-2xl bg-brand-blue/15 text-brand-blue flex items-center justify-center mx-auto text-3xl border border-brand-blue/25 shadow-inner">
        🔐
      </div>

      <div class="space-y-2">
        <h1 class="text-2xl font-black tracking-tight text-white light:text-ink">
          Admin Portal &amp; Rate Limits
        </h1>
        <p class="text-xs text-gray-400 light:text-gray-500 leading-relaxed">
          Enter administrative master passcode to manage articles, view student fair-use search limits, reset IP quotas, and control CDN caching.
        </p>
      </div>

      <form id="admin-login-form" class="space-y-4 text-left">
        <div>
          <label for="admin-passcode-input" class="block text-xs font-semibold text-gray-300 light:text-gray-700 mb-1.5">
            Admin Master Passcode
          </label>
          <div class="relative">
            <input 
              id="admin-passcode-input" 
              type="password" 
              required
              autocomplete="current-password"
              placeholder="Enter passcode"
              class="w-full px-4 py-3 rounded-xl bg-black/40 light:bg-gray-50 border border-white/15 light:border-gray-300 text-white light:text-ink text-sm focus:outline-none focus:ring-2 focus:ring-brand-blue transition-all"
            />
          </div>
        </div>

        <div id="admin-auth-error" class="hidden p-3 rounded-xl bg-rose-500/10 border border-rose-500/20 text-rose-400 text-xs font-medium text-center"></div>

        <button 
          id="admin-auth-submit-btn" 
          type="submit" 
          class="w-full py-3 rounded-xl bg-gradient-to-r from-brand-blue to-purple-600 hover:from-brand-blue-hover hover:to-purple-700 text-white text-xs font-bold transition-all shadow-lg shadow-brand-blue/25 cursor-pointer transform hover:scale-[1.01] active:scale-[0.99] flex items-center justify-center gap-2"
        >
          <span>Unlock Admin Console &amp; Limits</span>
          <span>&rarr;</span>
        </button>
      </form>

      <div class="pt-2 text-[11px] text-gray-500 border-t border-white/5 light:border-black/5">
        <span>Protected administrative route • Real-time telemetry</span>
      </div>
    </div>

    <!-- Screen 2: Administration Dashboard (shown when authenticated) -->
    <div id="admin-dashboard-view" class="hidden space-y-8">
      
      <!-- Dashboard Top Header Bar -->
      <header class="flex flex-col lg:flex-row lg:items-center justify-between gap-4 p-6 rounded-3xl bg-gradient-to-r from-[#0e1117] via-slate-900/50 to-[#0e1117] light:from-white light:via-slate-50 light:to-white border border-white/10 light:border-black/10 shadow-xl">
        <div class="space-y-1">
          <div class="flex items-center gap-2.5 flex-wrap">
            <h1 class="text-xl sm:text-2xl font-black text-white light:text-ink tracking-tight flex items-center gap-2">
              <span>⚡</span>
              <span>AKTU Administration Portal</span>
            </h1>
            <span class="px-2.5 py-0.5 rounded-full text-[10px] font-bold uppercase tracking-wider bg-emerald-500/15 text-emerald-400 border border-emerald-500/25 flex items-center gap-1">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
              <span>Authenticated</span>
            </span>
          </div>
          <p class="text-xs text-gray-400 light:text-gray-500">
            Publish circulars, monitor student search limits, unblock IP quotas, and control fair-use caching.
          </p>
        </div>

        <!-- Prominent Navigation Switcher Pill directly in Header -->
        <div class="inline-flex p-1.5 rounded-2xl bg-black/40 light:bg-gray-100 border border-white/15 light:border-black/15 shadow-inner self-start lg:self-center shrink-0">
          <button 
            id="admin-nav-articles-btn" 
            type="button" 
            class="px-4 py-2 rounded-xl text-xs font-bold transition-all flex items-center gap-2 cursor-pointer bg-brand-blue text-white shadow-md shadow-brand-blue/30"
          >
            <span>📰</span>
            <span>Articles</span>
          </button>
          <button 
            id="admin-nav-limits-btn" 
            type="button" 
            class="px-4 py-2 rounded-xl text-xs font-bold transition-all flex items-center gap-2 cursor-pointer text-gray-400 hover:text-white light:text-gray-600 light:hover:text-black"
          >
            <span>🛡️</span>
            <span>User Limits</span>
            <span id="nav-limits-badge" class="px-1.5 py-0.5 rounded-full text-[10px] font-mono bg-rose-500 text-white hidden">0</span>
          </button>
        </div>

        <div class="flex items-center gap-2.5 flex-wrap">
          <button 
            id="admin-generate-btn" 
            type="button" 
            class="px-4 py-2.5 rounded-xl bg-gradient-to-r from-emerald-600 to-teal-600 hover:from-emerald-500 hover:to-teal-500 text-white font-bold text-xs shadow-lg shadow-emerald-600/25 transition-all transform hover:scale-105 active:scale-95 flex items-center gap-1.5 cursor-pointer"
            title="Scan latest official videos and synthesize new article"
          >
            <span>⚡</span>
            <span id="admin-generate-btn-text">Generate New Article</span>
          </button>

          <a 
            href="/news" 
            target="_blank" 
            rel="noopener noreferrer" 
            class="px-3.5 py-2.5 rounded-xl bg-white/5 hover:bg-white/10 light:bg-black/5 light:hover:bg-black/10 text-white light:text-ink text-xs font-semibold border border-white/10 light:border-black/10 transition-all flex items-center gap-1.5"
            title="Open public news feed in new tab"
          >
            <span>🌐</span>
            <span>View Public Feed</span>
          </a>

          <button 
            id="admin-logout-btn" 
            type="button" 
            class="px-3.5 py-2.5 rounded-xl bg-rose-500/10 hover:bg-rose-500/20 text-rose-400 border border-rose-500/25 text-xs font-semibold transition-all cursor-pointer flex items-center gap-1.5"
            title="End admin session"
          >
            <span>🚪</span>
            <span>Logout</span>
          </button>
        </div>
      </header>

      <!-- Toast Feedback Notification -->
      <div id="admin-toast" class="hidden p-4 rounded-2xl border text-xs font-medium transition-all duration-300"></div>

      <!-- Navigation Tabs: Articles vs User Rate Limits (Secondary Full-width bar) -->
      <nav class="flex items-center gap-3 border-b border-white/10 light:border-black/10 pb-3 overflow-x-auto">
        <button 
          id="admin-tab-articles-btn" 
          type="button" 
          class="px-5 py-3 rounded-2xl font-bold text-xs sm:text-sm transition-all flex items-center gap-2.5 cursor-pointer bg-brand-blue text-white shadow-lg shadow-brand-blue/20 shrink-0"
        >
          <span>📰</span>
          <span>Articles Management</span>
          <span id="tab-articles-badge" class="px-2 py-0.5 rounded-full text-[10px] bg-white/20 text-white font-mono">--</span>
        </button>

        <button 
          id="admin-tab-limits-btn" 
          type="button" 
          class="px-5 py-3 rounded-2xl font-bold text-xs sm:text-sm transition-all flex items-center gap-2.5 cursor-pointer bg-white/5 hover:bg-white/10 light:bg-black/5 light:hover:bg-black/10 text-gray-400 hover:text-white light:text-gray-600 light:hover:text-black border border-white/10 light:border-black/10 shrink-0"
        >
          <span>🛡️</span>
          <span>User Rate Limits &amp; Quotas</span>
          <span id="tab-limits-badge" class="px-2.5 py-0.5 rounded-full text-[10px] bg-rose-500/20 text-rose-300 border border-rose-500/30 font-mono hidden">0 blocked</span>
        </button>
      </nav>

      <!-- TAB 1: ARTICLES MANAGEMENT SECTION -->
      <div id="section-articles" class="space-y-6">
        <!-- Quick Switch Banner to Limits -->
        <div class="flex items-center justify-between p-4 rounded-2xl bg-brand-blue/10 border border-brand-blue/25 text-xs text-gray-300 flex-wrap gap-3">
          <div class="flex items-center gap-2.5">
            <span class="text-xl">🛡️</span>
            <div>
              <div class="font-bold text-white light:text-ink">Looking for Student Fair-Use Rate Limits &amp; IP Quotas?</div>
              <div class="text-[11px] text-gray-400">Inspect real-time student lookups, unblock restricted IPs, or test daily quota enforcement.</div>
            </div>
          </div>
          <button 
            id="admin-switch-to-limits-quick-btn" 
            type="button" 
            class="px-4 py-2 rounded-xl bg-brand-blue hover:bg-brand-blue-hover text-white font-bold text-xs transition-all cursor-pointer shadow-md shadow-brand-blue/20 shrink-0"
          >
            Open User Limits &amp; Quotas &rarr;
          </button>
        </div>
        <!-- KPI Summary Cards -->
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
          <div class="p-5 rounded-2xl bg-white/[0.02] light:bg-white border border-white/10 light:border-black/10 space-y-1">
            <span class="text-[11px] font-semibold text-gray-400 light:text-gray-500 uppercase tracking-wider block">Total Articles</span>
            <div id="stat-total-articles" class="text-2xl font-black text-white light:text-ink">--</div>
          </div>

          <div class="p-5 rounded-2xl bg-white/[0.02] light:bg-white border border-white/10 light:border-black/10 space-y-1">
            <span class="text-[11px] font-semibold text-gray-400 light:text-gray-500 uppercase tracking-wider block">Total Views</span>
            <div id="stat-total-views" class="text-2xl font-black text-emerald-400">--</div>
          </div>

          <div class="p-5 rounded-2xl bg-white/[0.02] light:bg-white border border-white/10 light:border-black/10 space-y-1">
            <span class="text-[11px] font-semibold text-gray-400 light:text-gray-500 uppercase tracking-wider block">Categories</span>
            <div id="stat-categories" class="text-2xl font-black text-brand-blue">--</div>
          </div>

          <div class="p-5 rounded-2xl bg-white/[0.02] light:bg-white border border-white/10 light:border-black/10 space-y-1">
            <span class="text-[11px] font-semibold text-gray-400 light:text-gray-500 uppercase tracking-wider block">Filtered Count</span>
            <div id="stat-filtered-articles" class="text-2xl font-black text-purple-400">--</div>
          </div>
        </div>

        <!-- Search, Filter & Refresh Bar -->
        <div class="p-4 rounded-2xl bg-white/[0.02] light:bg-white border border-white/10 light:border-black/10 flex flex-col sm:flex-row items-center justify-between gap-3">
          <div class="relative w-full sm:w-96">
            <span class="absolute left-3.5 top-1/2 -translate-y-1/2 text-gray-500 text-xs">🔍</span>
            <input 
              id="admin-search-input" 
              type="text" 
              placeholder="Search articles by title, slug, or keywords..."
              class="w-full pl-9 pr-3.5 py-2.5 rounded-xl bg-black/40 light:bg-gray-50 border border-white/10 light:border-gray-200 text-white light:text-ink text-xs focus:outline-none focus:ring-2 focus:ring-brand-blue transition-all"
            />
          </div>

          <div class="flex items-center gap-2.5 w-full sm:w-auto justify-between sm:justify-end">
            <select 
              id="admin-category-select" 
              class="px-3.5 py-2.5 rounded-xl bg-black/40 light:bg-gray-50 border border-white/10 light:border-gray-200 text-white light:text-ink text-xs focus:outline-none focus:ring-2 focus:ring-brand-blue transition-all cursor-pointer"
            >
              <option value="All">All Categories</option>
              <option value="Results & Marksheets">Results &amp; Marksheets</option>
              <option value="Circulars & Updates">Circulars &amp; Updates</option>
              <option value="Exam Schedule">Exam Schedule</option>
              <option value="Student Services">Student Services</option>
            </select>

            <button 
              id="admin-refresh-btn" 
              type="button" 
              class="px-3.5 py-2.5 rounded-xl bg-white/5 hover:bg-white/10 light:bg-black/5 light:hover:bg-black/10 text-gray-300 light:text-gray-700 text-xs font-semibold border border-white/10 light:border-black/10 transition-all cursor-pointer flex items-center gap-1.5"
              title="Reload articles list"
            >
              <span>🔄</span>
              <span>Refresh</span>
            </button>
          </div>
        </div>

        <!-- Articles Management Table Container -->
        <div class="rounded-3xl border border-white/10 light:border-black/10 bg-white/[0.02] light:bg-white overflow-hidden shadow-xl">
          <!-- Loading State -->
          <div id="admin-table-loading" class="py-16 text-center space-y-3">
            <div class="w-10 h-10 border-2 border-brand-blue border-t-transparent rounded-full animate-spin mx-auto"></div>
            <p class="text-xs text-gray-400 light:text-gray-500">Loading articles from database...</p>
          </div>

          <!-- Empty State -->
          <div id="admin-table-empty" class="hidden py-16 text-center space-y-3">
            <span class="text-3xl block">📭</span>
            <h3 class="text-sm font-bold text-white light:text-ink">No Articles Found</h3>
            <p class="text-xs text-gray-400 light:text-gray-500">Try adjusting your search query or generate a new article.</p>
          </div>

          <!-- Articles Table -->
          <div class="overflow-x-auto">
            <table id="admin-articles-table" class="hidden w-full text-left border-collapse text-xs">
              <thead>
                <tr class="border-b border-white/10 light:border-black/10 bg-white/[0.03] light:bg-black/[0.02] text-gray-400 light:text-gray-500 font-bold uppercase tracking-wider text-[10px]">
                  <th class="py-3.5 px-4">Article</th>
                  <th class="py-3.5 px-4">Category</th>
                  <th class="py-3.5 px-4">Views</th>
                  <th class="py-3.5 px-4">Published</th>
                  <th class="py-3.5 px-4">Source Video</th>
                  <th class="py-3.5 px-4 text-right">Actions</th>
                </tr>
              </thead>
              <tbody id="admin-articles-tbody" class="divide-y divide-white/5 light:divide-black/5 text-gray-300 light:text-gray-700 font-normal">
                <!-- Dynamically populated via client script -->
              </tbody>
            </table>
          </div>
        </div>
      </div>

      <!-- TAB 2: USER RATE LIMITS & QUOTAS SECTION -->
      <div id="section-limits" class="hidden space-y-6">
        <!-- Quick Switch Banner to Articles -->
        <div class="flex items-center justify-between p-4 rounded-2xl bg-purple-500/10 border border-purple-500/25 text-xs text-gray-300 flex-wrap gap-3">
          <div class="flex items-center gap-2.5">
            <span class="text-xl">📰</span>
            <div>
              <div class="font-bold text-white light:text-ink">Looking for Articles &amp; Circular Management?</div>
              <div class="text-[11px] text-gray-400">Edit circular news, generate AI summaries from official video notices, or purge CDN cache.</div>
            </div>
          </div>
          <button 
            id="admin-switch-to-articles-quick-btn" 
            type="button" 
            class="px-4 py-2 rounded-xl bg-purple-600 hover:bg-purple-700 text-white font-bold text-xs transition-all cursor-pointer shadow-md shadow-purple-600/20 shrink-0"
          >
            &larr; Switch to Articles
          </button>
        </div>
        <!-- Applied Policy & System Rules Card -->
        <div class="rounded-3xl p-6 sm:p-7 bg-gradient-to-r from-blue-950/30 via-slate-900/60 to-purple-950/30 border border-blue-500/20 light:bg-blue-50/40 light:border-blue-200 shadow-xl space-y-4">
          <div class="flex items-center justify-between flex-wrap gap-3">
            <div class="flex items-center gap-3">
              <div class="w-12 h-12 rounded-2xl bg-brand-blue/20 text-brand-blue flex items-center justify-center text-2xl border border-brand-blue/30 shrink-0">
                🛡️
              </div>
              <div>
                <h2 class="text-base sm:text-lg font-bold text-white light:text-ink flex items-center gap-2">
                  <span>Active Student Rate Limit Policy</span>
                  <span class="px-2 py-0.5 rounded-full text-[10px] font-bold uppercase tracking-wider bg-emerald-500/15 text-emerald-400 border border-emerald-500/25">Enforced Live</span>
                </h2>
                <p class="text-xs text-gray-400 light:text-gray-500">
                  Fair-use quota protecting university result lookups and preventing automated bot harvesting.
                </p>
              </div>
            </div>
            <div class="flex items-center gap-2">
              <span class="text-[11px] text-gray-400 light:text-gray-500 font-mono">Storage Engine:</span>
              <span id="limits-engine-badge" class="px-2.5 py-1 rounded-xl text-xs font-bold bg-white/5 border border-white/10 text-white light:text-ink">Checking...</span>
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3 pt-2">
            <div class="p-3.5 rounded-2xl bg-black/40 light:bg-white border border-white/5 light:border-black/5 space-y-1">
              <span class="text-[10px] font-bold uppercase tracking-wider text-gray-400 light:text-gray-500">Per-IP Daily Quota</span>
              <div class="text-lg font-black text-white light:text-ink">5 Successful Fetches</div>
              <p class="text-[11px] text-gray-400">Only counted on successful result or DOB retrieval</p>
            </div>

            <div class="p-3.5 rounded-2xl bg-black/40 light:bg-white border border-white/5 light:border-black/5 space-y-1">
              <span class="text-[10px] font-bold uppercase tracking-wider text-gray-400 light:text-gray-500">Auto-Reset Window</span>
              <div class="text-lg font-black text-amber-400">24h Rolling Window</div>
              <p class="text-[11px] text-gray-400">86,400s key TTL in Upstash Redis</p>
            </div>

            <div class="p-3.5 rounded-2xl bg-black/40 light:bg-white border border-white/5 light:border-black/5 space-y-1">
              <span class="text-[10px] font-bold uppercase tracking-wider text-gray-400 light:text-gray-500">Enforcement Action</span>
              <div class="text-lg font-black text-rose-400">HTTP 429 Too Many Req</div>
              <p class="text-[11px] text-gray-400">Blocks API &amp; displays quota dialog</p>
            </div>

            <div class="p-3.5 rounded-2xl bg-black/40 light:bg-white border border-white/5 light:border-black/5 space-y-1">
              <span class="text-[10px] font-bold uppercase tracking-wider text-gray-400 light:text-gray-500">Client Defense</span>
              <div class="text-lg font-black text-emerald-400">LocalStorage Guard</div>
              <p class="text-[11px] text-gray-400">Immediate local modal prevents spam</p>
            </div>
          </div>

          <div class="p-3 rounded-xl bg-rose-500/10 border border-rose-500/20 text-rose-300 light:text-rose-900 text-xs flex items-center gap-2">
            <span>⚠️</span>
            <span><strong>Penalty message displayed to blocked students:</strong> "You have exceeded the limit to fetch details kindly comeback later"</span>
          </div>
        </div>

        <!-- Real-time Quota Telemetry KPI Cards -->
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
          <div class="p-5 rounded-2xl bg-white/[0.02] light:bg-white border border-white/10 light:border-black/10 space-y-1">
            <span class="text-[11px] font-semibold text-gray-400 light:text-gray-500 uppercase tracking-wider block">Tracked Users Today</span>
            <div id="stat-limits-total" class="text-2xl font-black text-white light:text-ink">--</div>
          </div>

          <div class="p-5 rounded-2xl bg-white/[0.02] light:bg-white border border-white/10 light:border-black/10 space-y-1">
            <span class="text-[11px] font-semibold text-gray-400 light:text-gray-500 uppercase tracking-wider block">Blocked (Limit Exceeded)</span>
            <div id="stat-limits-blocked" class="text-2xl font-black text-rose-400">--</div>
          </div>

          <div class="p-5 rounded-2xl bg-white/[0.02] light:bg-white border border-white/10 light:border-black/10 space-y-1">
            <span class="text-[11px] font-semibold text-gray-400 light:text-gray-500 uppercase tracking-wider block">High Usage (3-4 / 5)</span>
            <div id="stat-limits-warning" class="text-2xl font-black text-amber-400">--</div>
          </div>

          <div class="p-5 rounded-2xl bg-white/[0.02] light:bg-white border border-white/10 light:border-black/10 space-y-1">
            <span class="text-[11px] font-semibold text-gray-400 light:text-gray-500 uppercase tracking-wider block">Total Searches Today</span>
            <div id="stat-limits-queries" class="text-2xl font-black text-brand-blue">--</div>
          </div>
        </div>

        <!-- Filter, Search, & IP Unblock Bar -->
        <div class="p-4 rounded-2xl bg-white/[0.02] light:bg-white border border-white/10 light:border-black/10 flex flex-col md:flex-row items-center justify-between gap-3">
          <div class="flex items-center gap-2.5 w-full md:w-auto flex-1">
            <div class="relative w-full sm:w-80">
              <span class="absolute left-3.5 top-1/2 -translate-y-1/2 text-gray-500 text-xs">🔍</span>
              <input 
                id="limits-search-input" 
                type="text" 
                placeholder="Filter by IP address or client ID..."
                class="w-full pl-9 pr-3.5 py-2.5 rounded-xl bg-black/40 light:bg-gray-50 border border-white/10 light:border-gray-200 text-white light:text-ink text-xs focus:outline-none focus:ring-2 focus:ring-brand-blue transition-all"
              />
            </div>

            <select 
              id="limits-status-filter" 
              class="px-3.5 py-2.5 rounded-xl bg-black/40 light:bg-gray-50 border border-white/10 light:border-gray-200 text-white light:text-ink text-xs focus:outline-none focus:ring-2 focus:ring-brand-blue transition-all cursor-pointer"
            >
              <option value="all">All Tracked Users</option>
              <option value="blocked">🔴 Blocked Only (&ge; 5)</option>
              <option value="high">🟡 High Usage (3-4)</option>
              <option value="active">🟢 Normal Usage (&lt; 3)</option>
            </select>
          </div>

          <div class="flex items-center gap-2 w-full md:w-auto justify-end flex-wrap">
            <!-- Quick unblock manual IP input -->
            <div class="flex items-center gap-1.5 w-full sm:w-auto">
              <input 
                id="limits-quick-ip-input" 
                type="text" 
                placeholder="Enter IP to unblock..."
                class="px-3 py-2 rounded-xl bg-black/40 light:bg-gray-50 border border-white/10 light:border-gray-200 text-white light:text-ink text-xs focus:outline-none focus:ring-2 focus:ring-emerald-500 transition-all w-36 sm:w-44"
              />
              <button 
                id="limits-quick-unblock-btn" 
                type="button" 
                class="px-3 py-2 rounded-xl bg-emerald-600/20 hover:bg-emerald-600/30 text-emerald-400 border border-emerald-500/30 text-xs font-bold transition-all cursor-pointer flex items-center gap-1"
                title="Unblock this IP"
              >
                <span>🔓</span>
                <span>Unblock IP</span>
              </button>
            </div>

            <!-- Simulate Test User Button -->
            <button 
              id="limits-simulate-btn" 
