                  <span class="text-xs font-bold text-brand-blue uppercase tracking-wider">Gateway Security Code</span>
                </div>
              </div>

              <p class="text-xs text-gray-300 light:text-gray-700">
                Please enter the security verification code displayed below to fetch your marksheet:
              </p>

              <div class="flex items-center justify-center gap-3 p-3 bg-black/60 light:bg-gray-50 rounded-xl border border-white/10 light:border-gray-200">
                <img 
                  id="without-dob-captcha-img" 
                  src="${imgSrc}" 
                  alt="Security verification code" 
                  class="h-12 rounded-lg border border-white/20 light:border-gray-200 shadow-inner bg-white/5 light:bg-white object-contain"
                />
                <button 
                  type="button" 
                  id="without-dob-refresh-captcha-btn" 
                  class="px-3 py-2 bg-white/10 hover:bg-white/15 light:bg-gray-100 light:hover:bg-gray-200 text-xs text-gray-300 light:text-gray-700 rounded-lg transition-all cursor-pointer flex items-center gap-1 border border-transparent light:border-gray-200"
                >
                  <span>New Code</span>
                </button>
              </div>

              ${errorMsg ? `<div class="p-2 rounded-lg bg-rose-500/10 border border-rose-500/20 text-rose-400 text-xs text-center font-medium">${errorMsg}</div>` : ''}

              <input 
                type="text" 
                id="without-dob-security-code-input" 
                maxlength="6"
                placeholder="Enter characters shown"
                autocomplete="off"
                class="w-full px-3 py-2.5 bg-white/5 border border-white/20 light:bg-gray-50 light:border-gray-300 rounded-lg text-white light:text-ink light:placeholder-gray-400 font-mono text-center tracking-widest text-base uppercase placeholder-gray-500 focus:outline-none focus:border-brand-blue"
              />

              <div class="flex gap-2 pt-1">
                <button 
                  type="button" 
                  id="without-dob-cancel-code-btn" 
                  class="flex-1 py-2.5 bg-white/10 hover:bg-white/15 light:bg-gray-100 light:hover:bg-gray-200 text-gray-300 light:text-gray-700 rounded-lg text-xs font-semibold transition-all cursor-pointer border border-transparent light:border-gray-200"
                >
                  Cancel
                </button>
                <button 
                  type="button" 
                  id="without-dob-submit-code-btn" 
                  class="flex-1 py-2.5 bg-brand-blue hover:bg-brand-blue-hover text-white rounded-lg text-xs font-semibold transition-all cursor-pointer flex items-center justify-center gap-1"
                >
                  <span>Verify &amp; Proceed</span>
                </button>
              </div>
            </div>
          `;

          const codeInput = document.getElementById("without-dob-security-code-input");
          if (codeInput) {
            codeInput.focus();
            codeInput.addEventListener("keydown", (e) => {
              if (e.key === "Enter") {
                e.preventDefault();
                submitCode();
              }
            });
          }

          document.getElementById("without-dob-refresh-captcha-btn")?.addEventListener("click", async () => {
            const btn = document.getElementById("without-dob-refresh-captcha-btn");
            if (btn) btn.innerHTML = `<span>Loading...</span>`;
            try {
              const rRes = await fetch("/api/search", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ rollNumber: rollVal, action: "refreshCaptcha", session: currentSession })
              });
              const rData = await rRes.json();
              if (rData && rData.captchaImage) {
                currentSession = rData.session || currentSession;
                updateModal(rData.captchaImage);
              } else {
                updateModal(imgSrc, "Could not refresh code. Try again.");
              }
            } catch (e) {
              updateModal(imgSrc, "Network error refreshing code.");
            }
          });

          document.getElementById("without-dob-submit-code-btn")?.addEventListener("click", submitCode);
          document.getElementById("without-dob-cancel-code-btn")?.addEventListener("click", resetUI);
        }

        async function submitCode() {
          const codeInput = document.getElementById("without-dob-security-code-input");
          const code = codeInput ? codeInput.value.trim().toUpperCase() : "";
          if (!code || code.length < 4) {
            if (codeInput) codeInput.focus();
            return;
          }

          const submitBtn = document.getElementById("without-dob-submit-code-btn");
          if (submitBtn) {
            submitBtn.disabled = true;
            submitBtn.innerHTML = `
              <div class="w-4 h-4 border-2 border-white/30 border-t-white rounded-full animate-spin"></div>
              <span>Verifying...</span>
            `;
          }

          try {
            const vRes = await fetch("/api/search", {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({ rollNumber: rollVal, manualCaptcha: code, session: currentSession })
            });
            const vData = await vRes.json();
            if (vData && vData.success) {
              showWithoutDobAdInterstitialThen(vData, () => {
                renderVerifiedProfile(vData);
              });
            } else if (vData && vData.needsManualCaptcha && vData.captchaImage) {
              currentSession = vData.session || currentSession;
              updateModal(vData.captchaImage, vData.error || "Incorrect code. Please enter the new characters shown.");
            } else {
              updateModal(initialData.captchaImage, vData?.error || "Verification failed. Please try again.");
            }
          } catch (e) {
            updateModal(initialData.captchaImage, "Network error during verification. Please try again.");
          }
        }

        updateModal(initialData.captchaImage);
      }

      // Execute Search
      function executeSearch(enteredRoll) {
        if (!enteredRoll || !/^[0-9]{10,15}$/.test(enteredRoll)) {
          alert("Please enter a valid 10 to 14 digit AKTU University Roll Number.");
          rollInput?.focus();
          return;
        }

        searchForm?.classList.add("hidden");
        if (captchaContainer) {
          captchaContainer.classList.add("hidden");
          captchaContainer.innerHTML = "";
        }
        if (profileContainer) {
          profileContainer.classList.add("hidden");
          profileContainer.innerHTML = "";
        }
        errorState?.classList.add("hidden");
        loaderState?.classList.remove("hidden");

        log1?.classList.add("hidden");
        log2?.classList.add("hidden");
        log3?.classList.add("hidden");
        log4?.classList.add("hidden");

        if (loadingStatus) loadingStatus.textContent = "Connecting to AKTU Gateway...";
        if (loadingSubstatus) loadingSubstatus.textContent = "Authenticating session & bypassing DOB requirement...";

        setTimeout(() => {
          if (loadingStatus) loadingStatus.textContent = "Negotiating University Gateway...";
          if (loadingSubstatus) loadingSubstatus.textContent = "Validating cryptographic ViewState tokens...";
          log1?.classList.remove("hidden");
        }, 400);

        setTimeout(() => {
          if (loadingStatus) loadingStatus.textContent = "Accessing OneView Archives...";
          if (loadingSubstatus) loadingSubstatus.textContent = "Bypassing DOB requirement check...";
          log2?.classList.remove("hidden");
        }, 900);

        setTimeout(() => {
          if (loadingStatus) loadingStatus.textContent = "Resolving Student Marksheet...";
          if (loadingSubstatus) loadingSubstatus.textContent = "Assembling semester grades & credits ledger...";
          log3?.classList.remove("hidden");
        }, 1500);

        const fetchPromise = fetch('/api/search', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ rollNumber: enteredRoll })
        });

        const delayPromise = new Promise(resolve => setTimeout(resolve, 1800));

        Promise.all([fetchPromise, delayPromise])
          .then(async ([res]) => {
            loaderState?.classList.add("hidden");

            function showError(title, desc) {
              if (errorTitle) errorTitle.textContent = title;
              if (errorDesc) errorDesc.textContent = desc;
              const errBotBtn = document.getElementById("without-dob-error-bot-btn");
              if (errBotBtn && enteredRoll) {
                errBotBtn.setAttribute("href", `https://t.me/akturesultwithoutdobbot?start=${encodeURIComponent(enteredRoll)}`);
              }
              errorState?.classList.remove("hidden");
            }

            if (!res.ok) {
              let errorText = "Could not fetch result right now. Please try again.";
              try {
                const errData = await res.json();
                if (errData?.error) errorText = errData.error;
              } catch (e) {}
              showError("Result Search Failed", errorText);
              return;
            }

            const data = await res.json();
            if (data.success) {
              showWithoutDobAdInterstitialThen(data, () => {
                renderVerifiedProfile(data);
              });
            } else if (data.needsManualCaptcha && data.captchaImage) {
              renderManualCaptcha(data, enteredRoll);
            } else {
              showError("Search Failed", data.error || "Could not retrieve records for this roll number.");
            }
          })
          .catch(err => {
            console.error("Without DOB Search API Error:", err);
            loaderState?.classList.add("hidden");
            if (errorTitle) errorTitle.textContent = "Network Error";
            if (errorDesc) errorDesc.textContent = "Failed to connect to gateway. Please check your internet connection.";
            const errBotBtn = document.getElementById("without-dob-error-bot-btn");
            if (errBotBtn && enteredRoll) {
              errBotBtn.setAttribute("href", `https://t.me/akturesultwithoutdobbot?start=${encodeURIComponent(enteredRoll)}`);
            }
            errorState?.classList.remove("hidden");
          });
      }

      searchForm?.addEventListener("submit", (e) => {
        e.preventDefault();
        const enteredRoll = rollInput ? rollInput.value.trim() : "";
        executeSearch(enteredRoll);
      });

      // Auto-trigger if roll parameter present in URL
      const urlParams = new URLSearchParams(window.location.search);
      const paramRoll = urlParams.get('roll') || urlParams.get('rollNumber');
      if (paramRoll && rollInput) {
        rollInput.value = paramRoll;
        setTimeout(() => {
          executeSearch(paramRoll);
        }, 200);
      }
    };

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", initWithoutDob);
    } else {
      initWithoutDob();
    }
  </script>
</Layout>
