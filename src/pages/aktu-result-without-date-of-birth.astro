  <!-- Client-Side Background Process Script -->
  <script is:inline>
    const initWithoutDob = () => {
      const cardWrapper = document.getElementById("without-dob-card-wrapper");
      const searchForm = document.getElementById("without-dob-search-form");
      const rollInput = document.getElementById("without-dob-roll-number");
      const loaderState = document.getElementById("without-dob-loader-state");
      const loadingStatus = document.getElementById("without-dob-loading-status");
      const loadingSubstatus = document.getElementById("without-dob-loading-substatus");
      const log1 = document.getElementById("without-dob-log-1");
      const log2 = document.getElementById("without-dob-log-2");
      const log3 = document.getElementById("without-dob-log-3");
      const log4 = document.getElementById("without-dob-log-4");

      const captchaContainer = document.getElementById("without-dob-manual-captcha-container");
      const profileContainer = document.getElementById("without-dob-verified-profile-container");
      const errorState = document.getElementById("without-dob-error-state");
      const errorTitle = document.getElementById("without-dob-error-title");
      const errorDesc = document.getElementById("without-dob-error-desc");
      const retryBtn = document.getElementById("without-dob-error-retry-btn");

      // Overall Status Calculator
      function calculateOverallStatus(semesters, defaultCgpa) {
        let hasBack = false;
        let hasFail = false;
        let hasGrace = false;

        if (Array.isArray(semesters)) {
          semesters.forEach((sem) => {
            const status = (sem.status || "").toUpperCase();
            if (status.includes("PCP") || status.includes("CP") || status.includes("FAIL")) hasBack = true;
            if (status.includes("FAIL")) hasFail = true;
            if (status.includes("PWG")) hasGrace = true;

            if (sem.subjects && Array.isArray(sem.subjects)) {
              sem.subjects.forEach((sub) => {
                if (sub.grade === "F" || (sub.back && sub.back !== "--")) hasBack = true;
              });
            }
          });
        }

        let overall = "PASS";
        let badgeClass = "text-emerald-400 font-extrabold text-xs sm:text-sm";

        if (hasFail) {
          overall = "FAIL";
          badgeClass = "text-red-400 font-extrabold text-xs sm:text-sm";
        } else if (hasBack) {
          overall = "PCP";
          badgeClass = "text-purple-400 font-extrabold text-xs sm:text-sm";
        } else if (hasGrace) {
          overall = "PWG";
          badgeClass = "text-amber-400 font-extrabold text-xs sm:text-sm";
        }

        return { status: overall, badgeClass };
      }

      // Build Semesters Accordion HTML
      function buildSemestersAccordionHtml(semesters) {
        if (!Array.isArray(semesters) || semesters.length === 0) return '';
        return semesters.map((semData, idx) => {
          const subjects = semData.subjects || [];
          const rowsHtml = subjects.map(sub => `
            <tr class="hover:bg-white/5 light:hover:bg-gray-50 border-b border-white/5 light:border-gray-100 text-[11px] text-gray-300 light:text-gray-700">
              <td class="p-2.5 font-mono font-bold text-gray-400 light:text-gray-500">${sub.code || '--'}</td>
              <td class="p-2.5 text-white light:text-ink font-medium max-w-[160px] sm:max-w-none truncate sm:whitespace-normal" title="${sub.name || ''}">${sub.name || '--'}</td>
              <td class="p-2.5 text-gray-400 light:text-gray-500 uppercase text-[10px]">${sub.type || '--'}</td>
              <td class="p-2.5 text-center text-gray-300 light:text-gray-700 font-mono">${sub.int ?? '--'}</td>
              <td class="p-2.5 text-center text-gray-300 light:text-gray-700 font-mono">${sub.ext ?? '--'}</td>
              <td class="p-2.5 text-center font-mono ${sub.back && sub.back !== '--' ? 'text-purple-400 light:text-purple-700 font-bold' : 'text-gray-500'}">${sub.back || '--'}</td>
              <td class="p-2.5 text-center font-mono font-bold ${sub.grade === 'F' ? 'text-red-400 light:text-red-600' : 'text-brand-blue'}">${sub.grade || '--'}</td>
            </tr>
          `).join('');

          return `
            <div class="border border-white/10 light:border-gray-200 rounded-xl bg-white/[0.02] light:bg-white overflow-hidden light:shadow-xs">
              <button 
                type="button" 
                class="without-dob-sem-toggle w-full px-4 py-3 flex items-center justify-between text-left focus:outline-none hover:bg-white/[0.04] light:hover:bg-gray-50 transition-colors cursor-pointer"
                data-sem-index="${idx}"
                aria-expanded="false"
              >
                <div class="flex flex-col sm:flex-row sm:items-center gap-1 sm:gap-4">
                  <span class="font-bold text-white light:text-ink text-xs sm:text-sm">${semData.sem || `Semester ${idx + 1}`}</span>
                  <div class="flex gap-2 text-[10px] text-gray-400 light:text-gray-600">
                    <span>SGPA: <strong class="text-brand-blue font-bold">${semData.sgpa || '--'}</strong></span>
                    <span>Marks: <strong class="text-gray-200 light:text-gray-800">${semData.marks || '--'}</strong></span>
                    <span class="px-1.5 py-0.5 rounded font-bold ${semData.status === 'PASS' || semData.status === 'Cleared' ? 'bg-emerald-500/20 light:bg-emerald-100 text-emerald-400 light:text-emerald-800' : 'bg-purple-500/20 light:bg-purple-100 text-purple-400 light:text-purple-800'}">${semData.status || 'PASS'}</span>
                  </div>
                </div>
                <svg class="w-4 h-4 transform transition-transform duration-200 text-gray-400 without-dob-sem-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                </svg>
              </button>
              <div class="without-dob-sem-content hidden p-3 border-t border-white/10 light:border-gray-200 bg-black/40 light:bg-gray-50/50">
                <div class="overflow-x-auto rounded-lg border border-white/10 light:border-gray-200 bg-black/20 light:bg-white">
                  <table class="w-full text-left border-collapse min-w-[480px]">
                    <thead>
                      <tr class="bg-white/5 light:bg-gray-100 text-gray-400 light:text-gray-600 border-b border-white/10 light:border-gray-200 text-[10px] uppercase tracking-wider font-semibold">
                        <th class="p-2.5">Code</th>
                        <th class="p-2.5">Subject Name</th>
                        <th class="p-2.5">Type</th>
                        <th class="p-2.5 text-center">Int</th>
                        <th class="p-2.5 text-center">Ext</th>
                        <th class="p-2.5 text-center">Back</th>
                        <th class="p-2.5 text-center">Grade</th>
                      </tr>
                    </thead>
                    <tbody class="divide-y divide-white/5 light:divide-gray-100">
                      ${rowsHtml || '<tr><td colspan="7" class="p-3 text-center text-gray-500 light:text-gray-600 text-xs">No individual subject entries found for this semester.</td></tr>'}
                    </tbody>
                  </table>
                </div>
              </div>
            </div>
          `;
        }).join('');
      }

      // Reset to search form
      function resetUI() {
        if (cardWrapper) {
          cardWrapper.classList.remove("max-w-4xl");
          cardWrapper.classList.add("max-w-lg");
        }
        loaderState?.classList.add("hidden");
        if (adCountdownInterval) {
          clearInterval(adCountdownInterval);
          adCountdownInterval = null;
        }
        const interstitial = document.getElementById("without-dob-ad-interstitial-state");
        if (interstitial) interstitial.classList.add("hidden");
        if (captchaContainer) {
          captchaContainer.classList.add("hidden");
          captchaContainer.innerHTML = "";
        }
        if (profileContainer) {
          profileContainer.classList.add("hidden");
          profileContainer.innerHTML = "";
        }
        errorState?.classList.add("hidden");
        searchForm?.classList.remove("hidden");
        if (rollInput) {
          rollInput.disabled = false;
          rollInput.focus();
        }
      }

      retryBtn?.addEventListener("click", resetUI);

      let adCountdownInterval = null;

      // Pre-Result AdSense Interstitial Handler
      function showWithoutDobAdInterstitialThen(data, onProceed) {
        loaderState?.classList.add("hidden");
        searchForm?.classList.add("hidden");
        errorState?.classList.add("hidden");
        if (captchaContainer) {
          captchaContainer.classList.add("hidden");
          captchaContainer.innerHTML = "";
        }
        if (profileContainer) {
          profileContainer.classList.add("hidden");
          profileContainer.innerHTML = "";
        }

        const interstitial = document.getElementById("without-dob-ad-interstitial-state");
        if (!interstitial) {
          onProceed();
          return;
        }

        interstitial.classList.remove("hidden");
        try {
          (window.adsbygoogle = window.adsbygoogle || []).push({});
        } catch (e) {}

        let timeLeft = 5;
        const countdownText = document.getElementById("without-dob-ad-countdown-text");
        const progressBar = document.getElementById("without-dob-ad-progress-bar");
        if (countdownText) countdownText.textContent = `${timeLeft}s`;
        if (progressBar) progressBar.style.width = "0%";

        if (adCountdownInterval) clearInterval(adCountdownInterval);

        let finished = false;
        const finishAndShow = () => {
          if (finished) return;
          finished = true;
          if (adCountdownInterval) {
            clearInterval(adCountdownInterval);
            adCountdownInterval = null;
          }
          interstitial.classList.add("hidden");
          onProceed();
          try {
            (window.adsbygoogle = window.adsbygoogle || []).push({});
          } catch (e) {}
        };

        adCountdownInterval = setInterval(() => {
          timeLeft--;
          const pct = Math.min(100, Math.round(((5 - timeLeft) / 5) * 100));
          if (progressBar) progressBar.style.width = `${pct}%`;
          if (countdownText) countdownText.textContent = `${timeLeft}s`;
          if (timeLeft <= 0) {
            finishAndShow();
          }
        }, 1000);

        const viewBtn = document.getElementById("without-dob-ad-view-result-btn");
        if (viewBtn) {
          viewBtn.onclick = (e) => {
            e.preventDefault();
            finishAndShow();
          };
        }
      }

      // Render Verified Profile Card
      function renderVerifiedProfile(data) {
        loaderState?.classList.add("hidden");
        searchForm?.classList.add("hidden");
        if (captchaContainer) {
          captchaContainer.classList.add("hidden");
          captchaContainer.innerHTML = "";
        }

        const studentName = data.name || data.student?.name || "Verified AKTU Student";
        const rollNumber = data.rollNo || data.rollNumber || (rollInput ? rollInput.value.trim() : "--");
        const botUrl = data.telegramBotUrl || `https://t.me/akturesultwithoutdobbot?start=${encodeURIComponent(rollNumber)}`;
        const enrollmentNo = data.enrollmentNo || data.student?.enrollmentNo;
        const enrollmentHtml = (enrollmentNo && enrollmentNo !== '--') 
          ? `<div><span class="text-gray-500 light:text-gray-500 block text-[10px] uppercase">Enrollment No</span><span class="font-bold text-white light:text-ink">${enrollmentNo}</span></div>` 
          : '';
        const fatherName = data.fatherName || data.student?.fatherName;
        const fatherHtml = (fatherName && fatherName !== '--') 
          ? `<div><span class="text-gray-500 light:text-gray-500 block text-[10px] uppercase">Father's Name</span><span class="font-bold text-white light:text-ink">${fatherName}</span></div>` 
          : '';
        const course = data.course || data.student?.course;
        const courseHtml = (course && course !== '--') 
          ? `<div class="sm:col-span-2"><span class="text-gray-500 light:text-gray-500 block text-[10px] uppercase">Course / Program</span><span class="text-gray-200 light:text-gray-800 font-semibold">${course}</span></div>` 
          : '';
        const institute = data.institute || data.student?.college;
        const instituteHtml = (institute && institute !== '--') 
          ? `<div class="sm:col-span-2"><span class="text-gray-500 light:text-gray-500 block text-[10px] uppercase">College / Institute</span><span class="text-gray-200 light:text-gray-800 font-semibold">${institute}</span></div>` 
