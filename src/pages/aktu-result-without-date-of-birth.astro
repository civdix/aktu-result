---
import Layout from "../layouts/Layout.astro";
import { getAcademicYearInfo } from "../utils/academicYear";

const yearInfo = getAcademicYearInfo();

const roll = Astro.url.searchParams.get("roll") || Astro.url.searchParams.get("rollNumber") || "";

const siteUrl = "https://akturesult.bond";
const pageUrl = `${siteUrl}/aktu-result-without-date-of-birth`;

const pageTitle = roll 
  ? `AKTU Result Without DOB | Marksheet Roll ${roll}` 
  : `AKTU Result Without DOB | OneView Marksheet Online`;

const pageDescription = `Check AKTU Result without Date of Birth online for ${yearInfo.sessionFormatted}. Enter your Roll Number to view complete OneView marksheet, SGPA, and grades instantly.`;

const withoutDobKeywords = `aktu result without date of birth, aktu result without dob, check aktu result without date of birth, how to check aktu result without date of birth, aktu one view result without dob, aktu result by roll number without date of birth, aktu marksheet without date of birth, aktu result date of birth problem, aktu result 2026 without dob, aktu oneview, aktu result ${yearInfo.session}`;

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": pageUrl,
      "url": pageUrl,
      "name": `AKTU Result Without Date of Birth | OneView Marksheet Online`,
      "description": pageDescription,
      "isPartOf": {
        "@type": "WebSite",
        "@id": `${siteUrl}/#website`,
        "name": "AKTU Result & OneView Portal",
        "url": siteUrl
      }
    },
    {
      "@type": "BreadcrumbList",
      "@id": `${pageUrl}/#breadcrumb`,
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": siteUrl
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "AKTU Result Without Date of Birth",
          "item": pageUrl
        }
      ]
    },
    {
      "@type": "HowTo",
      "@id": `${pageUrl}/#howto`,
      "name": "How to Check AKTU Result Without Date of Birth",
      "description": "Step-by-step tutorial on retrieving your AKTU OneView semester marksheet and scorecards without needing your registered Date of Birth.",
      "totalTime": "PT30S",
      "step": [
        {
          "@type": "HowToStep",
          "position": 1,
          "name": "Enter University Roll Number",
          "text": "Locate your 10 to 13 digit AKTU University Roll Number from your student ID or admit card and enter it into the search box.",
          "url": `${pageUrl}#search-box`
        },
        {
          "@type": "HowToStep",
          "position": 2,
          "name": "Automated Gateway Handshake",
          "text": "Click 'Check Result Without DOB'. The system queries the university gateway without asking for your registered date of birth.",
          "url": `${pageUrl}#search-box`
        },
        {
          "@type": "HowToStep",
          "position": 3,
          "name": "View and Print Marksheet",
          "text": "Inspect all semester subject grades, theory and sessional marks, SGPA, CGPA, and download or print your scorecard.",
          "url": `${pageUrl}#search-box`
        }
      ]
    },
    {
      "@type": "FAQPage",
      "@id": `${pageUrl}/#faq`,
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Can I check my AKTU result without Date of Birth (DOB)?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. While the official OneView portal at oneview.aktu.ac.in requires both Roll Number and registered Date of Birth, our tool establishes an authenticated gateway connection to fetch your complete semester marksheet, SGPA, CGPA, and pass status using only your University Roll Number."
          }
        },
        {
          "@type": "Question",
          "name": "Why does the official AKTU OneView portal require Date of Birth?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Dr. A.P.J. Abdul Kalam Technical University introduced the Date of Birth verification step to protect student privacy and prevent unauthorized third parties from viewing academic scorecards. However, students frequently face errors due to forgotten DOBs or formatting discrepancies."
          }
        },
        {
          "@type": "Question",
          "name": "What should I do if I forgot my registered Date of Birth in AKTU records?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "If you cannot recall the exact Date of Birth submitted during admission, you can check your marksheet right here without DOB. You can also verify your registered DOB on your AKTU semester admit card, high school marksheet, or by checking your student profile on the AKTU ERP portal (erp.aktu.ac.in)."
          }
        },
        {
          "@type": "Question",
          "name": "Does this tool support both regular and carry-over (COP) results?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. Our tool displays your full historical OneView marksheet, including all past semesters, regular theory/practical papers, carry-over papers (COP), special carry-over results, and grace marks (PWG/PCP)."
          }
        },
        {
          "@type": "Question",
          "name": "Is the marksheet displayed here authentic and official?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The data is fetched directly in real-time from the official AKTU academic servers (oneview.aktu.ac.in). While this score card provides genuine official grades for provisional use and verification, the final degree certificate is issued by your affiliated college."
          }
        },
        {
          "@type": "Question",
          "name": "What courses are supported for checking result without DOB?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "All undergraduate and postgraduate courses affiliated with AKTU are supported, including B.Tech, B.Pharma, MBA, MCA, B.Arch, M.Tech, B.Voc, and Diploma lateral entries."
          }
        }
      ]
    }
  ]
};
---

<Layout 
  title={pageTitle} 
  description={pageDescription} 
  keywords={withoutDobKeywords}
  canonicalUrl={pageUrl}
  jsonLd={jsonLd}
>
  <!-- Hero Section with Search Interface -->
  <section class="relative pb-12 md:pb-16 overflow-hidden border-b border-canvas-dark-border light:border-canvas-light-border bg-gradient-to-b from-black via-canvas-dark-surface to-black light:from-white light:via-canvas-light-surface light:to-white transition-colors duration-300">
    <!-- Ambient Glows -->
    <div class="absolute top-[-10%] left-[-10%] w-[500px] h-[500px] rounded-full bg-brand-blue/10 blur-[130px] pointer-events-none"></div>
    <div class="absolute bottom-[10%] right-[-10%] w-[450px] h-[450px] rounded-full bg-purple-500/10 blur-[130px] pointer-events-none"></div>

    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 text-center space-y-8">
      
      <!-- Headline & Introduction -->
      <div class="space-y-4 max-w-3xl mx-auto">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-white/[0.08] light:border-black/[0.06] bg-white/[0.03] light:bg-white/40 backdrop-blur-md text-xs text-gray-400 light:text-gray-600">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
          <span>Official AKTU OneView Gateway • No Date of Birth Needed</span>
        </div>

        <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-extrabold tracking-tight leading-[1.15] bg-gradient-to-b from-white to-gray-400 dark:from-white dark:to-gray-400 light:from-ink light:to-gray-800 bg-clip-text text-transparent">
          AKTU Result <span class="bg-gradient-to-r from-brand-blue via-brand-blue-light to-purple-500 bg-clip-text text-transparent">Without Date of Birth</span>
        </h1>

        <p class="text-sm sm:text-base md:text-lg text-gray-400 light:text-gray-600 leading-relaxed">
          Forgot or lost your registered Date of Birth? Check your <strong class="text-white light:text-ink font-semibold">AKTU Result {yearInfo.sessionFormatted}</strong> online instantly. Enter your University Roll Number below to retrieve your complete <strong class="text-white light:text-ink font-semibold">OneView Marksheet</strong>, SGPA, CGPA, and semester grades directly.
        </p>
      </div>

      <!-- Search Card Interface -->
      <div id="without-dob-card-wrapper" class="w-full max-w-lg mx-auto relative group transition-all duration-500 text-left">
        <div class="absolute -inset-1 bg-gradient-to-r from-brand-blue to-purple-600 rounded-2xl blur-xl opacity-20 group-hover:opacity-35 transition duration-1000"></div>
        
        <div class="relative iphone-glass p-6 sm:p-8 rounded-2xl transition-all duration-300">
          
          <!-- 1. Search Form -->
          <form id="without-dob-search-form" class="space-y-4" action="javascript:void(0);">
            <div>
              <label for="without-dob-roll-number" class="block text-xs font-bold uppercase tracking-wider text-gray-400 light:text-gray-600 mb-2">
                University Roll Number
              </label>
              <div class="relative">
                <input 
                  type="text" 
                  id="without-dob-roll-number" 
                  name="roll" 
                  placeholder="e.g. 2100650100045" 
                  maxlength="15"
                  pattern="[0-9]{10,15}"
                  value={roll}
                  required 
                  autocomplete="off"
                  class="w-full px-4 py-3 bg-black/40 light:bg-white border border-canvas-dark-border light:border-canvas-light-border rounded-xl text-white light:text-ink font-mono text-base tracking-wider placeholder-gray-600 light:placeholder-gray-400 focus:outline-none focus:border-brand-blue transition-all"
                />
                <div class="absolute right-3 top-3 text-gray-500 pointer-events-none text-xs">
                  10-14 digits
                </div>
              </div>
              <p class="text-[11px] text-gray-500 light:text-gray-500 mt-1.5">
                🔒 No Date of Birth (DOB) or password required. Direct OneView handshake.
              </p>
            </div>

            <button 
              type="submit" 
              id="without-dob-submit-btn" 
              class="w-full py-3.5 bg-brand-blue hover:bg-brand-blue-hover text-white text-sm font-bold rounded-xl transition-all cursor-pointer flex items-center justify-center gap-2 premium-shadow-dark"
            >
              <span>⚡ Check Result Without DOB</span>
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            </button>

            <div class="pt-1 flex items-center justify-center gap-1.5 text-center text-xs text-gray-400 light:text-gray-600">
              <svg class="w-3.5 h-3.5 fill-sky-400 shrink-0" viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm4.64 6.8c-.15 1.58-.8 5.42-1.13 7.19-.14.75-.42 1-.68 1.03-.58.05-1.02-.38-1.58-.75-.88-.58-1.38-.94-2.23-1.5-.99-.65-.35-1.01.22-1.59.15-.15 2.71-2.48 2.76-2.69a.2.2 0 00-.05-.18c-.06-.05-.14-.03-.21-.02-.09.02-1.49.95-4.22 2.79-.4.27-.76.41-1.08.4-.36-.01-1.04-.2-1.55-.37-.63-.2-1.12-.31-1.08-.66.02-.18.27-.36.75-.55 2.92-1.27 4.86-2.11 5.83-2.51 2.78-1.16 3.35-1.36 3.73-1.36.08 0 .27.02.39.12.1.08.13.19.14.27-.01.06.01.24 0 .38z"/></svg>
              <span>Instant results also via</span>
              <a href="https://t.me/akturesultwithoutdobbot" target="_blank" rel="noopener noreferrer" class="text-sky-400 light:text-brand-blue font-semibold hover:underline">
                Telegram Bot (@akturesultwithoutdobbot)
              </a>
            </div>
          </form>

          <!-- 2. Loading State -->
          <div id="without-dob-loader-state" class="hidden py-8 space-y-4 text-center">
            <div class="w-12 h-12 border-3 border-brand-blue/20 border-t-brand-blue rounded-full animate-spin mx-auto"></div>
            <div class="space-y-1">
              <h3 class="text-sm font-bold text-white light:text-ink" id="without-dob-loading-status">Connecting to AKTU Gateway...</h3>
              <p class="text-xs text-gray-400 light:text-gray-500" id="without-dob-loading-substatus">Authenticating session &amp; bypassing DOB requirement...</p>
            </div>

            <!-- Animated Log Lines -->
            <div class="font-mono text-[10px] text-gray-600 light:text-gray-500 bg-black/80 light:bg-gray-100 rounded-lg p-3 space-y-1 overflow-hidden h-24 border border-canvas-dark-border light:border-gray-200 text-left">
              <div class="text-gray-400">&gt; Starting OneView handshake protocol...</div>
              <div id="without-dob-log-1" class="hidden text-gray-500">&gt; Initializing session tokens... [OK]</div>
              <div id="without-dob-log-2" class="hidden text-gray-500">&gt; Bypassing Date of Birth parameter... [OK]</div>
              <div id="without-dob-log-3" class="hidden text-brand-blue">&gt; Querying semester marks database... [OK]</div>
              <div id="without-dob-log-4" class="hidden text-emerald-400">&gt; Assembling student marksheet ledger... [OK]</div>
            </div>
          </div>

          <!-- 3. Manual Security Verification Code Container -->
          <div id="without-dob-manual-captcha-container" class="hidden space-y-4"></div>

          <!-- Pre-Result AdSense Interstitial Modal -->
          <div id="without-dob-ad-interstitial-state" class="hidden space-y-4 animate-fade-in text-center">
            <div class="p-3 sm:p-4 rounded-xl border border-brand-blue/30 light:border-brand-blue/20 bg-brand-blue/5 light:bg-blue-50/60 space-y-2">
              <div class="flex items-center justify-center gap-2 text-brand-blue text-xs font-bold">
                <span class="w-2 h-2 rounded-full bg-brand-blue animate-ping"></span>
                <span>OneView Gateway Result Ready</span>
              </div>
              <p class="text-xs text-gray-300 light:text-gray-700">
                Your semester grades & scorecards have been verified. Displaying marksheet in a few seconds...
              </p>
            </div>

            <!-- Interstitial AdSense Unit -->
            <div class="p-3 rounded-xl border border-white/10 light:border-gray-200 bg-black/40 light:bg-white overflow-hidden text-center min-h-[250px] flex flex-col justify-center items-center">
              <span class="text-[9px] uppercase font-bold text-gray-400 light:text-gray-500 tracking-wider mb-2 block">Sponsored Advertisement</span>
              <ins class="adsbygoogle"
                   style="display:block; width:100%; min-height: 250px;"
                   data-ad-client="ca-pub-5590747238948130"
                   data-ad-slot="default"
                   data-ad-format="auto"
                   data-full-width-responsive="true"></ins>
            </div>

            <div class="space-y-3 pt-1">
              <div class="flex items-center justify-between text-xs text-gray-400 light:text-gray-600">
                <span class="font-medium">Loading marksheet ledger...</span>
                <span class="font-bold text-brand-blue font-mono" id="without-dob-ad-countdown-text">5s</span>
              </div>
              <!-- Animated Progress Bar -->
              <div class="w-full bg-white/10 light:bg-gray-200 h-1.5 rounded-full overflow-hidden">
                <div id="without-dob-ad-progress-bar" class="bg-gradient-to-r from-brand-blue to-emerald-400 h-full w-0 transition-all duration-1000 ease-linear"></div>
              </div>

              <button 
                type="button" 
                id="without-dob-ad-view-result-btn" 
                class="w-full py-3.5 bg-gradient-to-r from-emerald-500 via-teal-500 to-brand-blue hover:from-emerald-600 hover:to-brand-blue-hover text-white text-xs sm:text-sm font-bold rounded-xl shadow-lg transition-all flex items-center justify-center gap-2 cursor-pointer"
              >
                <span>⚡ View Full Marksheet Now</span>
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                </svg>
              </button>
            </div>
          </div>

          <!-- 4. Verified Academic Profile Container -->
          <div id="without-dob-verified-profile-container" class="hidden space-y-4"></div>

          <!-- 5. Error State Card -->
          <div id="without-dob-error-state" class="hidden space-y-4 animate-fade-in">
            <div class="p-4 rounded-xl bg-red-500/10 border border-red-500/20 text-center">
              <div class="w-10 h-10 rounded-full bg-red-500/20 text-red-400 flex items-center justify-center mx-auto mb-2 text-lg">✕</div>
              <h3 class="text-sm font-semibold text-red-400" id="without-dob-error-title">Result Retrieval Failed</h3>
              <p class="text-xs text-gray-400 mt-1" id="without-dob-error-desc">We couldn't locate a student record for the specified roll number. Please verify and try again.</p>
            </div>

            <a 
              id="without-dob-error-bot-btn"
              href="https://t.me/akturesultwithoutdobbot" 
              target="_blank" 
              rel="noopener noreferrer" 
              class="w-full py-3 bg-gradient-to-r from-blue-600 to-purple-600 hover:from-blue-500 hover:to-purple-500 text-white text-xs font-bold rounded-xl transition-all shadow-md flex items-center justify-center gap-2 text-center cursor-pointer"
            >
              <svg class="w-4 h-4 fill-current shrink-0" viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm4.64 6.8c-.15 1.58-.8 5.42-1.13 7.19-.14.75-.42 1-.68 1.03-.58.05-1.02-.38-1.58-.75-.88-.58-1.38-.94-2.23-1.5-.99-.65-.35-1.01.22-1.59.15-.15 2.71-2.48 2.76-2.69a.2.2 0 00-.05-.18c-.06-.05-.14-.03-.21-.02-.09.02-1.49.95-4.22 2.79-.4.27-.76.41-1.08.4-.36-.01-1.04-.2-1.55-.37-.63-.2-1.12-.31-1.08-.66.02-.18.27-.36.75-.55 2.92-1.27 4.86-2.11 5.83-2.51 2.78-1.16 3.35-1.36 3.73-1.36.08 0 .27.02.39.12.1.08.13.19.14.27-.01.06.01.24 0 .38z"/></svg>
              <span>Get Result on Telegram Bot (@akturesultwithoutdobbot)</span>
            </a>

            <button 
              type="button" 
              id="without-dob-error-retry-btn" 
              class="w-full py-3 bg-gray-900 light:bg-gray-100 hover:bg-gray-800 light:hover:bg-gray-200 border border-canvas-dark-border light:border-canvas-light-border text-xs font-semibold rounded-xl text-white light:text-ink transition-colors cursor-pointer"
            >
              Retry Search
            </button>
          </div>

        </div>

        <!-- Cross Links -->
        <div class="pt-4 flex items-center justify-center gap-4 text-xs text-gray-400 flex-wrap">
          <a href="/oneview" class="text-brand-blue hover:underline">OneView Portal &rarr;</a>
          <span>•</span>
          <a href="/aktu-erp-result" class="text-brand-blue hover:underline">AKTU ERP Result &rarr;</a>
          <span>•</span>
          <a href="/roll-number-finder" class="text-brand-blue hover:underline">Find Roll Number &rarr;</a>
        </div>
      </div>

    </div>
  </section>

  <!-- Step-by-Step Tutorial -->
  <section class="py-16 md:py-20 border-b border-canvas-dark-border light:border-canvas-light-border bg-canvas-dark-surface light:bg-canvas-light-surface transition-colors duration-300">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
      
      <div class="text-center space-y-3 max-w-2xl mx-auto">
        <h2 class="text-2xl sm:text-3xl md:text-4xl font-extrabold text-white light:text-ink tracking-tight">
          How to Check AKTU Result Without Date of Birth
        </h2>
        <p class="text-xs sm:text-sm text-gray-400 light:text-gray-600">
          Follow these three simple steps to access your full university marksheet in less than 10 seconds.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <!-- Step 1 -->
        <div class="p-6 rounded-2xl bg-black/40 light:bg-white border border-white/10 light:border-black/10 space-y-4">
          <div class="w-10 h-10 rounded-xl bg-brand-blue/20 text-brand-blue flex items-center justify-center font-bold text-lg">
            1
          </div>
          <h3 class="font-bold text-white light:text-ink text-base">Enter Your Roll Number</h3>
          <p class="text-xs text-gray-400 light:text-gray-600 leading-relaxed">
            Locate your 10 to 13 digit AKTU University Roll Number from your examination admit card, student ID card, or registration slip. Enter it into the search input above.
          </p>
        </div>

        <!-- Step 2 -->
        <div class="p-6 rounded-2xl bg-black/40 light:bg-white border border-white/10 light:border-black/10 space-y-4">
          <div class="w-10 h-10 rounded-xl bg-purple-500/20 text-purple-400 flex items-center justify-center font-bold text-lg">
            2
          </div>
          <h3 class="font-bold text-white light:text-ink text-base">No Date of Birth Needed</h3>
          <p class="text-xs text-gray-400 light:text-gray-600 leading-relaxed">
            Unlike the official university portal which demands your registered DOB, our automated engine queries the gateway directly, removing the need for birth dates or password resets.
          </p>
        </div>

        <!-- Step 3 -->
        <div class="p-6 rounded-2xl bg-black/40 light:bg-white border border-white/10 light:border-black/10 space-y-4">
          <div class="w-10 h-10 rounded-xl bg-emerald-500/20 text-emerald-400 flex items-center justify-center font-bold text-lg">
            3
          </div>
          <h3 class="font-bold text-white light:text-ink text-base">View Full Marksheet</h3>
          <p class="text-xs text-gray-400 light:text-gray-600 leading-relaxed">
            Instantly view semester-wise grades, internal/external marks, carry-over status (COP), SGPA, CGPA, and print or save your authentic academic score card.
          </p>
        </div>
      </div>

    </div>
  </section>

  <!-- In-Depth Guide: Why Official Portal Requires DOB & Troubleshooting -->
  <section class="py-16 md:py-20 border-b border-canvas-dark-border light:border-canvas-light-border bg-black light:bg-canvas-light transition-colors duration-300">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
      
      <!-- Section 1: Why AKTU Requires DOB -->
      <div class="space-y-4">
        <h2 class="text-2xl sm:text-3xl font-extrabold text-white light:text-ink tracking-tight">
          Why Does Official AKTU OneView Require Date of Birth?
        </h2>
        <p class="text-xs sm:text-sm text-gray-400 light:text-gray-600 leading-relaxed">
          Dr. A.P.J. Abdul Kalam Technical University (AKTU Lucknow) implemented Date of Birth (DOB) verification on the <strong class="text-white light:text-ink">oneview.aktu.ac.in</strong> portal as an added privacy measure. In previous years, anyone with a student's roll number could inspect their semester grades, percentage, and carry-over papers.
        </p>
        <p class="text-xs sm:text-sm text-gray-400 light:text-gray-600 leading-relaxed">
          While intended to prevent public score snooping, this requirement frequently prevents legitimate students from accessing their own marksheets due to common issues:
        </p>
        
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-2 text-xs">
          <div class="p-4 rounded-xl bg-white/[0.03] border border-white/[0.08] light:border-black/[0.08] space-y-1.5">
            <span class="font-bold text-brand-blue">1. Mismatched Admission Records</span>
            <p class="text-gray-400 light:text-gray-600">Many students discover their college clerk entered their DOB incorrectly during UPTAC/JEE counseling registration.</p>
          </div>
          <div class="p-4 rounded-xl bg-white/[0.03] border border-white/[0.08] light:border-black/[0.08] space-y-1.5">
            <span class="font-bold text-brand-blue">2. Forgotten Registered Date</span>
            <p class="text-gray-400 light:text-gray-600">Discrepancies between Aadhaar cards and High School matriculation certificates often leave students unsure which date AKTU has on file.</p>
          </div>
          <div class="p-4 rounded-xl bg-white/[0.03] border border-white/[0.08] light:border-black/[0.08] space-y-1.5">
            <span class="font-bold text-brand-blue">3. Date Format Confusion</span>
            <p class="text-gray-400 light:text-gray-600">The official portal uses strict formatting (DD/MM/YYYY vs MM/DD/YYYY). Entering slashes or hyphens incorrectly leads to immediate rejection.</p>
          </div>
          <div class="p-4 rounded-xl bg-white/[0.03] border border-white/[0.08] light:border-black/[0.08] space-y-1.5">
