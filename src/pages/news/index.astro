---
import Layout from '../../layouts/Layout.astro';
import { ArticleService } from '../../services/article.service';

export const prerender = false;

const currentUrl = Astro.url;
const selectedCategory = currentUrl.searchParams.get('category') || 'All';
const page = parseInt(currentUrl.searchParams.get('page') || '1', 10);
const limit = 12;
const skip = (page - 1) * limit;

const { articles, total } = await ArticleService.getRecentArticles(limit, skip, selectedCategory);
const totalPages = Math.ceil(total / limit);

const categories = [
  'All',
  'Results & Marksheets',
  'Circulars & Updates',
  'Exam Schedule',
  'Student Services'
];

const pageTitle = "AKTU News & Latest Circulars 2026 | Result Alerts & Exam Updates";
const pageDescription = "Stay informed with daily AKTU circular breakdowns, odd/even semester results, carry over (COP) exam schedules, marksheet updates, and official university notices.";
const pageKeywords = "aktu news today, aktu circular 2026, aktu latest news, aktu result date, aktu cop exam form, aktu oneview update, aktu btech syllabus, aktu exam center list";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": pageTitle,
  "description": pageDescription,
  "url": "https://akturesult.bond/news",
  "publisher": {
    "@type": "Organization",
    "name": "AKTU Student Portal",
    "logo": {
      "@type": "ImageObject",
      "url": "https://akturesult.bond/images/gemini-svg.webp"
    }
  }
};
---

<Layout
  title={pageTitle}
  description={pageDescription}
  keywords={pageKeywords}
  canonicalUrl="https://akturesult.bond/news"
  jsonLd={jsonLd}
>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-14 space-y-10 text-left">
    
    <!-- Hero Header & Admin Status Bar -->
    <div class="flex items-center justify-between gap-3 flex-wrap">
      <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full border border-purple-500/20 bg-purple-500/10 text-xs text-purple-400 font-semibold">
        <span class="w-2 h-2 rounded-full bg-purple-400 animate-pulse"></span>
        <span>Daily University Feed &amp; Circular Updates</span>
      </div>

      <div id="admin-actions-bar" class="flex items-center gap-2">
        <button 
          id="admin-login-trigger-btn" 
          type="button" 
          class="text-[11px] px-2.5 py-1 rounded-xl border border-white/10 light:border-black/10 text-gray-400 hover:text-white light:hover:text-ink hover:bg-white/5 light:hover:bg-black/5 transition-all flex items-center gap-1 cursor-pointer"
          title="Admin Access"
        >
          <span>🔒</span>
          <span>Admin</span>
        </button>

        <div id="admin-controls-panel" class="hidden items-center gap-2">
          <span class="text-[10px] uppercase font-bold tracking-wider px-2 py-0.5 rounded-md bg-emerald-500/15 text-emerald-400 border border-emerald-500/25 flex items-center gap-1">
            <span>🛡️</span>
            <span>Admin</span>
          </span>
          <button 
            id="admin-logout-trigger-btn" 
            type="button" 
            class="text-[11px] px-2 py-1 rounded-xl border border-white/10 light:border-black/10 text-gray-400 hover:text-white light:hover:text-ink transition-all cursor-pointer"
            title="Logout Admin"
          >
            Logout
          </button>
        </div>
      </div>
    </div>

    <header class="text-center space-y-3.5 max-w-2xl mx-auto">
      <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold tracking-tight bg-gradient-to-r from-white via-gray-200 to-gray-400 dark:from-white dark:via-gray-200 dark:to-gray-400 light:from-ink light:via-gray-800 light:to-gray-900 bg-clip-text text-transparent">
        AKTU News &amp; Circular Desk
      </h1>
      <p class="text-xs sm:text-sm text-gray-400 light:text-gray-600 leading-relaxed">
        Real-time breakdowns of official AKTU notifications, exam guidelines, carry-over forms, marksheet releases, and degree distributions.
      </p>
    </header>

    <!-- Top Sponsored AdSense Unit -->
    <div class="p-3 rounded-2xl border border-white/10 light:border-gray-200 bg-black/40 light:bg-white overflow-hidden text-center min-h-[90px] flex flex-col justify-center items-center">
      <span class="text-[9px] uppercase font-bold text-gray-400 light:text-gray-500 tracking-wider mb-1 block">Sponsored Advertisement</span>
      <ins class="adsbygoogle"
           style="display:block; width:100%; min-height: 90px;"
           data-ad-client="ca-pub-5590747238948130"
           data-ad-format="auto"
           data-full-width-responsive="true"></ins>
    </div>

    <!-- Category Filter Tabs -->
    <div class="flex items-center gap-2 overflow-x-auto pb-2 scrollbar-none justify-start sm:justify-center">
      {categories.map((cat) => {
        const isSelected = selectedCategory === cat;
        const href = cat === 'All' ? '/news' : `/news?category=${encodeURIComponent(cat)}`;
        return (
          <a
            href={href}
            class={`px-4 py-2 rounded-xl text-xs font-semibold whitespace-nowrap transition-all duration-200 border ${
              isSelected
                ? 'bg-brand-blue text-white border-brand-blue shadow-lg shadow-brand-blue/20'
                : 'bg-white/[0.03] light:bg-black/[0.03] text-gray-400 light:text-gray-600 border-white/10 light:border-black/10 hover:text-white light:hover:text-ink'
            }`}
          >
            {cat}
          </a>
        );
      })}
    </div>

    <!-- Articles Grid -->
    {articles.length === 0 ? (
      <div class="text-center py-16 space-y-4 rounded-3xl border border-white/10 light:border-black/10 bg-white/[0.02] light:bg-black/[0.02]">
        <div class="w-16 h-16 rounded-full bg-brand-blue/10 text-brand-blue flex items-center justify-center mx-auto text-2xl">
          📰
        </div>
        <h3 class="text-lg font-bold text-white light:text-ink">No Articles Found</h3>
        <p class="text-xs text-gray-400 light:text-gray-600 max-w-sm mx-auto">
          No news articles matching the selected category. New articles are automatically generated every day from university broadcasts!
        </p>
        <a href="/news" class="inline-block px-4 py-2 text-xs font-semibold rounded-xl bg-brand-blue text-white">
          View All Updates
        </a>
      </div>
    ) : (
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {articles.map((art) => (
          <article 
            id={`article-card-${art.slug}`}
            class="flex flex-col justify-between p-6 rounded-3xl border border-white/10 light:border-black/10 bg-white/[0.02] light:bg-white hover:border-brand-blue/40 light:hover:border-brand-blue/40 transition-all duration-300 hover:scale-[1.01] shadow-xl group"
          >
            <div class="space-y-3">
              <!-- Meta Badges -->
              <div class="flex items-center justify-between gap-2 text-[11px]">
                <span class="px-2.5 py-0.5 rounded-full font-bold bg-brand-blue/15 text-brand-blue border border-brand-blue/25">
                  {art.category}
                </span>
                <span class="text-gray-500 light:text-gray-400">
                  {new Date(art.publishedAt).toLocaleDateString('en-IN', {
                    day: 'numeric',
                    month: 'short',
                    year: 'numeric'
                  })}
                </span>
              </div>

              <!-- Title -->
              <h2 class="text-base font-bold text-white light:text-ink group-hover:text-brand-blue transition-colors line-clamp-2 leading-snug">
                <a href={`/news/${art.slug}`}>
                  {art.title}
                </a>
              </h2>

              <!-- Excerpt -->
              <p class="text-xs text-gray-400 light:text-gray-600 line-clamp-3 leading-relaxed">
                {art.excerpt}
              </p>
            </div>

            <!-- Footer Meta -->
            <div class="pt-5 mt-4 border-t border-white/5 light:border-black/5 flex items-center justify-between text-xs text-gray-400 light:text-gray-500">
              <span class="flex items-center gap-1.5">
                <span>⏱️</span>
                <span>{art.readingTime} min read</span>
              </span>
              <div class="flex items-center gap-3">
                <button
                  type="button"
                  class="admin-card-delete-btn hidden text-rose-400 hover:text-rose-300 font-semibold items-center gap-1 cursor-pointer transition-colors"
                  data-slug={art.slug}
                  data-title={art.title}
                  title="Delete article"
                >
                  <span>🗑️</span>
                  <span>Delete</span>
                </button>
                <a
                  href={`/news/${art.slug}`}
                  class="font-semibold text-brand-blue hover:text-brand-blue-hover flex items-center gap-1 group-hover:translate-x-0.5 transition-transform"
                >
                  <span>Read Full</span>
                  <span>&rarr;</span>
                </a>
              </div>
            </div>
          </article>
        ))}
      </div>
    )}

    <!-- Direct Tool Access Banner -->
    <section class="p-6 sm:p-8 rounded-3xl bg-gradient-to-r from-blue-900/30 via-purple-900/30 to-indigo-900/30 light:from-blue-50 light:via-purple-50 light:to-indigo-50 border border-brand-blue/30 light:border-brand-blue/20 flex flex-col md:flex-row items-center justify-between gap-6">
      <div class="space-y-1.5 text-center md:text-left">
        <h3 class="text-base sm:text-lg font-bold text-white light:text-ink">
          Need to Check Your Live Semester Scorecard?
        </h3>
        <p class="text-xs text-gray-300 light:text-gray-600 max-w-xl">
          Don't let a missing or forgotten Date of Birth stop you. Use our direct handshake recovery tool to view your genuine AKTU OneView marksheet by University Roll Number alone.
        </p>
      </div>
      <div class="flex items-center gap-3 shrink-0">
        <a
          href="/"
          class="px-5 py-2.5 rounded-xl bg-gradient-to-r from-brand-blue to-purple-600 hover:from-brand-blue-hover hover:to-purple-700 text-white font-bold text-xs shadow-lg shadow-brand-blue/25 transition-all transform hover:scale-105 active:scale-95"
        >
          ⚡ Check Result Online
        </a>
        <a
          href="/oneview"
          class="px-4 py-2.5 rounded-xl bg-white/10 hover:bg-white/20 light:bg-black/5 light:hover:bg-black/10 text-white light:text-ink font-semibold text-xs border border-white/10 light:border-black/10 transition-all"
        >
          Open OneView
        </a>
      </div>
    </section>

  </div>

  <!-- Admin Login Modal -->
  <div id="admin-login-modal" class="fixed inset-0 z-50 flex items-center justify-center hidden p-4">
    <div id="admin-login-backdrop" class="absolute inset-0 bg-black/75 backdrop-blur-md cursor-pointer"></div>
    <div class="relative w-full max-w-sm bg-[#0e1117] light:bg-white border border-white/15 light:border-gray-200 rounded-3xl p-6 shadow-2xl z-10 space-y-4 text-left">
      <div class="flex items-center justify-between">
        <div class="flex items-center gap-2">
          <span class="text-xl">🔐</span>
          <h3 class="text-base font-bold text-white light:text-ink">Admin Login</h3>
        </div>
        <button id="admin-login-close-btn" class="text-gray-400 hover:text-white light:hover:text-ink cursor-pointer text-sm">✕</button>
      </div>
      <p class="text-xs text-gray-400 light:text-gray-500">
        Enter the administrative passcode configured in the backend to manage and delete articles.
      </p>
      <div class="space-y-3">
        <div>
          <label class="block text-[11px] font-semibold text-gray-300 light:text-gray-700 mb-1">Admin Password</label>
          <input 
            id="admin-password-input" 
            type="password" 
            placeholder="Enter admin password" 
            class="w-full px-3.5 py-2.5 rounded-xl bg-black/40 light:bg-gray-50 border border-white/15 light:border-gray-300 text-white light:text-ink text-xs focus:outline-none focus:ring-2 focus:ring-brand-blue" 
          />
        </div>
        <div id="admin-login-error" class="hidden text-xs text-rose-400 font-medium"></div>
        <button 
          id="admin-login-submit-btn" 
          type="button" 
          class="w-full py-2.5 rounded-xl bg-brand-blue hover:bg-brand-blue-hover text-white text-xs font-bold transition-all shadow-lg cursor-pointer text-center"
        >
          Authenticate &amp; Unlock
        </button>
      </div>
    </div>
  </div>

  <!-- Admin Delete Confirmation Modal -->
  <div id="admin-delete-modal" class="fixed inset-0 z-50 flex items-center justify-center hidden p-4">
    <div id="admin-delete-backdrop" class="absolute inset-0 bg-black/80 backdrop-blur-md cursor-pointer"></div>
    <div class="relative w-full max-w-md bg-[#0e1117] light:bg-white border border-red-500/30 rounded-3xl p-6 shadow-2xl z-10 space-y-4 text-left">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-2xl bg-red-500/15 text-red-400 flex items-center justify-center text-xl shrink-0">
          🗑️
        </div>
        <div>
          <h3 class="text-base font-bold text-white light:text-ink">Delete Article?</h3>
          <p class="text-xs text-gray-400 light:text-gray-500">This action is permanent and cannot be undone.</p>
        </div>
      </div>
      <p class="text-xs text-gray-300 light:text-gray-600 leading-relaxed">
        Are you sure you want to permanently delete:
        <br />
        <strong id="admin-delete-article-title" class="text-white light:text-ink block mt-1"></strong>
        <br />
        This will delete the article file from disk and database, remove it from Google search sitemaps, and clear edge caches.
      </p>
      <div id="admin-delete-error" class="hidden text-xs text-rose-400 font-medium"></div>
      <div class="flex items-center justify-end gap-2.5 pt-2">
        <button 
          id="admin-delete-cancel-btn" 
          type="button" 
          class="px-4 py-2 rounded-xl border border-white/15 light:border-gray-300 text-xs font-semibold text-gray-300 light:text-gray-700 hover:bg-white/5 cursor-pointer"
        >
          Cancel
        </button>
        <button 
          id="admin-delete-confirm-btn" 
          type="button" 
          class="px-4 py-2 rounded-xl bg-red-600 hover:bg-red-500 text-white text-xs font-bold transition-all shadow-lg shadow-red-600/30 cursor-pointer flex items-center gap-1.5"
        >
          <span>Confirm Delete</span>
        </button>
      </div>
    </div>
  </div>

  <script>
    let activeDeleteSlug = '';

    const loginTriggerBtn = document.getElementById("admin-login-trigger-btn");
    const controlsPanel = document.getElementById("admin-controls-panel");
    const logoutTriggerBtn = document.getElementById("admin-logout-trigger-btn");

    const loginModal = document.getElementById("admin-login-modal");
    const loginBackdrop = document.getElementById("admin-login-backdrop");
    const loginCloseBtn = document.getElementById("admin-login-close-btn");
    const passwordInput = document.getElementById("admin-password-input") as HTMLInputElement | null;
    const loginSubmitBtn = document.getElementById("admin-login-submit-btn") as HTMLButtonElement | null;
    const loginError = document.getElementById("admin-login-error");

    const deleteModal = document.getElementById("admin-delete-modal");
    const deleteBackdrop = document.getElementById("admin-delete-backdrop");
    const deleteCancelBtn = document.getElementById("admin-delete-cancel-btn");
    const deleteConfirmBtn = document.getElementById("admin-delete-confirm-btn") as HTMLButtonElement | null;
    const deleteError = document.getElementById("admin-delete-error");
    const deleteTitleEl = document.getElementById("admin-delete-article-title");

    const getLocalToken = (): string => {
      try {
        return localStorage.getItem("aktu_admin_token") || "";
      } catch {
        return "";
      }
    };

    const setLocalToken = (token: string): void => {
      try {
        if (token) localStorage.setItem("aktu_admin_token", token);
        else localStorage.removeItem("aktu_admin_token");
      } catch {}
    };

    const updateAdminUI = (authenticated: boolean): void => {
      const deleteButtons = document.querySelectorAll('.admin-card-delete-btn');
      if (authenticated) {
        loginTriggerBtn?.classList.add("hidden");
        controlsPanel?.classList.remove("hidden");
        controlsPanel?.classList.add("flex");
        deleteButtons.forEach(btn => {
          btn.classList.remove('hidden');
          btn.classList.add('inline-flex');
        });
      } else {
        loginTriggerBtn?.classList.remove("hidden");
        controlsPanel?.classList.add("hidden");
        controlsPanel?.classList.remove("flex");
        deleteButtons.forEach(btn => {
          btn.classList.add('hidden');
          btn.classList.remove('inline-flex');
        });
      }
    };

    // Instant optimistic unlock if local token exists (works regardless of CDN caching)
    if (getLocalToken()) {
      updateAdminUI(true);
    }

    // Check admin authentication status with cache-busting
    const checkAdminStatus = async () => {
      try {
        const token = getLocalToken();
        const headers: Record<string, string> = {};
        if (token) headers["Authorization"] = `Bearer ${token}`;

        const res = await fetch(`/api/admin/status?_t=${Date.now()}`, {
          headers,
          cache: "no-store"
        });
        const data = await res.json();

        if (data.authenticated) {
          updateAdminUI(true);
        } else {
          setLocalToken("");
          updateAdminUI(false);
        }
      } catch {
        // ignore
      }
    };

    checkAdminStatus();

    // Login modal toggles
    loginTriggerBtn?.addEventListener("click", () => {
      loginModal?.classList.remove("hidden");
      loginError?.classList.add("hidden");
      if (passwordInput) {
        passwordInput.value = "";
        passwordInput.focus();
      }
    });

    const closeLoginModal = () => {
      loginModal?.classList.add("hidden");
    };

    loginBackdrop?.addEventListener("click", closeLoginModal);
    loginCloseBtn?.addEventListener("click", closeLoginModal);

    // Login submit
    const handleLogin = async () => {
      const pass = passwordInput?.value?.trim() || "";
      if (!pass) return;

      if (loginSubmitBtn) {
        loginSubmitBtn.disabled = true;
        loginSubmitBtn.textContent = "Verifying...";
      }
      loginError?.classList.add("hidden");

      try {
        const res = await fetch(`/api/admin/login?_t=${Date.now()}`, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ password: pass }),
          cache: "no-store"
        });
        const data = await res.json();
        if (res.ok && data.success) {
          if (data.token) {
            setLocalToken(data.token);
          }
          closeLoginModal();
          updateAdminUI(true);
          checkAdminStatus();
        } else {
          if (loginError) {
            loginError.textContent = data.message || "Incorrect admin password";
            loginError.classList.remove("hidden");
          }
        }
      } catch {
        if (loginError) {
          loginError.textContent = "Authentication request failed";
          loginError.classList.remove("hidden");
        }
      } finally {
        if (loginSubmitBtn) {
          loginSubmitBtn.disabled = false;
          loginSubmitBtn.textContent = "Authenticate & Unlock";
        }
      }
    };

    loginSubmitBtn?.addEventListener("click", handleLogin);
    passwordInput?.addEventListener("keydown", (e) => {
      if (e.key === "Enter") handleLogin();
    });

    // Logout
    logoutTriggerBtn?.addEventListener("click", async () => {
      setLocalToken("");
      updateAdminUI(false);
      await fetch(`/api/admin/logout?_t=${Date.now()}`, {
        method: "POST",
        cache: "no-store"
      });
      checkAdminStatus();
    });

    // Attach click handlers to all card delete buttons
    document.querySelectorAll('.admin-card-delete-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        const slug = btn.getAttribute('data-slug') || '';
        const title = btn.getAttribute('data-title') || '';
        activeDeleteSlug = slug;
        if (deleteTitleEl) {
          deleteTitleEl.textContent = `"${title}"`;
        }
        deleteModal?.classList.remove('hidden');
        deleteError?.classList.add('hidden');
      });
    });

    const closeDeleteModal = () => {
      deleteModal?.classList.add('hidden');
      activeDeleteSlug = '';
    };

    deleteBackdrop?.addEventListener('click', closeDeleteModal);
    deleteCancelBtn?.addEventListener('click', closeDeleteModal);

    // Confirm card delete
    deleteConfirmBtn?.addEventListener('click', async () => {
      if (!activeDeleteSlug) return;

      deleteConfirmBtn.disabled = true;
      deleteConfirmBtn.textContent = "Deleting...";

      try {
        const token = getLocalToken();
        const headers: Record<string, string> = { "Content-Type": "application/json" };
        if (token) headers["Authorization"] = `Bearer ${token}`;

        const res = await fetch(`/api/admin/delete-article?_t=${Date.now()}`, {
          method: "POST",
          headers,
          body: JSON.stringify({ slug: activeDeleteSlug }),
          cache: "no-store"
        });

        const data = await res.json();
        if (res.ok && data.success) {
          deleteConfirmBtn.textContent = "Deleted!";
          const card = document.getElementById(`article-card-${activeDeleteSlug}`);
          if (card) {
            card.style.transition = "all 0.3s ease-out";
            card.style.opacity = "0";
            card.style.transform = "scale(0.9)";
            setTimeout(() => {
              card.remove();
            }, 300);
          }
          setTimeout(() => {
            closeDeleteModal();
            deleteConfirmBtn.disabled = false;
            deleteConfirmBtn.textContent = "Confirm Delete";
          }, 400);
        } else {
          if (deleteError) {
            deleteError.textContent = data.message || "Failed to delete article";
            deleteError.classList.remove("hidden");
          }
          deleteConfirmBtn.disabled = false;
          deleteConfirmBtn.textContent = "Confirm Delete";
        }
      } catch {
        if (deleteError) {
          deleteError.textContent = "Network error while deleting";
          deleteError.classList.remove("hidden");
        }
        deleteConfirmBtn.disabled = false;
        deleteConfirmBtn.textContent = "Confirm Delete";
      }
    });
  </script>
</Layout>
