---
import Layout from '../../layouts/Layout.astro';
import { ArticleService } from '../../services/article.service';
import { MarkdownService } from '../../services/markdown.service';

export const prerender = false;

const { slug } = Astro.params;

if (!slug) {
  return Astro.redirect('/news');
}

const article = await ArticleService.getArticleBySlug(slug);

if (!article) {
  return Astro.redirect('/404');
}

// Increment view counter
await ArticleService.incrementViews(slug);

// Fetch recent related articles
const { articles: relatedArticles } = await ArticleService.getRecentArticles(4, 0, article.category);
const filteredRelated = relatedArticles.filter(a => a.slug !== article.slug).slice(0, 3);

const domain = "https://akturesult.bond";
const articleUrl = `${domain}/news/${article.slug}`;

// Format publish date
const publishedFormatted = new Date(article.publishedAt).toLocaleDateString('en-IN', {
  day: 'numeric',
  month: 'long',
  year: 'numeric'
});

const articleImage = article.sourceVideoId 
  ? `https://i.ytimg.com/vi/${article.sourceVideoId}/maxresdefault.jpg` 
  : `${domain}/og-image.png`;

const fallbackArticleImage = article.sourceVideoId 
  ? `https://i.ytimg.com/vi/${article.sourceVideoId}/hqdefault.jpg` 
  : `${domain}/og-image.png`;

// JSON-LD NewsArticle Structured Data (Optimized for Google News & Top Stories)
const jsonLd: Record<string, any> = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "NewsArticle",
      "headline": article.title,
      "description": article.excerpt,
      "url": articleUrl,
      "mainEntityOfPage": articleUrl,
      "datePublished": article.publishedAt,
      "dateModified": article.updatedAt || article.publishedAt,
      "articleSection": article.category,
      "inLanguage": "en-IN",
      "isAccessibleForFree": true,
      "keywords": article.tags.join(', '),
      "author": {
        "@type": "Organization",
        "name": article.author || "AKTU Student News Desk",
        "url": `${domain}/about`
      },
      "publisher": {
        "@type": "Organization",
        "name": "AKTU Student Portal",
        "url": domain,
        "logo": {
          "@type": "ImageObject",
          "url": `${domain}/images/gemini-svg.webp`,
          "width": 512,
          "height": 512
        },
        "publishingPrinciples": `${domain}/about`,
        "correctionsPolicy": `${domain}/contact`
      },
      "image": [
        articleImage,
        fallbackArticleImage,
        `${domain}/og-image.png`
      ]
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": domain
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "News",
          "item": `${domain}/news`
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": article.title,
          "item": articleUrl
        }
      ]
    }
  ]
};

// Add FAQPage schema if faqs exist
if (article.faqs && article.faqs.length > 0) {
  jsonLd["@graph"].push({
    "@type": "FAQPage",
    "mainEntity": article.faqs.map(faq => ({
      "@type": "Question",
      "name": faq.question,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": faq.answer
      }
    }))
  });
}

const renderedHtml = MarkdownService.render(article.content);
---

<Layout
  title={`${article.title} | AKTU News 2026`}
  description={article.excerpt}
  keywords={article.tags.join(', ')}
  canonicalUrl={articleUrl}
  ogType="article"
  ogImage={fallbackArticleImage}
  jsonLd={jsonLd}
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12 space-y-8 text-left">
    
    <!-- Breadcrumb Navigation & Admin Controls Bar -->
    <div class="flex items-center justify-between gap-3 flex-wrap">
      <nav aria-label="Breadcrumb" class="text-xs text-gray-400 light:text-gray-500 flex items-center gap-1.5 flex-wrap">
        <a href="/" class="hover:text-white light:hover:text-ink transition-colors">Home</a>
        <span>/</span>
        <a href="/news" class="hover:text-white light:hover:text-ink transition-colors">News</a>
        <span>/</span>
        <span class="text-gray-500 light:text-gray-400 truncate max-w-[180px] sm:max-w-md">{article.title}</span>
      </nav>

      <!-- Admin Status & Action Controls -->
      <div id="admin-actions-bar" class="flex items-center gap-2">
        <button 
          id="admin-login-trigger-btn" 
          type="button" 
          class="text-[11px] px-2.5 py-1 rounded-xl border border-white/10 light:border-black/10 text-gray-400 hover:text-white light:hover:text-ink hover:bg-white/5 light:hover:bg-black/5 transition-all flex items-center gap-1 cursor-pointer"
          title="Admin Access"
        >
          <span>🔒</span>
          <span>Admin</span>
        </button>

        <div id="admin-controls-panel" class="hidden items-center gap-2">
          <span class="text-[10px] uppercase font-bold tracking-wider px-2 py-0.5 rounded-md bg-emerald-500/15 text-emerald-400 border border-emerald-500/25 flex items-center gap-1">
            <span>🛡️</span>
            <span>Admin</span>
          </span>
          <button 
            id="admin-delete-trigger-btn" 
            type="button" 
            class="text-xs px-3 py-1.5 rounded-xl bg-gradient-to-r from-red-600 to-rose-600 hover:from-red-500 hover:to-rose-500 text-white font-bold transition-all shadow-lg shadow-red-600/25 flex items-center gap-1.5 cursor-pointer active:scale-95"
            title="Permanently delete this article"
          >
            <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24">
              <path d="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z"/>
            </svg>
            <span>Delete Article</span>
          </button>
          <button 
            id="admin-logout-trigger-btn" 
            type="button" 
            class="text-[11px] px-2 py-1 rounded-xl border border-white/10 light:border-black/10 text-gray-400 hover:text-white light:hover:text-ink transition-all cursor-pointer"
            title="Logout Admin"
          >
            Logout
          </button>
        </div>
      </div>
    </div>

    <!-- Article Header -->
    <header class="space-y-4">
      <div class="flex items-center gap-2 flex-wrap text-xs text-gray-400 light:text-gray-500">
        <span class="px-3 py-1 rounded-full font-bold bg-brand-blue/20 text-brand-blue border border-brand-blue/30">
          {article.category}
        </span>
        <span class="flex items-center gap-1.5">
          <span>📅 Published:</span>
          <time datetime={article.publishedAt} class="text-white light:text-ink font-medium">{publishedFormatted}</time>
        </span>
        <span class="flex items-center gap-1.5 px-2 py-0.5 rounded-md bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 text-[11px] font-semibold">
          <span>✓</span>
          <span>Verified Circular</span>
        </span>
        <span class="flex items-center gap-1">
          <span>⏱️</span>
          <span>{article.readingTime} min read</span>
        </span>
        <span class="flex items-center gap-1">
          <span>✍️</span>
          <span class="text-white light:text-ink font-semibold">{article.author}</span>
        </span>
      </div>

      <h1 class="text-2xl sm:text-3xl md:text-4xl font-extrabold tracking-tight text-white light:text-ink leading-tight">
        {article.title}
      </h1>

      <div class="p-4 sm:p-5 rounded-2xl bg-gradient-to-r from-blue-950/30 via-slate-900/40 to-black/30 light:from-blue-50/70 light:via-slate-50 light:to-white border border-brand-blue/25 space-y-1.5">
        <span class="text-[10px] font-bold uppercase tracking-wider text-brand-blue block">Key Takeaway &amp; Summary</span>
        <p class="text-xs sm:text-sm text-gray-300 light:text-gray-700 leading-relaxed font-medium">
          {article.excerpt}
        </p>
      </div>
    </header>

    <!-- Top In-Article AdSense Banner -->
    <div class="p-3 rounded-2xl border border-white/10 light:border-gray-200 bg-black/40 light:bg-white overflow-hidden text-center min-h-[90px] flex flex-col justify-center items-center">
      <span class="text-[9px] uppercase font-bold text-gray-400 light:text-gray-500 tracking-wider mb-1 block">Sponsored Advertisement</span>
      <ins class="adsbygoogle"
           style="display:block; width:100%; min-height: 90px;"
           data-ad-client="ca-pub-5590747238948130"
           data-ad-format="auto"
           data-full-width-responsive="true"></ins>
    </div>

    <!-- Lead Article Image from YouTube Video Thumbnail (Direct CDN URL - Zero Disk Storage) -->
    {article.sourceVideoId && (
      <div class="space-y-3">
        <a 
          href={`https://www.youtube.com/watch?v=${article.sourceVideoId}`}
          target="_blank"
          rel="noopener noreferrer"
          class="block rounded-3xl overflow-hidden border border-white/10 dark:border-white/10 light:border-black/10 aspect-video shadow-2xl bg-black relative group cursor-pointer"
          title="Click to watch full video on YouTube"
        >
          <img 
            src={`https://i.ytimg.com/vi/${article.sourceVideoId}/maxresdefault.jpg`}
            onerror={`this.onerror=null;this.src='https://i.ytimg.com/vi/${article.sourceVideoId}/hqdefault.jpg';`}
            alt={article.title} 
            class="w-full h-full object-cover group-hover:scale-[1.02] transition-transform duration-500"
            loading="eager"
            decoding="async"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/25 to-transparent flex items-center justify-center opacity-90 group-hover:opacity-100 transition-opacity">
            <div class="w-16 h-16 sm:w-20 sm:h-20 rounded-full bg-red-600/90 text-white flex items-center justify-center shadow-2xl group-hover:scale-110 group-hover:bg-red-600 transition-all duration-300">
              <svg class="w-8 h-8 sm:w-10 sm:h-10 fill-current ml-1" viewBox="0 0 24 24">
                <path d="M8 5v14l11-7z"/>
              </svg>
            </div>
          </div>
          <div class="absolute bottom-3 left-4 right-4 flex items-center justify-between text-xs text-white/90 drop-shadow">
            <span class="truncate max-w-[85%] font-medium">📺 {article.sourceVideoTitle || article.title}</span>
            <span class="text-[10px] font-bold px-2 py-0.5 rounded bg-black/60 backdrop-blur-md">HD</span>
          </div>
        </a>

        <!-- Below Thumbnail Action: See Video for Details Button -->
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 p-3.5 sm:p-4 rounded-2xl border border-white/10 dark:border-white/10 light:border-black/10 bg-white/[0.02] dark:bg-white/[0.02] light:bg-black/[0.02]">
          <div class="flex items-center gap-2 text-xs text-gray-400 light:text-gray-600">
            <span class="w-2 h-2 rounded-full bg-red-500 animate-pulse"></span>
            <span>Broadcast Source: <strong class="text-white dark:text-white light:text-ink font-semibold">{article.sourceChannel || 'University Education Desk'}</strong></span>
          </div>
          <a 
            href={`https://www.youtube.com/watch?v=${article.sourceVideoId}`}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-2 px-5 py-2.5 rounded-xl bg-gradient-to-r from-red-600 via-rose-600 to-red-700 hover:from-red-500 hover:to-rose-500 text-white font-bold text-xs shadow-lg shadow-red-600/25 transition-all transform hover:scale-105 active:scale-95 cursor-pointer shrink-0"
          >
            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
              <path d="M19.615 3.184c-3.604-.246-11.631-.245-15.23 0-3.897.266-4.356 2.62-4.385 8.816.029 6.185.484 8.549 4.385 8.816 3.6.245 11.626.246 15.23 0 3.897-.266 4.356-2.62 4.385-8.816-.029-6.185-.484-8.549-4.385-8.816zm-10.615 12.816v-8l8 3.993-8 4.007z"/>
            </svg>
            <span>See Video for Details</span>
          </a>
        </div>
      </div>
    )}

    <!-- Main Article Body -->
    <article class="space-y-6 article-content prose prose-invert dark:prose-invert max-w-none text-left">
      <div set:html={renderedHtml} />
    </article>

    <!-- Mid-Article AdSense Unit -->
    <div class="p-3 rounded-2xl border border-white/10 light:border-gray-200 bg-black/40 light:bg-white overflow-hidden text-center min-h-[250px] flex flex-col justify-center items-center my-6">
      <span class="text-[9px] uppercase font-bold text-gray-400 light:text-gray-500 tracking-wider mb-1 block">Sponsored Advertisement</span>
      <ins class="adsbygoogle"
           style="display:block; width:100%; min-height: 250px;"
           data-ad-client="ca-pub-5590747238948130"
           data-ad-format="auto"
           data-full-width-responsive="true"></ins>
    </div>

    <!-- Interactive CTA Island: Check Result Without DOB -->
    <section class="p-6 sm:p-8 rounded-3xl bg-gradient-to-r from-blue-900/40 via-purple-900/40 to-slate-900/40 light:from-blue-50 light:via-purple-50 light:to-slate-100 border border-brand-blue/30 space-y-4">
      <div class="flex items-center gap-2">
        <span class="text-2xl">⚡</span>
        <h3 class="text-base sm:text-lg font-bold text-white light:text-ink">
          Verify Your AKTU Semester Marksheet Instantly
        </h3>
      </div>
      <p class="text-xs sm:text-sm text-gray-300 light:text-gray-600 leading-relaxed">
        Need to verify your semester results, SGPA ledger, or backlog status mentioned in this notice? You can query the live AKTU OneView repository without entering your registered Date of Birth.
      </p>
      <div class="flex flex-wrap items-center gap-3 pt-2">
        <a 
          href="/" 
          class="px-5 py-2.5 rounded-xl bg-gradient-to-r from-brand-blue to-purple-600 hover:from-brand-blue-hover hover:to-purple-700 text-white font-bold text-xs shadow-lg shadow-brand-blue/25 transition-all transform hover:scale-105 active:scale-95"
        >
          Check Result Online
        </a>
        <a 
          href="/roll-number-finder" 
          class="px-4 py-2.5 rounded-xl bg-white/10 hover:bg-white/20 light:bg-black/5 light:hover:bg-black/10 text-white light:text-ink font-semibold text-xs border border-white/10 light:border-black/10 transition-all"
        >
          Forgot Roll Number?
        </a>
        <a 
          href="/oneview" 
          class="px-4 py-2.5 rounded-xl bg-white/10 hover:bg-white/20 light:bg-black/5 light:hover:bg-black/10 text-white light:text-ink font-semibold text-xs border border-white/10 light:border-black/10 transition-all"
        >
          OneView Portal
        </a>
      </div>
    </section>

    <!-- Tags Row -->
    {article.tags && article.tags.length > 0 && (
      <div class="pt-4 border-t border-white/10 light:border-black/10">
        <span class="text-xs font-semibold text-gray-400 light:text-gray-500 block mb-2">Related Topics:</span>
        <div class="flex items-center gap-2 flex-wrap">
          {article.tags.map(t => (
            <span class="px-3 py-1 rounded-xl bg-white/5 light:bg-black/5 text-gray-300 light:text-gray-700 text-xs font-medium border border-white/10 light:border-black/10">
              #{t}
            </span>
          ))}
        </div>
      </div>
    )}

    <!-- E-E-A-T Editorial Accountability & Fact-Check Card -->
    <div class="p-5 sm:p-6 rounded-3xl border border-white/10 light:border-black/10 bg-white/[0.02] light:bg-black/[0.02] space-y-3">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-full bg-brand-blue/20 text-brand-blue flex items-center justify-center font-bold text-sm shrink-0 border border-brand-blue/30">
          AKTU
        </div>
        <div>
          <h4 class="text-xs sm:text-sm font-bold text-white light:text-ink flex items-center gap-1.5">
            <span>{article.author}</span>
            <span class="text-emerald-400 text-xs font-semibold" title="Verified University Desk">✓ Verified Editorial Desk</span>
          </h4>
          <p class="text-[11px] text-gray-400 light:text-gray-500">
            Dedicated student journalism &amp; academic notification desk for Dr. A.P.J. Abdul Kalam Technical University.
          </p>
        </div>
      </div>
      <div class="pt-3 border-t border-white/5 light:border-black/5 flex flex-wrap items-center justify-between gap-2 text-[11px] text-gray-400 light:text-gray-500">
        <span>Editorial Standards: Fact-checked against official AKTU circulars &amp; university gazettes.</span>
        <div class="flex items-center gap-3">
          <a href="/about" class="text-brand-blue hover:underline">Editorial Policy</a>
          <span>•</span>
          <a href="/contact" class="text-brand-blue hover:underline">Report Discrepancy</a>
        </div>
      </div>
    </div>

    <!-- Related Articles -->
    {filteredRelated.length > 0 && (
      <section class="pt-8 space-y-4 border-t border-white/10 light:border-black/10">
        <h3 class="text-lg font-bold text-white light:text-ink flex items-center gap-2">
          <span>📰 Related News &amp; Circulars</span>
        </h3>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
          {filteredRelated.map(rel => (
            <a 
              href={`/news/${rel.slug}`} 
              class="p-4 rounded-2xl border border-white/10 light:border-black/10 bg-white/[0.02] light:bg-white hover:border-brand-blue/40 transition-all block group"
            >
              <span class="text-[10px] font-bold text-brand-blue block mb-1">{rel.category}</span>
              <h4 class="text-xs font-bold text-white light:text-ink group-hover:text-brand-blue transition-colors line-clamp-2 leading-snug">
                {rel.title}
              </h4>
              <span class="text-[10px] text-gray-500 light:text-gray-400 mt-2 block">
                {new Date(rel.publishedAt).toLocaleDateString('en-IN', { day: 'numeric', month: 'short' })}
              </span>
            </a>
          ))}
        </div>
      </section>
    )}

  </div>

  <!-- Admin Login Modal -->
  <div id="admin-login-modal" class="fixed inset-0 z-50 flex items-center justify-center hidden p-4">
    <div id="admin-login-backdrop" class="absolute inset-0 bg-black/75 backdrop-blur-md cursor-pointer"></div>
    <div class="relative w-full max-w-sm bg-[#0e1117] light:bg-white border border-white/15 light:border-gray-200 rounded-3xl p-6 shadow-2xl z-10 space-y-4 text-left">
      <div class="flex items-center justify-between">
        <div class="flex items-center gap-2">
          <span class="text-xl">🔐</span>
          <h3 class="text-base font-bold text-white light:text-ink">Admin Login</h3>
        </div>
        <button id="admin-login-close-btn" class="text-gray-400 hover:text-white light:hover:text-ink cursor-pointer text-sm">✕</button>
      </div>
      <p class="text-xs text-gray-400 light:text-gray-500">
        Enter the administrative passcode configured in the backend to manage and delete articles.
      </p>
      <div class="space-y-3">
        <div>
          <label class="block text-[11px] font-semibold text-gray-300 light:text-gray-700 mb-1">Admin Password</label>
          <input 
            id="admin-password-input" 
            type="password" 
            placeholder="Enter admin password" 
            class="w-full px-3.5 py-2.5 rounded-xl bg-black/40 light:bg-gray-50 border border-white/15 light:border-gray-300 text-white light:text-ink text-xs focus:outline-none focus:ring-2 focus:ring-brand-blue" 
          />
        </div>
        <div id="admin-login-error" class="hidden text-xs text-rose-400 font-medium"></div>
        <button 
          id="admin-login-submit-btn" 
          type="button" 
          class="w-full py-2.5 rounded-xl bg-brand-blue hover:bg-brand-blue-hover text-white text-xs font-bold transition-all shadow-lg cursor-pointer text-center"
        >
          Authenticate &amp; Unlock
        </button>
      </div>
    </div>
  </div>

  <!-- Admin Delete Confirmation Modal -->
  <div id="admin-delete-modal" class="fixed inset-0 z-50 flex items-center justify-center hidden p-4">
    <div id="admin-delete-backdrop" class="absolute inset-0 bg-black/80 backdrop-blur-md cursor-pointer"></div>
    <div class="relative w-full max-w-md bg-[#0e1117] light:bg-white border border-red-500/30 rounded-3xl p-6 shadow-2xl z-10 space-y-4 text-left">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-2xl bg-red-500/15 text-red-400 flex items-center justify-center text-xl shrink-0">
          🗑️
        </div>
        <div>
          <h3 class="text-base font-bold text-white light:text-ink">Delete Article?</h3>
          <p class="text-xs text-gray-400 light:text-gray-500">This action is permanent and cannot be undone.</p>
        </div>
      </div>
      <p class="text-xs text-gray-300 light:text-gray-600 leading-relaxed">
        Are you sure you want to permanently delete:
        <br />
        <strong class="text-white light:text-ink block mt-1">"{article.title}"</strong>
        <br />
        This will delete the article file from disk and database, remove it from Google search sitemaps, and clear edge caches.
      </p>
      <div id="admin-delete-error" class="hidden text-xs text-rose-400 font-medium"></div>
      <div class="flex items-center justify-end gap-2.5 pt-2">
        <button 
          id="admin-delete-cancel-btn" 
          type="button" 
          class="px-4 py-2 rounded-xl border border-white/15 light:border-gray-300 text-xs font-semibold text-gray-300 light:text-gray-700 hover:bg-white/5 cursor-pointer"
        >
          Cancel
        </button>
        <button 
          id="admin-delete-confirm-btn" 
          type="button" 
          class="px-4 py-2 rounded-xl bg-red-600 hover:bg-red-500 text-white text-xs font-bold transition-all shadow-lg shadow-red-600/30 cursor-pointer flex items-center gap-1.5"
        >
          <span>Confirm Delete</span>
        </button>
      </div>
    </div>
  </div>

  <script define:vars={{ articleSlug: article.slug }}>
    const loginTriggerBtn = document.getElementById("admin-login-trigger-btn");
    const controlsPanel = document.getElementById("admin-controls-panel");
    const logoutTriggerBtn = document.getElementById("admin-logout-trigger-btn");
    const deleteTriggerBtn = document.getElementById("admin-delete-trigger-btn");

    const loginModal = document.getElementById("admin-login-modal");
    const loginBackdrop = document.getElementById("admin-login-backdrop");
    const loginCloseBtn = document.getElementById("admin-login-close-btn");
    const passwordInput = document.getElementById("admin-password-input");
    const loginSubmitBtn = document.getElementById("admin-login-submit-btn");
    const loginError = document.getElementById("admin-login-error");

    const deleteModal = document.getElementById("admin-delete-modal");
    const deleteBackdrop = document.getElementById("admin-delete-backdrop");
    const deleteCancelBtn = document.getElementById("admin-delete-cancel-btn");
    const deleteConfirmBtn = document.getElementById("admin-delete-confirm-btn");
    const deleteError = document.getElementById("admin-delete-error");

    // Check admin authentication status
    const checkAdminStatus = async () => {
      try {
        const res = await fetch('/api/admin/status');
        const data = await res.json();
        if (data.authenticated) {
          loginTriggerBtn?.classList.add("hidden");
          controlsPanel?.classList.remove("hidden");
          controlsPanel?.classList.add("flex");
        } else {
          loginTriggerBtn?.classList.remove("hidden");
          controlsPanel?.classList.add("hidden");
          controlsPanel?.classList.remove("flex");
        }
      } catch {
        // ignore
      }
    };

    checkAdminStatus();

    // Open/close login modal
    loginTriggerBtn?.addEventListener("click", () => {
      loginModal?.classList.remove("hidden");
      loginError?.classList.add("hidden");
      if (passwordInput) {
        passwordInput.value = "";
        passwordInput.focus();
      }
    });

    const closeLoginModal = () => {
      loginModal?.classList.add("hidden");
    };

    loginBackdrop?.addEventListener("click", closeLoginModal);
    loginCloseBtn?.addEventListener("click", closeLoginModal);

    // Handle login submit
    const handleLogin = async () => {
      const pass = passwordInput?.value?.trim() || "";
      if (!pass) return;

      loginSubmitBtn.disabled = true;
      loginSubmitBtn.textContent = "Verifying...";
      loginError?.classList.add("hidden");

      try {
        const res = await fetch('/api/admin/login', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ password: pass })
        });
        const data = await res.json();
        if (res.ok && data.success) {
          closeLoginModal();
          checkAdminStatus();
        } else {
          if (loginError) {
            loginError.textContent = data.message || "Incorrect admin password";
            loginError.classList.remove("hidden");
          }
        }
      } catch (err) {
        if (loginError) {
          loginError.textContent = "Authentication request failed";
          loginError.classList.remove("hidden");
        }
      } finally {
        loginSubmitBtn.disabled = false;
        loginSubmitBtn.textContent = "Authenticate & Unlock";
      }
    };

    loginSubmitBtn?.addEventListener("click", handleLogin);
    passwordInput?.addEventListener("keydown", (e) => {
      if (e.key === "Enter") handleLogin();
    });

    // Handle logout
    logoutTriggerBtn?.addEventListener("click", async () => {
      await fetch('/api/admin/logout', { method: 'POST' });
      checkAdminStatus();
    });

    // Open/close delete modal
    deleteTriggerBtn?.addEventListener("click", () => {
      deleteModal?.classList.remove("hidden");
      deleteError?.classList.add("hidden");
    });

    const closeDeleteModal = () => {
      deleteModal?.classList.add("hidden");
    };

    deleteBackdrop?.addEventListener("click", closeDeleteModal);
    deleteCancelBtn?.addEventListener("click", closeDeleteModal);

    // Confirm delete action
    deleteConfirmBtn?.addEventListener("click", async () => {
      deleteConfirmBtn.disabled = true;
      deleteConfirmBtn.textContent = "Deleting...";

      try {
        const res = await fetch('/api/admin/delete-article', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ slug: articleSlug })
        });

        const data = await res.json();
        if (res.ok && data.success) {
          deleteConfirmBtn.textContent = "Deleted!";
          setTimeout(() => {
            window.location.href = "/news";
          }, 600);
        } else {
          if (deleteError) {
            deleteError.textContent = data.message || "Failed to delete article";
            deleteError.classList.remove("hidden");
          }
          deleteConfirmBtn.disabled = false;
          deleteConfirmBtn.textContent = "Confirm Delete";
        }
      } catch (err) {
        if (deleteError) {
          deleteError.textContent = "Network error while deleting";
          deleteError.classList.remove("hidden");
        }
        deleteConfirmBtn.disabled = false;
        deleteConfirmBtn.textContent = "Confirm Delete";
      }
    });
  </script>
</Layout>
