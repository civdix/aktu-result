    // Calculate overall status and division based on semesters
    const calculateOverallStatusAndDivision = (semesters, defaultCgpa) => {
      let hasBack = false;
      let hasFail = false;
      let hasGrace = false;

      semesters.forEach((sem) => {
        const status = sem.status.toUpperCase();
        if (status.includes("PCP") || status.includes("CP") || status.includes("FAIL")) {
          hasBack = true;
        }
        if (status.includes("FAIL")) {
          hasFail = true;
        }
        if (status.includes("PWG")) {
          hasGrace = true;
        }

        if (sem.subjects) {
          sem.subjects.forEach((sub) => {
            if (sub.grade === "F" || (sub.back && sub.back !== "--")) {
              hasBack = true;
            }
          });
        }
      });

      let overallStatus = "PASS";
      let badgeClass = "text-emerald-400 font-bold text-[10px] sm:text-xs";
      let division = "I-DIV";

      const cgpa = parseFloat(defaultCgpa);

      if (hasFail) {
        overallStatus = "FAIL";
        badgeClass = "text-red-500 font-bold text-[10px] sm:text-xs";
        division = "--";
      } else if (hasBack) {
        overallStatus = "PCP";
        badgeClass = "text-purple-400 font-bold text-[10px] sm:text-xs";
        division = "--";
      } else if (hasGrace) {
        overallStatus = "PWG";
        badgeClass = "text-amber-500 font-bold text-[10px] sm:text-xs";
        if (cgpa >= 6.5) {
          division = "I-DIV";
        } else if (cgpa >= 5.0) {
          division = "II-DIV";
        } else {
          division = "III-DIV";
        }
      } else {
        if (cgpa >= 7.5) {
          division = "I-DIV HONS";
        } else if (cgpa >= 6.5) {
          division = "I-DIV";
        } else if (cgpa >= 5.0) {
          division = "II-DIV";
        } else {
          division = "III-DIV";
        }
      }

      return { status: overallStatus, badgeClass, division };
    };

