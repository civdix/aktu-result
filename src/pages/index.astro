          <button type="button" id="home-finder-retry-btn" class="w-full py-2.5 bg-white/[0.05] hover:bg-white/[0.1] text-white text-xs font-semibold rounded-lg mt-2 cursor-pointer transition-all">Retry Search</button>
        `;
        document.getElementById("home-finder-retry-btn")?.addEventListener("click", () => {
          homeFinderOutput.classList.add("hidden");
          homeFinderForm.classList.remove("hidden");
          expectedHomeFinderCaptchaSum = generateHomeFinderCaptcha();
          if (captchaAnsInput) captchaAnsInput.value = "";
        });
      }
    });

