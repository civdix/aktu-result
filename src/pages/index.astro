    </div>
  </section>

  <!-- Client-Side Form Handler Script -->
  <script is:inline>
    const initApp = () => {
      // Animate counter from current display to new count
      const updateCounterUI = (count) => {
      const counterEl = document.getElementById("live-counter");
      if (counterEl) {
        const start = parseInt(counterEl.textContent.replace(/[^0-9]/g, ''), 10) || 24000;
        const end = count;
        if (isNaN(start) || start >= end) {
          counterEl.textContent = Number(end).toLocaleString() + "+";
          return;
        }
        
        let current = start;
        const range = end - start;
        const increment = range > 50 ? Math.ceil(range / 20) : 1;
        const stepTime = Math.max(Math.floor(300 / (range / increment)), 15);
        
        const timer = setInterval(() => {
          current += increment;
          if (current >= end) {
            current = end;
            clearInterval(timer);
          }
          counterEl.textContent = Number(current).toLocaleString() + "+";
        }, stepTime);
      }
    };

    // Fetch live counter on load
    const fetchLiveCounter = async () => {
      try {
        const response = await fetch('/api/counter');
        const data = await response.json();
        if (data.success && data.count) {
          updateCounterUI(data.count);
        }
      } catch (err) {
        console.error("Failed to load counter", err);
      }
    };

    // Call it on load
    fetchLiveCounter();

    // Prefill rollNumber from URL parameter and auto-trigger background search
    const urlParams = new URLSearchParams(window.location.search);
    const rollParam = urlParams.get('rollNumber') || urlParams.get('roll');
    const pageRollInput = document.getElementById("roll-number");
    if (rollParam && pageRollInput) {
      pageRollInput.value = rollParam;
      setTimeout(() => {
        pageRollInput.scrollIntoView({ behavior: 'smooth', block: 'center' });
        pageRollInput.focus();
        pageRollInput.classList.add("ring-2", "ring-brand-blue/50");
        const searchFormEl = document.getElementById("search-form");
        if (searchFormEl) {
          searchFormEl.dispatchEvent(new Event("submit"));
        }
      }, 300);
    }
    // DOM Elements
    const heroGrid = document.getElementById("hero-grid");
    const heroCopy = document.getElementById("hero-copy");
    const heroCardWrapper = document.getElementById("hero-card-wrapper");

    const searchForm = document.getElementById("search-form");
    const loaderState = document.getElementById("loader-state");
    const resultState = document.getElementById("result-state");
    const errorState = document.getElementById("error-state");

    const rollInput = document.getElementById("roll-number");

    const resultName = document.getElementById("result-name");
    const resultFather = document.getElementById("result-father");
    const resultRoll = document.getElementById("result-roll");
    const resultEnrollment = document.getElementById("result-enrollment");
    const resultCourse = document.getElementById("result-course");
    const resultInstitute = document.getElementById("result-institute");
    const resultCgpa = document.getElementById("result-cgpa");
    const resultDivision = document.getElementById("result-division");
    const resultDivisionContainer = document.getElementById("result-division-container");
    const resultIndicatorsGrid = document.getElementById("result-indicators-grid");
    const resultStatusBadge = document.getElementById("result-status-badge");
    const accordionContainer = document.getElementById("semesters-accordion-container");
    const finalResultSummaryContainer = document.getElementById("final-result-summary-container");
    const finalResultSummaryContent = document.getElementById("final-result-summary-content");

    const loadingStatus = document.getElementById("loading-status");
    const loadingSubstatus = document.getElementById("loading-substatus");

    // Console logs simulation elements
    const log1 = document.getElementById("log-step-1");
    const log2 = document.getElementById("log-step-2");
    const log3 = document.getElementById("log-step-3");
    const log4 = document.getElementById("log-step-4");

    const printBtn = document.getElementById("print-result-btn");
    const resetBtn = document.getElementById("reset-form-btn");
    const retryBtn = document.getElementById("error-retry-btn");

    // Dynamic Semester Results are loaded live via API
    const genericSemesters = [];

    // Calculate overall status and division based on semesters
    const calculateOverallStatusAndDivision = (semesters, defaultCgpa) => {
      let hasBack = false;
      let hasFail = false;
      let hasGrace = false;

      semesters.forEach((sem) => {
        const status = sem.status.toUpperCase();
        if (status.includes("PCP") || status.includes("CP") || status.includes("FAIL")) {
          hasBack = true;
        }
        if (status.includes("FAIL")) {
          hasFail = true;
        }
        if (status.includes("PWG")) {
          hasGrace = true;
        }

        if (sem.subjects) {
          sem.subjects.forEach((sub) => {
            if (sub.grade === "F" || (sub.back && sub.back !== "--")) {
              hasBack = true;
            }
          });
        }
      });

      let overallStatus = "PASS";
      let badgeClass = "text-emerald-400 font-bold text-[10px] sm:text-xs";
      let division = "I-DIV";

      const cgpa = parseFloat(defaultCgpa);

      if (hasFail) {
        overallStatus = "FAIL";
        badgeClass = "text-red-500 font-bold text-[10px] sm:text-xs";
        division = "--";
      } else if (hasBack) {
        overallStatus = "PCP";
        badgeClass = "text-purple-400 font-bold text-[10px] sm:text-xs";
        division = "--";
      } else if (hasGrace) {
        overallStatus = "PWG";
        badgeClass = "text-amber-500 font-bold text-[10px] sm:text-xs";
        if (cgpa >= 6.5) {
          division = "I-DIV";
        } else if (cgpa >= 5.0) {
          division = "II-DIV";
        } else {
          division = "III-DIV";
        }
      } else {
        if (cgpa >= 7.5) {
          division = "I-DIV HONS";
        } else if (cgpa >= 6.5) {
          division = "I-DIV";
        } else if (cgpa >= 5.0) {
          division = "II-DIV";
        } else {
          division = "III-DIV";
        }
      }

      return { status: overallStatus, badgeClass, division };
    };

    // Accordion Renderer
    const renderSemesters = (semesters) => {
      accordionContainer.innerHTML = "";
      semesters.forEach((semData) => {
        const semDiv = document.createElement("div");
        semDiv.className = "border border-canvas-dark-border/60 light:border-canvas-light-border rounded-xl bg-canvas-dark-surface/50 light:bg-canvas-light-surface/50 overflow-hidden";
        
        // Header Button
        const headerBtn = document.createElement("button");
        headerBtn.type = "button";
        headerBtn.className = "w-full px-4 py-3 flex items-center justify-between text-left focus:outline-none hover:bg-canvas-dark-tile/40 light:hover:bg-canvas-light-tile transition-colors";
        headerBtn.innerHTML = `
          <div class="flex flex-col sm:flex-row sm:items-center gap-1 sm:gap-4">
            <span class="font-bold text-white light:text-ink text-[11px] sm:text-xs">${semData.sem}</span>
            <div class="flex gap-2 text-[9px] text-gray-500">
              <span>SGPA: <strong class="text-brand-blue">${semData.sgpa}</strong></span>
              <span>Marks: <strong>${semData.marks}</strong></span>
              <span class="px-1.5 py-0.2 rounded font-bold ${semData.status === "PASS" || semData.status === "Cleared" ? "bg-emerald-500/10 text-emerald-400 light:bg-emerald-100 light:text-emerald-700" : "bg-purple-500/10 text-purple-400 light:bg-purple-100 light:text-purple-700"}">${semData.status}</span>
            </div>
          </div>
          <svg class="w-3.5 h-3.5 transform transition-transform duration-300 text-gray-500 sem-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
          </svg>
        `;
        
        // Content area
        const contentDiv = document.createElement("div");
        contentDiv.className = "max-h-0 overflow-hidden transition-all duration-300 ease-in-out bg-black/25 light:bg-canvas-light-surface/10";
        
        const rowsHtml = semData.subjects.map(sub => `
          <tr class="hover:bg-canvas-dark-surface/40 light:hover:bg-canvas-light-surface/30 border-b border-canvas-dark-border/10 light:border-canvas-light-border/40 text-[10px] text-gray-300 light:text-gray-700">
            <td class="p-2 font-mono font-bold text-gray-400 light:text-gray-500">${sub.code}</td>
            <td class="p-2 text-white light:text-ink font-medium max-w-[140px] truncate sm:max-w-none" title="${sub.name}">${sub.name}</td>
            <td class="p-2 text-gray-500 uppercase text-[9px]">${sub.type}</td>
            <td class="p-2 text-center">${sub.int}</td>
            <td class="p-2 text-center">${sub.ext}</td>
            <td class="p-2 text-center ${sub.back !== "--" ? "text-purple-400 font-bold" : "text-gray-600"}">${sub.back}</td>
            <td class="p-2 text-center font-bold ${sub.grade === "F" ? "text-red-500" : "text-brand-blue"}">${sub.grade}</td>
          </tr>
        `).join("");
        
        contentDiv.innerHTML = `
          <div class="p-3 border-t border-canvas-dark-border/40 light:border-canvas-light-border">
            <div class="overflow-x-auto rounded-lg border border-canvas-dark-border/40 light:border-canvas-light-border bg-black/40 light:bg-white">
              <table class="w-full text-left border-collapse min-w-[500px] sm:min-w-0">
                <thead>
                  <tr class="bg-canvas-dark-surface/90 light:bg-canvas-light-surface text-gray-500 light:text-gray-600 border-b border-canvas-dark-border/40 light:border-canvas-light-border text-[9px] uppercase tracking-wider">
                    <th class="p-2 font-semibold">Code</th>
                    <th class="p-2 font-semibold">Subject</th>
                    <th class="p-2 font-semibold">Type</th>
                    <th class="p-2 font-semibold text-center">Int</th>
                    <th class="p-2 font-semibold text-center">Ext</th>
                    <th class="p-2 font-semibold text-center">Back</th>
                    <th class="p-2 font-semibold text-center">Grade</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-canvas-dark-border/20 light:divide-canvas-light-border/40">
                  ${rowsHtml}
                </tbody>
              </table>
            </div>
          </div>
        `;
        
        // Toggler click event
        headerBtn.addEventListener("click", () => {
          const isExpanded = headerBtn.getAttribute("aria-expanded") === "true";
          const icon = headerBtn.querySelector(".sem-icon");
          
          if (isExpanded) {
            contentDiv.style.maxHeight = null;
            headerBtn.setAttribute("aria-expanded", "false");
            icon.classList.remove("rotate-180");
          } else {
            contentDiv.style.maxHeight = contentDiv.scrollHeight + "px";
            headerBtn.setAttribute("aria-expanded", "true");
            icon.classList.add("rotate-180");
          }
        });
        
        semDiv.appendChild(headerBtn);
        semDiv.appendChild(contentDiv);
        accordionContainer.appendChild(semDiv);
      });
    };

    // Print helper
    printBtn.addEventListener("click", () => {
      window.print();
    });

    const resetUI = () => {
      searchForm.classList.remove("hidden");
      loaderState.classList.add("hidden");
      resultState.classList.add("hidden");
      errorState.classList.add("hidden");
      if (adCountdownInterval) {
        clearInterval(adCountdownInterval);
        adCountdownInterval = null;
      }
      if (dobTimerInterval) {
        clearInterval(dobTimerInterval);
        dobTimerInterval = null;
      }
      const adInterstitialState = document.getElementById("ad-interstitial-state");
      if (adInterstitialState) {
        adInterstitialState.classList.add("hidden");
      }
      const verifiedProfileContainer = document.getElementById("search-verified-profile-container");
      if (verifiedProfileContainer) {
        verifiedProfileContainer.classList.add("hidden");
        verifiedProfileContainer.innerHTML = "";
      }
      const manualCaptchaContainer = document.getElementById("search-manual-captcha-container");
      if (manualCaptchaContainer) {
        manualCaptchaContainer.classList.add("hidden");
        manualCaptchaContainer.innerHTML = "";
      }
      rollInput.value = "";
      
      // Revert layout back to initial columns
      if (heroGrid && heroCopy && heroCardWrapper) {
        heroGrid.classList.add("md:grid-cols-12", "items-center");
        heroGrid.classList.remove("grid-cols-1", "justify-items-center");
        
        heroCopy.classList.add("md:col-span-7", "md:text-left");
        heroCopy.classList.remove("w-full", "text-center", "order-2", "mt-12");
        
        heroCardWrapper.classList.add("md:col-span-5", "max-w-lg");
        heroCardWrapper.classList.remove("w-full", "max-w-[90vw]", "md:max-w-[90vw]", "order-1");
      }

      if (resultIndicatorsGrid && resultDivisionContainer) {
        resultIndicatorsGrid.classList.remove("grid-cols-2");
        resultIndicatorsGrid.classList.add("grid-cols-3");
        resultDivisionContainer.classList.remove("hidden");
      }

      if (finalResultSummaryContainer && finalResultSummaryContent) {
        finalResultSummaryContainer.classList.add("hidden");
        finalResultSummaryContent.innerHTML = "";
      }

      // Reset logs
      log1.classList.add("hidden");
      log2.classList.add("hidden");
      log3.classList.add("hidden");
      log4.classList.add("hidden");
    };

    resetBtn.addEventListener("click", resetUI);
    retryBtn.addEventListener("click", resetUI);

    // Roll Number Assistant Trigger Link
    const forgotRollBtn = document.getElementById("forgot-roll-btn");
    forgotRollBtn?.addEventListener("click", () => {
      if (typeof window.openRollAssistantModal === "function") {
        window.openRollAssistantModal();
      }
    });

    const assistantForm = document.getElementById("roll-assistant-form");
    const assistantSubmitBtn = document.getElementById("assistant-submit-btn");
    const assistantOutput = document.getElementById("assistant-output");

    assistantForm?.addEventListener("submit", async (e) => {
      e.preventDefault();
      if (!assistantSubmitBtn || !assistantOutput) return;

      const yearSelect = document.getElementById("assistant-year");
      const collegeSelect = document.getElementById("assistant-college");
      const manualCollegeInput = document.getElementById("assistant-manual-college");
      const branchSelect = document.getElementById("assistant-branch");
      const classRollInput = document.getElementById("assistant-class-roll");
      const nameInput = document.getElementById("assistant-name");

      const admissionYear = yearSelect.value;
      let collegeCode = collegeSelect.value;
      if (collegeCode === "other") {
        collegeCode = manualCollegeInput.value.trim();
      }
      const branchCode = branchSelect.value;
      const classRoll = classRollInput.value.trim();
      const name = nameInput.value.trim();

      if (!admissionYear || !collegeCode || !branchCode) {
        alert("Please select Admission Year, College, and Branch.");
        return;
      }

      // Disable button & show spinner
      assistantSubmitBtn.setAttribute("disabled", "true");
      const originalText = assistantSubmitBtn.innerHTML;
      assistantSubmitBtn.innerHTML = `
        <svg class="animate-spin h-4 w-4 text-white inline-block" fill="none" viewBox="0 0 24 24">
          <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
          <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
        </svg>
        <span>Searching...</span>
      `;

      try {
        const res = await fetch('/api/find-roll', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            admissionYear,
            collegeCode,
            branchCode,
            name
          })
        });

        assistantOutput.classList.remove("hidden");
        assistantOutput.innerHTML = "";

        if (!res.ok) {
          throw new Error("API call failed");
        }

        const data = await res.json();
        if (!data || !data.success) {
          assistantOutput.innerHTML = `
            <div class="p-3 bg-rose-500/10 border border-rose-500/20 text-rose-400 rounded-lg text-[10px]">
              ${(data && data.error) || "Failed to generate details. Try again."}
            </div>
          `;
          return;
        }

        let html = "";

        // 1. If class roll is specified, construct exact roll number
        if (classRoll) {
          const exactRoll = `${data.prefix}${classRoll.padStart(4, '0')}`;
          html += `
            <div class="p-3 bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 rounded-lg space-y-2">
              <div class="text-[9px] uppercase font-bold tracking-wider opacity-85">Generated Roll Number</div>
              <div class="font-mono text-sm font-extrabold tracking-wide text-white light:text-ink">${exactRoll}</div>
              <button 
                type="button" 
                class="use-roll-action-btn w-full py-1.5 bg-emerald-600 hover:bg-emerald-500 text-white font-bold text-[10px] rounded-md transition-colors cursor-pointer"
                data-roll="${exactRoll}"
              >
                Use this Roll Number
              </button>
            </div>
          `;
        }

        // 2. Display database matches if any
        if (data.matches && data.matches.length > 0) {
          html += `
            <div class="space-y-1.5">
              <div class="text-[9px] font-bold text-gray-400 light:text-gray-500 uppercase tracking-wider">Matching Students Found</div>
              <div class="space-y-1 max-h-36 overflow-y-auto pr-1">
          `;
          data.matches.forEach((m) => {
            html += `
              <button 
                type="button"
                class="use-roll-action-btn w-full text-left p-2 rounded-lg border border-canvas-dark-border light:border-canvas-light-border bg-black/40 light:bg-gray-50 hover:bg-brand-blue/10 hover:border-brand-blue/30 text-[10px] transition-all flex justify-between items-center cursor-pointer"
                data-roll="${m.rollNumber}"
              >
                <div>
                  <div class="font-bold text-white light:text-ink">${m.name}</div>
                  <div class="text-[9px] text-gray-500">${m.rollNumber} • ${m.course || ""}</div>
                </div>
                <span class="text-[9px] text-brand-blue font-bold">Select</span>
              </button>
            `;
          });
          html += `
              </div>
            </div>
          `;
        } else if (name && name.length >= 3) {
          html += `
            <div class="p-2.5 bg-amber-500/10 border border-amber-500/20 text-amber-500 rounded-lg text-[10px]">
              No matching names found in the database.
            </div>
          `;
        }

        // 3. Display Range
        html += `
          <div class="p-3 bg-brand-blue/10 border border-brand-blue/20 text-brand-blue rounded-lg space-y-2">
            <div class="text-[9px] uppercase font-bold tracking-wider opacity-85 text-gray-400">Class Roll Number Range</div>
            <div class="font-mono text-xs font-bold text-white light:text-ink">Range: ${data.rangeStart} to ${data.rangeEnd}</div>
            <p class="text-[9px] text-gray-500 leading-normal">You can try scanning class roll numbers sequentially from this range.</p>
            
            <div class="text-[10px] font-bold text-gray-400 mt-2">Quick Test Roll Numbers:</div>
            <div class="flex flex-wrap gap-1 mt-1">
        `;
        
        // Generate first 12 sample roll numbers for quick clicks
        for (let i = 1; i <= 12; i++) {
          const rollVal = `${data.prefix}${String(i).padStart(4, '0')}`;
          html += `
            <button 
              type="button" 
              class="use-roll-action-btn px-2 py-0.5 bg-black/35 light:bg-gray-150 border border-canvas-dark-border light:border-canvas-light-border hover:border-brand-blue rounded text-[9px] text-gray-300 light:text-gray-700 font-mono transition-all cursor-pointer"
              data-roll="${rollVal}"
            >
              #${i}
            </button>
          `;
        }
        html += `
            </div>
          </div>
        `;

        assistantOutput.innerHTML = html;

        // Bind click events on generated buttons
        const actionBtns = assistantOutput.querySelectorAll(".use-roll-action-btn");
        actionBtns.forEach(btn => {
          btn.addEventListener("click", () => {
            const roll = btn.getAttribute("data-roll");
            if (roll && rollInput) {
              rollInput.value = roll;
              if (typeof window.closeRollAssistantModal === "function") {
                window.closeRollAssistantModal();
              }
              rollInput.focus();
              rollInput.classList.add("ring-2", "ring-emerald-500/50");
              setTimeout(() => {
                rollInput.classList.remove("ring-2", "ring-emerald-500/50");
              }, 1500);
            }
          });
        });

      } catch (err) {
        console.error("Roll assistant error:", err);
        assistantOutput.innerHTML = `
          <div class="p-3 bg-rose-500/10 border border-rose-500/20 text-rose-400 rounded-lg text-[10px]">
            Error querying roll numbers. Please try again.
          </div>
        `;
      } finally {
        assistantSubmitBtn.removeAttribute("disabled");
        assistantSubmitBtn.innerHTML = originalText;
      }
    });

    // Search normalization helpers for college and branch comboboxes
    const normalizeSearchClean = (str) => (str || "").toLowerCase().replace(/[^a-z0-9]/g, "");
    const normalizeSearchWords = (str) => (str || "")
      .toLowerCase()
      .replace(/(?<=\b[a-z0-9])[\.\s]+(?=[a-z0-9](\.|\s|$))/gi, "")
      .replace(/[^a-z0-9\s]/g, " ")
      .replace(/\s+/g, " ")
      .trim();

    const matchesSearchItem = (name, code, query) => {
      if (!query) return true;
      const qRaw = query.trim().toLowerCase();
      if (!qRaw) return true;

      const nRaw = (name || "").toLowerCase();
      const cRaw = (code || "").toLowerCase();

      // 1. Code match (exact, without leading zeros, or substring)
      const qNum = qRaw.replace(/^0+/, "");
      const cNum = cRaw.replace(/^0+/, "");
      if (cRaw.includes(qRaw) || (qNum && cNum === qNum)) return true;

      // 2. Direct substring match
      if (nRaw.includes(qRaw)) return true;

      // 3. Normalized stripped match (ignoring dots, spaces, hyphens, punctuation)
      const qClean = normalizeSearchClean(qRaw);
      const nClean = normalizeSearchClean(nRaw);
      if (qClean && nClean.includes(qClean)) return true;

      // 4. Multi-token match with acronym collapsing
      const qWordsNorm = normalizeSearchWords(qRaw);
      const nWordsNorm = normalizeSearchWords(nRaw);
      if (nWordsNorm.includes(qWordsNorm)) return true;

      const tokens = qWordsNorm.split(/\s+/).filter(Boolean);
      if (tokens.length > 1) {
        return tokens.every((t) => {
          const tClean = normalizeSearchClean(t);
          return nWordsNorm.includes(t) || (tClean && nClean.includes(tClean));
        });
      }
      return false;
    };

    // Setup combobox dropdown helper
    const setupCombobox = (comboboxId, searchInputId, hiddenInputId, dropdownId, listId, isSearchable) => {
      const combobox = document.getElementById(comboboxId);
      const searchInput = document.getElementById(searchInputId);
      const hiddenInput = document.getElementById(hiddenInputId);
      const dropdown = document.getElementById(dropdownId);
      const list = document.getElementById(listId);
      if (!combobox || !searchInput || !hiddenInput || !dropdown || !list) return;

      const items = Array.from(list.querySelectorAll("button"));

      // Click to toggle dropdown
      searchInput.addEventListener("focus", () => {
        dropdown.classList.remove("hidden");
        // Ensure all options are visible initially on focus
        items.forEach(item => item.classList.remove("hidden"));
      });

      // Filter options as user types
      if (isSearchable) {
        searchInput.addEventListener("input", () => {
          const query = searchInput.value;
          dropdown.classList.remove("hidden");
          
          items.forEach(item => {
            const name = item.getAttribute("data-name") || "";
            const code = item.getAttribute("data-code") || "";
            const labelText = item.textContent.trim();
            if (matchesSearchItem(`${name} ${labelText}`, code, query)) {
              item.classList.remove("hidden");
            } else {
              item.classList.add("hidden");
            }
          });
        });
      }

      // Handle item selection
      list.addEventListener("click", (e) => {
        const itemBtn = e.target.closest("button");
        if (!itemBtn) return;

        const val = itemBtn.getAttribute("data-code") || itemBtn.getAttribute("data-value") || itemBtn.textContent.trim();
        const displayName = itemBtn.getAttribute("data-name") || itemBtn.textContent.trim();

        hiddenInput.value = val;
        searchInput.value = displayName;
        
        // Trigger validation if form expects it
        hiddenInput.dispatchEvent(new Event("change"));

        dropdown.classList.add("hidden");
      });

      // Hide dropdown when clicking outside
      document.addEventListener("click", (e) => {
        if (!combobox.contains(e.target)) {
          dropdown.classList.add("hidden");
          // If searchInput value doesn't match hiddenInput value name, reset or clear
          if (!hiddenInput.value) {
            searchInput.value = "";
          } else {
            // Find selected item to restore its name
            const activeItem = items.find(item => (item.getAttribute("data-code") || item.getAttribute("data-value")) === hiddenInput.value);
            if (activeItem) {
              searchInput.value = activeItem.getAttribute("data-name") || activeItem.textContent.trim();
            }
          }
        }
      });
    };

    // In-memory caches for fast, zero-delay combobox interactions
    let cachedCollegesData = null;
    let cachedBranchesData = null;

    const fetchColleges = async () => {
      if (cachedCollegesData) return cachedCollegesData;
      try {
        const res = await fetch('/api/colleges');
        const json = await res.json();
        if (json.success && json.colleges) {
          cachedCollegesData = json.colleges.sort((a, b) => a.name.localeCompare(b.name));
          return cachedCollegesData;
        }
      } catch (err) {
        console.error('Error fetching colleges:', err);
      }
      return [];
    };

    const fetchBranches = async () => {
      if (cachedBranchesData) return cachedBranchesData;
      try {
        const res = await fetch('/api/branches');
        const json = await res.json();
        if (json.success && json.branches) {
          cachedBranchesData = json.branches.sort((a, b) => a.name.localeCompare(b.name));
          return cachedBranchesData;
        }
      } catch (err) {
        console.error('Error fetching branches:', err);
      }
      return [];
    };

    const setupDynamicCombobox = (comboboxId, searchInputId, hiddenInputId, dropdownId, listId, fetchDataFn) => {
      const combobox = document.getElementById(comboboxId);
      const searchInput = document.getElementById(searchInputId);
      const hiddenInput = document.getElementById(hiddenInputId);
      const dropdown = document.getElementById(dropdownId);
      const list = document.getElementById(listId);
      if (!combobox || !searchInput || !hiddenInput || !dropdown || !list) return;

      let allItems = [];
      let isLoading = false;

      const renderItems = (itemsToRender) => {
        if (!itemsToRender.length) {
          list.innerHTML = `<div class="p-3 text-center text-xs text-gray-500 light:text-gray-400">No matching results found</div>`;
          return;
        }
        const visible = itemsToRender.slice(0, 50);
        list.innerHTML = visible.map(item => `
          <button
            type="button"
            data-code="${item.code}"
            data-name="${item.name.replace(/"/g, '&quot;')}"
            class="w-full text-left px-3 py-2.5 rounded-lg text-xs text-gray-300 light:text-gray-700 hover:bg-brand-blue hover:text-white light:hover:bg-brand-blue light:hover:text-white transition-all flex justify-between items-center gap-2 cursor-pointer"
          >
            <span class="font-medium truncate">${item.name}</span>
            <span class="font-mono text-[9px] opacity-60 bg-white/10 px-1.5 py-0.5 rounded">${item.code}</span>
          </button>
        `).join('');
      };

      const ensureData = async () => {
        if (allItems.length > 0) return allItems;
        if (isLoading) return [];
        isLoading = true;
        list.innerHTML = `<div class="p-3 text-center text-xs text-gray-400"><span class="animate-pulse inline-block mr-1">⏳</span> Loading options...</div>`;
        allItems = await fetchDataFn();
        isLoading = false;
        return allItems;
      };

      const openAndFilter = async (query = '') => {
        dropdown.classList.remove("hidden");
        const data = await ensureData();
        if (!query.trim()) {
          renderItems(data);
        } else {
          const filtered = data.filter(item => 
            matchesSearchItem(item.name, item.code, query)
          );
          renderItems(filtered);
        }
      };

      searchInput.addEventListener("focus", () => {
        openAndFilter(searchInput.value);
      });

      searchInput.addEventListener("input", () => {
        openAndFilter(searchInput.value);
      });

      list.addEventListener("click", (e) => {
        const itemBtn = e.target.closest("button");
        if (!itemBtn) return;

        const code = itemBtn.getAttribute("data-code") || "";
        const name = itemBtn.getAttribute("data-name") || "";
        hiddenInput.value = code;
        searchInput.value = name;
        hiddenInput.dispatchEvent(new Event("change"));
        dropdown.classList.add("hidden");
      });

      document.addEventListener("click", (e) => {
        if (!combobox.contains(e.target)) {
          dropdown.classList.add("hidden");
          if (!hiddenInput.value) {
            searchInput.value = "";
          } else {
            const match = allItems.find(i => i.code === hiddenInput.value);
            if (match) {
              searchInput.value = match.name;
            }
          }
        }
      });
    };

    // Initialize custom comboboxes
    setupCombobox("home-year-combobox", "home-year-search", "home-finder-year", "home-year-dropdown", "home-year-list", false);
    setupDynamicCombobox("home-college-combobox", "home-college-search", "home-finder-college", "home-college-dropdown", "home-college-list", fetchColleges);
    setupDynamicCombobox("home-branch-combobox", "home-branch-search", "home-finder-branch", "home-branch-dropdown", "home-branch-list", fetchBranches);

