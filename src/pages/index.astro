          if (isExpanded) {
            contentDiv.style.maxHeight = null;
            headerBtn.setAttribute("aria-expanded", "false");
            icon.classList.remove("rotate-180");
          } else {
            contentDiv.style.maxHeight = contentDiv.scrollHeight + "px";
            headerBtn.setAttribute("aria-expanded", "true");
            icon.classList.add("rotate-180");
          }
        });
        
        semDiv.appendChild(headerBtn);
        semDiv.appendChild(contentDiv);
        accordionContainer.appendChild(semDiv);
      });
    };

    // Print helper
    printBtn.addEventListener("click", () => {
      window.print();
    });

    const resetUI = () => {
      searchForm.classList.remove("hidden");
      loaderState.classList.add("hidden");
      resultState.classList.add("hidden");
      errorState.classList.add("hidden");
      rollInput.value = "";
      captchaInput.value = "";
      expectedCaptchaSum = generateCaptcha();
      
      // Revert layout back to initial columns
      if (heroGrid && heroCopy && heroCardWrapper) {
        heroGrid.classList.add("md:grid-cols-12", "items-center");
        heroGrid.classList.remove("grid-cols-1", "justify-items-center");
        
        heroCopy.classList.add("md:col-span-7", "md:text-left");
        heroCopy.classList.remove("w-full", "text-center", "order-2", "mt-12");
        
        heroCardWrapper.classList.add("md:col-span-5", "max-w-lg");
        heroCardWrapper.classList.remove("w-full", "max-w-[90vw]", "md:max-w-[90vw]", "order-1");
      }

      if (resultIndicatorsGrid && resultDivisionContainer) {
        resultIndicatorsGrid.classList.remove("grid-cols-2");
        resultIndicatorsGrid.classList.add("grid-cols-3");
        resultDivisionContainer.classList.remove("hidden");
      }

      if (finalResultSummaryContainer && finalResultSummaryContent) {
        finalResultSummaryContainer.classList.add("hidden");
        finalResultSummaryContent.innerHTML = "";
      }

      // Reset logs
      log1.classList.add("hidden");
      log2.classList.add("hidden");
      log3.classList.add("hidden");
      log4.classList.add("hidden");
    };

    resetBtn.addEventListener("click", resetUI);
    retryBtn.addEventListener("click", resetUI);

    // Roll Number Assistant Trigger Link
    const forgotRollBtn = document.getElementById("forgot-roll-btn");
    forgotRollBtn?.addEventListener("click", () => {
      if (typeof window.openRollAssistantModal === "function") {
        window.openRollAssistantModal();
      }
    });

    const assistantForm = document.getElementById("roll-assistant-form");
    const assistantSubmitBtn = document.getElementById("assistant-submit-btn");
    const assistantOutput = document.getElementById("assistant-output");

    assistantForm?.addEventListener("submit", async (e) => {
      e.preventDefault();
      if (!assistantSubmitBtn || !assistantOutput) return;

      const yearSelect = document.getElementById("assistant-year");
      const collegeSelect = document.getElementById("assistant-college");
      const manualCollegeInput = document.getElementById("assistant-manual-college");
      const branchSelect = document.getElementById("assistant-branch");
      const classRollInput = document.getElementById("assistant-class-roll");
      const nameInput = document.getElementById("assistant-name");

      const admissionYear = yearSelect.value;
      let collegeCode = collegeSelect.value;
      if (collegeCode === "other") {
        collegeCode = manualCollegeInput.value.trim();
      }
      const branchCode = branchSelect.value;
      const classRoll = classRollInput.value.trim();
      const name = nameInput.value.trim();

      if (!admissionYear || !collegeCode || !branchCode) {
        alert("Please select Admission Year, College, and Branch.");
        return;
      }

      // Disable button & show spinner
      assistantSubmitBtn.setAttribute("disabled", "true");
      const originalText = assistantSubmitBtn.innerHTML;
      assistantSubmitBtn.innerHTML = `
        <svg class="animate-spin h-4 w-4 text-white inline-block" fill="none" viewBox="0 0 24 24">
          <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
          <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
        </svg>
        <span>Searching...</span>
      `;

      try {
        const res = await fetch('/api/find-roll', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            admissionYear,
            collegeCode,
            branchCode,
            name
          })
        });

        assistantOutput.classList.remove("hidden");
        assistantOutput.innerHTML = "";

        if (!res.ok) {
          throw new Error("API call failed");
        }

        const data = await res.json();
        if (!data || !data.success) {
          assistantOutput.innerHTML = `
            <div class="p-3 bg-rose-500/10 border border-rose-500/20 text-rose-400 rounded-lg text-[10px]">
              ${(data && data.error) || "Failed to generate details. Try again."}
            </div>
          `;
          return;
        }

        let html = "";

        // 1. If class roll is specified, construct exact roll number
        if (classRoll) {
          const exactRoll = `${data.prefix}${classRoll.padStart(4, '0')}`;
          html += `
            <div class="p-3 bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 rounded-lg space-y-2">
              <div class="text-[9px] uppercase font-bold tracking-wider opacity-85">Generated Roll Number</div>
              <div class="font-mono text-sm font-extrabold tracking-wide text-white light:text-ink">${exactRoll}</div>
              <button 
                type="button" 
                class="use-roll-action-btn w-full py-1.5 bg-emerald-600 hover:bg-emerald-500 text-white font-bold text-[10px] rounded-md transition-colors cursor-pointer"
                data-roll="${exactRoll}"
              >
                Use this Roll Number
              </button>
            </div>
          `;
        }

        // 2. Display database matches if any
        if (data.matches && data.matches.length > 0) {
          html += `
            <div class="space-y-1.5">
              <div class="text-[9px] font-bold text-gray-400 light:text-gray-500 uppercase tracking-wider">Matching Students Found</div>
              <div class="space-y-1 max-h-36 overflow-y-auto pr-1">
          `;
          data.matches.forEach((m) => {
            html += `
              <button 
                type="button"
                class="use-roll-action-btn w-full text-left p-2 rounded-lg border border-canvas-dark-border light:border-canvas-light-border bg-black/40 light:bg-gray-50 hover:bg-brand-blue/10 hover:border-brand-blue/30 text-[10px] transition-all flex justify-between items-center cursor-pointer"
                data-roll="${m.rollNumber}"
              >
                <div>
                  <div class="font-bold text-white light:text-ink">${m.name}</div>
                  <div class="text-[9px] text-gray-500">${m.rollNumber} • ${m.course || ""}</div>
                </div>
                <span class="text-[9px] text-brand-blue font-bold">Select</span>
              </button>
            `;
          });
          html += `
              </div>
            </div>
          `;
        } else if (name && name.length >= 3) {
          html += `
            <div class="p-2.5 bg-amber-500/10 border border-amber-500/20 text-amber-500 rounded-lg text-[10px]">
              No matching names found in the database.
            </div>
          `;
        }

        // 3. Display Range
        html += `
          <div class="p-3 bg-brand-blue/10 border border-brand-blue/20 text-brand-blue rounded-lg space-y-2">
            <div class="text-[9px] uppercase font-bold tracking-wider opacity-85 text-gray-400">Class Roll Number Range</div>
            <div class="font-mono text-xs font-bold text-white light:text-ink">Range: ${data.rangeStart} to ${data.rangeEnd}</div>
            <p class="text-[9px] text-gray-500 leading-normal">You can try scanning class roll numbers sequentially from this range.</p>
            
            <div class="text-[10px] font-bold text-gray-400 mt-2">Quick Test Roll Numbers:</div>
            <div class="flex flex-wrap gap-1 mt-1">
        `;
        
        // Generate first 12 sample roll numbers for quick clicks
        for (let i = 1; i <= 12; i++) {
          const rollVal = `${data.prefix}${String(i).padStart(4, '0')}`;
          html += `
            <button 
              type="button" 
              class="use-roll-action-btn px-2 py-0.5 bg-black/35 light:bg-gray-150 border border-canvas-dark-border light:border-canvas-light-border hover:border-brand-blue rounded text-[9px] text-gray-300 light:text-gray-700 font-mono transition-all cursor-pointer"
              data-roll="${rollVal}"
            >
              #${i}
            </button>
          `;
        }
        html += `
            </div>
          </div>
        `;

        assistantOutput.innerHTML = html;

        // Bind click events on generated buttons
        const actionBtns = assistantOutput.querySelectorAll(".use-roll-action-btn");
        actionBtns.forEach(btn => {
          btn.addEventListener("click", () => {
            const roll = btn.getAttribute("data-roll");
            if (roll && rollInput) {
              rollInput.value = roll;
              if (typeof window.closeRollAssistantModal === "function") {
                window.closeRollAssistantModal();
              }
              rollInput.focus();
              rollInput.classList.add("ring-2", "ring-emerald-500/50");
              setTimeout(() => {
                rollInput.classList.remove("ring-2", "ring-emerald-500/50");
              }, 1500);
            }
          });
        });

      } catch (err) {
        console.error("Roll assistant error:", err);
        assistantOutput.innerHTML = `
          <div class="p-3 bg-rose-500/10 border border-rose-500/20 text-rose-400 rounded-lg text-[10px]">
            Error querying roll numbers. Please try again.
          </div>
        `;
      } finally {
        assistantSubmitBtn.removeAttribute("disabled");
        assistantSubmitBtn.innerHTML = originalText;
      }
    });

    searchForm.addEventListener("submit", (e) => {
      e.preventDefault();
      
      const enteredRoll = rollInput.value.trim();
      const enteredAnswer = parseInt(captchaInput.value.trim(), 10);

      // Validate Captcha
      if (enteredAnswer !== expectedCaptchaSum) {
        alert("Incorrect Captcha Answer. Please try again.");
        expectedCaptchaSum = generateCaptcha();
        captchaInput.value = "";
        return;
      }

      // Hide Form & Show Loader
      searchForm.classList.add("hidden");
      loaderState.classList.remove("hidden");

      // Shift layout to wide and push headline down
      if (heroGrid && heroCopy && heroCardWrapper) {
        heroGrid.classList.remove("md:grid-cols-12", "items-center");
        heroGrid.classList.add("grid-cols-1", "justify-items-center");
        
        heroCopy.classList.remove("md:col-span-7", "md:text-left");
        heroCopy.classList.add("w-full", "text-center", "order-2", "mt-12");
        
        heroCardWrapper.classList.remove("md:col-span-5", "max-w-lg");
        heroCardWrapper.classList.add("w-full", "max-w-[90vw]", "md:max-w-[90vw]", "order-1");
      }

      // Stage-based Loader Updates
      setTimeout(() => {
        loadingStatus.textContent = "Negotiating Handshake...";
        loadingSubstatus.textContent = "Parsing cookies...";
        log1.classList.remove("hidden");
      }, 700);

      setTimeout(() => {
        loadingStatus.textContent = "Extracting ViewState...";
        loadingSubstatus.textContent = "Scraping event target variables...";
        log2.classList.remove("hidden");
      }, 1500);

      setTimeout(() => {
        loadingStatus.textContent = "Bypassing DOB Verification...";
        loadingSubstatus.textContent = "Injecting reference session credentials...";
        log3.classList.remove("hidden");
      }, 2300);

      setTimeout(() => {
        loadingStatus.textContent = "Retrieving Academic Records...";
        loadingSubstatus.textContent = "Compiling detailed semester grids...";
        log4.classList.remove("hidden");
      }, 3100);

      // Final response display
      setTimeout(async () => {
        try {
          const res = await fetch('/api/search', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json'
            },
            body: JSON.stringify({ rollNumber: enteredRoll })
          });

          loaderState.classList.add("hidden");

          if (!res.ok) {
            errorState.classList.remove("hidden");
            return;
          }

          const data = await res.json();
          if (data.success) {
            if (data.totalSearches) {
              updateCounterUI(data.totalSearches);
            }
            resultName.textContent = data.name;
            resultFather.textContent = data.fatherName || "--";
            resultRoll.textContent = data.rollNumber;
            resultEnrollment.textContent = data.enrollmentNumber || "--";
            resultCourse.textContent = data.course || "--";
            resultInstitute.textContent = data.institute || "--";
            resultCgpa.textContent = data.cgpa;
            
            const overall = calculateOverallStatusAndDivision(data.semesters, data.cgpa);
            
            if (data.courseCompleted) {
              if (resultDivisionContainer) resultDivisionContainer.classList.remove("hidden");
              if (resultIndicatorsGrid) {
                resultIndicatorsGrid.classList.remove("grid-cols-2");
                resultIndicatorsGrid.classList.add("grid-cols-3");
              }
              
              const divisionText = data.divisionAwarded || "Awarded";
              resultDivision.textContent = divisionText;
              if (divisionText === "Clear Backlog") {
                resultDivision.className = "text-red-400 font-bold text-[10px] sm:text-xs";
              } else {
                resultDivision.className = "text-white light:text-ink font-bold text-[10px] sm:text-xs";
              }

              if (finalResultSummaryContainer && finalResultSummaryContent && data.finalResultHtml) {
                finalResultSummaryContent.innerHTML = data.finalResultHtml;
                finalResultSummaryContainer.classList.remove("hidden");
              }
            } else {
              if (resultDivisionContainer) resultDivisionContainer.classList.add("hidden");
              if (resultIndicatorsGrid) {
                resultIndicatorsGrid.classList.remove("grid-cols-3");
                resultIndicatorsGrid.classList.add("grid-cols-2");
              }
              if (finalResultSummaryContainer) {
                finalResultSummaryContainer.classList.add("hidden");
              }
            }
            
            resultStatusBadge.textContent = overall.status;
            resultStatusBadge.className = overall.badgeClass;
            
            renderSemesters(data.semesters);
            resultState.classList.remove("hidden");
          } else {
            document.getElementById("error-title").textContent = "Search Failed";
            document.getElementById("error-desc").textContent = data.error || "Could not able to fetch now try later";
            errorState.classList.remove("hidden");
          }
        } catch (error) {
          console.error("API Error:", error);
          loaderState.classList.add("hidden");
          document.getElementById("error-title").textContent = "Fetch Failed";
          document.getElementById("error-desc").textContent = "Could not able to fetch now try later";
          errorState.classList.remove("hidden");
        }
      }, 4300);

    });
    });
  </script>
</Layout>
