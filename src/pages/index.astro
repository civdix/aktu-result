        }

        const data = await res.json();
        if (!data || !data.success) {
          assistantOutput.innerHTML = `
            <div class="p-3 bg-rose-500/10 border border-rose-500/20 text-rose-400 rounded-lg text-[10px]">
              ${(data && data.error) || "Failed to generate details. Try again."}
            </div>
          `;
          return;
        }

        let html = "";

        // 1. If class roll is specified, construct exact roll number
        if (classRoll) {
          const exactRoll = `${data.prefix}${classRoll.padStart(4, '0')}`;
          html += `
            <div class="p-3 bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 rounded-lg space-y-2">
              <div class="text-[9px] uppercase font-bold tracking-wider opacity-85">Generated Roll Number</div>
