      const interstitial = document.getElementById("ad-interstitial-state");
      if (!interstitial) {
        onProceed();
        return;
      }

      interstitial.classList.remove("hidden");
      try {
        (window.adsbygoogle = window.adsbygoogle || []).push({});
      } catch (e) {}

      let timeLeft = 5;
      const countdownText = document.getElementById("ad-countdown-text");
      const progressBar = document.getElementById("ad-progress-bar");
      if (countdownText) countdownText.textContent = `${timeLeft}s`;
      if (progressBar) progressBar.style.width = "0%";

      if (adCountdownInterval) clearInterval(adCountdownInterval);

      let finished = false;
      const finishAndShow = () => {
        if (finished) return;
        finished = true;
        if (adCountdownInterval) {
          clearInterval(adCountdownInterval);
          adCountdownInterval = null;
        }
        interstitial.classList.add("hidden");
        onProceed();
        try {
          (window.adsbygoogle = window.adsbygoogle || []).push({});
        } catch (e) {}
      };

      adCountdownInterval = setInterval(() => {
        timeLeft--;
        const pct = Math.min(100, Math.round(((5 - timeLeft) / 5) * 100));
        if (progressBar) progressBar.style.width = `${pct}%`;
        if (countdownText) countdownText.textContent = `${timeLeft}s`;
        if (timeLeft <= 0) {
          finishAndShow();
        }
      }, 1000);

      const viewBtn = document.getElementById("ad-view-result-btn");
      if (viewBtn) {
        viewBtn.onclick = (e) => {
          e.preventDefault();
          finishAndShow();
        };
      }
    }

