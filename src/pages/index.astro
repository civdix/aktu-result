    window.addEventListener("DOMContentLoaded", () => {
      // Animate counter from current display to new count
      const updateCounterUI = (count) => {
      const counterEl = document.getElementById("live-counter");
      if (counterEl) {
        const start = parseInt(counterEl.textContent.replace(/[^0-9]/g, ''), 10) || 24000;
        const end = count;
        if (isNaN(start) || start >= end) {
          counterEl.textContent = Number(end).toLocaleString() + "+";
          return;
        }
        
        let current = start;
        const range = end - start;
        const increment = range > 50 ? Math.ceil(range / 20) : 1;
        const stepTime = Math.max(Math.floor(300 / (range / increment)), 15);
        
        const timer = setInterval(() => {
          current += increment;
          if (current >= end) {
            current = end;
            clearInterval(timer);
          }
          counterEl.textContent = Number(current).toLocaleString() + "+";
        }, stepTime);
      }
    };

