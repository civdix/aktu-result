              </button>
            </div>

            ${errorMsg ? `<div class="p-2 rounded-lg bg-rose-500/10 border border-rose-500/20 text-rose-400 text-xs text-center font-medium">${errorMsg}</div>` : ''}

            <input 
              type="text" 
              id="search-security-code-input" 
              maxlength="6"
              placeholder="Enter 5 characters"
              autocomplete="off"
              class="w-full px-3 py-2.5 bg-white/5 border border-white/20 light:bg-gray-50 light:border-gray-300 rounded-lg text-white light:text-ink light:placeholder-gray-400 font-mono text-center tracking-widest text-base uppercase placeholder-gray-500 focus:outline-none focus:border-brand-blue"
            />

            <!-- Sponsored Ad Unit in Verification Step -->
            <div class="p-2.5 rounded-xl border border-white/5 light:border-black/5 bg-white/[0.02] light:bg-black/[0.01] text-center overflow-hidden">
              <span class="text-[8px] uppercase font-bold text-gray-400 light:text-gray-500 tracking-wider block mb-1">Sponsored Advertisement</span>
              <ins class="adsbygoogle"
                   style="display:block; min-height: 90px;"
                   data-ad-client="ca-pub-5590747238948130"
                   data-ad-format="auto"
                   data-full-width-responsive="true"></ins>
            </div>

            <div class="flex gap-2 pt-1">
              <button 
                type="button" 
                id="search-cancel-code-btn" 
                class="flex-1 py-2.5 bg-white/10 hover:bg-white/15 light:bg-gray-100 light:hover:bg-gray-200 text-gray-300 light:text-gray-700 rounded-lg text-xs font-semibold transition-all cursor-pointer border border-transparent light:border-gray-200"
              >
                Cancel
              </button>
              <button 
                type="button" 
                id="search-submit-code-btn" 
                class="flex-1 py-2.5 bg-brand-blue hover:bg-brand-blue-hover text-white rounded-lg text-xs font-semibold transition-all cursor-pointer flex items-center justify-center gap-1"
              >
                <span>Verify & Proceed</span>
              </button>
            </div>
          </div>
        `;

        try {
          (window.adsbygoogle = window.adsbygoogle || []).push({});
        } catch (e) {}

        const codeInput = document.getElementById("search-security-code-input");
        if (codeInput) {
          codeInput.focus();
          codeInput.addEventListener("keydown", (e) => {
            if (e.key === "Enter") {
              e.preventDefault();
              submitCode();
            }
          });
        }

        document.getElementById("search-refresh-captcha-btn")?.addEventListener("click", async () => {
          const btn = document.getElementById("search-refresh-captcha-btn");
          if (btn) btn.innerHTML = `<span>Loading...</span>`;
          try {
            const rRes = await fetch("/api/search", {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({ rollNumber: roll, action: "refreshCaptcha", session: currentSession })
            });
            const rData = await rRes.json();
            if (rData && rData.captchaImage) {
              currentSession = rData.session || currentSession;
              updateModal(rData.captchaImage);
            } else {
              updateModal(imgSrc, "Could not refresh captcha. Try again.");
            }
          } catch (e) {
            updateModal(imgSrc, "Network error refreshing captcha.");
          }
        });

        document.getElementById("search-submit-code-btn")?.addEventListener("click", submitCode);
        document.getElementById("search-cancel-code-btn")?.addEventListener("click", resetUI);
      }

      async function submitCode() {
        const codeInput = document.getElementById("search-security-code-input");
        const code = codeInput ? codeInput.value.trim().toUpperCase() : "";
        if (!code || code.length < 4) {
          if (codeInput) codeInput.focus();
          return;
        }

        const submitBtn = document.getElementById("search-submit-code-btn");
        if (submitBtn) {
          submitBtn.disabled = true;
          submitBtn.innerHTML = `
            <div class="w-4 h-4 border-2 border-white/30 border-t-white rounded-full animate-spin"></div>
            <span>Verifying...</span>
          `;
        }

        try {
          const vRes = await fetch("/api/search", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ rollNumber: roll, manualCaptcha: code, session: currentSession })
          });
          const vData = await vRes.json();
          if (vData && vData.success) {
            showAdInterstitialThen(vData, () => {
              if (vData.semesters && vData.semesters.length > 0) {
                displayFullResult(vData);
              } else {
                renderSearchVerifiedProfile(vData);
              }
            });
          } else if (vData && vData.needsManualCaptcha && vData.captchaImage) {
            currentSession = vData.session || currentSession;
            updateModal(vData.captchaImage, vData.error || "Incorrect code. Please enter the new characters shown.");
          } else {
            updateModal(initialData.captchaImage, vData?.error || "Verification failed. Please try again.");
          }
        } catch (e) {
          updateModal(initialData.captchaImage, "Network error during verification. Please try again.");
        }
      }

      updateModal(initialData.captchaImage);
    }

    searchForm.addEventListener("submit", (e) => {
      e.preventDefault();
      
      const enteredRoll = rollInput.value.trim();
      if (!enteredRoll) return;

      // Hide Form & Show Loader
      searchForm.classList.add("hidden");
      const vpc = document.getElementById("search-verified-profile-container");
      if (vpc) {
        vpc.classList.add("hidden");
        vpc.innerHTML = "";
      }
      const mcc = document.getElementById("search-manual-captcha-container");
      if (mcc) {
        mcc.classList.add("hidden");
        mcc.innerHTML = "";
      }
      resultState.classList.add("hidden");
      errorState.classList.add("hidden");
      loaderState.classList.remove("hidden");

      // Reset logs & progress
      log1.classList.add("hidden");
      log2.classList.add("hidden");
      log3.classList.add("hidden");
      log4.classList.add("hidden");

      let searchPercent = 5;
      const pctEl = document.getElementById("loading-percentage");
      const barEl = document.getElementById("loading-progress-bar");
      if (pctEl) pctEl.textContent = "5%";
      if (barEl) barEl.style.width = "5%";

      const progressTimer = setInterval(() => {
        if (searchPercent < 92) {
          const step = searchPercent < 35 ? 6 : (searchPercent < 70 ? 3 : 1);
          searchPercent = Math.min(92, searchPercent + step);
          if (pctEl) pctEl.textContent = `${searchPercent}%`;
          if (barEl) barEl.style.width = `${searchPercent}%`;
        }
      }, 80);

      const completeProgress = (callback) => {
        clearInterval(progressTimer);
        searchPercent = 100;
        if (pctEl) pctEl.textContent = "100%";
        if (barEl) barEl.style.width = "100%";
        setTimeout(() => {
          loaderState.classList.add("hidden");
          callback();
        }, 300);
      };

      loadingStatus.textContent = "Connecting to AKTU Gateway...";
      loadingSubstatus.textContent = "Negotiating secure session handshake...";

      // Stage-based Loader Updates
      setTimeout(() => {
        loadingStatus.textContent = "Checking Academic Archives...";
        loadingSubstatus.textContent = "Searching local marksheet repository...";
        log1.classList.remove("hidden");
      }, 400);

      setTimeout(() => {
        loadingStatus.textContent = "Querying University Portal...";
        loadingSubstatus.textContent = "Authenticating student profile credentials...";
        log2.classList.remove("hidden");
      }, 900);

      setTimeout(() => {
        loadingStatus.textContent = "Resolving Student Record...";
        loadingSubstatus.textContent = "Assembling semester grades & credits ledger...";
        log3.classList.remove("hidden");
      }, 1500);

      // Start network request immediately
      const fetchPromise = fetch('/api/search', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json'
        },
        body: JSON.stringify({ 
          rollNumber: enteredRoll
        })
      });

      // Await both minimum animation delay and fetch result
      const delayPromise = new Promise(resolve => setTimeout(resolve, 1800));

      Promise.all([fetchPromise, delayPromise])
        .then(async ([res]) => {
          let resData = null;
          let isOk = res.ok;
          try {
            resData = await res.json();
          } catch (e) {}

          completeProgress(() => {
            if (resData && resData.success) {
              if (resData.totalSearches) {
                updateCounterUI(resData.totalSearches);
              }
              showAdInterstitialThen(resData, () => {
                if (resData.semesters && resData.semesters.length > 0) {
                  displayFullResult(resData);
                } else {
                  renderSearchVerifiedProfile(resData);
                }
              });
            } else if (resData && resData.needsManualCaptcha && resData.captchaImage) {
              renderSearchManualCaptcha(resData, enteredRoll);
            } else {
              const errorText = resData?.error || "Could not retrieve records for this roll number. Please verify the roll number.";
              document.getElementById("error-title").textContent = resData?.notFound ? "Record Not Found In Database" : "Search Failed";
              document.getElementById("error-desc").textContent = errorText;
              errorState.classList.remove("hidden");
            }
          });
        })
        .catch(error => {
          console.error("API Error:", error);
          clearInterval(progressTimer);
          loaderState.classList.add("hidden");
          document.getElementById("error-title").textContent = "Fetch Failed";
          document.getElementById("error-desc").textContent = "Connection error. You can still open the official portal below directly.";
          errorState.classList.remove("hidden");
      });
    });

    // Wire Direct Live Portal Button on Search Form
    document.getElementById("home-direct-portal-btn")?.addEventListener("click", () => {
      const enteredRoll = rollInput ? rollInput.value.trim() : "";
      if (typeof window.openOneViewModal === "function") {
        window.openOneViewModal(enteredRoll, "");
      } else {
        window.open("https://oneview.aktu.ac.in/WebPages/aktu/OneView.aspx", "_blank");
      }
    });

    // Wire Error State Fallback Button to Open OneView Modal
    document.getElementById("error-open-oneview-btn")?.addEventListener("click", () => {
      const enteredRoll = rollInput ? rollInput.value.trim() : "";
      if (typeof window.openOneViewModal === "function") {
        window.openOneViewModal(enteredRoll, "");
      } else {
        window.open("https://oneview.aktu.ac.in/WebPages/aktu/OneView.aspx", "_blank");
      }
    });

    document.getElementById("open-live-oneview-btn")?.addEventListener("click", () => {
      if (typeof window.openOneViewModal === "function") {
        window.openOneViewModal(currentResultData?.rollNumber || "", currentResultData?.dob || "");
      } else {
        window.open("https://oneview.aktu.ac.in/WebPages/aktu/OneView.aspx", "_blank");
      }
    });

  };

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initApp);
  } else {
    initApp();
  }
</script>

<OneViewIframeModal />
</Layout>
