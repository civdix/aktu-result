        assistantOutput.innerHTML = html;

        // Bind click events on generated buttons
        const actionBtns = assistantOutput.querySelectorAll(".use-roll-action-btn");
        actionBtns.forEach(btn => {
          btn.addEventListener("click", () => {
            const roll = btn.getAttribute("data-roll");
            if (roll && rollInput) {
              rollInput.value = roll;
              if (typeof window.closeRollAssistantModal === "function") {
                window.closeRollAssistantModal();
              }
              rollInput.focus();
              rollInput.classList.add("ring-2", "ring-emerald-500/50");
              setTimeout(() => {
                rollInput.classList.remove("ring-2", "ring-emerald-500/50");
              }, 1500);
            }
          });
        });

      } catch (err) {
        console.error("Roll assistant error:", err);
        assistantOutput.innerHTML = `
          <div class="p-3 bg-rose-500/10 border border-rose-500/20 text-rose-400 rounded-lg text-[10px]">
            Error querying roll numbers. Please try again.
          </div>
        `;
      } finally {
        assistantSubmitBtn.removeAttribute("disabled");
        assistantSubmitBtn.innerHTML = originalText;
      }
    });

    // Setup combobox dropdown helper
    const setupCombobox = (comboboxId, searchInputId, hiddenInputId, dropdownId, listId, isSearchable) => {
      const combobox = document.getElementById(comboboxId);
      const searchInput = document.getElementById(searchInputId);
      const hiddenInput = document.getElementById(hiddenInputId);
      const dropdown = document.getElementById(dropdownId);
      const list = document.getElementById(listId);
      if (!combobox || !searchInput || !hiddenInput || !dropdown || !list) return;

      const items = Array.from(list.querySelectorAll("button"));

      // Click to toggle dropdown
      searchInput.addEventListener("focus", () => {
        dropdown.classList.remove("hidden");
        // Ensure all options are visible initially on focus
        items.forEach(item => item.classList.remove("hidden"));
      });

      // Filter options as user types
      if (isSearchable) {
        searchInput.addEventListener("input", () => {
          const query = searchInput.value.trim().toLowerCase();
          dropdown.classList.remove("hidden");
          
          items.forEach(item => {
            const name = item.getAttribute("data-name") ? item.getAttribute("data-name").toLowerCase() : "";
            const code = item.getAttribute("data-code") ? item.getAttribute("data-code").toLowerCase() : "";
            const labelText = item.textContent.trim().toLowerCase();
            if (name.includes(query) || code.includes(query) || labelText.includes(query)) {
              item.classList.remove("hidden");
            } else {
              item.classList.add("hidden");
            }
          });
        });
      }

      // Handle item selection
      list.addEventListener("click", (e) => {
        const itemBtn = e.target.closest("button");
        if (!itemBtn) return;

        const val = itemBtn.getAttribute("data-code") || itemBtn.getAttribute("data-value") || itemBtn.textContent.trim();
        const displayName = itemBtn.getAttribute("data-name") || itemBtn.textContent.trim();

        hiddenInput.value = val;
        searchInput.value = displayName;
        
        // Trigger validation if form expects it
        hiddenInput.dispatchEvent(new Event("change"));

        dropdown.classList.add("hidden");
      });

      // Hide dropdown when clicking outside
      document.addEventListener("click", (e) => {
        if (!combobox.contains(e.target)) {
          dropdown.classList.add("hidden");
          // If searchInput value doesn't match hiddenInput value name, reset or clear
          if (!hiddenInput.value) {
            searchInput.value = "";
          } else {
            // Find selected item to restore its name
            const activeItem = items.find(item => (item.getAttribute("data-code") || item.getAttribute("data-value")) === hiddenInput.value);
            if (activeItem) {
              searchInput.value = activeItem.getAttribute("data-name") || activeItem.textContent.trim();
            }
          }
        }
      });
    };

    // Initialize custom comboboxes
    setupCombobox("home-year-combobox", "home-year-search", "home-finder-year", "home-year-dropdown", "home-year-list", false);
    setupCombobox("home-college-combobox", "home-college-search", "home-finder-college", "home-college-dropdown", "home-college-list", true);
    setupCombobox("home-branch-combobox", "home-branch-search", "home-finder-branch", "home-branch-dropdown", "home-branch-list", true);

    // Tab switching logic
    const tabRollFinder = document.getElementById("home-tab-roll-finder");
    const tabCheckResult = document.getElementById("home-tab-check-result");
    const tabDobFinder = document.getElementById("home-tab-dob-finder");

    const viewRollFinder = document.getElementById("home-view-roll-finder");
    const viewCheckResult = document.getElementById("home-view-check-result");
    const viewDobFinder = document.getElementById("home-view-dob-finder");

    const switchTab = (activeTab, activeView) => {
      // Hide all views
      viewRollFinder.classList.add("hidden");
      viewCheckResult.classList.add("hidden");
      viewDobFinder.classList.add("hidden");

      // Show active view
      activeView.classList.remove("hidden");

      // Reset tab button styles
      [tabRollFinder, tabCheckResult, tabDobFinder].forEach(btn => {
        if (btn) {
          btn.className = "flex-1 py-2 text-center rounded-lg text-gray-400 hover:text-white light:text-gray-650 light:hover:text-ink focus:outline-none transition-all flex items-center justify-center gap-1.5 cursor-pointer select-none";
        }
      });

      // Highlight active tab button
      if (activeTab) {
        activeTab.className = "flex-1 py-2 text-center rounded-lg bg-brand-blue text-white focus:outline-none transition-all flex items-center justify-center gap-1.5 cursor-pointer select-none";
      }
    };

    tabRollFinder?.addEventListener("click", () => switchTab(tabRollFinder, viewRollFinder));
    tabCheckResult?.addEventListener("click", () => switchTab(tabCheckResult, viewCheckResult));
    tabDobFinder?.addEventListener("click", () => switchTab(tabDobFinder, viewDobFinder));

    document.getElementById("home-switch-to-roll-finder")?.addEventListener("click", () => {
      switchTab(tabRollFinder, viewRollFinder);
    });

    // Home Roll Finder Captcha Generator
    const generateHomeFinderCaptcha = () => {
      const num1 = Math.floor(Math.random() * 9) + 1;
      const num2 = Math.floor(Math.random() * 9) + 1;
      const el1 = document.getElementById("home-finder-captcha-num1");
      const el2 = document.getElementById("home-finder-captcha-num2");
      if (el1 && el2) {
        el1.textContent = num1;
        el2.textContent = num2;
      }
      return num1 + num2;
    };
    let expectedHomeFinderCaptchaSum = generateHomeFinderCaptcha();

    const homeFinderForm = document.getElementById("home-finder-form");
    const homeFinderSubmitBtn = document.getElementById("home-finder-submit-btn");
    const homeFinderLoader = document.getElementById("home-finder-loader-state");
    const homeFinderOutput = document.getElementById("home-finder-output");

    homeFinderForm?.addEventListener("submit", async (e) => {
      e.preventDefault();
      
      // Verify Captcha
      const captchaAnsInput = document.getElementById("home-finder-captcha-answer");
      const captchaAns = parseInt(captchaAnsInput?.value.trim(), 10);
      if (captchaAns !== expectedHomeFinderCaptchaSum) {
        alert("Incorrect Captcha Answer. Please try again.");
        expectedHomeFinderCaptchaSum = generateHomeFinderCaptcha();
        if (captchaAnsInput) captchaAnsInput.value = "";
        return;
      }

      const yearVal = document.getElementById("home-finder-year").value;
      const collegeVal = document.getElementById("home-finder-college").value;
      const branchVal = document.getElementById("home-finder-branch").value;
      const nameVal = document.getElementById("home-finder-name").value.trim();

      if (!yearVal || !collegeVal || !branchVal) {
        alert("Please select Admission Year, College, and Branch.");
        return;
      }

      // Show loader
      homeFinderForm.classList.add("hidden");
      homeFinderLoader.classList.remove("hidden");
      homeFinderOutput.classList.add("hidden");

      const loadingSub = document.getElementById("home-finder-loading-substatus");
      
      const stages = [
        "Connecting to AKTU ERP portals...",
        "Authenticating session tokens...",
        "Querying database records...",
        "Compiling matching student details..."
      ];
      let stageIdx = 0;
      if (loadingSub) loadingSub.textContent = stages[stageIdx++];
      const interval = setInterval(() => {
        if (loadingSub && stageIdx < stages.length) {
          loadingSub.textContent = stages[stageIdx++];
        }
      }, 800);

      try {
        const res = await fetch('/api/find-roll', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            admissionYear: yearVal,
            collegeCode: collegeVal,
            branchCode: branchVal,
            name: nameVal
          })
        });

        clearInterval(interval);
        homeFinderLoader.classList.add("hidden");
        homeFinderOutput.classList.remove("hidden");
        homeFinderOutput.innerHTML = "";

        if (!res.ok) {
          throw new Error("Server error");
        }

        const data = await res.json();
        if (!data || !data.success) {
          homeFinderOutput.innerHTML = `
            <div class="p-4 rounded-xl border border-rose-500/20 bg-rose-500/5 text-rose-400 text-xs text-center">
              ${data.error || "No student details found. Check parameters."}
            </div>
            <button type="button" id="home-finder-retry-btn" class="w-full py-2.5 bg-white/[0.05] hover:bg-white/[0.1] text-white text-xs font-semibold rounded-lg mt-2 cursor-pointer transition-all">Retry Search</button>
          `;
          document.getElementById("home-finder-retry-btn")?.addEventListener("click", () => {
            homeFinderOutput.classList.add("hidden");
            homeFinderForm.classList.remove("hidden");
            expectedHomeFinderCaptchaSum = generateHomeFinderCaptcha();
            if (captchaAnsInput) captchaAnsInput.value = "";
          });
          return;
        }

        let html = "";

        // Display Roll Range
        html += `
          <div class="p-4 rounded-xl border border-white/[0.08] bg-white/[0.03] space-y-2 text-left">
            <div class="text-[10px] uppercase font-bold text-gray-400 tracking-wider">Class Roll Range</div>
            <div class="flex justify-between items-center text-xs">
              <div>Start: <span class="font-mono font-bold text-white">${data.rangeStart}</span></div>
              <div>End: <span class="font-mono font-bold text-white">${data.rangeEnd}</span></div>
            </div>
            <p class="text-[10px] text-gray-450 leading-relaxed mt-1">Found ${data.matches ? data.matches.length : 0} matching students.</p>
          </div>
        `;

        // Display Matches
        if (data.matches && data.matches.length > 0) {
          html += `
            <div class="space-y-2 text-left">
              <div class="text-[10px] uppercase font-bold text-gray-400 tracking-wider">Matches List</div>
              <div class="space-y-1.5 max-h-56 overflow-y-auto pr-1">
          `;
          data.matches.forEach((student) => {
            html += `
              <div class="p-3 bg-black/45 hover:bg-brand-blue/5 border border-white/[0.06] hover:border-brand-blue/30 rounded-xl flex justify-between items-center transition-all">
                <div>
                  <div class="font-bold text-xs text-white">${student.name}</div>
                  <div class="text-[10px] font-mono text-gray-500 mt-0.5">${student.rollNumber}</div>
                </div>
                <button 
                  type="button" 
                  class="home-select-student-btn px-3 py-1 bg-brand-blue/20 hover:bg-brand-blue text-brand-blue hover:text-white rounded-lg text-[10px] font-bold transition-all cursor-pointer"
                  data-roll="${student.rollNumber}"
                  data-name="${student.name}"
                >
                  Get Result
                </button>
              </div>
            `;
          });
          html += `
              </div>
            </div>
          `;
        } else {
          html += `
            <div class="p-4 rounded-xl border border-white/[0.06] text-center text-xs text-gray-500">
              No specific matching students found. Try selecting the base range from above.
            </div>
          `;
        }

        html += `
          <button type="button" id="home-finder-back-btn" class="w-full py-2.5 bg-white/[0.05] hover:bg-white/[0.1] text-white text-xs font-semibold rounded-lg mt-2 cursor-pointer transition-all">New Search</button>
        `;

        homeFinderOutput.innerHTML = html;

        // Bind Select buttons
        homeFinderOutput.querySelectorAll(".home-select-student-btn").forEach(btn => {
          btn.addEventListener("click", () => {
            const roll = btn.getAttribute("data-roll");
            if (roll) {
              switchTab(tabCheckResult, viewCheckResult);
              const rollInp = document.getElementById("roll-number");
              if (rollInp) {
                rollInp.value = roll;
                rollInp.focus();
                rollInp.scrollIntoView({ behavior: 'smooth', block: 'center' });
              }
            }
          });
        });

        // Bind back button
        document.getElementById("home-finder-back-btn")?.addEventListener("click", () => {
          homeFinderOutput.classList.add("hidden");
          homeFinderForm.classList.remove("hidden");
          expectedHomeFinderCaptchaSum = generateHomeFinderCaptcha();
          if (captchaAnsInput) captchaAnsInput.value = "";
        });

      } catch (err) {
        clearInterval(interval);
        homeFinderLoader.classList.add("hidden");
        homeFinderOutput.classList.remove("hidden");
        homeFinderOutput.innerHTML = `
          <div class="p-4 rounded-xl border border-rose-500/20 bg-rose-500/5 text-rose-400 text-xs text-center">
            Failed to connect to ERP scanner. Please retry.
          </div>
          <button type="button" id="home-finder-retry-btn" class="w-full py-2.5 bg-white/[0.05] hover:bg-white/[0.1] text-white text-xs font-semibold rounded-lg mt-2 cursor-pointer transition-all">Retry Search</button>
        `;
        document.getElementById("home-finder-retry-btn")?.addEventListener("click", () => {
          homeFinderOutput.classList.add("hidden");
          homeFinderForm.classList.remove("hidden");
          expectedHomeFinderCaptchaSum = generateHomeFinderCaptcha();
          if (captchaAnsInput) captchaAnsInput.value = "";
        });
      }
    });

    // Home DOB Finder Form Handler
    const homeDobForm = document.getElementById("home-dob-form");
    const homeDobLoader = document.getElementById("home-dob-loader");
    const homeDobOutput = document.getElementById("home-dob-output");

    homeDobForm?.addEventListener("submit", async (e) => {
      e.preventDefault();
      const rollInputEl = document.getElementById("home-dob-roll");
      const roll = rollInputEl?.value.trim();

      if (!roll) return;

      homeDobForm.classList.add("hidden");
      homeDobLoader.classList.remove("hidden");
      homeDobOutput.classList.add("hidden");

      try {
        const res = await fetch("/api/dob", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ rollNumber: roll })
        });

        homeDobLoader.classList.add("hidden");
        homeDobOutput.classList.remove("hidden");

        const data = await res.json();
      function renderDobSuccessCard(data) {
        const studentName = data.student?.name || data.name || "Verified Student";
        const enrollmentNo = data.student?.enrollmentNo || data.enrollmentNumber;
        const enrollmentHtml = (enrollmentNo && enrollmentNo !== '--') ? `<div class="text-xs font-mono text-gray-400">Enrollment No: <span class="font-bold text-white">${enrollmentNo}</span></div>` : '';
        const fatherName = data.student?.fatherName ? `<div class="text-xs text-gray-400">Father's Name: <span class="text-gray-200">${data.student.fatherName}</span></div>` : '';
        const course = data.student?.course ? `<div class="text-xs text-gray-400">Course: <span class="text-gray-200">${data.student.course}</span></div>` : '';
        const college = data.student?.college ? `<div class="text-[11px] text-gray-400">College: <span class="text-gray-200">${data.student.college}</span></div>` : '';

        homeDobOutput.innerHTML = `
          <div class="p-4 rounded-xl border border-emerald-500/30 bg-emerald-500/10 space-y-3 text-left">
            <div class="flex items-center justify-between">
              <span class="text-[10px] uppercase font-bold text-emerald-400 tracking-wider">DOB Located Successfully</span>
              <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-emerald-500/20 text-emerald-300">Verified</span>
            </div>
            <div>
              <div class="text-sm font-bold text-white">${studentName}</div>
              <div class="text-xs font-mono text-gray-400">Roll: <span class="font-bold text-white">${data.rollNumber}</span></div>
              ${enrollmentHtml}
              ${fatherName}
              ${course}
              ${college}
            </div>
            <div class="p-3 bg-black/40 rounded-xl border border-emerald-500/20 flex items-center justify-between">
              <div>
                <span class="text-[10px] uppercase font-bold text-gray-400">Registered Date of Birth:</span>
                <div class="text-base font-mono font-extrabold text-emerald-400 tracking-wide">${data.dob}</div>
              </div>
              <button 
                type="button" 
                id="dob-copy-val-btn" 
                class="px-2.5 py-1.5 bg-white/10 hover:bg-white/20 text-white rounded-lg text-xs font-semibold transition-all flex items-center gap-1 cursor-pointer"
              >
                <span>📋 Copy</span>
              </button>
            </div>
            <button 
              type="button" 
              id="dob-use-result-btn" 
              class="w-full py-3 bg-gradient-to-r from-brand-blue to-purple-600 hover:from-brand-blue-hover hover:to-purple-700 text-white text-xs font-bold rounded-xl transition-all cursor-pointer shadow-lg flex items-center justify-center gap-1.5"
            >
              <span>🚀 Open AKTU OneView (DOB Copied)</span>
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" /></svg>
            </button>
          </div>
          <button type="button" id="dob-reset-btn" class="w-full py-2 bg-white/[0.05] hover:bg-white/[0.1] text-white text-xs font-semibold rounded-lg mt-1 cursor-pointer transition-all">Scan Another Roll</button>
        `;

        document.getElementById("dob-copy-val-btn")?.addEventListener("click", () => {
          if (data.dob) {
            navigator.clipboard.writeText(data.dob).then(() => {
              const btn = document.getElementById("dob-copy-val-btn");
              if (btn) btn.innerHTML = `<span>✓ Copied!</span>`;
              setTimeout(() => {
                const b = document.getElementById("dob-copy-val-btn");
                if (b) b.innerHTML = `<span>📋 Copy</span>`;
              }, 2000);
            });
          }
        });

        document.getElementById("dob-use-result-btn")?.addEventListener("click", () => {
          if (data.dob) {
            navigator.clipboard.writeText(data.dob).catch(() => {});
          }
          window.open('https://oneview.aktu.ac.in/WebPages/aktu/OneView.aspx', '_blank');
        });

        document.getElementById("dob-reset-btn")?.addEventListener("click", () => {
          homeDobOutput.classList.add("hidden");
          homeDobForm.classList.remove("hidden");
        });
      }

      function renderManualCaptchaModal(initialData, roll) {
        let currentSession = initialData.session;

        function updateModal(imgSrc, errorMsg) {
          homeDobOutput.innerHTML = `
            <div class="p-4 rounded-xl border border-brand-blue/30 bg-black/60 space-y-3 text-left">
              <div class="flex items-center justify-between">
                <span class="text-xs font-bold text-brand-blue">Security Verification</span>
                <span class="text-[10px] text-gray-400">Step 2 of 2</span>
              </div>
              <p class="text-xs text-gray-400">Enter the 5 characters shown below to reveal date of birth:</p>
              
              <div class="flex items-center justify-center gap-3 p-3 bg-white/5 rounded-xl border border-white/10">
                <img id="manual-captcha-img" src="${imgSrc}" alt="Security Captcha" class="h-10 rounded shadow bg-white" />
                <button 
                  type="button" 
                  id="refresh-captcha-btn" 
                  title="Load new code"
                  class="px-2.5 py-2 bg-white/10 hover:bg-white/20 text-gray-300 hover:text-white rounded-lg transition-all text-xs flex items-center gap-1 cursor-pointer"
                >
                  <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" /></svg>
                  <span>New Code</span>
                </button>
              </div>

              ${errorMsg ? `<div class="p-2 rounded-lg bg-rose-500/10 border border-rose-500/20 text-rose-400 text-xs text-center font-medium">${errorMsg}</div>` : ''}

              <input 
                type="text" 
                id="manual-security-code-input" 
                placeholder="Enter 5 characters" 
                maxlength="6"
                autocomplete="off"
                autocapitalize="characters"
                class="w-full px-3.5 py-2.5 bg-white/5 border border-white/10 rounded-xl text-white text-center font-mono text-sm uppercase tracking-widest focus:outline-none focus:border-brand-blue" 
              />
              <button 
                type="button" 
                id="submit-security-code-btn" 
                class="w-full py-3 bg-brand-blue hover:bg-brand-blue-hover text-white text-xs font-bold rounded-xl transition-all cursor-pointer shadow-md flex items-center justify-center gap-1.5"
              >
                <span>Verify & Reveal DOB</span>
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
              </button>
            </div>
            <button type="button" id="dob-cancel-code-btn" class="w-full py-2 bg-white/[0.05] hover:bg-white/[0.1] text-white text-xs font-semibold rounded-lg mt-1 cursor-pointer transition-all">Cancel</button>
          `;

          const codeInput = document.getElementById("manual-security-code-input");
          if (codeInput) {
            codeInput.focus();
            codeInput.addEventListener("keypress", (e) => {
              if (e.key === "Enter") {
                e.preventDefault();
                submitCode();
              }
            });
            codeInput.addEventListener("input", () => {
              codeInput.value = codeInput.value.toUpperCase().replace(/[^A-Z0-9]/g, '');
            });
          }

          document.getElementById("refresh-captcha-btn")?.addEventListener("click", async () => {
            const btn = document.getElementById("refresh-captcha-btn");
            if (btn) btn.innerHTML = `<span class="text-xs">Loading...</span>`;
            try {
              const rRes = await fetch("/api/dob", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ rollNumber: roll, action: 'refreshCaptcha' })
              });
              const rData = await rRes.json();
              if (rData && rData.captchaImage) {
                currentSession = rData.session;
                updateModal(rData.captchaImage);
              }
            } catch (err) {
              if (btn) btn.innerHTML = `<span>New Code</span>`;
            }
          });

          document.getElementById("submit-security-code-btn")?.addEventListener("click", submitCode);

          document.getElementById("dob-cancel-code-btn")?.addEventListener("click", () => {
            homeDobOutput.classList.add("hidden");
            homeDobForm.classList.remove("hidden");
          });
        }

        async function submitCode() {
          const codeInput = document.getElementById("manual-security-code-input");
          const code = codeInput ? codeInput.value.trim().toUpperCase() : "";
          if (!code || code.length < 4) {
            if (codeInput) codeInput.focus();
            return;
          }

          const submitBtn = document.getElementById("submit-security-code-btn");
          if (submitBtn) {
            submitBtn.disabled = true;
            submitBtn.innerHTML = `
              <div class="w-4 h-4 border-2 border-white/30 border-t-white rounded-full animate-spin"></div>
              <span>Verifying...</span>
            `;
          }

          try {
            const vRes = await fetch("/api/dob", {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({ rollNumber: roll, manualCaptcha: code, session: currentSession })
            });
            const vData = await vRes.json();
            if (vData && vData.success && vData.dob) {
              renderDobSuccessCard(vData);
            } else if (vData && vData.needsManualCaptcha && vData.captchaImage) {
              currentSession = vData.session || currentSession;
              updateModal(vData.captchaImage, vData.error || "Incorrect code. Please enter the new characters shown.");
            } else {
              updateModal(initialData.captchaImage, vData?.error || "Verification failed. Please try again.");
            }
          } catch (e) {
            updateModal(initialData.captchaImage, "Network error during verification. Please try again.");
          }
        }

        updateModal(initialData.captchaImage);
      }

      if (data && data.success && data.dob) {
        renderDobSuccessCard(data);
      } else if (data && data.needsManualCaptcha && data.captchaImage) {
        renderManualCaptchaModal(data, roll);
      } else {
        homeDobOutput.innerHTML = `
          <div class="p-4 rounded-xl border border-rose-500/20 bg-rose-500/10 text-rose-400 text-xs text-center space-y-1">
            <div class="font-bold">Date of Birth Not Found</div>
            <div class="text-gray-400 text-[11px]">${data?.error || "Could not find registered DOB for this roll number."}</div>
          </div>
          <button type="button" id="dob-retry-btn" class="w-full py-2.5 bg-white/[0.05] hover:bg-white/[0.1] text-white text-xs font-semibold rounded-lg mt-2 cursor-pointer transition-all">Try Again</button>
        `;
        document.getElementById("dob-retry-btn")?.addEventListener("click", () => {
          homeDobOutput.classList.add("hidden");
          homeDobForm.classList.remove("hidden");
        });
      }
      } catch (err) {
        homeDobLoader.classList.add("hidden");
        homeDobOutput.classList.remove("hidden");
        homeDobOutput.innerHTML = `
          <div class="p-4 rounded-xl border border-rose-500/20 bg-rose-500/10 text-rose-400 text-xs text-center">
            Failed to connect to DOB scanning service. Please try again.
          </div>
          <button type="button" id="dob-retry-btn" class="w-full py-2.5 bg-white/[0.05] hover:bg-white/[0.1] text-white text-xs font-semibold rounded-lg mt-2 cursor-pointer transition-all">Try Again</button>
        `;
        document.getElementById("dob-retry-btn")?.addEventListener("click", () => {
          homeDobOutput.classList.add("hidden");
          homeDobForm.classList.remove("hidden");
        });
      }
    });

    function displayFullResult(data) {
      loaderState.classList.add("hidden");
      searchForm.classList.add("hidden");
      const vpc = document.getElementById("search-verified-profile-container");
      if (vpc) vpc.classList.add("hidden");
      const mcc = document.getElementById("search-manual-captcha-container");
      if (mcc) mcc.classList.add("hidden");

      // Shift layout to wide and push headline down
      if (heroGrid && heroCopy && heroCardWrapper) {
        heroGrid.classList.remove("md:grid-cols-12", "items-center");
        heroGrid.classList.add("grid-cols-1", "justify-items-center");
        
        heroCopy.classList.remove("md:col-span-7", "md:text-left");
        heroCopy.classList.add("w-full", "text-center", "order-2", "mt-12");
        
        heroCardWrapper.classList.remove("md:col-span-5", "max-w-lg");
        heroCardWrapper.classList.add("w-full", "max-w-[90vw]", "md:max-w-[90vw]", "order-1");
      }

      if (data.totalSearches) {
        updateCounterUI(data.totalSearches);
      }
      resultName.textContent = data.name;
      resultFather.textContent = data.fatherName || "--";
      resultRoll.textContent = data.rollNumber;
      resultEnrollment.textContent = data.enrollmentNumber || "--";
      resultCourse.textContent = data.course || "--";
      resultInstitute.textContent = data.institute || "--";
      resultCgpa.textContent = data.cgpa;
      
      const overall = calculateOverallStatusAndDivision(data.semesters, data.cgpa);
      
      if (data.courseCompleted) {
        if (resultDivisionContainer) resultDivisionContainer.classList.remove("hidden");
        if (resultIndicatorsGrid) {
          resultIndicatorsGrid.classList.remove("grid-cols-2");
          resultIndicatorsGrid.classList.add("grid-cols-3");
        }
        
        const divisionText = data.divisionAwarded || "Awarded";
        resultDivision.textContent = divisionText;
        if (divisionText === "Clear Backlog") {
          resultDivision.className = "text-red-400 font-bold text-[10px] sm:text-xs";
        } else {
          resultDivision.className = "text-white light:text-ink font-bold text-[10px] sm:text-xs";
        }

        if (finalResultSummaryContainer && finalResultSummaryContent && data.finalResultHtml) {
          finalResultSummaryContent.innerHTML = data.finalResultHtml;
          finalResultSummaryContainer.classList.remove("hidden");
        }
      } else {
        if (resultDivisionContainer) resultDivisionContainer.classList.add("hidden");
        if (resultIndicatorsGrid) {
          resultIndicatorsGrid.classList.remove("grid-cols-3");
          resultIndicatorsGrid.classList.add("grid-cols-2");
        }
        if (finalResultSummaryContainer) {
          finalResultSummaryContainer.classList.add("hidden");
        }
      }
      
      resultStatusBadge.textContent = overall.status;
      resultStatusBadge.className = overall.badgeClass;
      
      renderSemesters(data.semesters);
      resultState.classList.remove("hidden");
    }

    function renderSearchVerifiedProfile(data) {
      loaderState.classList.add("hidden");
      searchForm.classList.add("hidden");
      resultState.classList.add("hidden");
      errorState.classList.add("hidden");

      const mcc = document.getElementById("search-manual-captcha-container");
      if (mcc) {
        mcc.classList.add("hidden");
        mcc.innerHTML = "";
      }

      const container = document.getElementById("search-verified-profile-container");
      if (!container) return;
      container.classList.remove("hidden");

      const studentName = data.name || data.student?.name || "Verified Student";
      const rollNumber = data.rollNumber || "";
      const enrollmentNo = data.enrollmentNumber || data.student?.enrollmentNo;
      const enrollmentHtml = (enrollmentNo && enrollmentNo !== '--') 
