          `;

          try {
            (window.adsbygoogle = window.adsbygoogle || []).push({});
          } catch (e) {}

          const codeInput = document.getElementById("manual-security-code-input");
          if (codeInput) {
            codeInput.focus();
            codeInput.addEventListener("keypress", (e) => {
              if (e.key === "Enter") {
                e.preventDefault();
                submitCode();
              }
            });
            codeInput.addEventListener("input", () => {
              codeInput.value = codeInput.value.toUpperCase().replace(/[^A-Z0-9]/g, '');
            });
          }

          document.getElementById("refresh-captcha-btn")?.addEventListener("click", async () => {
            const btn = document.getElementById("refresh-captcha-btn");
            if (btn) btn.innerHTML = `<span class="text-xs">Loading...</span>`;
            try {
              const rRes = await fetch("/api/dob", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ rollNumber: roll, action: 'refreshCaptcha' })
              });
              const rData = await rRes.json();
              if (rData && rData.captchaImage) {
                currentSession = rData.session;
                updateModal(rData.captchaImage);
              }
            } catch (err) {
              if (btn) btn.innerHTML = `<span>New Code</span>`;
            }
          });

          document.getElementById("submit-security-code-btn")?.addEventListener("click", submitCode);

          document.getElementById("dob-cancel-code-btn")?.addEventListener("click", () => {
            homeDobOutput.classList.add("hidden");
            homeDobForm.classList.remove("hidden");
          });
        }

        async function submitCode() {
          const codeInput = document.getElementById("manual-security-code-input");
          const code = codeInput ? codeInput.value.trim().toUpperCase() : "";
          if (!code || code.length < 4) {
            if (codeInput) codeInput.focus();
            return;
          }

          const submitBtn = document.getElementById("submit-security-code-btn");
          if (submitBtn) {
            submitBtn.disabled = true;
            submitBtn.innerHTML = `
              <div class="w-4 h-4 border-2 border-white/30 border-t-white rounded-full animate-spin"></div>
              <span>Verifying...</span>
            `;
          }

          try {
            const vRes = await fetch("/api/dob", {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({ rollNumber: roll, manualCaptcha: code, session: currentSession })
            });
            const vData = await vRes.json();
            if (vData && vData.success && vData.dob) {
              renderDobSuccessCard(vData);
            } else if (vData && vData.needsManualCaptcha && vData.captchaImage) {
              currentSession = vData.session || currentSession;
              updateModal(vData.captchaImage, vData.error || "Incorrect code. Please enter the new characters shown.");
            } else {
              updateModal(initialData.captchaImage, vData?.error || "Verification failed. Please try again.");
            }
          } catch (e) {
            updateModal(initialData.captchaImage, "Network error during verification. Please try again.");
          }
        }

        updateModal(initialData.captchaImage);
      }

      if (data && data.success && data.dob) {
