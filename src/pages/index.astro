    // Tab switching logic
    const tabRollFinder = document.getElementById("home-tab-roll-finder");
    const tabCheckResult = document.getElementById("home-tab-check-result");
    const tabDobFinder = document.getElementById("home-tab-dob-finder");

    const viewRollFinder = document.getElementById("home-view-roll-finder");
    const viewCheckResult = document.getElementById("home-view-check-result");
    const viewDobFinder = document.getElementById("home-view-dob-finder");

    const switchTab = (activeTab, activeView) => {
      // Hide all views
      viewRollFinder.classList.add("hidden");
      viewCheckResult.classList.add("hidden");
      viewDobFinder.classList.add("hidden");

      // Show active view
      activeView.classList.remove("hidden");

      // Reset tab button styles
      [tabRollFinder, tabCheckResult, tabDobFinder].forEach(btn => {
        if (btn) {
          btn.className = "flex-1 py-2 text-center rounded-lg text-gray-400 hover:text-white light:text-gray-650 light:hover:text-ink focus:outline-none transition-all flex items-center justify-center gap-1.5 cursor-pointer select-none";
        }
      });

      // Highlight active tab button
      if (activeTab) {
        activeTab.className = "flex-1 py-2 text-center rounded-lg bg-brand-blue text-white focus:outline-none transition-all flex items-center justify-center gap-1.5 cursor-pointer select-none";
      }
    };

    tabRollFinder?.addEventListener("click", () => {
      fetchColleges();
      fetchBranches();
      switchTab(tabRollFinder, viewRollFinder);
    });
    tabCheckResult?.addEventListener("click", () => switchTab(tabCheckResult, viewCheckResult));
    tabDobFinder?.addEventListener("click", () => switchTab(tabDobFinder, viewDobFinder));

    document.getElementById("home-switch-to-roll-finder")?.addEventListener("click", () => {
      fetchColleges();
      fetchBranches();
      switchTab(tabRollFinder, viewRollFinder);
