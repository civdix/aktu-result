            </div>
            <p class="text-[10px] text-gray-400 light:text-gray-600 leading-relaxed mt-1">Found ${data.matches ? data.matches.length : 0} matching students.</p>
          </div>
        `;

        // Display Matches
        if (data.matches && data.matches.length > 0) {
          html += `
            <div class="space-y-2 text-left">
              <div class="text-[10px] uppercase font-bold text-gray-400 light:text-gray-500 tracking-wider">Matched Students (${data.matches.length})</div>
              <div class="space-y-2 max-h-[380px] sm:max-h-[460px] overflow-y-auto pr-1">
          `;
          data.matches.forEach((student) => {
            html += `
              <div class="p-3 sm:p-3.5 bg-black/45 light:bg-white hover:bg-brand-blue/5 light:hover:bg-blue-50/70 border border-white/[0.08] light:border-gray-200 hover:border-brand-blue/30 light:hover:border-brand-blue/40 rounded-xl flex justify-between items-center transition-all light:shadow-xs">
