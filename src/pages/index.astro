---
import Layout from "../layouts/Layout.astro";
import colleges from "../data/colleges.json";
import branches from "../data/branches.json";

const sortedColleges = [...colleges].sort((a, b) => a.name.localeCompare(b.name));
const sortedBranches = [...branches].sort((a, b) => a.name.localeCompare(b.name));


// JSON-LD Structured Data for index page
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "AKTU Result Without DOB Query Tool",
  "url": "https://akturesultwithoutdob.com",
  "description": "Helper tool for Dr. A.P.J. Abdul Kalam Technical University (AKTU) students to retrieve their detailed academic result sheets using their Roll Number.",
  "applicationCategory": "EducationalApplication",
  "operatingSystem": "All",
  "browserRequirements": "Requires JavaScript. Requires HTML5.",
  "creator": {
    "@type": "Organization",
    "name": "AKTU Student Portal",
    "url": "https://akturesultwithoutdob.com"
  }
};
const homeKeywords = "aktu result without dob, aktu one view, aktu result direct link, aktu result search, aktu scraper, check aktu marksheet, aktu roll number check, check aktu result";
---

<Layout 
  title="AKTU Result Without DOB | View Full One View Results Online"
  description="Forget your Date of Birth? Retrieve your full AKTU One View results sheet instantly using your Roll Number. Secure, fast, and student-focused query tool."
  keywords={homeKeywords}
  jsonLd={jsonLd}
>
  <!-- Hero Section -->
  <section class="relative pb-12 md:pb-16 overflow-hidden border-b border-canvas-dark-border light:border-canvas-light-border bg-gradient-to-b from-black via-canvas-dark-surface to-black light:from-white light:via-canvas-light-surface light:to-white transition-colors duration-300">
    <!-- Layered iPhone-style Ambient Glows -->
    <div class="absolute top-[-10%] left-[-10%] w-[550px] h-[550px] rounded-full bg-brand-blue/8 blur-[120px] pointer-events-none animate-pulse" style="animation-duration: 8s;"></div>
    <div class="absolute bottom-[10%] right-[-10%] w-[500px] h-[500px] rounded-full bg-purple-500/5 blur-[130px] pointer-events-none animate-pulse" style="animation-duration: 12s;"></div>
    <div class="absolute top-[20%] left-[30%] w-[350px] h-[350px] rounded-full bg-cyan-500/5 blur-[100px] pointer-events-none"></div>

    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div id="hero-grid" class="grid grid-cols-1 md:grid-cols-12 gap-8 md:gap-12 items-center min-h-[500px] transition-all duration-500">
        <!-- Left Side: Copywriting & Headline -->
        <div id="hero-copy" class="md:col-span-7 text-center md:text-left space-y-6 transition-all duration-500">
          <!-- Trust Badge -->
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-white/[0.08] light:border-black/[0.06] bg-white/[0.03] light:bg-white/40 backdrop-blur-md text-xs text-gray-400 light:text-gray-600 premium-shadow-light">
            <span class="w-1.5 h-1.5 rounded-full bg-brand-blue animate-pulse"></span>
            AKTU B.Tech / MBA / MCA Students Assistant
          </div>

          <!-- Main Headline -->
          <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-extrabold tracking-tight leading-[1.1] bg-gradient-to-b from-white to-gray-400 dark:from-white dark:to-gray-400 light:from-ink light:to-gray-800 bg-clip-text text-transparent">
            Find your AKTU Result <br class="hidden lg:inline" />
            <span class="bg-gradient-to-r from-brand-blue via-brand-blue-light to-purple-500 bg-clip-text text-transparent">Without Date of Birth</span>
          </h1>

          <p class="text-sm sm:text-base md:text-lg text-gray-400 light:text-gray-600 leading-relaxed max-w-xl mx-auto md:mx-0">
            Forget your credentials? Simply enter your university Roll Number to authenticate and display your complete academic grades card instantly without needing your Date of Birth.
          </p>

          <!-- Live Search Metrics -->
          <div class="text-xs text-gray-600 light:text-gray-400 flex items-center justify-center md:justify-start gap-4 flex-wrap pt-2">
            <span>🔒 256-bit Connection</span>
            <span>⏱️ Avg. Recovery: 4.8s</span>
            <span class="flex items-center gap-1">🔥 <span id="live-counter">24,000+</span> Recovered Results</span>
          </div>
        </div>

        <!-- Right Side: Search Box Container (Interactive Island) -->
        <div id="hero-card-wrapper" class="md:col-span-5 w-full max-w-lg mx-auto relative group transition-all duration-500">
          <!-- Glass Card Border Backdrop Glow -->
          <div class="absolute -inset-1.5 bg-gradient-to-r from-brand-blue to-purple-600 rounded-2xl blur-xl opacity-20 group-hover:opacity-35 transition duration-1000 group-hover:duration-200"></div>
          
          <div class="relative iphone-glass p-6 sm:p-8 rounded-2xl transition-all duration-300 text-left">
            
            <!-- Interactive Tabs for Navigation -->
            <div class="flex bg-black/40 light:bg-gray-100 p-1 rounded-xl mb-6 border border-white/5 light:border-black/5 text-[10px] sm:text-xs font-bold gap-x-2">
              <button 
                type="button"
                id="home-tab-check-result" 
                class="flex-1 py-2 text-center rounded-lg bg-brand-blue text-white focus:outline-none transition-all flex items-center justify-center gap-1.5 cursor-pointer select-none"
              >
                <span>⚡ Check Result</span>
              </button>
              <button 
                type="button"
                id="home-tab-roll-finder" 
                class="flex-1 py-2 text-center rounded-lg text-gray-400 hover:text-white light:text-gray-600 light:hover:text-ink focus:outline-none transition-all flex items-center justify-center gap-1.5 cursor-pointer select-none"
              >
                <span>🔍 Roll Finder</span>
              </button>
              <button 
                type="button"
                id="home-tab-dob-finder" 
                class="flex-1 py-2 text-center rounded-lg text-gray-400 hover:text-white light:text-gray-600 light:hover:text-ink focus:outline-none transition-all flex items-center justify-center gap-1.5 cursor-pointer select-none"
              >
                <span>🤖 Telegram Bot</span>
              </button>
            </div>

            <!-- TAB 2: Roll Finder Content -->
            <div id="home-view-roll-finder" class="hidden space-y-6">
              <form id="home-finder-form" class="space-y-5">
                <!-- Admission Year -->
                <div class="relative" id="home-year-combobox">
                  <label class="block text-xs font-semibold text-gray-400 light:text-gray-500 uppercase tracking-wider mb-2">
                    Admission Year
                  </label>
                  <div class="relative">
                    <input 
                      type="text" 
                      id="home-year-search" 
                      placeholder="Select Year"
                      readonly
                      required
                      class="w-full px-4 py-3 bg-white/[0.03] light:bg-black/[0.02] border border-white/[0.08] light:border-black/[0.08] rounded-xl text-white light:text-ink placeholder-gray-500 focus:outline-none focus:border-brand-blue focus:ring-1 focus:ring-brand-blue transition-all pr-10 cursor-pointer text-xs"
                    />
                    <input type="hidden" id="home-finder-year" name="admissionYear" />
                    <div class="absolute inset-y-0 right-0 flex items-center pr-3 pointer-events-none text-gray-500">
                      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                      </svg>
                    </div>
                  </div>
                  <!-- Dropdown Options List -->
                  <div 
                    id="home-year-dropdown" 
                    class="hidden absolute z-50 w-full mt-1 bg-[#121212]/95 light:bg-white/95 backdrop-blur-md border border-white/[0.1] light:border-black/[0.1] rounded-xl shadow-2xl max-h-60 overflow-y-auto"
                  >
                    <div class="p-1 space-y-0.5" id="home-year-list">
                      <button type="button" data-value="2025" class="w-full text-left px-3 py-2.5 rounded-lg text-xs text-gray-300 light:text-gray-700 hover:bg-brand-blue hover:text-white light:hover:bg-brand-blue light:hover:text-white transition-all cursor-pointer">2025</button>
                      <button type="button" data-value="2024" class="w-full text-left px-3 py-2.5 rounded-lg text-xs text-gray-300 light:text-gray-700 hover:bg-brand-blue hover:text-white light:hover:bg-brand-blue light:hover:text-white transition-all cursor-pointer">2024</button>
                      <button type="button" data-value="2023" class="w-full text-left px-3 py-2.5 rounded-lg text-xs text-gray-300 light:text-gray-700 hover:bg-brand-blue hover:text-white light:hover:bg-brand-blue light:hover:text-white transition-all cursor-pointer">2023</button>
                      <button type="button" data-value="2022" class="w-full text-left px-3 py-2.5 rounded-lg text-xs text-gray-300 light:text-gray-700 hover:bg-brand-blue hover:text-white light:hover:bg-brand-blue light:hover:text-white transition-all cursor-pointer">2022</button>
                      <button type="button" data-value="2021" class="w-full text-left px-3 py-2.5 rounded-lg text-xs text-gray-300 light:text-gray-705 hover:bg-brand-blue hover:text-white light:hover:bg-brand-blue light:hover:text-white transition-all cursor-pointer">2021</button>
                      <button type="button" data-value="2020" class="w-full text-left px-3 py-2.5 rounded-lg text-xs text-gray-300 light:text-gray-705 hover:bg-brand-blue hover:text-white light:hover:bg-brand-blue light:hover:text-white transition-all cursor-pointer">2020</button>
                      <button type="button" data-value="2019" class="w-full text-left px-3 py-2.5 rounded-lg text-xs text-gray-300 light:text-gray-705 hover:bg-brand-blue hover:text-white light:hover:bg-brand-blue light:hover:text-white transition-all cursor-pointer">2019</button>
                      <button type="button" data-value="2018" class="w-full text-left px-3 py-2.5 rounded-lg text-xs text-gray-300 light:text-gray-705 hover:bg-brand-blue hover:text-white light:hover:bg-brand-blue light:hover:text-white transition-all cursor-pointer">2018</button>
                    </div>
                  </div>
                </div>
                <!-- College -->
                <div class="relative" id="home-college-combobox">
                  <label class="block text-xs font-semibold text-gray-400 light:text-gray-500 uppercase tracking-wider mb-2">
                    College / Institute
                  </label>
                  <div class="relative">
                    <input 
                      type="text" 
                      id="home-college-search" 
                      placeholder="Type college name or code..."
                      autocomplete="off"
                      required
                      class="w-full px-4 py-3 bg-white/[0.03] light:bg-black/[0.02] border border-white/[0.08] light:border-black/[0.08] rounded-xl text-white light:text-ink placeholder-gray-500 focus:outline-none focus:border-brand-blue focus:ring-1 focus:ring-brand-blue transition-all pr-10 text-xs"
                    />
                    <input type="hidden" id="home-finder-college" name="collegeCode" />
                    <div class="absolute inset-y-0 right-0 flex items-center pr-3 pointer-events-none text-gray-500">
                      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                      </svg>
                    </div>
                  </div>
                  <!-- Dropdown Options List -->
                  <div 
                    id="home-college-dropdown" 
                    class="hidden absolute z-50 w-full mt-1 bg-[#121212]/95 light:bg-white/95 backdrop-blur-md border border-white/[0.1] light:border-black/[0.1] rounded-xl shadow-2xl max-h-60 overflow-y-auto"
                  >
                    <div class="p-1 space-y-0.5" id="home-college-list">
                      {sortedColleges.map((c) => (
                        <button
                          type="button"
                          data-code={c.code}
                          data-name={c.name}
                          class="w-full text-left px-3 py-2.5 rounded-lg text-xs text-gray-300 light:text-gray-700 hover:bg-brand-blue hover:text-white light:hover:bg-brand-blue light:hover:text-white transition-all flex justify-between items-center gap-2 cursor-pointer"
                        >
                          <span class="font-medium truncate">{c.name}</span>
                          <span class="font-mono text-[9px] opacity-60 bg-white/10 px-1.5 py-0.5 rounded">{c.code}</span>
                        </button>
                      ))}
                    </div>
                  </div>
                </div>

                <!-- Branch -->
                <div class="relative" id="home-branch-combobox">
                  <label class="block text-xs font-semibold text-gray-400 light:text-gray-500 uppercase tracking-wider mb-2">
                    Branch / Course
                  </label>
                  <div class="relative">
                    <input 
                      type="text" 
                      id="home-branch-search" 
                      placeholder="Type branch name or code..."
                      autocomplete="off"
                      required
                      class="w-full px-4 py-3 bg-white/[0.03] light:bg-black/[0.02] border border-white/[0.08] light:border-black/[0.08] rounded-xl text-white light:text-ink placeholder-gray-500 focus:outline-none focus:border-brand-blue focus:ring-1 focus:ring-brand-blue transition-all pr-10 text-xs"
                    />
                    <input type="hidden" id="home-finder-branch" name="branchCode" />
                    <div class="absolute inset-y-0 right-0 flex items-center pr-3 pointer-events-none text-gray-500">
                      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                      </svg>
                    </div>
                  </div>
                  <!-- Dropdown Options List -->
                  <div 
                    id="home-branch-dropdown" 
                    class="hidden absolute z-50 w-full mt-1 bg-[#121212]/95 light:bg-white/95 backdrop-blur-md border border-white/[0.1] light:border-black/[0.1] rounded-xl shadow-2xl max-h-60 overflow-y-auto"
                  >
                    <div class="p-1 space-y-0.5" id="home-branch-list">
                      {sortedBranches.map((b) => (
                        <button
                          type="button"
                          data-code={b.code}
                          data-name={b.name}
                          class="w-full text-left px-3 py-2.5 rounded-lg text-xs text-gray-300 light:text-gray-700 hover:bg-brand-blue hover:text-white light:hover:bg-brand-blue light:hover:text-white transition-all flex justify-between items-center gap-2 cursor-pointer"
                        >
                          <span class="font-medium truncate">{b.name}</span>
                          <span class="font-mono text-[9px] opacity-60 bg-white/10 px-1.5 py-0.5 rounded">{b.code}</span>
                        </button>
                      ))}
                    </div>
                  </div>
                </div>

                <!-- Student Name -->
                <div>
                  <label for="home-finder-name" class="block text-xs font-semibold text-gray-400 light:text-gray-500 uppercase tracking-wider mb-2">
                    Student Name (Optional)
                  </label>
                  <input 
                    type="text" 
                    id="home-finder-name" 
                    name="name" 
                    placeholder="e.g. SHIVAM" 
                    class="w-full px-4 py-3 bg-white/[0.03] light:bg-black/[0.02] border border-white/[0.08] light:border-black/[0.08] rounded-xl text-white light:text-ink placeholder-gray-600 focus:outline-none focus:border-brand-blue transition-all"
                  />
                </div>

                <!-- Captcha -->
                <div class="p-4 rounded-xl bg-white/[0.02] light:bg-black/[0.01] border border-white/[0.06] light:border-black/[0.04]">
                  <label class="block text-xs font-semibold text-gray-400 light:text-gray-500 uppercase tracking-wider mb-2">
                    Verification Captcha
                  </label>
                  <div class="flex items-center gap-3">
                    <div class="px-3.5 py-1.5 bg-brand-blue/10 border border-brand-blue/20 rounded-lg font-mono text-brand-blue text-sm tracking-wider select-none font-bold">
                      <span id="home-finder-captcha-num1">3</span> + <span id="home-finder-captcha-num2">5</span> = ?
                    </div>
                    <input 
                      type="number" 
                      id="home-finder-captcha-answer" 
                      name="captchaAnswer" 
                      placeholder="Result" 
                      required
                      class="flex-1 px-3 py-1.5 bg-white/[0.03] light:bg-white border border-white/[0.08] light:border-black/[0.08] rounded-lg text-white light:text-ink text-sm placeholder-gray-600 focus:outline-none focus:border-brand-blue transition-all"
                    />
                  </div>
                </div>

                <button 
                  type="submit" 
                  id="home-finder-submit-btn"
                  class="w-full py-3.5 bg-gradient-to-r from-brand-blue to-purple-600 hover:from-brand-blue-hover hover:to-purple-700 text-white text-sm font-semibold rounded-xl premium-shadow-dark hover:scale-[1.02] active:scale-[0.98] transition-all duration-300 flex items-center justify-center gap-2 cursor-pointer"
                >
                  <span>Search Class Roster</span>
                  <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                  </svg>
                </button>
              </form>

              <!-- Finder Loader -->
              <div id="home-finder-loader-state" class="hidden py-8 space-y-6">
                <div class="flex flex-col items-center justify-center text-center">
                  <div class="relative w-12 h-12 mb-4">
                    <div class="w-12 h-12 rounded-full border-4 border-brand-blue/20 animate-spin border-t-brand-blue"></div>
                  </div>
                  <h3 class="text-sm font-semibold text-white light:text-ink mb-1">Scanning AKTU ERP Directory...</h3>
                  <p class="text-xs text-gray-500" id="home-finder-loading-substatus">Negotiating ASP.NET state verification...</p>
                </div>
              </div>

              <!-- Finder Output Results -->
              <div id="home-finder-output" class="hidden space-y-4">
                <!-- Dynamic Content Injection -->
              </div>
            </div>

            <!-- TAB 1: Check Result Content -->
            <div id="home-view-check-result" class="space-y-6">
              <form id="search-form" class="space-y-6">
                <div>
                  <div class="flex justify-between items-center mb-2">
                    <label for="roll-number" class="block text-xs font-semibold text-gray-400 light:text-gray-500 uppercase tracking-wider">
                      University Roll Number
                    </label>
                    <button 
                      type="button" 
                      id="home-switch-to-roll-finder" 
                      class="text-[10px] text-brand-blue font-bold hover:underline cursor-pointer bg-transparent border-none p-0 focus:outline-none"
                    >
                      Forgot Roll Number?
                    </button>
                  </div>
                  <input 
                    type="text" 
                    id="roll-number" 
                    name="rollNumber"
                    placeholder="e.g. 2200650100100" 
                    required
                    pattern="^[0-9]{10,15}$"
                    class="w-full px-4 py-3 bg-white/[0.03] light:bg-black/[0.02] border border-white/[0.08] light:border-black/[0.08] rounded-xl text-white light:text-ink placeholder-gray-600 focus:outline-none focus:border-brand-blue focus:ring-1 focus:ring-brand-blue transition-all"
                  />
                  <span class="text-[10px] text-gray-500 light:text-gray-400 mt-1 block">Enter your 10 to 14 digit AKTU university roll number. No Date of Birth or token required.</span>
                </div>

                <button 
                  type="submit" 
                  id="search-btn"
                  class="w-full py-3.5 bg-gradient-to-r from-brand-blue to-purple-600 hover:from-brand-blue-hover hover:to-purple-700 text-white text-sm font-semibold rounded-xl premium-shadow-dark hover:scale-[1.02] active:scale-[0.98] transition-all duration-300 flex items-center justify-center gap-2 cursor-pointer"
                >
                  <span>⚡ Check Result</span>
                  <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                  </svg>
                </button>
              </form>

              <!-- Search Manual Security Code Modal Container -->
              <div id="search-manual-captcha-container" class="hidden space-y-4"></div>

              <!-- Search Verified Profile & Direct Launcher Container -->
              <div id="search-verified-profile-container" class="hidden space-y-4"></div>
            </div>

            <!-- TAB 3: Telegram Bot Content -->
            <div id="home-view-dob-finder" class="hidden space-y-5 text-left">
              <div class="p-4 rounded-xl border border-blue-500/30 bg-blue-500/10 text-xs text-gray-300 light:text-gray-600 leading-relaxed space-y-2">
                <div class="flex items-center gap-2">
                  <span class="text-base leading-none">🤖</span>
                  <span class="font-bold text-white text-sm">AKTU Official Marksheet Telegram Bot</span>
                </div>
                <p>
                  Retrieve your complete semester results, download official PDF marksheets, and view all SGPA/CGPA breakdowns directly on Telegram with zero Date of Birth needed!
                </p>
              </div>

              <div class="p-4 rounded-xl bg-black/40 light:bg-black/5 border border-white/10 space-y-3 font-sans text-xs">
                <div class="font-bold text-white light:text-ink text-xs uppercase tracking-wider">Features on Telegram Bot:</div>
                <ul class="space-y-2.5 text-gray-300 light:text-gray-700">
                  <li class="flex items-center gap-2">
                    <span class="text-emerald-400 font-bold">✓</span>
                    <span><b>Zero Date of Birth Required:</b> Direct verified lookup</span>
                  </li>
                  <li class="flex items-center gap-2">
                    <span class="text-emerald-400 font-bold">✓</span>
                    <span><b>Official PDF Marksheet:</b> High-resolution transcript document</span>
                  </li>
                  <li class="flex items-center gap-2">
                    <span class="text-emerald-400 font-bold">✓</span>
                    <span><b>Pre-Expanded HTML:</b> View all semester tables in one page</span>
                  </li>
                  <li class="flex items-center gap-2">
                    <span class="text-emerald-400 font-bold">✓</span>
                    <span><b>24/7 Available:</b> Instant automated results</span>
                  </li>
                </ul>
              </div>

              <a 
                href="https://t.me/akturesultwithoutdobbot" 
                target="_blank" 
                rel="noopener noreferrer"
                class="w-full py-4 bg-gradient-to-r from-brand-blue via-blue-500 to-purple-600 hover:from-brand-blue-hover hover:to-purple-700 text-white text-sm font-bold rounded-xl shadow-lg transition-all hover:scale-[1.02] active:scale-[0.98] flex items-center justify-center gap-2 text-center cursor-pointer"
              >
                <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
                  <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm4.64 6.8c-.15 1.58-.8 5.42-1.13 7.19-.14.75-.42 1-.68 1.03-.58.05-1.02-.38-1.58-.75-.88-.58-1.38-.94-2.23-1.5-.99-.65-.35-1.01.22-1.59.15-.15 2.71-2.48 2.76-2.69a.2.2 0 00-.05-.18c-.06-.05-.14-.03-.21-.02-.09.02-1.49.95-4.22 2.79-.4.27-.76.41-1.08.4-.36-.01-1.04-.2-1.55-.37-.63-.2-1.12-.31-1.08-.66.02-.18.27-.36.75-.55 2.92-1.27 4.86-2.11 5.83-2.51 2.78-1.16 3.35-1.36 3.73-1.36.08 0 .27.02.39.12.1.08.13.19.14.27-.01.06.01.24 0 .38z"/>
                </svg>
                <span>👉 Open @akturesultwithoutdobbot</span>
              </a>
            </div>


            <!-- Loading State Card (Skeleton Loader) -->
            <div id="loader-state" class="hidden py-8 space-y-6">
              <div class="flex flex-col items-center justify-center text-center">
                <!-- Spinner -->
                <div class="relative w-12 h-12 mb-4">
                  <div class="w-12 h-12 rounded-full border-4 border-brand-blue/20 animate-spin border-t-brand-blue"></div>
                </div>
                <h3 class="text-sm font-semibold text-white light:text-ink mb-1" id="loading-status">Connecting to AKTU Portal...</h3>
                <p class="text-xs text-gray-500" id="loading-substatus">Locating session token...</p>
              </div>
              
              <!-- Mocking Console Log Steps -->
              <div class="font-mono text-[10px] text-gray-600 bg-black/80 rounded-lg p-3 space-y-1 overflow-hidden h-24 border border-canvas-dark-border">
                <div class="text-gray-400">&gt; Starting scraping job...</div>
                <div id="log-step-1" class="hidden text-gray-500">&gt; Fetching ASP.NET_SessionId cookie... [OK]</div>
