      const botUrl = data.telegramBotUrl || `https://t.me/akturesultwithoutdobbot?start=${encodeURIComponent(rollNumber)}`;

      container.innerHTML = `
        <div class="p-5 sm:p-6 rounded-2xl border border-emerald-500/30 bg-gradient-to-b from-emerald-500/10 via-black/60 to-black/80 space-y-5 text-left shadow-2xl backdrop-blur-xl">
          <!-- Status Banner -->
          <div class="flex items-center justify-between pb-3 border-b border-emerald-500/20">
            <div class="flex items-center gap-2">
              <span class="w-2.5 h-2.5 rounded-full bg-emerald-400 animate-pulse"></span>
              <span class="text-xs font-bold text-emerald-400 uppercase tracking-wider">Academic Record Verified ✅</span>
            </div>
            <span class="px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-emerald-500/20 text-emerald-300 border border-emerald-500/30">
              AKTU Database
            </span>
          </div>

          <!-- Student Profile Details -->
          <div class="space-y-2">
            <div class="text-[11px] text-gray-400 uppercase font-medium">Student Name:</div>
            <div class="text-lg sm:text-xl font-black text-white tracking-tight">${studentName}</div>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 pt-2 border-t border-white/5 font-mono text-xs">
              <div class="text-gray-400">Roll No: <span class="font-bold text-white">${rollNumber}</span></div>
              ${enrollmentHtml}
              ${fatherHtml}
              ${courseHtml}
              ${instituteHtml}
            </div>
          </div>

          <!-- Telegram Bot Promotion Box -->
          <div class="p-4 rounded-xl bg-gradient-to-r from-blue-600/20 to-purple-600/20 border border-blue-500/30 space-y-3">
            <div class="flex items-center gap-2">
              <span class="text-lg">🤖</span>
              <span class="text-xs font-bold text-white uppercase tracking-wider">Access Your Result On Telegram</span>
            </div>
            <p class="text-xs text-gray-300 leading-relaxed">
              Your academic file has been successfully verified! You can access your <b>complete semester marksheet</b>, <b>all subject grades & SGPA</b>, and download your <b>official PDF marksheet</b> without needing your Date of Birth on our Telegram Bot.
            </p>

            <div class="grid grid-cols-2 gap-2 text-[11px] text-gray-300 pt-1">
              <div class="flex items-center gap-1.5">
                <span class="text-emerald-400 font-bold">✓</span> No DOB Required
              </div>
              <div class="flex items-center gap-1.5">
                <span class="text-emerald-400 font-bold">✓</span> Official PDF Marksheet
              </div>
              <div class="flex items-center gap-1.5">
                <span class="text-emerald-400 font-bold">✓</span> Full Web Page View
              </div>
              <div class="flex items-center gap-1.5">
                <span class="text-emerald-400 font-bold">✓</span> Instant Delivery
              </div>
            </div>
          </div>

          <!-- Primary Telegram Bot Button -->
          <div class="space-y-2 pt-1">
            <a 
              href="${botUrl}" 
              target="_blank" 
              rel="noopener noreferrer"
              class="w-full py-4 bg-gradient-to-r from-brand-blue via-blue-500 to-purple-600 hover:from-brand-blue-hover hover:to-purple-700 text-white text-sm font-bold rounded-xl transition-all shadow-xl hover:scale-[1.02] active:scale-[0.98] flex items-center justify-center gap-2 text-center cursor-pointer"
            >
              <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
                <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm4.64 6.8c-.15 1.58-.8 5.42-1.13 7.19-.14.75-.42 1-.68 1.03-.58.05-1.02-.38-1.58-.75-.88-.58-1.38-.94-2.23-1.5-.99-.65-.35-1.01.22-1.59.15-.15 2.71-2.48 2.76-2.69a.2.2 0 00-.05-.18c-.06-.05-.14-.03-.21-.02-.09.02-1.49.95-4.22 2.79-.4.27-.76.41-1.08.4-.36-.01-1.04-.2-1.55-.37-.63-.2-1.12-.31-1.08-.66.02-.18.27-.36.75-.55 2.92-1.27 4.86-2.11 5.83-2.51 2.78-1.16 3.35-1.36 3.73-1.36.08 0 .27.02.39.12.1.08.13.19.14.27-.01.06.01.24 0 .38z"/>
              </svg>
              <span>Access Marksheet on Telegram (@akturesultwithoutdobbot)</span>
            </a>
            <p class="text-[11px] text-gray-400 text-center">
              Direct Telegram Bot: <a href="https://t.me/akturesultwithoutdobbot" target="_blank" class="text-brand-blue underline font-mono">@akturesultwithoutdobbot</a>
            </p>
          </div>
        </div>

        <button 
          type="button" 
          id="search-check-another-btn" 
          class="w-full py-2.5 bg-white/[0.05] hover:bg-white/[0.1] text-white text-xs font-semibold rounded-xl border border-white/10 cursor-pointer transition-all text-center"
        >
          ← Check Another Roll Number
        </button>
      `;

      document.getElementById("search-check-another-btn")?.addEventListener("click", resetUI);
    }

    function renderSearchManualCaptcha(initialData, roll) {
      let currentSession = initialData.session;
      const container = document.getElementById("search-manual-captcha-container");
      if (!container) return;

      loaderState.classList.add("hidden");
      searchForm.classList.add("hidden");
      resultState.classList.add("hidden");
      errorState.classList.add("hidden");
      container.classList.remove("hidden");

      function updateModal(imgSrc, errorMsg) {
        container.innerHTML = `
          <div class="p-4 rounded-xl border border-brand-blue/30 bg-black/60 space-y-3 text-left">
            <div class="flex items-center justify-between">
              <span class="text-xs font-bold text-brand-blue">Security Verification</span>
              <span class="text-[10px] text-gray-400">Step 2 of 2</span>
            </div>
            <p class="text-xs text-gray-400">Enter the 5 characters shown below to access student result:</p>
            
            <div class="flex items-center justify-center gap-3 p-3 bg-white/5 rounded-xl border border-white/10">
              <img id="search-manual-captcha-img" src="${imgSrc}" alt="Security Captcha" class="h-10 rounded shadow bg-white" />
              <button 
                type="button" 
                id="search-refresh-captcha-btn" 
                title="Load new code"
                class="px-2.5 py-2 bg-white/10 hover:bg-white/20 text-gray-300 hover:text-white rounded-lg transition-all text-xs flex items-center gap-1 cursor-pointer"
              >
                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" /></svg>
                <span>New Code</span>
              </button>
            </div>

            ${errorMsg ? `<div class="p-2 rounded-lg bg-rose-500/10 border border-rose-500/20 text-rose-400 text-xs text-center font-medium">${errorMsg}</div>` : ''}

            <input 
              type="text" 
              id="search-security-code-input" 
              maxlength="6"
              placeholder="Enter 5 characters"
              autocomplete="off"
              class="w-full px-3 py-2.5 bg-white/5 border border-white/20 rounded-lg text-white font-mono text-center tracking-widest text-base uppercase placeholder-gray-500 focus:outline-none focus:border-brand-blue"
            />

            <div class="flex gap-2 pt-1">
              <button 
                type="button" 
                id="search-cancel-code-btn" 
                class="flex-1 py-2.5 bg-white/10 hover:bg-white/15 text-gray-300 rounded-lg text-xs font-semibold transition-all cursor-pointer"
              >
                Cancel
              </button>
              <button 
                type="button" 
                id="search-submit-code-btn" 
                class="flex-1 py-2.5 bg-brand-blue hover:bg-brand-blue-hover text-white rounded-lg text-xs font-semibold transition-all cursor-pointer flex items-center justify-center gap-1"
              >
                <span>Verify & Proceed</span>
              </button>
            </div>
          </div>
        `;

        const codeInput = document.getElementById("search-security-code-input");
        if (codeInput) {
          codeInput.focus();
          codeInput.addEventListener("keydown", (e) => {
            if (e.key === "Enter") {
              e.preventDefault();
              submitCode();
            }
          });
        }

        document.getElementById("search-refresh-captcha-btn")?.addEventListener("click", async () => {
          const btn = document.getElementById("search-refresh-captcha-btn");
          if (btn) btn.innerHTML = `<span>Loading...</span>`;
          try {
            const rRes = await fetch("/api/search", {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({ rollNumber: roll, action: "refreshCaptcha", session: currentSession })
            });
            const rData = await rRes.json();
            if (rData && rData.captchaImage) {
              currentSession = rData.session || currentSession;
              updateModal(rData.captchaImage);
            } else {
              updateModal(imgSrc, "Could not refresh captcha. Try again.");
            }
          } catch (e) {
            updateModal(imgSrc, "Network error refreshing captcha.");
          }
        });

        document.getElementById("search-submit-code-btn")?.addEventListener("click", submitCode);
        document.getElementById("search-cancel-code-btn")?.addEventListener("click", resetUI);
      }

      async function submitCode() {
        const codeInput = document.getElementById("search-security-code-input");
        const code = codeInput ? codeInput.value.trim().toUpperCase() : "";
        if (!code || code.length < 4) {
          if (codeInput) codeInput.focus();
          return;
        }

        const submitBtn = document.getElementById("search-submit-code-btn");
        if (submitBtn) {
          submitBtn.disabled = true;
          submitBtn.innerHTML = `
            <div class="w-4 h-4 border-2 border-white/30 border-t-white rounded-full animate-spin"></div>
            <span>Verifying...</span>
          `;
        }

        try {
          const vRes = await fetch("/api/search", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ rollNumber: roll, manualCaptcha: code, session: currentSession })
          });
          const vData = await vRes.json();
          if (vData && vData.success) {
            renderSearchVerifiedProfile(vData);
          } else if (vData && vData.needsManualCaptcha && vData.captchaImage) {
            currentSession = vData.session || currentSession;
            updateModal(vData.captchaImage, vData.error || "Incorrect code. Please enter the new characters shown.");
          } else {
            updateModal(initialData.captchaImage, vData?.error || "Verification failed. Please try again.");
          }
        } catch (e) {
          updateModal(initialData.captchaImage, "Network error during verification. Please try again.");
        }
      }

      updateModal(initialData.captchaImage);
    }

    searchForm.addEventListener("submit", (e) => {
      e.preventDefault();
      
      const enteredRoll = rollInput.value.trim();
      if (!enteredRoll) return;

      // Hide Form & Show Loader
      searchForm.classList.add("hidden");
      const vpc = document.getElementById("search-verified-profile-container");
      if (vpc) {
        vpc.classList.add("hidden");
        vpc.innerHTML = "";
      }
      const mcc = document.getElementById("search-manual-captcha-container");
      if (mcc) {
        mcc.classList.add("hidden");
        mcc.innerHTML = "";
      }
      resultState.classList.add("hidden");
      errorState.classList.add("hidden");
      loaderState.classList.remove("hidden");

      // Reset logs
      log1.classList.add("hidden");
      log2.classList.add("hidden");
      log3.classList.add("hidden");
      log4.classList.add("hidden");

      loadingStatus.textContent = "Connecting to AKTU Database...";
      loadingSubstatus.textContent = "Querying student records and verifying credentials...";

      // Stage-based Loader Updates
      setTimeout(() => {
        loadingStatus.textContent = "Checking Academic Archives...";
        loadingSubstatus.textContent = "Searching local marksheet repository...";
        log1.classList.remove("hidden");
      }, 400);

      setTimeout(() => {
        loadingStatus.textContent = "Querying University Portal...";
        loadingSubstatus.textContent = "Authenticating student profile...";
        log2.classList.remove("hidden");
      }, 900);

      setTimeout(() => {
        loadingStatus.textContent = "Resolving Student Record...";
        loadingSubstatus.textContent = "Verifying enrollment & academic credentials...";
        log3.classList.remove("hidden");
      }, 1500);

      // Start network request immediately
      const fetchPromise = fetch('/api/search', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json'
        },
        body: JSON.stringify({ 
          rollNumber: enteredRoll
        })
      });

      // Await both minimum animation delay and fetch result
      const delayPromise = new Promise(resolve => setTimeout(resolve, 1800));

      Promise.all([fetchPromise, delayPromise])
        .then(async ([res]) => {
          loaderState.classList.add("hidden");

          if (!res.ok) {
            let errorText = "Could not fetch result now. Please try again.";
            try {
              const errData = await res.json();
              if (errData?.error) errorText = errData.error;
            } catch (e) {}
            document.getElementById("error-title").textContent = "Search Failed";
            document.getElementById("error-desc").textContent = errorText;
            errorState.classList.remove("hidden");
            return;
          }

          const data = await res.json();
          if (data.success) {
            if (data.totalSearches) {
              updateCounterUI(data.totalSearches);
            }
            renderSearchVerifiedProfile(data);
          } else if (data.needsManualCaptcha && data.captchaImage) {
            renderSearchManualCaptcha(data, enteredRoll);
          } else {
            document.getElementById("error-title").textContent = "Search Failed";
            document.getElementById("error-desc").textContent = data.error || "Could not fetch result now. Please try again.";
            errorState.classList.remove("hidden");
          }
        })
        .catch(error => {
          console.error("API Error:", error);
          loaderState.classList.add("hidden");
          document.getElementById("error-title").textContent = "Fetch Failed";
          document.getElementById("error-desc").textContent = "Connection error. Please check your connection and try again.";
          errorState.classList.remove("hidden");
        });
    });
    });
  </script>
</Layout>
