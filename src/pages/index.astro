---
import Layout from "../layouts/Layout.astro";

// JSON-LD Structured Data for index page
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "AKTU Result Without DOB Query Tool",
  "url": "https://akturesultwithoutdob.com",
  "description": "Helper tool for Dr. A.P.J. Abdul Kalam Technical University (AKTU) students to retrieve their detailed academic result sheets using their Roll Number.",
  "applicationCategory": "EducationalApplication",
  "operatingSystem": "All",
  "browserRequirements": "Requires JavaScript. Requires HTML5.",
  "creator": {
    "@type": "Person",
    "name": "Shivam Dixit",
    "url": "https://shivamdixit.vercel.app"
  }
};
const homeKeywords = "aktu result without dob, aktu one view, aktu result direct link, aktu result search, aktu scraper, check aktu marksheet, aktu roll number check, check aktu result";
---

<Layout 
  title="AKTU Result Without DOB | View Full One View Results Online"
  description="Forget your Date of Birth? Retrieve your full AKTU One View results sheet instantly using your Roll Number. Secure, fast, and student-focused query tool."
  keywords={homeKeywords}
  jsonLd={jsonLd}
>
  <!-- Hero Section -->
  <section class="relative pb-12 md:pb-16 overflow-hidden border-b border-canvas-dark-border light:border-canvas-light-border bg-gradient-to-b from-black via-canvas-dark-surface to-black light:from-white light:via-canvas-light-surface light:to-white transition-colors duration-300">
    <!-- Layered iPhone-style Ambient Glows -->
    <div class="absolute top-[-10%] left-[-10%] w-[550px] h-[550px] rounded-full bg-brand-blue/8 blur-[120px] pointer-events-none animate-pulse" style="animation-duration: 8s;"></div>
    <div class="absolute bottom-[10%] right-[-10%] w-[500px] h-[500px] rounded-full bg-purple-500/5 blur-[130px] pointer-events-none animate-pulse" style="animation-duration: 12s;"></div>
    <div class="absolute top-[20%] left-[30%] w-[350px] h-[350px] rounded-full bg-cyan-500/5 blur-[100px] pointer-events-none"></div>

    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div id="hero-grid" class="grid grid-cols-1 md:grid-cols-12 gap-8 md:gap-12 items-center min-h-[500px] transition-all duration-500">
        <!-- Left Side: Copywriting & Headline -->
        <div id="hero-copy" class="md:col-span-7 text-center md:text-left space-y-6 transition-all duration-500">
          <!-- Trust Badge -->
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-white/[0.08] light:border-black/[0.06] bg-white/[0.03] light:bg-white/40 backdrop-blur-md text-xs text-gray-400 light:text-gray-600 premium-shadow-light">
            <span class="w-1.5 h-1.5 rounded-full bg-brand-blue animate-pulse"></span>
            AKTU B.Tech / MBA / MCA Students Assistant
          </div>

          <!-- Main Headline -->
          <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-extrabold tracking-tight leading-[1.1] bg-gradient-to-b from-white to-gray-400 dark:from-white dark:to-gray-400 light:from-ink light:to-gray-800 bg-clip-text text-transparent">
            Find your AKTU Result <br class="hidden lg:inline" />
            <span class="bg-gradient-to-r from-brand-blue via-brand-blue-light to-purple-500 bg-clip-text text-transparent">Without Date of Birth</span>
          </h1>

          <p class="text-sm sm:text-base md:text-lg text-gray-400 light:text-gray-600 leading-relaxed max-w-xl mx-auto md:mx-0">
            Forget your credentials? Simply enter your university Roll Number to authenticate and display your complete academic grades card instantly without needing your Date of Birth.
          </p>

          <!-- Live Search Metrics -->
          <div class="text-xs text-gray-600 light:text-gray-400 flex items-center justify-center md:justify-start gap-4 flex-wrap pt-2">
            <span>🔒 256-bit Connection</span>
            <span>⏱️ Avg. Recovery: 4.8s</span>
            <span class="flex items-center gap-1">🔥 <span id="live-counter">24,000+</span> Recovered Results</span>
          </div>
        </div>

        <!-- Right Side: Search Box Container (Interactive Island) -->
        <div id="hero-card-wrapper" class="md:col-span-5 w-full max-w-lg mx-auto relative group transition-all duration-500">
          <!-- Glass Card Border Backdrop Glow -->
          <div class="absolute -inset-1.5 bg-gradient-to-r from-brand-blue to-purple-600 rounded-2xl blur-xl opacity-20 group-hover:opacity-35 transition duration-1000 group-hover:duration-200"></div>
          
          <div class="relative iphone-glass p-6 sm:p-8 rounded-2xl transition-all duration-300 text-left">
            
            <!-- Search Form -->
            <form id="search-form" class="space-y-6">
              <div>
                <div class="flex justify-between items-center mb-2">
                  <label for="roll-number" class="block text-xs font-semibold text-gray-400 light:text-gray-500 uppercase tracking-wider">
                    University Roll Number
                  </label>
                  <button 
                    type="button" 
                    id="forgot-roll-btn" 
                    class="text-[10px] text-brand-blue font-bold hover:underline cursor-pointer bg-transparent border-none p-0 focus:outline-none"
                  >
                    Forgot Roll Number?
                  </button>
                </div>
                <input 
                  type="text" 
                  id="roll-number" 
                  name="rollNumber" 
                  placeholder="e.g. 2200650100100" 
                  required
                  pattern="^[0-9]{10,15}$"
                  class="w-full px-4 py-3 bg-white/[0.03] light:bg-black/[0.02] border border-white/[0.08] light:border-black/[0.08] rounded-xl text-white light:text-ink placeholder-gray-600 light:placeholder-gray-400 focus:outline-none focus:border-brand-blue focus:ring-1 focus:ring-brand-blue transition-all"
                />
                <p class="text-[11px] text-gray-600 light:text-gray-400 mt-1.5">Usually a 10 to 13 digit number on your admit card.</p>
              </div>

              <!-- Mock Captcha Validation -->
              <div class="p-4 rounded-xl bg-white/[0.02] light:bg-black/[0.01] border border-white/[0.06] light:border-black/[0.04]">
                <label class="block text-xs font-semibold text-gray-400 light:text-gray-500 uppercase tracking-wider mb-2">
                  Verification Captcha
                </label>
                <div class="flex items-center gap-3">
                  <div class="px-3.5 py-1.5 bg-brand-blue/10 border border-brand-blue/20 rounded-lg font-mono text-brand-blue text-sm tracking-wider select-none font-bold">
                    <span id="captcha-num1">8</span> + <span id="captcha-num2">4</span> = ?
                  </div>
                  <input 
                    type="number" 
                    id="captcha-answer" 
                    name="captchaAnswer" 
                    placeholder="Result" 
                    required
                    class="flex-1 px-3 py-1.5 bg-white/[0.03] light:bg-white border border-white/[0.08] light:border-black/[0.08] rounded-lg text-white light:text-ink text-sm placeholder-gray-600 focus:outline-none focus:border-brand-blue transition-all"
                  />
                </div>
              </div>

              <button 
                type="submit" 
                class="w-full py-3.5 bg-gradient-to-r from-brand-blue to-purple-600 hover:from-brand-blue-hover hover:to-purple-700 text-white text-sm font-semibold rounded-xl premium-shadow-dark hover:scale-[1.02] active:scale-[0.98] transition-all duration-300 flex items-center justify-center gap-2 cursor-pointer"
              >
                <span>Search Result</span>
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                </svg>
              </button>
            </form>

            <!-- Loading State Card (Skeleton Loader) -->
            <div id="loader-state" class="hidden py-8 space-y-6">
              <div class="flex flex-col items-center justify-center text-center">
                <!-- Spinner -->
                <div class="relative w-12 h-12 mb-4">
                  <div class="w-12 h-12 rounded-full border-4 border-brand-blue/20 animate-spin border-t-brand-blue"></div>
                </div>
                <h3 class="text-sm font-semibold text-white light:text-ink mb-1" id="loading-status">Connecting to AKTU Portal...</h3>
                <p class="text-xs text-gray-500" id="loading-substatus">Locating session token...</p>
              </div>
              
              <!-- Mocking Console Log Steps -->
              <div class="font-mono text-[10px] text-gray-600 bg-black/80 rounded-lg p-3 space-y-1 overflow-hidden h-24 border border-canvas-dark-border">
                <div class="text-gray-400">&gt; Starting scraping job...</div>
                <div id="log-step-1" class="hidden text-gray-500">&gt; Fetching ASP.NET_SessionId cookie... [OK]</div>
                <div id="log-step-2" class="hidden text-gray-500">&gt; Extracting __VIEWSTATE encryption vector... [OK]</div>
                <div id="log-step-3" class="hidden text-brand-blue">&gt; Executing session bypass protocol... [OK]</div>
                <div id="log-step-4" class="hidden text-emerald-400">&gt; Fetching and parsing semester grades grid... [OK]</div>
              </div>
            </div>

            <!-- Result Box Card -->
            <div id="result-state" class="hidden space-y-5 animate-fade-in">
              <div class="p-4 rounded-xl bg-emerald-500/10 border border-emerald-500/20 text-center">
                <div class="w-10 h-10 rounded-full bg-emerald-500/20 text-emerald-400 flex items-center justify-center mx-auto mb-2 text-lg">✓</div>
                <h3 class="text-sm font-semibold text-emerald-400">Academic Records Fetched!</h3>
              </div>

              <div id="printable-marksheet" class="space-y-4 font-mono text-[11px] sm:text-xs border border-canvas-dark-border light:border-canvas-light-border rounded-xl p-4 bg-black/20 light:bg-canvas-light-tile">
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 pb-3 border-b border-canvas-dark-border/40">
                  <div class="space-y-0.5">
                    <div class="text-gray-500 text-[9px] uppercase tracking-wider">Student Name</div>
                    <div class="text-white light:text-ink font-bold text-[11px] sm:text-xs" id="result-name">SHIVAM DIXIT</div>
                  </div>
                  <div class="space-y-0.5">
                    <div class="text-gray-500 text-[9px] uppercase tracking-wider">Father's Name</div>
                    <div class="text-white light:text-ink font-semibold text-[11px] sm:text-xs" id="result-father">BHOLA DIXIT</div>
                  </div>
                  <div class="space-y-0.5">
                    <div class="text-gray-500 text-[9px] uppercase tracking-wider">Roll Number</div>
                    <div class="text-white light:text-ink font-semibold text-[11px] sm:text-xs" id="result-roll">2200650100100</div>
                  </div>
                  <div class="space-y-0.5">
                    <div class="text-gray-500 text-[9px] uppercase tracking-wider">Enrollment No.</div>
                    <div class="text-white light:text-ink font-semibold text-[11px] sm:text-xs" id="result-enrollment">220065010083516</div>
                  </div>
                  <div class="space-y-0.5 sm:col-span-2">
                    <div class="text-gray-500 text-[9px] uppercase tracking-wider">Course / Branch</div>
                    <div class="text-white light:text-ink font-semibold text-[11px] sm:text-xs" id="result-course">B.Tech (Computer Science & Eng.)</div>
                  </div>
                  <div class="space-y-0.5 sm:col-span-2">
                    <div class="text-gray-500 text-[9px] uppercase tracking-wider">Institute</div>
                    <div class="text-white light:text-ink font-semibold text-[11px] sm:text-xs" id="result-institute">B.S.A. COLLEGE OF ENGINEERING & TECHNOLOGY, MATHURA</div>
                  </div>
                </div>

                <!-- Cumulative Indicators -->
                <div id="result-indicators-grid" class="grid grid-cols-3 gap-2 py-3 border-b border-canvas-dark-border/40 light:border-canvas-light-border/60 text-center">
                  <div class="p-2 rounded bg-black/40 light:bg-canvas-light-surface border border-canvas-dark-border/40 light:border-canvas-light-border">
                    <div class="text-[8px] text-gray-500 light:text-gray-500 uppercase">CGPA</div>
                    <div class="text-brand-blue font-bold text-xs sm:text-sm" id="result-cgpa">7.15</div>
                  </div>
                  <div id="result-division-container" class="p-2 rounded bg-black/40 light:bg-canvas-light-surface border border-canvas-dark-border/40 light:border-canvas-light-border">
                    <div class="text-[8px] text-gray-500 light:text-gray-500 uppercase">Division</div>
                    <div class="text-white light:text-ink font-bold text-[10px] sm:text-xs" id="result-division">I-DIV</div>
                  </div>
                  <div class="p-2 rounded bg-black/40 light:bg-canvas-light-surface border border-canvas-dark-border/40 light:border-canvas-light-border">
                    <div class="text-[8px] text-gray-500 light:text-gray-500 uppercase">Status</div>
                    <div class="text-emerald-400 font-bold text-[10px] sm:text-xs" id="result-status-badge">PASS</div>
                  </div>
                </div>

                <!-- Semesters Accordion -->
                <div class="space-y-2.5 pt-2">
                  <span class="text-gray-500 block font-semibold mb-1 text-[10px] uppercase tracking-wider">Semester Reports (Click to Expand)</span>
                  <div class="space-y-2" id="semesters-accordion-container">
                    <!-- Semester tables populated dynamically -->
                  </div>
                </div>

                <!-- Final Result Panel Summary -->
                <div id="final-result-summary-container" class="hidden mt-4 pt-3 border-t border-canvas-dark-border/40 light:border-canvas-light-border/60">
                  <span class="text-gray-500 block font-semibold mb-2 text-[10px] uppercase tracking-wider">Course Completion Summary</span>
                  <div id="final-result-summary-content" class="p-3 bg-black/40 light:bg-white rounded-xl border border-canvas-dark-border/40 light:border-canvas-light-border text-[11px] overflow-x-auto">
                    <!-- Dynamic HTML content injected here -->
                  </div>
                </div>
              </div>

              <!-- Ko-fi Donation Banner -->
              <div class="p-4 rounded-xl border border-[#72a4f2]/25 bg-[#72a4f2]/5 text-center space-y-2.5">
                <p class="text-xs text-gray-300 light:text-gray-600">
                  🎉 <strong>Successfully found your academic records?</strong> Keep this service alive and free by supporting the developer!
                </p>
                <button class="coffee-trigger px-4 py-2 bg-[#72a4f2] hover:bg-[#5b8ddb] text-white text-xs font-bold rounded-lg transition-colors btn-press-active inline-flex items-center gap-1.5 cursor-pointer">
                  💙 Support me on Ko-fi
                </button>
              </div>

              <div class="space-y-2">
                <button 
                  id="print-result-btn" 
                  class="w-full py-3 bg-brand-blue text-white rounded-xl text-sm font-semibold hover:bg-brand-blue-hover text-center block transition-colors btn-press-active"
                >
                  Print Academic Report
                </button>
                <button 
                  id="reset-form-btn" 
                  class="w-full py-2.5 bg-transparent border border-canvas-dark-border light:border-canvas-light-border hover:bg-gray-900 light:hover:bg-gray-50 text-xs text-gray-400 hover:text-white light:text-gray-600 light:hover:text-ink font-medium rounded-xl transition-colors btn-press-active"
                >
                  Search Another Roll Number
                </button>
              </div>
            </div>

            <!-- Error Card -->
            <div id="error-state" class="hidden space-y-4 animate-fade-in">
              <div class="p-4 rounded-xl bg-red-500/10 border border-red-500/20 text-center">
                <div class="w-10 h-10 rounded-full bg-red-500/20 text-red-400 flex items-center justify-center mx-auto mb-2 text-lg">✕</div>
                <h3 class="text-sm font-semibold text-red-400" id="error-title">No Record Found</h3>
                <p class="text-xs text-gray-500 mt-1" id="error-desc">We couldn't locate a match for the specified parameters. Please confirm the roll number.</p>
              </div>

              <button 
                id="error-retry-btn" 
                class="w-full py-3 bg-gray-900 light:bg-gray-100 hover:bg-gray-800 light:hover:bg-gray-200 border border-canvas-dark-border light:border-canvas-light-border text-sm font-semibold rounded-xl text-white light:text-ink transition-colors btn-press-active"
              >
                Retry Search
              </button>
            </div>

          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Feature Grid -->
  <section class="py-16 md:py-24 bg-black light:bg-canvas-light transition-colors duration-300">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-16">
        <h2 class="text-3xl font-bold tracking-tight text-white light:text-ink mb-4">
          Why Students Trust This Service
        </h2>
        <p class="text-gray-400 light:text-gray-600 text-sm sm:text-base">
          Our service helps AKTU college students recover forgotten credentials securely.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        
        <!-- Feature 1 -->
        <div class="p-6 rounded-2xl iphone-glass hover:translate-y-[-4px] hover:border-brand-blue/30 transition-all duration-300">
          <div class="w-10 h-10 rounded-lg bg-brand-blue/10 text-brand-blue flex items-center justify-center font-bold text-lg mb-4">⚡</div>
          <h3 class="text-base font-semibold text-white light:text-ink mb-2">Instant Session Lookup</h3>
          <p class="text-xs text-gray-500 light:text-gray-600 leading-relaxed">
            Checks multiple year segments and months concurrently to pinpoint your exact birth record in seconds.
          </p>
        </div>

        <!-- Feature 2 -->
        <div class="p-6 rounded-2xl iphone-glass hover:translate-y-[-4px] hover:border-brand-blue/30 transition-all duration-300">
          <div class="w-10 h-10 rounded-lg bg-purple-500/10 text-purple-400 flex items-center justify-center font-bold text-lg mb-4">🔒</div>
          <h3 class="text-base font-semibold text-white light:text-ink mb-2">Pristine Student Privacy</h3>
          <p class="text-xs text-gray-500 light:text-gray-600 leading-relaxed">
            We don't save, log, or share student transcripts. The system simply fetches the validation date for result retrieval.
          </p>
        </div>

        <!-- Feature 3 -->
        <div class="p-6 rounded-2xl iphone-glass hover:translate-y-[-4px] hover:border-brand-blue/30 transition-all duration-300">
          <div class="w-10 h-10 rounded-lg bg-emerald-500/10 text-emerald-400 flex items-center justify-center font-bold text-lg mb-4">💯</div>
          <h3 class="text-base font-semibold text-white light:text-ink mb-2">High Accuracy</h3>
          <p class="text-xs text-gray-500 light:text-gray-600 leading-relaxed">
            Leverages ASP.NET session state management to guarantee 100% correct date outputs.
          </p>
        </div>

      </div>
    </div>
  </section>

  <!-- How It Works Section -->
  <section class="py-16 md:py-24 border-t border-canvas-dark-border light:border-canvas-light-border bg-canvas-dark-surface light:bg-canvas-light-surface transition-colors duration-300">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h2 class="text-3xl font-bold tracking-tight text-white light:text-ink mb-4">
          How The Recovery System Works
        </h2>
        <p class="text-gray-400 light:text-gray-600 text-sm">
          A step-by-step overview of the background retrieval cycle.
        </p>
      </div>

      <div class="relative pl-8 border-l border-canvas-dark-border light:border-canvas-light-border space-y-12 max-w-lg mx-auto">
        <!-- Step 1 -->
        <div class="relative">
          <div class="absolute -left-[41px] top-1.5 w-6 h-6 rounded-full bg-brand-blue/20 border-2 border-brand-blue text-brand-blue flex items-center justify-center text-[10px] font-bold">1</div>
          <h3 class="text-sm font-semibold text-white light:text-ink mb-1">Validation & Pre-Check</h3>
          <p class="text-xs text-gray-500 light:text-gray-600 leading-relaxed">
            The scraper establishes a session token with the AKTU portal and verifies if the roll number is valid.
          </p>
        </div>

        <!-- Step 2 -->
        <div class="relative">
          <div class="absolute -left-[41px] top-1.5 w-6 h-6 rounded-full bg-purple-500/20 border-2 border-purple-500 text-purple-400 flex items-center justify-center text-[10px] font-bold">2</div>
          <h3 class="text-sm font-semibold text-white light:text-ink mb-1">Dynamic Session Matching</h3>
          <p class="text-xs text-gray-500 light:text-gray-600 leading-relaxed">
            An automated iteration check scans dates within candidate birth years using live ViewState tokens.
          </p>
        </div>

        <!-- Step 3 -->
        <div class="relative">
          <div class="absolute -left-[41px] top-1.5 w-6 h-6 rounded-full bg-emerald-500/20 border-2 border-emerald-500 text-emerald-400 flex items-center justify-center text-[10px] font-bold">3</div>
          <h3 class="text-sm font-semibold text-white light:text-ink mb-1">Result Access</h3>
          <p class="text-xs text-gray-500 light:text-gray-600 leading-relaxed">
            Once a match occurs, the date of birth is instantly displayed for you to log in and inspect marks sheets.
          </p>
        </div>
      </div>
      
      <div class="text-center mt-12">
        <a href="/how-it-works" class="text-xs text-brand-blue hover:underline inline-flex items-center gap-1 font-semibold">
          Learn detailed session iteration logistics
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- Developer API Integration Promo Section -->
  <section class="py-16 md:py-24 border-t border-canvas-dark-border light:border-canvas-light-border bg-black light:bg-canvas-light-surface transition-colors duration-300">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="text-center max-w-2xl mx-auto mb-16">
        <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold text-brand-blue bg-brand-blue/10 border border-brand-blue/20 mb-4 uppercase tracking-wider">
          For Developers
        </div>
        <h2 class="text-3xl sm:text-4xl font-extrabold text-white light:text-ink tracking-tight mb-4">
          Robust REST API Suite
        </h2>
        <p class="text-gray-400 light:text-gray-600 text-xs sm:text-sm leading-relaxed">
          Need to integrate university records retrieval into your own platform? Leverage our developer REST APIs to fetch verified results or locate missing date of birth records programmatically.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-4xl mx-auto">
        <!-- Result API Card -->
        <div class="group relative rounded-2xl iphone-glass p-6 sm:p-8 hover:translate-y-[-4px] hover:border-brand-blue/30 transition-all duration-300">
          <div class="absolute top-4 right-4 flex items-center gap-1.5 font-mono text-[9px] px-2 py-0.5 rounded bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 uppercase font-bold">
            Public
          </div>
          <div class="w-10 h-10 rounded-xl bg-emerald-500/10 text-emerald-400 flex items-center justify-center font-bold text-lg mb-6">
            🔍
          </div>
          <h3 class="text-lg font-bold text-white light:text-ink mb-3 group-hover:text-brand-blue transition-colors">
            1. Student Result API
          </h3>
          <p class="text-xs text-gray-500 light:text-gray-600 leading-relaxed mb-6">
            Query academic result grids and cumulative indices instantly. Utilizes high-speed session bypass. Student DOB is omitted for compliance.
          </p>
          <div class="flex items-center gap-2 font-mono text-[10px] text-gray-400 light:text-gray-500 bg-white/[0.03] light:bg-black/[0.01] p-2.5 rounded-lg border border-white/[0.06] light:border-black/[0.04] mb-6">
            <span class="text-emerald-400 font-bold uppercase">POST</span>
            <span>/api/search</span>
          </div>
          <a href="/api#1-result-api-public-search" class="text-xs font-semibold text-brand-blue hover:underline inline-flex items-center gap-1">
            Read Result API docs
