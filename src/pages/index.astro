                  class="home-select-student-btn px-3.5 py-1.5 bg-brand-blue hover:bg-brand-blue-hover text-white rounded-lg text-xs font-bold transition-all shadow-sm hover:scale-105 active:scale-95 cursor-pointer flex items-center gap-1 shrink-0"
                  data-roll="${student.rollNumber}"
                  data-name="${student.name}"
                >
                  <span>⚡ Get Result</span>
                </button>
              </div>
            `;
          });
          html += `
              </div>
            </div>
          `;
        } else {
          html += `
            <div class="p-4 rounded-xl border border-white/[0.06] light:border-gray-200 text-center text-xs text-gray-500 light:text-gray-600 bg-black/20 light:bg-gray-50">
              No specific matching students found. Try selecting the base range from above.
            </div>
          `;
        }

        html += `
          <button type="button" id="home-finder-back-btn" class="w-full py-2.5 bg-white/[0.05] hover:bg-white/[0.1] light:bg-gray-100 light:hover:bg-gray-200 text-white light:text-gray-800 text-xs font-semibold rounded-lg mt-2 cursor-pointer transition-all border border-transparent light:border-gray-200">New Search</button>
        `;

        homeFinderOutput.innerHTML = html;

        // Bind Select buttons
        homeFinderOutput.querySelectorAll(".home-select-student-btn").forEach(btn => {
          btn.addEventListener("click", () => {
            const roll = btn.getAttribute("data-roll");
            if (roll) {
              switchTab(tabCheckResult, viewCheckResult);
              const rollInp = document.getElementById("roll-number");
              if (rollInp) {
                rollInp.value = roll;
                rollInp.focus();
                rollInp.scrollIntoView({ behavior: 'smooth', block: 'center' });
              }
