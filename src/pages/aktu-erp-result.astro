---
import Layout from "../layouts/Layout.astro";
import { getAcademicYearInfo } from "../utils/academicYear";

const yearInfo = getAcademicYearInfo();
const roll = Astro.url.searchParams.get("roll") || Astro.url.searchParams.get("rollNumber") || "";

const siteUrl = "https://akturesult.bond";
const pageUrl = `${siteUrl}/aktu-erp-result`;

const pageTitle = `AKTU ERP Result ${yearInfo.sessionFormatted} | Student Login & Portal Guide`;
const pageDescription = `Check AKTU ERP Result ${yearInfo.sessionFormatted} online. Student login guide for erp.aktu.ac.in, marksheet verification, scrutiny results, and semester exam grades.`;
const erpKeywords = `aktu erp result, erp aktu result, aktu erp login, aktu erp result ${yearInfo.session}, aktu erp student login, erp.aktu.ac.in result, check aktu erp result, aktu erp marksheet, aktu erp circular, aktu result ${yearInfo.startYear}, aktu result ${yearInfo.endYear}, aktu oneview erp`;

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": pageUrl,
      "url": pageUrl,
      "name": "AKTU ERP Result & Student Login Guide",
      "description": pageDescription,
      "isPartOf": {
        "@type": "WebSite",
        "@id": `${siteUrl}/#website`,
        "name": "AKTU Result & OneView Portal",
        "url": siteUrl
      }
    },
    {
      "@type": "BreadcrumbList",
      "@id": `${pageUrl}/#breadcrumb`,
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": siteUrl
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "AKTU ERP Result",
          "item": pageUrl
        }
      ]
    },
    {
      "@type": "FAQPage",
      "@id": `${pageUrl}/#faq`,
      "mainEntity": [
        {
          "@type": "Question",
          "name": "How do I check my AKTU ERP Result?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "To check your AKTU ERP result, you can either log into the official portal (erp.aktu.ac.in) using your User ID (University Roll Number) and password, or use our instant query tool above to fetch your complete semester marksheet without needing an ERP password."
          }
        },
        {
          "@type": "Question",
          "name": "What is the difference between AKTU ERP and AKTU OneView?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "AKTU OneView (oneview.aktu.ac.in) is a public result repository designed exclusively to view and print semester-wise marksheets using your roll number. AKTU ERP (erp.aktu.ac.in) is the private administrative student dashboard used for exam fee submission, scrutiny re-evaluation, admit card downloads, and profile management."
          }
        },
        {
          "@type": "Question",
          "name": "How to reset a forgotten AKTU ERP password?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "If you forgot your AKTU ERP password, visit erp.aktu.ac.in, click 'Reset Password', enter your User ID (Roll Number), and request an OTP. The OTP is sent to your registered mobile number and email. Alternatively, contact your college registrar or IT administrator to reset it."
          }
        },
        {
          "@type": "Question",
          "name": "Can I check my AKTU ERP result without logging into ERP?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes! You do not need to log into the ERP portal to view your grades. Our tool directly connects to the AKTU OneView result repository, allowing you to access your full semester marks and scorecards using only your University Roll Number."
          }
        }
      ]
    }
  ]
};
---

<Layout 
  title={pageTitle}
  description={pageDescription}
  keywords={erpKeywords}
  jsonLd={jsonLd}
>
  <!-- Hero Section with Embedded Quick Search -->
  <section class="relative py-12 md:py-16 overflow-hidden border-b border-canvas-dark-border light:border-canvas-light-border bg-gradient-to-b from-black via-canvas-dark-surface to-black light:from-white light:via-canvas-light-surface light:to-white transition-colors duration-300">
    <!-- Ambient Glows -->
    <div class="absolute top-[-10%] left-[-10%] w-[500px] h-[500px] rounded-full bg-purple-500/10 blur-[130px] pointer-events-none"></div>
    <div class="absolute bottom-[-10%] right-[-10%] w-[450px] h-[450px] rounded-full bg-brand-blue/10 blur-[130px] pointer-events-none"></div>

    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 space-y-8">
      
      <!-- Top Brand Header -->
      <div class="text-center space-y-3">
        <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full border border-purple-500/20 bg-purple-500/10 text-xs text-purple-400 font-semibold">
          <span class="w-2 h-2 rounded-full bg-purple-400 animate-pulse"></span>
          AKTU ERP (erp.aktu.ac.in) Student Portal Guide ({yearInfo.sessionFormatted})
        </div>
        <h1 class="text-3xl sm:text-4xl md:text-5xl font-black tracking-tight bg-gradient-to-r from-white via-gray-200 to-gray-400 dark:from-white dark:via-gray-200 dark:to-gray-400 light:from-ink light:via-gray-800 light:to-gray-900 bg-clip-text text-transparent">
          AKTU ERP Result &amp; Student Login Portal
        </h1>
        <p class="text-xs sm:text-sm text-gray-400 light:text-gray-600 max-w-xl mx-auto leading-relaxed">
          Verify your AKTU ERP semester results, access student login instructions, view examination circulars, and inspect your full academic marksheet online.
        </p>
      </div>

      <!-- Quick Result Lookup Island -->
      <div id="erp-card-wrapper" class="max-w-lg mx-auto p-6 sm:p-8 rounded-2xl iphone-glass border border-white/10 light:border-black/10 space-y-5 shadow-2xl text-left transition-all duration-500">
        <div class="flex items-center justify-between pb-2 border-b border-white/5 light:border-black/5">
          <span class="text-xs font-bold text-white light:text-ink flex items-center gap-2">
            <span>ÔÜí</span>
            <span>Instant ERP Result Lookup</span>
          </span>
          <span class="text-[10px] text-emerald-400 bg-emerald-500/10 px-2 py-0.5 rounded-full border border-emerald-500/20 font-semibold">
            No Password Required
          </span>
        </div>

        <!-- 1. Search Form -->
        <form id="erp-search-form" class="space-y-4">
          <div>
            <label for="erp-roll-number" class="text-[10px] uppercase font-bold text-gray-400 light:text-gray-600 tracking-wider block mb-1">
              University Roll Number (User ID)
            </label>
            <input 
              type="text" 
              id="erp-roll-number" 
              name="rollNumber" 
              value={roll}
              placeholder="e.g. 2400650100001" 
              required
              pattern="^[0-9]{10,15}$"
              class="w-full px-4 py-3 bg-white/5 light:bg-gray-100 border border-white/10 light:border-black/10 rounded-xl text-white light:text-ink font-mono text-sm placeholder-gray-500 focus:outline-none focus:border-brand-blue transition-all"
            />
            <span class="text-[10px] text-gray-500 light:text-gray-400 mt-1 block">Enter your 10 to 14 digit AKTU University Roll Number. No ERP password required.</span>
          </div>

          <button 
            type="submit" 
            id="erp-submit-btn"
            class="w-full py-3.5 bg-gradient-to-r from-purple-600 via-brand-blue to-blue-500 hover:from-purple-700 hover:to-brand-blue-hover text-white text-sm font-bold rounded-xl shadow-lg transition-all transform hover:scale-[1.02] active:scale-[0.98] flex items-center justify-center gap-2 cursor-pointer"
          >
            <span>ÔÜí Fetch ERP Semester Result</span>
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </button>
        </form>

        <!-- 2. Multi-Stage Background Process Loader -->
        <div id="erp-loader-state" class="hidden py-6 space-y-5">
          <div class="flex flex-col items-center justify-center text-center">
            <div class="relative w-12 h-12 mb-3">
              <div class="w-12 h-12 rounded-full border-4 border-purple-500/20 animate-spin border-t-purple-500"></div>
            </div>
            <h3 class="text-sm font-semibold text-white light:text-ink mb-1" id="erp-loading-status">Connecting to AKTU ERP Gateway...</h3>
            <p class="text-xs text-gray-500" id="erp-loading-substatus">Locating session token...</p>
          </div>
          
          <!-- Animated Scraping Terminal Logs -->
          <div class="font-mono text-[10px] text-gray-600 bg-black/80 rounded-lg p-3 space-y-1 overflow-hidden h-24 border border-canvas-dark-border">
            <div class="text-gray-400">&gt; Starting ERP background query...</div>
            <div id="erp-log-1" class="hidden text-gray-500">&gt; Fetching ASP.NET_SessionId cookie... [OK]</div>
            <div id="erp-log-2" class="hidden text-gray-500">&gt; Extracting __VIEWSTATE encryption vector... [OK]</div>
            <div id="erp-log-3" class="hidden text-purple-400">&gt; Connecting to University Academic Database... [OK]</div>
            <div id="erp-log-4" class="hidden text-emerald-400">&gt; Parsing semester scorecards and status ledger... [OK]</div>
          </div>
        </div>

        <!-- 3. Manual Security Verification Code Container -->
        <div id="erp-manual-captcha-container" class="hidden space-y-4"></div>

        <!-- 4. Verified Academic Profile Container -->
        <div id="erp-verified-profile-container" class="hidden space-y-4"></div>

        <!-- 5. Error State Card -->
        <div id="erp-error-state" class="hidden space-y-4 animate-fade-in">
          <div class="p-4 rounded-xl bg-red-500/10 border border-red-500/20 text-center">
            <div class="w-10 h-10 rounded-full bg-red-500/20 text-red-400 flex items-center justify-center mx-auto mb-2 text-lg">Ô£ò</div>
            <h3 class="text-sm font-semibold text-red-400" id="erp-error-title">ERP Result Query Failed</h3>
            <p class="text-xs text-gray-400 mt-1" id="erp-error-desc">We couldn't locate a match for the specified parameters. Please confirm the roll number.</p>
          </div>
          <button 
            type="button" 
            id="erp-error-retry-btn" 
            class="w-full py-3 bg-gray-900 light:bg-gray-100 hover:bg-gray-800 light:hover:bg-gray-200 border border-canvas-dark-border light:border-canvas-light-border text-xs font-semibold rounded-xl text-white light:text-ink transition-colors cursor-pointer"
          >
            Retry Search
          </button>
        </div>

        <!-- Official ERP Link Button -->
        <div class="pt-1 border-t border-white/5 light:border-black/5">
          <a 
            href="https://erp.aktu.ac.in/WebPages/OneView/OneView.aspx" 
            target="_blank" 
            rel="noopener noreferrer"
            class="w-full py-2.5 bg-white/5 light:bg-black/5 hover:bg-white/10 light:hover:bg-black/10 text-gray-300 light:text-gray-700 hover:text-white light:hover:text-ink rounded-xl border border-white/10 light:border-black/10 text-xs font-semibold transition-all flex items-center justify-center gap-2"
          >
            <span>­ƒöù Open Official erp.aktu.ac.in Login</span>
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" /></svg>
          </a>
        </div>
      </div>


      <!-- Helpful Cross-Link Callouts -->
      <div class="space-y-3 pt-2">
        <div class="p-3.5 rounded-xl bg-purple-500/10 border border-purple-500/20 text-center text-xs text-gray-300 light:text-gray-700">
          <span class="text-purple-400 font-semibold">Forgot your ERP password or Date of Birth?</span> View your semester marksheet instantly with
          <a href="/aktu-result-without-date-of-birth" class="text-brand-blue font-bold hover:underline ml-1">
            AKTU Result Without Date of Birth &rarr;
          </a>
        </div>
        <div class="text-center">
          <a href="/" class="text-xs text-brand-blue hover:underline inline-flex items-center gap-1">
            &larr; Return to AKTU Result Home Portal
          </a>
        </div>
      </div>

    </div>
  </section>

  <!-- Complete Guide: Understanding AKTU ERP -->
  <section class="py-16 md:py-20 border-t border-canvas-dark-border light:border-canvas-light-border bg-black light:bg-canvas-light transition-colors duration-300">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
      
      <div class="space-y-4">
        <h2 class="text-2xl sm:text-3xl font-extrabold text-white light:text-ink tracking-tight">
          What is AKTU ERP (erp.aktu.ac.in)?
        </h2>
        <p class="text-xs sm:text-sm text-gray-400 light:text-gray-600 leading-relaxed">
          The <strong>AKTU ERP (Enterprise Resource Planning)</strong> portal is the central administrative management backbone of Dr. A.P.J. Abdul Kalam Technical University, Lucknow. Every student admitted to an AKTU-affiliated institution receives an ERP account linked to their University Roll Number.
        </p>
        <p class="text-xs sm:text-sm text-gray-400 light:text-gray-600 leading-relaxed">
          While the general public uses the <strong>OneView</strong> portal to inspect grades, the ERP system provides authenticated self-service features: online examination forms submission, carry over paper (COP) registration, scrutiny re-evaluation application, admit card downloads, fee challan receipts, and institutional circulars.
        </p>
      </div>

      <!-- Step-by-Step: How to Log into AKTU ERP -->
      <div class="space-y-6">
        <h3 class="text-xl font-bold text-white light:text-ink">
          How to Log into AKTU ERP Student Portal (Step-by-Step)
        </h3>
        
        <div class="grid grid-cols-1 md:grid-cols-2 gap-5 text-xs">
          <div class="p-5 rounded-2xl bg-white/[0.02] light:bg-white border border-white/[0.08] light:border-black/[0.08] space-y-2">
            <span class="inline-block px-2 py-0.5 rounded bg-purple-500/20 text-purple-400 font-bold text-[10px]">Step 1</span>
            <h4 class="font-bold text-white light:text-ink text-sm">Navigate to Official ERP URL</h4>
            <p class="text-gray-400 light:text-gray-600 leading-relaxed">
              Open your browser and visit <code>https://erp.aktu.ac.in</code>. Ensure you are on the legitimate university domain to prevent phishing attacks.
            </p>
          </div>

          <div class="p-5 rounded-2xl bg-white/[0.02] light:bg-white border border-white/[0.08] light:border-black/[0.08] space-y-2">
            <span class="inline-block px-2 py-0.5 rounded bg-purple-500/20 text-purple-400 font-bold text-[10px]">Step 2</span>
            <h4 class="font-bold text-white light:text-ink text-sm">Enter Your User ID</h4>
            <p class="text-gray-400 light:text-gray-600 leading-relaxed">
              Your User ID is your 10 to 13 digit AKTU University Roll Number (e.g. <code>2400650100001</code>). Do not use your college internal roll number.
            </p>
          </div>

          <div class="p-5 rounded-2xl bg-white/[0.02] light:bg-white border border-white/[0.08] light:border-black/[0.08] space-y-2">
            <span class="inline-block px-2 py-0.5 rounded bg-purple-500/20 text-purple-400 font-bold text-[10px]">Step 3</span>
            <h4 class="font-bold text-white light:text-ink text-sm">Provide Password &amp; Captcha</h4>
            <p class="text-gray-400 light:text-gray-600 leading-relaxed">
              Type your registered alphanumeric password and solve the captcha image. Click <strong>Login</strong> to enter your student dashboard.
            </p>
          </div>

          <div class="p-5 rounded-2xl bg-white/[0.02] light:bg-white border border-white/[0.08] light:border-black/[0.08] space-y-2">
            <span class="inline-block px-2 py-0.5 rounded bg-purple-500/20 text-purple-400 font-bold text-[10px]">Step 4</span>
            <h4 class="font-bold text-white light:text-ink text-sm">Access Results &amp; Circulars</h4>
            <p class="text-gray-400 light:text-gray-600 leading-relaxed">
              Once inside, click on <strong>Examination &rarr; Student Result / OneView</strong> to view published grades, or navigate to <strong>Challenge Evaluation</strong> if you applied for paper re-checking.
            </p>
          </div>
        </div>
      </div>

      <!-- AKTU ERP Scrutiny & Challenge Evaluation -->
      <div class="p-6 rounded-2xl bg-gradient-to-r from-purple-900/20 via-black to-blue-900/20 border border-purple-500/30 space-y-4">
        <h3 class="text-lg font-bold text-white light:text-ink flex items-center gap-2">
          <span>­ƒôØ</span>
          <span>AKTU Challenge Evaluation &amp; Scrutiny Results</span>
        </h3>
        <p class="text-xs text-gray-300 light:text-gray-700 leading-relaxed">
          If you are unsatisfied with your semester marks, AKTU provides a two-stage re-checking mechanism through the ERP portal:
        </p>
        <ul class="space-y-2 text-xs text-gray-400 light:text-gray-600">
          <li class="flex items-start gap-2">
            <strong class="text-white light:text-ink">Stage 1 (Digital Answer Script Viewing):</strong>
            <span>Students pay a nominal fee (typically Ôé╣300 per subject) to review digital copies of their evaluated theory answer sheets online inside the ERP dashboard.</span>
          </li>
          <li class="flex items-start gap-2">
            <strong class="text-white light:text-ink">Stage 2 (Challenge Re-Evaluation):</strong>
            <span>If an evaluation mistake is spotted, students can submit a challenge evaluation request (typically Ôé╣2,500 per subject). If marks increase by 20% or more, a significant portion of the fee is refunded.</span>
          </li>
        </ul>
      </div>

      <!-- ERP FAQs -->
      <div class="space-y-4 pt-4">
        <h3 class="text-xl font-bold text-white light:text-ink">
          AKTU ERP Result Frequently Asked Questions
        </h3>
        <div class="space-y-3">
          <details class="group p-4 rounded-xl bg-white/[0.02] light:bg-white border border-white/[0.08] light:border-black/[0.08] [&_svg]:open:-rotate-180">
            <summary class="flex items-center justify-between cursor-pointer font-bold text-xs sm:text-sm text-white light:text-ink select-none list-none">
              <span>What to do if AKTU ERP password is forgotten?</span>
              <svg class="w-4 h-4 transition-transform duration-300 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
            </summary>
            <p class="mt-2 text-xs text-gray-400 light:text-gray-600 leading-relaxed">
              Click on the "Forgot Password" link on <code>erp.aktu.ac.in</code>. Enter your User ID (University Roll Number) and submit. An OTP will be dispatched to your registered mobile phone and email address. If you no longer have access to those credentials, request your college registrar or computer centre administrator to trigger a password reset for your profile.
            </p>
          </details>

          <details class="group p-4 rounded-xl bg-white/[0.02] light:bg-white border border-white/[0.08] light:border-black/[0.08] [&_svg]:open:-rotate-180">
            <summary class="flex items-center justify-between cursor-pointer font-bold text-xs sm:text-sm text-white light:text-ink select-none list-none">
              <span>Can I view my result if I haven't registered on AKTU ERP?</span>
              <svg class="w-4 h-4 transition-transform duration-300 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
            </summary>
            <p class="mt-2 text-xs text-gray-400 light:text-gray-600 leading-relaxed">
              Yes! You do not need to register on ERP to check your marks. Our search engine connects directly to the AKTU OneView database, allowing you to fetch your semester grades instantly using just your University Roll Number.
            </p>
          </details>

          <details class="group p-4 rounded-xl bg-white/[0.02] light:bg-white border border-white/[0.08] light:border-black/[0.08] [&_svg]:open:-rotate-180">
            <summary class="flex items-center justify-between cursor-pointer font-bold text-xs sm:text-sm text-white light:text-ink select-none list-none">
              <span>Are odd and even semester results both published on AKTU ERP?</span>
              <svg class="w-4 h-4 transition-transform duration-300 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
            </summary>
            <p class="mt-2 text-xs text-gray-400 light:text-gray-600 leading-relaxed">
              Yes. All semester resultsÔÇöincluding odd semester (1st, 3rd, 5th, 7th) and even semester (2nd, 4th, 6th, 8th)ÔÇöfor regular and carry-over (COP) candidates are published through AKTU's database and can be verified here.
            </p>
          </details>
        </div>
      </div>

    </div>
  </section>

  <!-- Client-Side Background Process Handler for ERP Search -->
  <script is:inline>
    const initErp = () => {
      const searchForm = document.getElementById("erp-search-form");
      const rollInput = document.getElementById("erp-roll-number");
      const submitBtn = document.getElementById("erp-submit-btn");

      const loaderState = document.getElementById("erp-loader-state");
      const loadingStatus = document.getElementById("erp-loading-status");
      const loadingSubstatus = document.getElementById("erp-loading-substatus");
      const log1 = document.getElementById("erp-log-1");
      const log2 = document.getElementById("erp-log-2");
      const log3 = document.getElementById("erp-log-3");
      const log4 = document.getElementById("erp-log-4");

      const cardWrapper = document.getElementById("erp-card-wrapper");
      const captchaContainer = document.getElementById("erp-manual-captcha-container");
      const profileContainer = document.getElementById("erp-verified-profile-container");
      const errorState = document.getElementById("erp-error-state");
      const errorTitle = document.getElementById("erp-error-title");
      const errorDesc = document.getElementById("erp-error-desc");
      const retryBtn = document.getElementById("erp-error-retry-btn");

      // Overall Status Calculator
      function calculateOverallStatus(semesters, defaultCgpa) {
        let hasBack = false;
        let hasFail = false;
        let hasGrace = false;

        if (Array.isArray(semesters)) {
          semesters.forEach((sem) => {
            const status = (sem.status || "").toUpperCase();
            if (status.includes("PCP") || status.includes("CP") || status.includes("FAIL")) hasBack = true;
            if (status.includes("FAIL")) hasFail = true;
            if (status.includes("PWG")) hasGrace = true;

            if (sem.subjects && Array.isArray(sem.subjects)) {
              sem.subjects.forEach((sub) => {
                if (sub.grade === "F" || (sub.back && sub.back !== "--")) hasBack = true;
              });
            }
          });
        }

        let overall = "PASS";
        let badgeClass = "text-emerald-400 font-extrabold text-xs sm:text-sm";

        if (hasFail) {
          overall = "FAIL";
          badgeClass = "text-red-400 font-extrabold text-xs sm:text-sm";
        } else if (hasBack) {
          overall = "PCP";
          badgeClass = "text-purple-400 font-extrabold text-xs sm:text-sm";
        } else if (hasGrace) {
          overall = "PWG";
          badgeClass = "text-amber-400 font-extrabold text-xs sm:text-sm";
        }

        return { status: overall, badgeClass };
      }

      // Build Semesters Accordion HTML
      function buildSemestersAccordionHtml(semesters) {
        if (!Array.isArray(semesters) || semesters.length === 0) return '';
        return semesters.map((semData, idx) => {
          const subjects = semData.subjects || [];
          const rowsHtml = subjects.map(sub => `
            <tr class="hover:bg-white/5 light:hover:bg-gray-50 border-b border-white/5 light:border-gray-100 text-[11px] text-gray-300 light:text-gray-700">
              <td class="p-2.5 font-mono font-bold text-gray-400 light:text-gray-500">${sub.code || '--'}</td>
              <td class="p-2.5 text-white light:text-ink font-medium max-w-[160px] sm:max-w-none truncate sm:whitespace-normal" title="${sub.name || ''}">${sub.name || '--'}</td>
              <td class="p-2.5 text-gray-400 light:text-gray-500 uppercase text-[10px]">${sub.type || '--'}</td>
              <td class="p-2.5 text-center text-gray-300 light:text-gray-700 font-mono">${sub.int ?? '--'}</td>
              <td class="p-2.5 text-center text-gray-300 light:text-gray-700 font-mono">${sub.ext ?? '--'}</td>
