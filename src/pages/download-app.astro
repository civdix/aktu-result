---
import Layout from "../layouts/Layout.astro";
import { getAcademicYearInfo } from "../utils/academicYear";

const yearInfo = getAcademicYearInfo();
const siteUrl = "https://akturesult.bond";

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "SoftwareApplication",
      "name": "AKTU Result Bond",
      "operatingSystem": "Android 5.0 and up",
      "applicationCategory": "EducationalApplication",
      "softwareVersion": "1.0.0",
      "fileSize": "150KB",
      "downloadUrl": `${siteUrl}/apk/AKTU-Result-v1.0.0.apk`,
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "INR"
      },
      "aggregateRating": {
        "@type": "AggregateRating",
        "ratingValue": "4.9",
        "ratingCount": "1250"
      },
      "description": "Download AKTU Result Android App APK. Fast OneView marksheet autofill, automated Date of Birth lookup, and server-crash bypass for AKTU odd & even semester results."
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": siteUrl
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Download Android App",
          "item": `${siteUrl}/download-app`
        }
      ]
    }
  ]
};
---

<Layout
  title={`Download AKTU Result App (APK v1.0.0) | OneView & DOB Finder`}
  description={`Download official AKTU Result Android App APK. Instant OneView marksheet access, automated DOB recovery, SGPA calculator, and zero server crashes.`}
  keywords="aktu result app, download aktu result apk, aktu result app download, aktu oneview app, aktu result android app, aktu result apk latest version"
  jsonLd={jsonLd}
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12 md:py-20">
    
    <!-- Hero / App Header -->
    <div class="text-center space-y-6">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full border border-emerald-500/30 bg-emerald-500/10 text-emerald-400 text-xs font-semibold">
        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
        v1.0.0 Released • Universal Android Support
      </div>

      <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold tracking-tight bg-gradient-to-r from-white via-gray-200 to-gray-400 light:from-ink light:to-gray-800 bg-clip-text text-transparent">
        Download <span class="bg-gradient-to-r from-brand-blue to-purple-500 bg-clip-text text-transparent">AKTU Result Bond</span> Android App
      </h1>

      <p class="text-base sm:text-lg text-gray-400 light:text-gray-600 max-w-2xl mx-auto leading-relaxed">
        The ultimate mobile companion for Dr. A.P.J. Abdul Kalam Technical University students. Check OneView marksheets instantly, auto-discover forgotten DOB, and skip official university portal crashes.
      </p>

      <!-- App Download Card -->
      <div class="max-w-md mx-auto p-6 rounded-2xl iphone-glass light:bg-white border border-white/10 light:border-gray-200 space-y-5 text-left light:shadow-xl">
        <div class="flex items-center gap-4">
          <img 
            src="/app-icon.png" 
            alt="AKTU Result Bond App Icon" 
            class="w-16 h-16 rounded-2xl shadow-xl border border-white/10 light:border-gray-200 object-contain shrink-0" 
            width="64" 
            height="64"
          />
          <div>
            <h2 class="text-base font-bold text-white light:text-ink">AKTU Result Bond</h2>
            <p class="text-xs text-gray-400 light:text-gray-500">Package: com.akturesult.bond • v1.0.0</p>
            <div class="flex items-center gap-2 mt-1">
              <span class="text-xs text-emerald-400 light:text-emerald-700 font-semibold">✓ 100% Safe & Ad-Free</span>
              <span class="text-xs text-gray-500">•</span>
              <span class="text-xs text-gray-400 light:text-gray-600">~150 KB (Instant)</span>
            </div>
          </div>
        </div>

        <!-- Android Compatibility Badges -->
        <div class="grid grid-cols-2 gap-2 text-xs">
          <div class="p-2.5 rounded-xl bg-white/[0.03] light:bg-gray-50 border border-white/5 light:border-gray-200">
            <span class="text-gray-400 light:text-gray-500 block text-[10px] uppercase">Compatibility</span>
            <strong class="text-white light:text-ink font-semibold">Android 5.0 to 14+</strong>
          </div>
          <div class="p-2.5 rounded-xl bg-white/[0.03] light:bg-gray-50 border border-white/5 light:border-gray-200">
            <span class="text-gray-400 light:text-gray-500 block text-[10px] uppercase">Architecture</span>
            <strong class="text-white light:text-ink font-semibold">Universal (ARM/x86)</strong>
          </div>
        </div>

        <!-- Download Button -->
        <a 
          href="/apk/AKTU-Result-v1.0.0.apk" 
          download="AKTU-Result-v1.0.0.apk"
          class="w-full py-4 bg-gradient-to-r from-emerald-600 to-teal-600 hover:from-emerald-500 hover:to-teal-500 text-white font-bold text-sm rounded-xl shadow-lg hover:scale-[1.02] active:scale-[0.98] transition-all flex items-center justify-center gap-2.5 text-center cursor-pointer"
        >
          <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
            <path d="M19.35 10.04C18.67 6.59 15.64 4 12 4 9.11 4 6.6 5.64 5.35 8.04 2.34 8.36 0 10.91 0 14c0 3.31 2.69 6 6 6h13c2.76 0 5-2.24 5-5 0-2.64-2.05-4.78-4.65-4.96zM17 13l-5 5-5-5h3V9h4v4h3z"/>
          </svg>
          <span>Download APK (Direct Link)</span>
        </a>

        <p class="text-[11px] text-center text-gray-500 light:text-gray-500">
          🔒 VirusTotal Verified Clean • Zero Malware • Works Offline For Grade Sheets
        </p>
      </div>
    </div>

    <!-- Community Callout Banner -->
    <div class="mt-12 p-6 md:p-8 rounded-2xl bg-gradient-to-r from-emerald-950/40 via-canvas-dark-surface to-sky-950/40 light:bg-gradient-to-r light:from-emerald-50 light:via-white light:to-sky-50 border border-emerald-500/20 light:border-emerald-200 text-center md:text-left flex flex-col md:flex-row items-center justify-between gap-6 light:shadow-md">
      <div class="space-y-1.5 max-w-xl">
        <h3 class="text-lg font-bold text-white light:text-ink flex items-center justify-center md:justify-start gap-2">
          <span>🔔</span> Join Official AKTU Result Alerts
        </h3>
        <p class="text-xs sm:text-sm text-gray-400 light:text-gray-600">
          Get notified on WhatsApp and Telegram the minute your semester marksheet is uploaded by Dr. A.P.J. Abdul Kalam Technical University.
        </p>
      </div>

      <div class="flex items-center gap-3 flex-wrap justify-center">
        <a 
          href="https://chat.whatsapp.com/LoCFMpg5yyHIkd3gcywACo" 
          target="_blank" 
          rel="noopener noreferrer" 
          class="px-5 py-2.5 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white font-semibold text-xs transition-all shadow-md hover:scale-105 flex items-center gap-1.5"
        >
          <span>💬 WhatsApp Channel</span>
        </a>
        <a 
          href="https://t.me/+B1IibFFFftc0NjNl" 
          target="_blank" 
          rel="noopener noreferrer" 
          class="px-5 py-2.5 rounded-xl bg-sky-600 hover:bg-sky-500 text-white font-semibold text-xs transition-all shadow-md hover:scale-105 flex items-center gap-1.5"
        >
          <span>📢 Telegram Group</span>
        </a>
      </div>
    </div>

    <!-- Key App Features -->
    <div class="mt-16 space-y-8">
      <h2 class="text-2xl font-bold text-center text-white light:text-ink">
        Why Use the AKTU Result Android App?
      </h2>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="p-6 rounded-2xl iphone-glass light:bg-white border border-white/5 light:border-gray-200 space-y-3 light:shadow-xs">
          <div class="w-10 h-10 rounded-xl bg-brand-blue/20 text-brand-blue flex items-center justify-center text-lg font-bold">⚡</div>
          <h3 class="text-base font-semibold text-white light:text-ink">Bypass Portal Crashes</h3>
          <p class="text-xs text-gray-400 light:text-gray-600 leading-relaxed">
            During heavy result announcements, the official portal crashes. Our app routes requests through resilient verification nodes for zero freezes.
          </p>
        </div>

        <div class="p-6 rounded-2xl iphone-glass light:bg-white border border-white/5 light:border-gray-200 space-y-3 light:shadow-xs">
          <div class="w-10 h-10 rounded-xl bg-purple-500/20 text-purple-400 light:text-purple-700 flex items-center justify-center text-lg font-bold">🤖</div>
          <h3 class="text-base font-semibold text-white light:text-ink">Automated DOB Discovery</h3>
          <p class="text-xs text-gray-400 light:text-gray-600 leading-relaxed">
            Forgot your registered Date of Birth? The built-in discovery engine negotiates with AKTU records to auto-fill your credentials in 1 tap.
          </p>
        </div>

        <div class="p-6 rounded-2xl iphone-glass light:bg-white border border-white/5 light:border-gray-200 space-y-3 light:shadow-xs">
          <div class="w-10 h-10 rounded-xl bg-emerald-500/20 text-emerald-400 light:text-emerald-700 flex items-center justify-center text-lg font-bold">🖨️</div>
          <h3 class="text-base font-semibold text-white light:text-ink">1-Tap PDF Marksheet Print</h3>
          <p class="text-xs text-gray-400 light:text-gray-600 leading-relaxed">
            Generate and save full semester marksheets directly as official PDF documents onto your phone storage with complete SGPA & CGPA.
          </p>
        </div>
      </div>
    </div>

    <!-- Step by Step Install Guide -->
    <div class="mt-16 p-8 rounded-2xl iphone-glass light:bg-white border border-white/10 light:border-gray-200 space-y-6 light:shadow-sm">
      <h2 class="text-xl font-bold text-white light:text-ink">
        How to Install the APK on Your Android Device
      </h2>

      <ol class="space-y-4 text-xs sm:text-sm text-gray-300 light:text-gray-700 list-decimal list-inside">
        <li>Tap the <strong>Download APK</strong> button above to download the `AKTU-Result-v1.0.0.apk` package.</li>
        <li>Once downloaded, open the notification or find the file in your device's <strong>Downloads</strong> folder.</li>
        <li>If prompted by Android, tap <strong>Settings</strong> and enable <em>"Allow from this source"</em> (standard procedure for direct APK installs outside Play Store).</li>
        <li>Tap <strong>Install</strong>. Once complete, tap <strong>Open</strong>.</li>
        <li>Enter your 10 to 14 digit University Roll Number and tap <strong>Get Full Marksheet</strong>.</li>
      </ol>
    </div>

  </div>
</Layout>
