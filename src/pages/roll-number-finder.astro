  </section>

  <!-- Client-Side Form Logic -->
  <script is:inline>
    window.addEventListener("DOMContentLoaded", () => {
      const finderForm = document.getElementById("dedicated-finder-form");
      const submitBtn = document.getElementById("finder-submit-btn");
      const collegeSelect = document.getElementById("finder-college");
      const manualCollegeContainer = document.getElementById("finder-manual-college-container");
      const manualCollegeInput = document.getElementById("finder-manual-college");
      
      const statusPanel = document.getElementById("finder-status-panel");
      const resultsContainer = document.getElementById("finder-results-container");

      // Handle College Selection Manual trigger
      collegeSelect?.addEventListener("change", () => {
        if (collegeSelect.value === "other") {
          manualCollegeContainer?.classList.remove("hidden");
          manualCollegeInput.required = true;
          manualCollegeInput.focus();
        } else {
          manualCollegeContainer?.classList.add("hidden");
          manualCollegeInput.required = false;
          manualCollegeInput.value = "";
        }
      });

      // Handle search submission
      finderForm?.addEventListener("submit", async (e) => {
        e.preventDefault();
        if (!submitBtn || !resultsContainer || !statusPanel) return;

        const yearSelect = document.getElementById("finder-year");
        const branchSelect = document.getElementById("finder-branch");
        const nameInput = document.getElementById("finder-name");

        const admissionYear = yearSelect.value;
        let collegeCode = collegeSelect ? collegeSelect.value : "";
        if (collegeCode === "other") {
          collegeCode = manualCollegeInput.value.trim();
        }
        const branchCode = branchSelect.value;
        const name = nameInput.value.trim();

        if (!admissionYear || !collegeCode || !branchCode) {
          alert("Please select admission year, college, and branch.");
          return;
        }

        // Show spinner state
        submitBtn.setAttribute("disabled", "true");
        const originalText = submitBtn.innerHTML;
        submitBtn.innerHTML = `
          <svg class="animate-spin h-4 w-4 text-white inline-block" fill="none" viewBox="0 0 24 24">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
          </svg>
          <span>Scanning ERP...</span>
        `;

        resultsContainer.classList.add("hidden");
        statusPanel.classList.remove("hidden");
        statusPanel.innerHTML = `
          <div class="py-12 space-y-4">
            <div class="w-10 h-10 rounded-full border-4 border-brand-blue/20 animate-spin border-t-brand-blue mx-auto"></div>
            <p class="text-xs font-semibold text-white light:text-ink">Connecting to AKTU ERP form gateway...</p>
            <p class="text-[10px] text-gray-500">Querying class records. This might take up to 10 seconds if scanning live.</p>
          </div>
        `;

        try {
          const response = await fetch("/api/find-roll", {
            method: "POST",
            headers: {
              "Content-Type": "application/json"
            },
            body: JSON.stringify({
              admissionYear,
              collegeCode,
              branchCode,
              name
            })
          });

          if (!response.ok) {
            throw new Error("Failed to scan roll numbers");
          }

          const data = await response.json();
          if (!data || !data.success) {
            statusPanel.innerHTML = `
              <div class="p-4 bg-rose-500/10 border border-rose-500/20 text-rose-400 rounded-lg text-xs leading-relaxed max-w-xs mx-auto">
                ${data.error || "Failed to scan class roll numbers. Please check codes and try again."}
              </div>
            `;
            return;
          }

          statusPanel.classList.add("hidden");
          resultsContainer.classList.remove("hidden");

          let htmlContent = "";

          // Display Range
          htmlContent += `
            <div class="p-3 bg-brand-blue/10 border border-brand-blue/20 text-brand-blue rounded-xl space-y-1">
              <div class="text-[9px] uppercase font-bold tracking-wider opacity-85 text-gray-400">Class Roll Number Range Map</div>
              <div class="font-mono text-xs font-bold text-white light:text-ink">Range: ${data.rangeStart} to ${data.rangeEnd}</div>
              <p class="text-[9px] text-gray-500 font-medium">All student records scanned in this class are stored in MongoDB cache for instant checkouts.</p>
            </div>
          `;

          // Display Student List
          if (data.matches && data.matches.length > 0) {
            htmlContent += `
              <div class="space-y-2">
                <div class="text-[9px] font-bold text-gray-400 light:text-gray-500 uppercase tracking-wider">Scanned Student Profiles (${data.matches.length})</div>
                <div class="divide-y divide-canvas-dark-border/40 light:divide-canvas-light-border/60 max-h-[250px] overflow-y-auto pr-1 border border-canvas-dark-border light:border-canvas-light-border rounded-xl bg-black/20 light:bg-gray-50">
            `;
            data.matches.forEach((student) => {
              htmlContent += `
                <div class="p-3 flex justify-between items-center text-xs hover:bg-brand-blue/5 transition-colors">
                  <div class="space-y-0.5">
                    <div class="font-bold text-white light:text-ink text-[11px] sm:text-xs">${student.name}</div>
                    <div class="font-mono text-[9px] text-gray-500">${student.rollNumber} • Class ID #${student.rollNumber.slice(-3)}</div>
                  </div>
                  <a 
                    href="/?rollNumber=${student.rollNumber}"
                    class="px-3 py-1 bg-brand-blue text-white rounded-lg font-semibold hover:bg-brand-blue-hover text-[10px] transition-colors premium-shadow-dark cursor-pointer select-none"
                  >
                    Check Result
                  </a>
                </div>
              `;
            });
            htmlContent += `
                </div>
              </div>
            `;
          } else {
            htmlContent += `
              <div class="p-6 text-center text-gray-500">
                <span class="text-2xl block mb-2">🔍</span>
                <p class="text-xs font-semibold text-white light:text-ink">No matching student cache found for this class.</p>
                <p class="text-[10px] text-gray-500 mt-1">If you entered a filter name, try removing it to view the entire scanned class roster.</p>
              </div>
            `;
          }

          resultsContainer.innerHTML = htmlContent;

        } catch (err) {
          console.error("Dedicated finder error:", err);
          statusPanel.innerHTML = `
            <div class="p-4 bg-rose-500/10 border border-rose-500/20 text-rose-400 rounded-lg text-xs leading-relaxed max-w-xs mx-auto">
              Scraping request failed. Please check network logs and try again.
            </div>
          `;
        } finally {
          submitBtn.removeAttribute("disabled");
          submitBtn.innerHTML = originalText;
        }
      });

      // Finder API documentation code toggler
      const finderBtns = document.querySelectorAll(".finder-tab-btn");
      const finderBlocks = document.querySelectorAll(".finder-code-block");
      const finderLinenos = document.getElementById("finder-linenos");
      const finderTitle = document.getElementById("finder-editor-title");

      const generateLinenos = (linesCount) => {
        let html = '';
        for (let i = 1; i <= linesCount; i++) {
          html += `<span>${i}</span>`;
        }
        return html;
      };

      finderBtns.forEach(btn => {
        btn.addEventListener("click", () => {
          const targetLang = btn.getAttribute("data-lang");
          const filename = btn.getAttribute("data-filename");
          
          finderBtns.forEach(b => {
            b.classList.remove("text-brand-blue", "bg-canvas-dark-surface", "light:bg-white");
            b.classList.add("text-gray-400");
          });
          btn.classList.add("text-brand-blue", "bg-canvas-dark-surface", "light:bg-white");
          btn.classList.remove("text-gray-400");

          if (finderTitle) finderTitle.textContent = filename;

          finderBlocks.forEach(block => {
            if (block.id === `finder-code-${targetLang}`) {
              block.classList.remove("hidden");
              const lines = parseInt(block.getAttribute("data-lines") || "1", 10);
              if (finderLinenos) finderLinenos.innerHTML = generateLinenos(lines);
            } else {
              block.classList.add("hidden");
            }
          });
        });
      });
    });
  </script>
</Layout>
