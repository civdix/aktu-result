  <!-- Client-side switcher script -->
  <script is:inline>
    // Helper to generate line numbers HTML
    const generateLinenos = (linesCount) => {
      let html = '';
      for (let i = 1; i <= linesCount; i++) {
        html += `<span>${i}</span>`;
      }
      return html;
    };

    // 1. Result Search API Switcher
    const searchBtns = document.querySelectorAll(".search-tab-btn");
    const searchBlocks = document.querySelectorAll(".search-code-block");
    const searchLinenos = document.getElementById("search-linenos");
    const searchTitle = document.getElementById("search-editor-title");

    searchBtns.forEach(btn => {
      btn.addEventListener("click", () => {
        const targetLang = btn.getAttribute("data-lang");
        const filename = btn.getAttribute("data-filename");
        
        searchBtns.forEach(b => {
          b.classList.remove("text-brand-blue", "bg-canvas-dark-surface", "light:bg-white");
          b.classList.add("text-gray-400");
        });
        btn.classList.add("text-brand-blue", "bg-canvas-dark-surface", "light:bg-white");
        btn.classList.remove("text-gray-400");

        if (searchTitle) searchTitle.textContent = filename;

        searchBlocks.forEach(block => {
          if (block.id === `search-code-${targetLang}`) {
            block.classList.remove("hidden");
            const lines = parseInt(block.getAttribute("data-lines") || "1", 10);
            if (searchLinenos) searchLinenos.innerHTML = generateLinenos(lines);
          } else {
            block.classList.add("hidden");
          }
        });
      });
    });

    // 2. DOB Finder API Switcher
    const dobBtns = document.querySelectorAll(".dob-tab-btn");
    const dobBlocks = document.querySelectorAll(".dob-code-block");
    const dobLinenos = document.getElementById("dob-linenos");
    const dobTitle = document.getElementById("dob-editor-title");

    dobBtns.forEach(btn => {
      btn.addEventListener("click", () => {
        const targetLang = btn.getAttribute("data-lang");
        const filename = btn.getAttribute("data-filename");
        
        dobBtns.forEach(b => {
          b.classList.remove("text-brand-blue", "bg-canvas-dark-surface", "light:bg-white");
          b.classList.add("text-gray-400");
        });
        btn.classList.add("text-brand-blue", "bg-canvas-dark-surface", "light:bg-white");
        btn.classList.remove("text-gray-400");

        if (dobTitle) dobTitle.textContent = filename;

        dobBlocks.forEach(block => {
          if (block.id === `dob-code-${targetLang}`) {
            block.classList.remove("hidden");
            const lines = parseInt(block.getAttribute("data-lines") || "1", 10);
            if (dobLinenos) dobLinenos.innerHTML = generateLinenos(lines);
          } else {
            block.classList.add("hidden");
          }
        });
      });
    });

    // 3. Roll Number Finder API Switcher
    const finderBtns = document.querySelectorAll(".finder-tab-btn");
    const finderBlocks = document.querySelectorAll(".finder-code-block");
    const finderLinenos = document.getElementById("finder-linenos");
    const finderTitle = document.getElementById("finder-editor-title");

    finderBtns.forEach(btn => {
      btn.addEventListener("click", () => {
        const targetLang = btn.getAttribute("data-lang");
        const filename = btn.getAttribute("data-filename");
        
        finderBtns.forEach(b => {
          b.classList.remove("text-brand-blue", "bg-canvas-dark-surface", "light:bg-white");
          b.classList.add("text-gray-400");
        });
        btn.classList.add("text-brand-blue", "bg-canvas-dark-surface", "light:bg-white");
        btn.classList.remove("text-gray-400");

        if (finderTitle) finderTitle.textContent = filename;

        finderBlocks.forEach(block => {
          if (block.id === `finder-code-${targetLang}`) {
            block.classList.remove("hidden");
            const lines = parseInt(block.getAttribute("data-lines") || "1", 10);
            if (finderLinenos) finderLinenos.innerHTML = generateLinenos(lines);
          } else {
            block.classList.add("hidden");
          }
        });
      });
    });
  </script>
