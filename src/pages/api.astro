            <span class="code-type">HttpURLConnection</span> <span class="code-var">conn</span> = (<span class="code-type">HttpURLConnection</span>) <span class="code-var">url</span>.<span class="code-fn">openConnection</span>();
            <span class="code-var">conn</span>.<span class="code-fn">setRequestMethod</span>(<span class="code-str">"POST"</span>);
            <span class="code-var">conn</span>.<span class="code-fn">setRequestProperty</span>(<span class="code-str">"Content-Type"</span>, <span class="code-str">"application/json"</span>);
            <span class="code-var">conn</span>.<span class="code-fn">setRequestProperty</span>(<span class="code-str">"X-API-Key"</span>, <span class="code-str">"YOUR_API_KEY_HERE"</span>);
            <span class="code-var">conn</span>.<span class="code-fn">setDoOutput</span>(<span class="code-num">true</span>);

            <span class="code-type">String</span> <span class="code-var">jsonInputString</span> = <span class="code-str">"{"</span>
                + <span class="code-str">"\"rollNumber\": \"2400650100001\","</span>
                + <span class="code-str">"\"startYear\": 2001,"</span>
                + <span class="code-str">"\"endYear\": 2005"</span>
                + <span class="code-str">"}"</span>;

            <span class="code-kw">try</span> (<span class="code-type">OutputStream</span> <span class="code-var">os</span> = <span class="code-var">conn</span>.<span class="code-fn">getOutputStream</span>()) {
                <span class="code-kw">byte</span>[] <span class="code-var">input</span> = <span class="code-var">jsonInputString</span>.<span class="code-fn">getBytes</span>(<span class="code-str">"utf-8"</span>);
                <span class="code-var">os</span>.<span class="code-fn">write</span>(<span class="code-var">input</span>, <span class="code-num">0</span>, <span class="code-var">input</span>.length);
            }

            <span class="code-kw">int</span> <span class="code-var">code</span> = <span class="code-var">conn</span>.<span class="code-fn">getResponseCode</span>();
            <span class="code-type">Scanner</span> <span class="code-var">scanner</span> = <span class="code-kw">new</span> <span class="code-type">Scanner</span>(<span class="code-var">conn</span>.<span class="code-fn">getInputStream</span>());
            <span class="code-type">StringBuilder</span> <span class="code-var">response</span> = <span class="code-kw">new</span> <span class="code-type">StringBuilder</span>();
            <span class="code-kw">while</span> (<span class="code-var">scanner</span>.<span class="code-fn">hasNext</span>()) {
                <span class="code-var">response</span>.<span class="code-fn">append</span>(<span class="code-var">scanner</span>.<span class="code-fn">nextLine</span>());
            }
            <span class="code-var">scanner</span>.<span class="code-fn">close</span>();
            <span class="code-type">System</span>.out.<span class="code-fn">println</span>(<span class="code-str">"Response: "</span> + <span class="code-var">response</span>.<span class="code-fn">toString</span>());
        } <span class="code-kw">catch</span> (<span class="code-type">Exception</span> <span class="code-var">e</span>) {
            <span class="code-var">e</span>.<span class="code-fn">printStackTrace</span>();
        }
    }
