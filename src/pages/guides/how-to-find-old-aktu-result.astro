---
import Layout from "../../layouts/Layout.astro";

const siteUrl = "https://akturesult.bond";
const pageUrl = `${siteUrl}/guides/how-to-find-old-aktu-result`;

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Article",
      "@id": pageUrl,
      "url": pageUrl,
      "headline": "How to Find Old AKTU Results and Past Marksheets (2015-Present)",
      "description": "Step-by-step instructions on accessing past semester AKTU results, recovering forgotten roll numbers, legacy UPTU archives, and applying for duplicate marksheets.",
      "datePublished": "2026-03-01T08:00:00+05:30",
      "dateModified": "2026-10-16T12:00:00+05:30",
      "author": {
        "@type": "Organization",
        "name": "akturesult.bond Student Editorial Team"
      },
      "publisher": {
        "@type": "Organization",
        "name": "akturesult.bond",
        "url": siteUrl
      }
    },
    {
      "@type": "BreadcrumbList",
      "@id": `${pageUrl}/#breadcrumb`,
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": siteUrl },
        { "@type": "ListItem", "position": 2, "name": "Guides", "item": `${siteUrl}/guides` },
        { "@type": "ListItem", "position": 3, "name": "Find Old AKTU Results", "item": pageUrl }
      ]
    }
  ]
};
---

<Layout 
  title="How to Find Old AKTU Results & Marksheet Archives | akturesult.bond"
  description="Need to find an old AKTU or UPTU marksheet? Learn how to retrieve past semester scores from 2015 onwards, recover lost roll numbers, and request duplicate transcripts."
  jsonLd={jsonLd}
>
  <article class="py-16 md:py-20 bg-black light:bg-white text-gray-400 light:text-gray-600 text-left">
    <div class="max-w-4xl mx-auto px-4 sm:px-6">
      
      <!-- Breadcrumbs -->
      <nav class="flex items-center gap-2 text-xs text-gray-500 mb-6" aria-label="Breadcrumb">
        <a href="/" class="hover:text-brand-blue transition-colors">Home</a>
        <span>/</span>
        <a href="/guides" class="hover:text-brand-blue transition-colors">Guides</a>
        <span>/</span>
        <span class="text-gray-300 light:text-gray-800 font-semibold truncate">Find Old Results</span>
      </nav>

      <!-- Header -->
      <div class="border-b border-canvas-dark-border light:border-canvas-light-border pb-6 mb-8">
        <div class="flex items-center gap-2 text-xs text-brand-blue font-semibold uppercase tracking-wider mb-2">
          <span>Archive &amp; Records</span>
          <span>•</span>
          <span>5 min read</span>
          <span>•</span>
          <span>Updated October 2026</span>
        </div>
        <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold tracking-tight text-white light:text-ink leading-tight">
          How to Find Old AKTU Results &amp; Past Semester Archives
        </h1>
        <p class="text-sm sm:text-base text-gray-400 light:text-gray-600 mt-3 leading-relaxed">
          Whether you graduated years ago, lost your physical marksheet, or need past semester scorecards for job verification, here is how to locate historical AKTU academic records.
        </p>
      </div>

      <!-- Mandatory Non-Affiliation Alert -->
      <div class="p-4 rounded-xl border border-amber-500/30 bg-amber-500/10 text-amber-200 text-xs sm:text-sm leading-relaxed mb-10">
        <strong>Important Student Notice:</strong> akturesult.bond is an independent student utility platform and is not affiliated with, endorsed by, or officially connected to Dr. A.P.J. Abdul Kalam Technical University (AKTU). For official physical marksheets or verified transcripts, students must contact official university authorities.
      </div>

      <div class="space-y-10 text-xs sm:text-sm leading-relaxed">
        
        <!-- Section 1 -->
        <section class="space-y-4">
          <h2 class="text-xl sm:text-2xl font-bold text-white light:text-ink">
            1. Accessing Results from 2015 to Present (OneView Archive)
          </h2>
          <p>
            AKTU modernized its digital examination database starting in 2015. For any examination conducted from 2015 onward, your entire academic history remains permanently hosted on the <strong>OneView server</strong>:
          </p>
          <ul class="list-disc pl-5 space-y-2">
            <li>Visit <a href="https://oneview.aktu.ac.in" target="_blank" rel="noopener noreferrer" class="text-brand-blue hover:underline">oneview.aktu.ac.in</a> or use the <a href="/" class="text-brand-blue hover:underline">akturesult.bond result checker</a>.</li>
            <li>Input your 10 to 14 digit University Roll Number.</li>
            <li>All semesters you attempted will load in order. Even if you graduated 5 or 8 years ago, your records remain intact in the cloud repository.</li>
          </ul>
        </section>

        <!-- Section 2 -->
        <section class="space-y-4">
          <h2 class="text-xl sm:text-2xl font-bold text-white light:text-ink">
            2. How to Retrieve a Lost University Roll Number
          </h2>
          <p>
            You cannot check past results without your roll number. If you have misplaced your admit cards and documents:
          </p>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div class="p-4 rounded-xl border border-canvas-dark-border light:border-canvas-light-border bg-canvas-dark-tile light:bg-canvas-light-tile space-y-2">
              <strong class="text-white light:text-ink block">Option A: Use Our Roll Number Finder</strong>
              <p class="text-xs text-gray-500">
                Use our built-in <a href="/roll-number-finder" class="text-brand-blue hover:underline font-semibold">Roll Number Finder</a>. Select your admission year, college code, and branch to locate your roll number from university class rosters.
              </p>
            </div>
            <div class="p-4 rounded-xl border border-canvas-dark-border light:border-canvas-light-border bg-canvas-dark-tile light:bg-canvas-light-tile space-y-2">
              <strong class="text-white light:text-ink block">Option B: Contact Your College Registrar</strong>
              <p class="text-xs text-gray-500">
                Every affiliated college preserves student ledgers permanently. Provide your full name, father's name, and admission session to your college academic registrar to retrieve your official roll number.
              </p>
            </div>
          </div>
        </section>

        <!-- Section 3 -->
        <section class="space-y-4">
          <h2 class="text-xl sm:text-2xl font-bold text-white light:text-ink">
            3. Legacy Pre-2015 Records (UPTU / GBTU / MTU)
          </h2>
          <p>
            Prior to the establishment of the modern AKTU ERP in 2015, the university operated under the names <em>Uttar Pradesh Technical University (UPTU)</em>, <em>Gautam Buddha Technical University (GBTU)</em>, and <em>Mahamaya Technical University (MTU)</em>.
          </p>
          <div class="p-4 rounded-xl border border-canvas-dark-border light:border-canvas-light-border bg-canvas-dark-surface/50 light:bg-canvas-light-surface/50 space-y-2">
            <h4 class="font-bold text-white light:text-ink">How to Retrieve Pre-2015 Records:</h4>
            <ul class="list-disc pl-5 text-xs text-gray-400 space-y-1">
              <li>Some legacy batches (2010-2014) have been migrated into OneView; test your roll number first.</li>
              <li>If your pre-2015 roll number is not indexed on OneView, you must apply for a physical verification or duplicate transcript through the university's offline Examination Gazette Archive at the Lucknow campus.</li>
            </ul>
          </div>
        </section>

        <!-- Section 4 -->
        <section class="space-y-4">
          <h2 class="text-xl sm:text-2xl font-bold text-white light:text-ink">
            4. Applying for an Official Duplicate Marksheet
          </h2>
          <p>
            If your original printed marksheet was lost or damaged, a web printout is not sufficient for formal legal or passport documentation. Follow this official procedure:
          </p>
          <ol class="list-decimal pl-5 space-y-2 text-xs text-gray-400 light:text-gray-600">
            <li>File an FIR / Lost Property Report with your local police station noting the loss of your university marksheet.</li>
            <li>Publish a brief notice in a local newspaper mentioning your lost marksheet details (Roll Number, Course, College).</li>
            <li>Log into the <a href="https://erp.aktu.ac.in" target="_blank" rel="noopener noreferrer" class="text-brand-blue hover:underline font-semibold">AKTU ERP Student Service Portal</a> and select <strong>Apply for Duplicate Marksheet</strong>.</li>
            <li>Upload scanned copies of the FIR, newspaper clipping, an affidavit, and pay the requisite university fee (typically ₹500 to ₹1000 per marksheet).</li>
            <li>The duplicate certificate will be dispatched via Speed Post or collected from the university registrar.</li>
          </ol>
        </section>

      </div>

      <!-- Quick CTA -->
      <div class="mt-12 p-6 rounded-2xl bg-gradient-to-r from-brand-blue/20 to-purple-600/15 border border-brand-blue/30 flex flex-col sm:flex-row items-center justify-between gap-4">
        <div>
          <h3 class="text-sm font-bold text-white light:text-ink">Know your roll number and ready to check?</h3>
          <p class="text-xs text-gray-400 light:text-gray-600">Retrieve your historical semester records in seconds.</p>
        </div>
        <a href="/" class="px-4 py-2.5 rounded-xl bg-brand-blue hover:bg-brand-blue-hover text-white text-xs font-bold transition-all shadow-md shrink-0">
          ⚡ Check Past Results &rarr;
        </a>
      </div>

    </div>
  </article>
</Layout>
