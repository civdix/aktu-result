---
import Layout from "../../layouts/Layout.astro";

const siteUrl = "https://akturesult.bond";
const pageUrl = `${siteUrl}/guides/aktu-revaluation-scrutiny-challenge`;

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Article",
      "@id": pageUrl,
      "url": pageUrl,
      "headline": "AKTU Challenge Evaluation & Scrutiny Guide: Stage 1, Stage 2 & Refund Policy",
      "description": "Complete student guide to AKTU challenge evaluation and scrutiny. Learn the ₹300 digital answer sheet viewing process, ₹2,500 challenge evaluation, and the 15% increase refund rule.",
      "datePublished": "2026-04-08T08:00:00+05:30",
      "dateModified": "2026-10-16T12:00:00+05:30",
      "author": {
        "@type": "Organization",
        "name": "akturesult.bond Student Editorial Team"
      },
      "publisher": {
        "@type": "Organization",
        "name": "akturesult.bond",
        "url": siteUrl
      }
    },
    {
      "@type": "BreadcrumbList",
      "@id": `${pageUrl}/#breadcrumb`,
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": siteUrl },
        { "@type": "ListItem", "position": 2, "name": "Guides", "item": `${siteUrl}/guides` },
        { "@type": "ListItem", "position": 3, "name": "Challenge Evaluation", "item": pageUrl }
      ]
    }
  ]
};
---

<Layout 
  title="AKTU Challenge Evaluation, Scrutiny & 15% Refund Rule | akturesult.bond"
  description="Guide to AKTU revaluation: Stage 1 digital answer sheet view (₹300), Stage 2 challenge evaluation (₹2500), and the 15% mark increase refund criteria."
  jsonLd={jsonLd}
>
  <article class="py-16 md:py-20 bg-black light:bg-white text-gray-400 light:text-gray-600 text-left">
    <div class="max-w-4xl mx-auto px-4 sm:px-6">
      
      <!-- Breadcrumbs -->
      <nav class="flex items-center gap-2 text-xs text-gray-500 mb-6" aria-label="Breadcrumb">
        <a href="/" class="hover:text-brand-blue transition-colors">Home</a>
        <span>/</span>
        <a href="/guides" class="hover:text-brand-blue transition-colors">Guides</a>
        <span>/</span>
        <span class="text-gray-300 light:text-gray-800 font-semibold truncate">Challenge Evaluation</span>
      </nav>

      <!-- Header -->
      <div class="border-b border-canvas-dark-border light:border-canvas-light-border pb-6 mb-8">
        <div class="flex items-center gap-2 text-xs text-brand-blue font-semibold uppercase tracking-wider mb-2">
          <span>Examination Redressal</span>
          <span>•</span>
          <span>7 min read</span>
          <span>•</span>
          <span>Updated October 2026</span>
        </div>
        <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold tracking-tight text-white light:text-ink leading-tight">
          AKTU Challenge Evaluation &amp; Scrutiny: Step-by-Step Guide
        </h1>
        <p class="text-sm sm:text-base text-gray-400 light:text-gray-600 mt-3 leading-relaxed">
          Unsatisfied with your semester exam marks? AKTU provides a transparent two-stage challenge evaluation mechanism. Here is the exact application procedure, fee structures, and the 15% mark increase refund policy.
        </p>
      </div>

      <!-- Mandatory Non-Affiliation Alert -->
      <div class="p-4 rounded-xl border border-amber-500/30 bg-amber-500/10 text-amber-200 text-xs sm:text-sm leading-relaxed mb-10">
        <strong>Important Student Notice:</strong> akturesult.bond is an independent student utility platform and is not affiliated with, endorsed by, or officially connected to Dr. A.P.J. Abdul Kalam Technical University (AKTU). Challenge evaluation applications must be submitted directly through the official AKTU ERP portal.
      </div>

      <div class="space-y-10 text-xs sm:text-sm leading-relaxed">
        
        <!-- Section 1 -->
        <section class="space-y-4">
          <h2 class="text-xl sm:text-2xl font-bold text-white light:text-ink">
            1. Scrutiny vs. Challenge Evaluation: Key Difference
          </h2>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div class="p-4 rounded-xl border border-canvas-dark-border light:border-canvas-light-border bg-canvas-dark-tile light:bg-canvas-light-tile space-y-2">
              <strong class="text-brand-blue text-sm block">Scrutiny (Re-Totalling Only)</strong>
              <p class="text-xs text-gray-400 light:text-gray-600">
                The university simply re-checks the mathematical addition of awarded marks and verifies whether any question was left un-assessed. <strong>Answers are NOT re-read or re-evaluated.</strong> Fee is approximately ₹500 per subject.
              </p>
            </div>
            <div class="p-4 rounded-xl border border-canvas-dark-border light:border-canvas-light-border bg-canvas-dark-tile light:bg-canvas-light-tile space-y-2">
              <strong class="text-emerald-400 text-sm block">Challenge Evaluation (Full Re-Check)</strong>
              <p class="text-xs text-gray-400 light:text-gray-600">
                Your entire evaluated answer booklet is masked, stripped of previous examiner marks, and re-evaluated from scratch by two independent subject matter experts.
              </p>
            </div>
          </div>
        </section>

        <!-- Section 2 -->
        <section class="space-y-4">
          <h2 class="text-xl sm:text-2xl font-bold text-white light:text-ink">
            2. The 2-Stage Challenge Evaluation Workflow
          </h2>
          <p>
            AKTU strictly enforces a two-stage sequential workflow. You cannot apply for Stage 2 without first completing Stage 1:
          </p>

          <div class="space-y-4">
            <!-- Stage 1 -->
            <div class="p-5 rounded-xl border border-brand-blue/30 bg-brand-blue/10 space-y-2">
              <div class="flex items-center justify-between">
                <span class="font-bold text-brand-blue text-sm">Stage 1: Viewing Evaluated Answer Sheet</span>
                <span class="text-xs font-mono font-bold text-brand-blue">Fee: ₹300 per subject</span>
              </div>
              <p class="text-xs text-gray-300 leading-relaxed">
                Within 30 days of result declaration, apply on <a href="https://erp.aktu.ac.in" target="_blank" rel="noopener noreferrer" class="underline font-semibold text-white">erp.aktu.ac.in</a> under <strong>Challenge Evaluation Stage 1</strong>. Pay ₹300 online. Within 10 to 14 days, a watermarked PDF copy of your evaluated handwritten answer booklet will be unlocked in your ERP dashboard.
              </p>
            </div>

            <!-- Stage 2 -->
            <div class="p-5 rounded-xl border border-purple-500/30 bg-purple-500/10 space-y-2">
              <div class="flex items-center justify-between">
                <span class="font-bold text-purple-400 text-sm">Stage 2: Applying for Challenge Re-Evaluation</span>
                <span class="text-xs font-mono font-bold text-purple-400">Fee: ₹2,500 per subject</span>
              </div>
              <p class="text-xs text-gray-300 leading-relaxed">
                Review your evaluated answer PDF with your college subject professors. If you and your professors conclude that answers were marked unfairly or below standard rubric, apply for <strong>Challenge Evaluation Stage 2</strong> on ERP and submit the ₹2,500 examination fee.
              </p>
            </div>
          </div>
        </section>

        <!-- Section 3 -->
        <section class="space-y-4">
          <h2 class="text-xl sm:text-2xl font-bold text-white light:text-ink">
            3. The 15% Rule &amp; Partial Fee Refund Policy
          </h2>
          <p>
            To prevent frivolous applications while protecting genuine students, AKTU operates under the <strong>15% Mark Increase Rule</strong>:
          </p>

          <div class="p-6 rounded-2xl bg-canvas-dark-surface/60 light:bg-canvas-light-surface/60 border border-canvas-dark-border space-y-3">
            <h4 class="font-bold text-white light:text-ink text-sm">How the Average is Calculated:</h4>
            <p class="text-xs text-gray-400 light:text-gray-600">
              Your booklet is evaluated by two independent examiners. The average of their marks is calculated.
            </p>
            <ul class="list-disc pl-5 text-xs text-gray-300 space-y-2">
              <li>
                <strong>If marks increase by &gt; 15% of the original marks:</strong> The new higher average marks are updated on your OneView marksheet, and <strong>₹1,000 (partial refund)</strong> is credited back to the student's bank account.
              </li>
              <li>
                <strong>If marks increase by &le; 15% (or do not change):</strong> The original marks remain unchanged on your record, and no refund is provided.
              </li>
              <li>
                <strong>If marks decrease:</strong> Under current university guidelines, if the re-evaluated average drops below your original score, the lower score may be enforced. Students should only apply if they are certain of substantial marking errors.
              </li>
            </ul>
          </div>
        </section>

        <!-- Section 4 -->
        <section class="space-y-4">
          <h2 class="text-xl sm:text-2xl font-bold text-white light:text-ink">
            4. Step-by-Step ERP Application Guide
          </h2>
          <ol class="list-decimal pl-5 space-y-2 text-xs text-gray-400 light:text-gray-600">
            <li>Log into <a href="https://erp.aktu.ac.in" target="_blank" rel="noopener noreferrer" class="text-brand-blue hover:underline font-semibold">erp.aktu.ac.in</a> using your Roll Number and Password.</li>
            <li>In the dashboard, click on <strong>Challenge Evaluation Service</strong>.</li>
            <li>Select the session, semester, and subjects you wish to inspect.</li>
            <li>Complete the online payment of ₹300 per subject.</li>
            <li>Check your ERP portal after 7-10 days to download your evaluated answer booklet PDF.</li>
          </ol>
        </section>

      </div>

      <!-- Quick CTA -->
      <div class="mt-12 p-6 rounded-2xl bg-gradient-to-r from-brand-blue/20 to-purple-600/15 border border-brand-blue/30 flex flex-col sm:flex-row items-center justify-between gap-4">
        <div>
          <h3 class="text-sm font-bold text-white light:text-ink">Need to check if your marks updated?</h3>
          <p class="text-xs text-gray-400 light:text-gray-600">Inspect your live OneView academic scorecard right now.</p>
        </div>
        <a href="/" class="px-4 py-2.5 rounded-xl bg-brand-blue hover:bg-brand-blue-hover text-white text-xs font-bold transition-all shadow-md shrink-0">
          ⚡ Check Current Marksheet &rarr;
        </a>
      </div>

    </div>
  </article>
</Layout>
