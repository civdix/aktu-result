---
export const prerender = false;

import colleges from "../../data/colleges.json";
import { slugifyCollege } from "../../utils/slugify";
import { matchesCollegeSearch } from "../../utils/searchUtils";

const acceptHeader = Astro.request.headers.get("accept") || "";
const url = new URL(Astro.request.url);
const format = url.searchParams.get("format");
const isJson = acceptHeader.includes("application/json") || format === "json";

if (isJson) {
  const query = (url.searchParams.get("q") || url.searchParams.get("search") || "").trim();
  const code = (url.searchParams.get("code") || "").trim().toLowerCase();

  let results = colleges.map(c => ({
    ...c,
    slug: slugifyCollege(c.name, c.code)
  }));

  if (code) {
    results = results.filter(c => c.code.toLowerCase() === code || c.code.replace(/^0+/, '') === code.replace(/^0+/, ''));
  } else if (query) {
    results = results.filter(c => matchesCollegeSearch(c.name, c.code, query));
  }

  return new Response(
    JSON.stringify({
      success: true,
      total: results.length,
      colleges: results
    }),
    {
      status: 200,
      headers: { "Content-Type": "application/json" }
    }
  );
}

// Redirect web visitors to the directory page
return Astro.redirect("/colleges", 301);
---
