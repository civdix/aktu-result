  <script is:inline>
    window.addEventListener("DOMContentLoaded", () => {
      // 1. Dual Tab Controller
      const resultTabBtn = document.getElementById("college-tab-result-btn");
      const rosterTabBtn = document.getElementById("college-tab-roster-btn");
      const resultPanel = document.getElementById("college-panel-result");
      const rosterPanel = document.getElementById("college-panel-roster");
      const switchToRosterBtn = document.getElementById("switch-to-roster-btn");

      const activateTab = (tab) => {
        if (tab === "result") {
          resultTabBtn?.classList.remove("text-gray-400", "light:text-gray-600");
          resultTabBtn?.classList.add("bg-brand-blue", "text-white", "shadow");
          rosterTabBtn?.classList.remove("bg-brand-blue", "text-white", "shadow");
          rosterTabBtn?.classList.add("text-gray-400", "light:text-gray-600");

          resultPanel?.classList.remove("hidden");
          rosterPanel?.classList.add("hidden");
        } else {
          rosterTabBtn?.classList.remove("text-gray-400", "light:text-gray-600");
          rosterTabBtn?.classList.add("bg-brand-blue", "text-white", "shadow");
          resultTabBtn?.classList.remove("bg-brand-blue", "text-white", "shadow");
          resultTabBtn?.classList.add("text-gray-400", "light:text-gray-600");

          rosterPanel?.classList.remove("hidden");
          resultPanel?.classList.add("hidden");
        }
      };

      resultTabBtn?.addEventListener("click", () => activateTab("result"));
      rosterTabBtn?.addEventListener("click", () => activateTab("roster"));
      switchToRosterBtn?.addEventListener("click", () => activateTab("roster"));

      // 2. Direct AKTU Result Form Handler
      const resultForm = document.getElementById("college-result-form");
      const rollInput = document.getElementById("college-roll-input");
      const resultLoader = document.getElementById("college-result-loader");
      const resultOutput = document.getElementById("college-result-output");
      const resultError = document.getElementById("college-result-error");
      const errorTitle = document.getElementById("college-error-title");
      const errorDesc = document.getElementById("college-error-desc");
      const resultRetryBtn = document.getElementById("college-result-retry-btn");

      resultRetryBtn?.addEventListener("click", () => {
        resultError?.classList.add("hidden");
        resultForm?.classList.remove("hidden");
        if (rollInput) rollInput.focus();
      });

      const handleResultSearch = async (roll) => {
        if (!roll) return;

        resultForm?.classList.add("hidden");
        resultOutput?.classList.add("hidden");
        resultError?.classList.add("hidden");
        resultLoader?.classList.remove("hidden");

        const loadingTitle = document.getElementById("college-result-loading-title");
        const loadingSub = document.getElementById("college-result-loading-sub");

        const stages = [
          { title: "Connecting to AKTU Gateway...", sub: "Querying university records database..." },
          { title: "Resolving Student Ledger...", sub: "Verifying enrollment & academic credentials..." },
          { title: "Loading Semester Scorecard...", sub: "Compiling grades, SGPA & OneView ledger..." }
        ];
        let stageIndex = 0;
        const interval = setInterval(() => {
          stageIndex++;
          if (stageIndex < stages.length && loadingTitle && loadingSub) {
            loadingTitle.textContent = stages[stageIndex].title;
            loadingSub.textContent = stages[stageIndex].sub;
          }
        }, 600);

        try {
          const res = await fetch("/api/search", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ rollNumber: roll })
          });

          clearInterval(interval);
          resultLoader?.classList.add("hidden");

          const data = await res.json();

          if (data && data.success) {
            const studentName = data.name || data.student?.name || "Verified Student";
            const enrollmentNo = data.enrollmentNumber || data.student?.enrollmentNo || "--";
            const fatherName = data.fatherName || data.student?.fatherName || "--";
            const course = data.course || data.student?.course || "--";
            const institute = data.institute || data.student?.college || "--";
            const botUrl = data.telegramBotUrl || `https://t.me/akturesultwithoutdobbot?start=${encodeURIComponent(roll)}`;

            resultOutput.innerHTML = `
              <div class="p-5 rounded-2xl border border-emerald-500/30 light:border-emerald-200 bg-gradient-to-b from-emerald-500/10 via-black/60 to-black/80 light:bg-gradient-to-b light:from-emerald-50/80 light:via-white light:to-gray-50/60 space-y-4 text-left shadow-xl backdrop-blur-xl">
                
                <div class="flex items-center justify-between pb-3 border-b border-emerald-500/20 light:border-emerald-200">
                  <div class="flex items-center gap-2">
                    <span class="w-2.5 h-2.5 rounded-full bg-emerald-400 light:bg-emerald-600 animate-pulse"></span>
                    <span class="text-xs font-bold text-emerald-400 light:text-emerald-700 uppercase tracking-wider">Record Verified ✅</span>
                  </div>
                  <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-emerald-500/20 light:bg-emerald-100 text-emerald-300 light:text-emerald-800 border border-emerald-500/30 light:border-emerald-200">
                    AKTU Result
                  </span>
                </div>

                <div class="space-y-1.5">
                  <div class="text-[10px] text-gray-400 light:text-gray-500 uppercase font-medium">Student Name:</div>
                  <div class="text-lg font-black text-white light:text-ink tracking-tight">${studentName}</div>
                  <div class="grid grid-cols-1 sm:grid-cols-2 gap-1.5 pt-2 border-t border-white/5 light:border-gray-200 font-mono text-xs">
                    <div class="text-gray-400 light:text-gray-500">Roll No: <span class="font-bold text-white light:text-ink">${roll}</span></div>
                    <div class="text-gray-400 light:text-gray-500">Enrollment: <span class="font-bold text-white light:text-ink">${enrollmentNo}</span></div>
                    <div class="text-gray-400 light:text-gray-500">Course: <span class="text-gray-200 light:text-gray-800">${course}</span></div>
                    <div class="text-gray-400 light:text-gray-500">Institute: <span class="text-gray-200 light:text-gray-800">${institute}</span></div>
                  </div>
                </div>

                <!-- Telegram Bot Promotion Box -->
                <div class="p-3.5 rounded-xl bg-gradient-to-r from-blue-600/20 to-purple-600/20 light:bg-gradient-to-r light:from-blue-50 light:to-purple-50 border border-blue-500/30 light:border-blue-200 space-y-2.5">
                  <div class="flex items-center gap-2.5">
                    <img src="/images/gemini-svg.webp" alt="AKTU Result Bot Logo" class="w-8 h-8 rounded-full object-cover shrink-0" />
                    <div>
                      <span class="text-xs font-bold text-white light:text-ink block">Access Full Marksheet &amp; PDF</span>
                      <span class="text-[10px] text-brand-blue font-mono">@akturesultwithoutdobbot</span>
                    </div>
                  </div>
                  <p class="text-[11px] text-gray-300 light:text-gray-600 leading-relaxed">
                    View complete semester grades, subject-wise marks, SGPA/CGPA, and download official PDF scorecards without Date of Birth.
                  </p>
                  <a 
                    href="${botUrl}" 
                    target="_blank" 
                    rel="noopener noreferrer"
                    class="w-full py-3 bg-gradient-to-r from-brand-blue to-purple-600 hover:from-brand-blue-hover hover:to-purple-700 text-white text-xs font-bold rounded-xl transition-all shadow-md flex items-center justify-center gap-2 text-center cursor-pointer"
                  >
                    <span>👉 Get Marksheet on Telegram</span>
                  </a>
                </div>

                <div class="flex gap-2 pt-1">
                  <a 
                    href="/aktu-result-without-date-of-birth?roll=${encodeURIComponent(roll)}"
                    class="flex-1 py-2.5 bg-brand-blue hover:bg-brand-blue-hover text-white text-xs font-semibold rounded-xl transition-all text-center"
                  >
                    Open Full OneView
                  </a>
                  <button 
                    type="button" 
                    id="college-check-another-btn" 
                    class="flex-1 py-2.5 bg-white/10 light:bg-gray-100 hover:bg-white/15 light:hover:bg-gray-200 text-white light:text-gray-800 text-xs font-semibold rounded-xl border border-white/10 light:border-gray-200 transition-all cursor-pointer text-center"
                  >
                    Check Another
                  </button>
                </div>
              </div>
            `;

            resultOutput.classList.remove("hidden");

            document.getElementById("college-check-another-btn")?.addEventListener("click", () => {
              resultOutput.classList.add("hidden");
              resultForm.classList.remove("hidden");
              if (rollInput) {
                rollInput.value = "";
                rollInput.focus();
              }
            });

          } else {
            resultError?.classList.remove("hidden");
            if (errorTitle) errorTitle.textContent = "Result Lookup Failed";
            if (errorDesc) errorDesc.textContent = data?.error || "We could not locate this roll number in AKTU records. Confirm the roll number and try again.";
          }
        } catch (err) {
          clearInterval(interval);
          resultLoader?.classList.add("hidden");
          resultError?.classList.remove("hidden");
          if (errorTitle) errorTitle.textContent = "Network Gateway Error";
          if (errorDesc) errorDesc.textContent = "Could not communicate with the AKTU server. Please check your internet connection.";
        }
      };

      resultForm?.addEventListener("submit", (e) => {
        e.preventDefault();
        const roll = rollInput?.value.trim();
        handleResultSearch(roll);
      });

      // 3. Class Roster Combobox Dropdown Helper
      const setupCombobox = (comboboxId, searchInputId, hiddenInputId, dropdownId, listId, isSearchable) => {
        const combobox = document.getElementById(comboboxId);
        const searchInput = document.getElementById(searchInputId);
        const hiddenInput = document.getElementById(hiddenInputId);
        const dropdown = document.getElementById(dropdownId);
        const list = document.getElementById(listId);
        if (!combobox || !searchInput || !hiddenInput || !dropdown || !list) return;

        const items = Array.from(list.querySelectorAll("button"));

        const openDropdown = () => {
          dropdown.classList.remove("hidden");
          items.forEach(item => item.classList.remove("hidden"));
        };
        searchInput.addEventListener("focus", openDropdown);
        searchInput.addEventListener("click", openDropdown);

        if (isSearchable) {
          searchInput.addEventListener("input", () => {
            const query = searchInput.value.trim().toLowerCase();
            dropdown.classList.remove("hidden");
            
            items.forEach(item => {
              const name = item.getAttribute("data-name") ? item.getAttribute("data-name").toLowerCase() : "";
              const code = item.getAttribute("data-code") ? item.getAttribute("data-code").toLowerCase() : "";
              const labelText = item.textContent.trim().toLowerCase();
              if (name.includes(query) || code.includes(query) || labelText.includes(query)) {
                item.classList.remove("hidden");
              } else {
                item.classList.add("hidden");
              }
            });
          });
        }

        list.addEventListener("click", (e) => {
          const itemBtn = e.target.closest("button");
          if (!itemBtn) return;

          const val = itemBtn.getAttribute("data-code") || itemBtn.getAttribute("data-value") || itemBtn.textContent.trim();
          const displayName = itemBtn.getAttribute("data-name") || itemBtn.textContent.trim();

          hiddenInput.value = val;
          searchInput.value = displayName;
          hiddenInput.dispatchEvent(new Event("change"));
          dropdown.classList.add("hidden");
        });

        document.addEventListener("click", (e) => {
          if (!combobox.contains(e.target)) {
            dropdown.classList.add("hidden");
            if (!hiddenInput.value) {
              searchInput.value = "";
            } else {
              const activeItem = items.find(item => (item.getAttribute("data-code") || item.getAttribute("data-value")) === hiddenInput.value);
              if (activeItem) {
                searchInput.value = activeItem.getAttribute("data-name") || activeItem.textContent.trim();
              }
            }
          }
        });
      };

      // Initialize Year and Branch comboboxes
      setupCombobox("home-year-combobox", "home-year-search", "home-finder-year", "home-year-dropdown", "home-year-list", false);
      setupCombobox("home-branch-combobox", "home-branch-search", "home-finder-branch", "home-branch-dropdown", "home-branch-list", true);

      // Captcha Generator for Roster Search
      const generateHomeFinderCaptcha = () => {
        const num1 = Math.floor(Math.random() * 9) + 1;
        const num2 = Math.floor(Math.random() * 9) + 1;
        const el1 = document.getElementById("home-finder-captcha-num1");
        const el2 = document.getElementById("home-finder-captcha-num2");
        if (el1 && el2) {
          el1.textContent = num1;
          el2.textContent = num2;
        }
        return num1 + num2;
      };
      let expectedHomeFinderCaptchaSum = generateHomeFinderCaptcha();

      const homeFinderForm = document.getElementById("home-finder-form");
      const homeFinderLoader = document.getElementById("home-finder-loader-state");
      const homeFinderOutput = document.getElementById("home-finder-output");

      homeFinderForm?.addEventListener("submit", async (e) => {
        e.preventDefault();
        
        const captchaAnsInput = document.getElementById("home-finder-captcha-answer");
        const captchaAns = parseInt(captchaAnsInput?.value.trim(), 10);
        if (captchaAns !== expectedHomeFinderCaptchaSum) {
          alert("Incorrect Captcha Answer. Please try again.");
          expectedHomeFinderCaptchaSum = generateHomeFinderCaptcha();
          if (captchaAnsInput) captchaAnsInput.value = "";
          return;
        }

        const yearVal = document.getElementById("home-finder-year").value;
        const collegeVal = document.getElementById("home-finder-college").value;
        const branchVal = document.getElementById("home-finder-branch").value;
        const nameVal = document.getElementById("home-finder-name").value.trim();

        if (!yearVal || !collegeVal || !branchVal) {
          alert("Please select Admission Year, College, and Branch.");
          return;
        }

        homeFinderForm.classList.add("hidden");
        homeFinderLoader.classList.remove("hidden");
        homeFinderOutput.classList.add("hidden");

        const loadingSub = document.getElementById("home-finder-loading-substatus");
        
        const stages = [
          "Connecting to AKTU ERP portals...",
          "Authenticating session tokens...",
          "Querying database records...",
          "Compiling matching student details..."
        ];
        let stageIdx = 0;
        if (loadingSub) loadingSub.textContent = stages[stageIdx++];
        const interval = setInterval(() => {
          if (loadingSub && stageIdx < stages.length) {
            loadingSub.textContent = stages[stageIdx++];
          }
        }, 800);

        try {
          const res = await fetch('/api/find-roll', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              admissionYear: yearVal,
              collegeCode: collegeVal,
              branchCode: branchVal,
              name: nameVal
            })
          });

          clearInterval(interval);
          homeFinderLoader.classList.add("hidden");
          homeFinderOutput.classList.remove("hidden");
          homeFinderOutput.innerHTML = "";

          if (!res.ok) {
            throw new Error("Server error");
          }

          const data = await res.json();
          if (!data || !data.success) {
            homeFinderOutput.innerHTML = `
              <div class="p-4 rounded-xl border border-rose-500/20 bg-rose-500/5 text-rose-400 text-xs text-center">
                ${data.error || "No student details found. Check parameters."}
              </div>
              <button type="button" id="home-finder-retry-btn" class="w-full py-2.5 bg-white/[0.05] hover:bg-white/[0.1] text-white text-xs font-semibold rounded-lg mt-2 cursor-pointer transition-all">Retry Search</button>
            `;
            document.getElementById("home-finder-retry-btn")?.addEventListener("click", () => {
              homeFinderOutput.classList.add("hidden");
              homeFinderForm.classList.remove("hidden");
              expectedHomeFinderCaptchaSum = generateHomeFinderCaptcha();
              if (captchaAnsInput) captchaAnsInput.value = "";
            });
            return;
          }

          let html = "";

          // Display Roll Range
          html += `
            <div class="p-4 rounded-xl border border-white/[0.08] light:border-gray-200 bg-white/[0.03] light:bg-gray-50 space-y-2 text-left">
              <div class="text-[10px] uppercase font-bold text-gray-400 light:text-gray-500 tracking-wider">Class Roll Range</div>
              <div class="flex justify-between items-center text-xs">
                <div>Start: <span class="font-mono font-bold text-white light:text-ink">${data.rangeStart}</span></div>
                <div>End: <span class="font-mono font-bold text-white light:text-ink">${data.rangeEnd}</span></div>
              </div>
              <p class="text-[10px] text-gray-400 light:text-gray-600 leading-relaxed mt-1">Found ${data.matches ? data.matches.length : 0} matching students.</p>
            </div>
          `;

          // Display matches if any
          if (data.matches && data.matches.length > 0) {
            html += `
              <div class="space-y-2 text-left">
                <div class="text-[10px] uppercase font-bold text-gray-400 light:text-gray-500 tracking-wider">Matched Students</div>
                <div class="max-h-60 overflow-y-auto border border-white/[0.08] light:border-gray-200 rounded-xl divide-y divide-white/[0.05] light:divide-gray-100 bg-black/20 light:bg-white">
            `;
            data.matches.forEach((m) => {
              html += `
                <div class="p-3 flex justify-between items-center hover:bg-white/[0.02] light:hover:bg-gray-50 transition-all">
                  <div class="space-y-0.5">
                    <div class="text-xs font-bold text-white light:text-ink">${m.name}</div>
                    <div class="text-[10px] text-gray-400 light:text-gray-500 font-mono">${m.rollNumber}</div>
                  </div>
                  <div class="flex items-center gap-1.5">
                    <button 
                      type="button" 
                      class="check-roster-result-btn px-2.5 py-1 bg-emerald-600 hover:bg-emerald-500 text-white text-[9px] font-bold rounded cursor-pointer transition-colors"
                      data-roll="${m.rollNumber}"
                    >
                      ⚡ Check Result
                    </button>
                    <button 
                      type="button" 
                      class="copy-roll-btn px-2 py-1 bg-white/10 light:bg-gray-100 hover:bg-white/20 light:hover:bg-gray-200 text-white light:text-gray-800 text-[9px] font-bold rounded cursor-pointer transition-colors"
                      data-roll="${m.rollNumber}"
                    >
                      Copy
                    </button>
                  </div>
                </div>
              `;
            });
            html += `
                </div>
              </div>
            `;
          }

          html += `
            <button type="button" id="home-finder-new-search-btn" class="w-full py-3 bg-white/[0.05] hover:bg-white/[0.1] light:bg-gray-100 light:hover:bg-gray-200 text-white light:text-gray-800 text-xs font-semibold rounded-xl transition-all cursor-pointer">Start New Search</button>
          `;

          homeFinderOutput.innerHTML = html;

          // Copy Button listener
          const copyButtons = homeFinderOutput.querySelectorAll(".copy-roll-btn");
          copyButtons.forEach((btn) => {
            btn.addEventListener("click", () => {
              const roll = btn.getAttribute("data-roll");
              if (roll) {
                navigator.clipboard.writeText(roll).then(() => {
                  btn.textContent = "Copied!";
                  btn.classList.add("bg-emerald-600", "text-white");
                  setTimeout(() => {
                    btn.textContent = "Copy";
                    btn.classList.remove("bg-emerald-600");
                  }, 1500);
                });
              }
            });
          });

          // Check Result from roster listener
          const checkButtons = homeFinderOutput.querySelectorAll(".check-roster-result-btn");
          checkButtons.forEach((btn) => {
            btn.addEventListener("click", () => {
              const roll = btn.getAttribute("data-roll");
              if (roll) {
                activateTab("result");
                if (rollInput) {
                  rollInput.value = roll;
                }
                handleResultSearch(roll);
              }
            });
          });

          // Reset button listener
          document.getElementById("home-finder-new-search-btn")?.addEventListener("click", () => {
            homeFinderOutput.classList.add("hidden");
            homeFinderForm.classList.remove("hidden");
            expectedHomeFinderCaptchaSum = generateHomeFinderCaptcha();
            if (captchaAnsInput) captchaAnsInput.value = "";
          });

        } catch (err) {
          clearInterval(interval);
          homeFinderLoader.classList.add("hidden");
          homeFinderOutput.classList.remove("hidden");
          homeFinderOutput.innerHTML = `
            <div class="p-4 rounded-xl border border-rose-500/20 bg-rose-500/5 text-rose-400 text-xs text-center">
              Network error occurred. Please verify your connection and try again.
            </div>
            <button type="button" id="home-finder-retry-btn" class="w-full py-2.5 bg-white/[0.05] hover:bg-white/[0.1] text-white text-xs font-semibold rounded-lg mt-2 cursor-pointer transition-all">Retry Search</button>
          `;
          document.getElementById("home-finder-retry-btn")?.addEventListener("click", () => {
            homeFinderOutput.classList.add("hidden");
            homeFinderForm.classList.remove("hidden");
            expectedHomeFinderCaptchaSum = generateHomeFinderCaptcha();
            if (captchaAnsInput) captchaAnsInput.value = "";
          });
        }
      });
    });
  </script>
</Layout>
