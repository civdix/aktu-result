---
export const prerender = false;

import Layout from "../../layouts/Layout.astro";
import colleges from "../../data/colleges.json";
import branches from "../../data/branches.json";
import aktuColleges from "../../data/AKTUCollege.json";
import { slugifyCollege, findCollegeBySlug } from "../../utils/slugify";
import { getCollegeWebsiteInfo } from "../../utils/collegeWebsite";

const { slug } = Astro.params;
const rawCollege = Astro.props.college || (slug ? findCollegeBySlug(slug, colleges) : null);

if (!rawCollege) {
  return Astro.redirect("/colleges", 302);
}

const college = rawCollege;
const canonicalSlug = slugifyCollege(college.name, college.code);

// Match with detailed metadata from AKTUCollege.json
const detail = aktuColleges.find((a: any) => 
  (college.CGId && a.CGId === college.CGId) || 
  (college.CGCode && a.CGCode && a.CGCode.toUpperCase() === college.CGCode.toUpperCase()) ||
  (a.CGCode && a.CGCode.replace(/^AK/i, '').replace(/^0+/, '') === college.code.replace(/^0+/, ''))
);

const collegeAddress = detail?.CGAddress || `${college.name}, Uttar Pradesh`;
const collegePincode = detail?.CGPincode || "";

// Resolve official website details and ERP links
const websiteInfo = getCollegeWebsiteInfo(college.code, college.name, college.CGId);

// If client requests JSON or ?format=json, return college details as JSON API response
const acceptHeader = Astro.request.headers.get("accept") || "";
const requestUrl = new URL(Astro.request.url);
if (acceptHeader.includes("application/json") || requestUrl.searchParams.get("format") === "json") {
  return new Response(
    JSON.stringify({
      success: true,
      college: {
        code: college.code,
        name: college.name,
        CGId: college.CGId,
        CGCode: college.CGCode,
        slug: canonicalSlug,
        address: collegeAddress,
        pincode: collegePincode,
        website: websiteInfo.url,
        isWebsiteVerified: websiteInfo.isVerified,
        displayUrl: websiteInfo.displayUrl,
        erpUrl: websiteInfo.erpUrl
      }
    }),
    {
      status: 200,
      headers: { "Content-Type": "application/json" }
    }
  );
}

const sortedBranches = [...branches].sort((a, b) => a.name.localeCompare(b.name));

const siteUrl = "https://akturesult.bond";
const pageUrl = `${siteUrl}/college/${canonicalSlug}`;

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "CollegeOrUniversity",
      "@id": `${pageUrl}#college`,
      "name": college.name,
      "alternateName": [`AKTU Code ${college.code}`, college.CGCode || `AK${college.code}`],
      "identifier": college.code,
      "url": websiteInfo.url,
      "sameAs": [
        websiteInfo.url,
        websiteInfo.erpUrl,
        "https://aktu.ac.in"
      ],
      "address": {
        "@type": "PostalAddress",
        "streetAddress": collegeAddress,
        ...(collegePincode ? { "postalCode": collegePincode } : {}),
        "addressRegion": "Uttar Pradesh",
        "addressCountry": "IN"
      },
      "parentOrganization": {
        "@type": "EducationalOrganization",
        "name": "Dr. A.P.J. Abdul Kalam Technical University",
        "alternateName": "AKTU Lucknow",
        "url": "https://aktu.ac.in"
      }
    },
    {
      "@type": "WebPage",
      "@id": pageUrl,
      "url": pageUrl,
      "name": `${college.name} AKTU Result 2026 - Check Marksheet Without DOB`,
      "description": `Check official AKTU semester results, marksheet, official college website (${websiteInfo.displayUrl}), and student roll numbers for ${college.name} (Code: ${college.code}).`,
      "isPartOf": {
        "@type": "WebSite",
        "@id": `${siteUrl}#website`,
        "name": "AKTU Result Without DOB",
        "url": siteUrl
      },
      "breadcrumb": {
        "@type": "BreadcrumbList",
        "itemListElement": [
          {
            "@type": "ListItem",
            "position": 1,
            "name": "Home",
            "item": siteUrl
          },
          {
            "@type": "ListItem",
            "position": 2,
            "name": "Colleges",
            "item": `${siteUrl}/colleges`
          },
          {
            "@type": "ListItem",
            "position": 3,
            "name": college.name,
            "item": pageUrl
          }
        ]
      }
    },
    {
      "@type": "FAQPage",
      "@id": `${pageUrl}#faq`,
      "mainEntity": [
        {
          "@type": "Question",
          "name": `How to check AKTU Result for ${college.name} without Date of Birth?`,
          "acceptedAnswer": {
            "@type": "Answer",
            "text": `Students of ${college.name} can check their AKTU OneView semester results instantly without Date of Birth by entering their 10-13 digit University Roll Number on this page or the AKTU Result Without DOB portal.`
          }
        },
        {
          "@type": "Question",
          "name": `What is the official website of ${college.name} and AKTU institute code?`,
          "acceptedAnswer": {
            "@type": "Answer",
            "text": `The official AKTU institute code for ${college.name} is ${college.code} (ERP Code: ${college.CGCode || `AK${college.code}`}). The official college website is accessible at ${websiteInfo.url} and the university ERP portal profile is at ${websiteInfo.erpUrl}.`
          }
        },
        {
          "@type": "Question",
          "name": `How to find student roll numbers for ${college.name} by name?`,
          "acceptedAnswer": {
            "@type": "Answer",
            "text": `To find student roll numbers at ${college.name}, select the admission year and branch, type the student name, solve the simple math verification, and view the class student roster.`
          }
        },
        {
          "@type": "Question",
          "name": `Where can students of ${college.name} download their AKTU marksheet PDF?`,
          "acceptedAnswer": {
            "@type": "Answer",
            "text": `After verifying their academic record on our portal, students of ${college.name} can download their official OneView PDF marksheet or access their digital marksheet directly via Telegram Bot (@akturesultwithoutdobbot).`
          }
        },
        {
          "@type": "Question",
          "name": `What are the passing criteria and grace marks policy for ${college.name}?`,
          "acceptedAnswer": {
            "@type": "Answer",
            "text": `As per AKTU academic guidelines, students of ${college.name} must secure at least 30% in university end-semester theory examinations and 40% aggregate (Theory + Internal) per subject. Up to 7-10 grace marks are awarded annually under statutory rules to clear semester status.`
          }
        }
      ]
    }
  ]
};

const collegeKeywords = `${college.name} aktu result, aktu result for ${college.name}, ${college.name} result without dob, ${college.name} result 2026, ${college.name} one view, aktu one view ${college.name}, ${college.name} college code ${college.code}, ${college.name} website, official website of ${college.name}, ${college.name} roll number finder, find aktu roll number of ${college.name}, ${college.name} semester marksheet, aktu odd sem result ${college.name}, aktu even sem result ${college.name}`;
---

<Layout 
  title={`${college.name} AKTU Result 2026 - Check Online Without DOB (Code ${college.code})`}
  description={`Check ${college.name} (Code ${college.code}) AKTU results online without Date of Birth. View One View semester scorecards, official college website (${websiteInfo.displayUrl}), and student roll number finder.`}
  keywords={collegeKeywords}
  jsonLd={jsonLd}
>
  <!-- Hero Section -->
  <section class="relative pb-12 md:pb-16 overflow-hidden border-b border-canvas-dark-border light:border-canvas-light-border bg-gradient-to-b from-black via-canvas-dark-surface to-black light:from-white light:via-canvas-light-surface light:to-white transition-colors duration-300">
    <!-- Ambient Glows -->
    <div class="absolute top-[-10%] left-[-10%] w-[550px] h-[550px] rounded-full bg-brand-blue/8 blur-[120px] pointer-events-none animate-pulse" style="animation-duration: 8s;"></div>
    <div class="absolute bottom-[10%] right-[-10%] w-[500px] h-[500px] rounded-full bg-purple-500/5 blur-[130px] pointer-events-none animate-pulse" style="animation-duration: 12s;"></div>

    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <!-- Breadcrumbs -->
      <nav class="flex items-center gap-2 py-4 text-[10px] text-gray-500 font-mono">
        <a href="/" class="hover:text-white light:hover:text-ink transition-colors">Home</a>
        <span>/</span>
        <a href="/colleges" class="hover:text-white light:hover:text-ink transition-colors">Colleges</a>
        <span>/</span>
        <span class="text-brand-blue font-bold">{college.code}</span>
      </nav>

      <div id="hero-grid" class="grid grid-cols-1 md:grid-cols-12 gap-8 md:gap-12 items-start min-h-[500px] transition-all duration-500">
        
        <!-- Left Side: Copywriting & Primary College Information -->
        <div id="hero-copy" class="md:col-span-7 text-center md:text-left space-y-6 transition-all duration-500">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-white/[0.08] light:border-black/[0.06] bg-white/[0.03] light:bg-white/40 backdrop-blur-md text-xs text-gray-400 light:text-gray-600 premium-shadow-light">
            <span class="w-1.5 h-1.5 rounded-full bg-brand-blue animate-pulse"></span>
            <span>🏛️ AKTU Affiliated Institute • Code {college.code}</span>
          </div>

          <h1 class="text-2xl sm:text-3xl md:text-4xl lg:text-5xl font-extrabold tracking-tight leading-[1.1] text-white light:text-ink">
            <span class="bg-gradient-to-r from-brand-blue via-brand-blue-light to-purple-500 bg-clip-text text-transparent">{college.name}</span> <br />
            AKTU Result 2026
          </h1>

          <p class="text-xs sm:text-sm md:text-base text-gray-400 light:text-gray-600 leading-relaxed max-w-xl">
            Check semester examination results, OneView marksheet, and SGPA/CGPA for <strong>{college.name}</strong> (College Code: <strong>{college.code}</strong>) without Date of Birth. Access official college website, find forgotten roll numbers by name, and explore class rosters.
          </p>

          <!-- Quick Official Resource Action Links -->
          <div class="flex flex-wrap gap-2.5 pt-1 justify-center md:justify-start">
            <a 
              href={websiteInfo.url} 
              target="_blank" 
              rel="noopener noreferrer" 
              class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl bg-brand-blue/10 light:bg-blue-50 hover:bg-brand-blue/20 light:hover:bg-blue-100 text-brand-blue text-xs font-bold border border-brand-blue/25 light:border-blue-200 transition-all shadow-xs"
              title={`Visit official website of ${college.name}`}
            >
              <span>🌐 {websiteInfo.isVerified ? `Website: ${websiteInfo.displayUrl}` : "Official College Website"}</span>
              <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
              </svg>
            </a>

            <a 
              href={websiteInfo.erpUrl} 
              target="_blank" 
              rel="noopener noreferrer" 
              class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl bg-purple-500/10 light:bg-purple-50 hover:bg-purple-500/20 light:hover:bg-purple-100 text-purple-400 light:text-purple-700 text-xs font-bold border border-purple-500/25 light:border-purple-200 transition-all shadow-xs"
              title="View AKTU ERP official college affiliation profile"
            >
              <span>🏛️ AKTU ERP Profile (Code {college.code})</span>
              <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
              </svg>
            </a>

            <a 
              href="https://oneview.aktu.ac.in" 
              target="_blank" 
              rel="noopener noreferrer" 
              class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl bg-emerald-500/10 light:bg-emerald-50 hover:bg-emerald-500/20 light:hover:bg-emerald-100 text-emerald-400 light:text-emerald-700 text-xs font-bold border border-emerald-500/25 light:border-emerald-200 transition-all shadow-xs"
              title="AKTU One View portal"
            >
              <span>📄 Official OneView Portal</span>
              <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
              </svg>
            </a>
          </div>

          <!-- SEO Keywords Bar -->
          <div class="p-4 rounded-xl border border-canvas-dark-border light:border-canvas-light-border bg-canvas-dark-tile/50 light:bg-gray-50 text-xs space-y-2">
            <h3 class="font-bold text-white light:text-ink flex items-center gap-2">
              <span class="text-brand-blue">⚡</span>
              <span>Popular Searches for {college.name}:</span>
            </h3>
            <div class="flex flex-wrap gap-1.5 text-[11px] text-gray-400 light:text-gray-600 font-mono">
              <span class="px-2 py-0.5 rounded bg-black/40 light:bg-white border border-white/5 light:border-gray-200">{college.name} aktu result</span>
              <span class="px-2 py-0.5 rounded bg-black/40 light:bg-white border border-white/5 light:border-gray-200">{college.name} result without dob</span>
              <span class="px-2 py-0.5 rounded bg-black/40 light:bg-white border border-white/5 light:border-gray-200">{college.name} one view</span>
              <span class="px-2 py-0.5 rounded bg-black/40 light:bg-white border border-white/5 light:border-gray-200">college code {college.code}</span>
              <span class="px-2 py-0.5 rounded bg-black/40 light:bg-white border border-white/5 light:border-gray-200">{college.name} website</span>
            </div>
          </div>
        </div>

        <!-- Right Side: Interactive Result & Roster Dual Tab Hub -->
        <div id="hero-card-wrapper" class="md:col-span-5 w-full max-w-lg mx-auto relative group transition-all duration-500">
          <div class="absolute -inset-1.5 bg-gradient-to-r from-brand-blue to-purple-600 rounded-2xl blur-xl opacity-20 group-hover:opacity-35 transition duration-1000 group-hover:duration-200"></div>
          
          <div class="relative iphone-glass p-5 sm:p-7 rounded-2xl transition-all duration-300 text-left light:bg-white light:border-gray-200 light:shadow-xl">
            
            <!-- Navigation Tabs: Result Checker (Primary) & Roll Finder -->
            <div class="flex items-center gap-1 p-1 bg-black/40 light:bg-gray-100 rounded-xl mb-5 border border-white/5 light:border-gray-200">
              <button 
                type="button" 
                id="college-tab-result-btn" 
                class="flex-1 py-2 px-3 rounded-lg text-xs font-bold transition-all text-center flex items-center justify-center gap-1.5 bg-brand-blue text-white shadow cursor-pointer"
              >
                <span>⚡ Check Result</span>
              </button>
              <button 
                type="button" 
                id="college-tab-roster-btn" 
                class="flex-1 py-2 px-3 rounded-lg text-xs font-bold transition-all text-center flex items-center justify-center gap-1.5 text-gray-400 light:text-gray-600 hover:text-white light:hover:text-ink cursor-pointer"
              >
                <span>👥 Find Roll by Name</span>
              </button>
            </div>

            <!-- PANEL 1: Check AKTU Result (Primary Flow) -->
            <div id="college-panel-result" class="space-y-4">
              <div class="space-y-1">
                <h2 class="text-sm font-bold text-white light:text-ink flex items-center gap-2">
                  <span>Check {college.name} Result</span>
                </h2>
                <p class="text-xs text-gray-400 light:text-gray-600">
                  Instant OneView semester scorecard without Date of Birth.
                </p>
              </div>

              <form id="college-result-form" class="space-y-4">
                <div>
                  <label for="college-roll-input" class="block text-xs font-semibold text-gray-400 light:text-gray-500 uppercase tracking-wider mb-2">
                    Enter University Roll Number
                  </label>
                  <input 
                    type="text" 
                    id="college-roll-input" 
                    placeholder={`e.g. 2100${college.code.padStart(3, '0')}10001`} 
                    maxlength="14"
                    required
                    autocomplete="off"
                    class="w-full px-4 py-3 bg-white/[0.03] light:bg-gray-50 border border-white/[0.1] light:border-gray-300 rounded-xl text-white light:text-ink font-mono text-sm tracking-wider focus:outline-none focus:border-brand-blue focus:ring-1 focus:ring-brand-blue transition-all"
                  />
                  <span class="block text-[10px] text-gray-500 mt-1.5">
                    💡 Tip: Roll numbers for this college typically contain institute code <strong>'{college.code.padStart(3, '0')}'</strong>.
                  </span>
                </div>

                <button 
                  type="submit" 
                  id="college-result-submit-btn" 
                  class="w-full py-3.5 bg-gradient-to-r from-brand-blue to-purple-600 hover:from-brand-blue-hover hover:to-purple-700 text-white text-xs sm:text-sm font-bold rounded-xl transition-all shadow-lg hover:shadow-brand-blue/30 cursor-pointer flex items-center justify-center gap-2"
                >
                  <span>Check {college.name} Result</span>
                  <span>&rarr;</span>
                </button>

                <div class="text-center pt-1">
                  <button 
                    type="button" 
                    id="switch-to-roster-btn" 
                    class="text-xs text-brand-blue hover:underline cursor-pointer font-medium"
                  >
                    Don't know your roll number? Find it by Name & Branch &rarr;
                  </button>
                </div>
              </form>

              <!-- Result Loader State -->
              <div id="college-result-loader" class="hidden py-8 text-center space-y-3">
                <div class="w-10 h-10 border-3 border-brand-blue/20 border-t-brand-blue rounded-full animate-spin mx-auto"></div>
                <div class="space-y-1">
                  <div class="text-xs font-bold text-white light:text-ink" id="college-result-loading-title">Connecting to AKTU Gateway...</div>
                  <div class="text-[11px] text-gray-400 light:text-gray-500" id="college-result-loading-sub">Authenticating student record for code {college.code}...</div>
                </div>
              </div>

              <!-- Result Output Display -->
              <div id="college-result-output" class="hidden space-y-4"></div>

              <!-- Result Error Display -->
              <div id="college-result-error" class="hidden space-y-3 animate-fade-in">
                <div class="p-4 rounded-xl bg-red-500/10 border border-red-500/20 text-center space-y-1">
                  <div class="text-red-400 font-bold text-xs" id="college-error-title">No Academic Record Found</div>
                  <p class="text-gray-400 light:text-gray-600 text-[11px]" id="college-error-desc">Please verify that the 10-13 digit roll number belongs to {college.name}.</p>
                </div>
                <button 
                  type="button" 
                  id="college-result-retry-btn" 
                  class="w-full py-2.5 bg-gray-900 light:bg-gray-100 hover:bg-gray-800 light:hover:bg-gray-200 border border-white/10 light:border-gray-200 text-white light:text-ink text-xs font-semibold rounded-xl transition-all cursor-pointer"
                >
                  Retry Search
                </button>
              </div>
            </div>

            <!-- PANEL 2: Find Roll Number by Name (Roster Search Flow) -->
            <div id="college-panel-roster" class="hidden space-y-6">
              <div class="space-y-1">
                <h2 class="text-sm font-bold text-white light:text-ink">
                  Find Student Roll Number by Name
                </h2>
                <p class="text-xs text-gray-400 light:text-gray-600">
                  Search student lists and class rosters for {college.name}.
                </p>
              </div>

              <form id="home-finder-form" class="space-y-4">
                <!-- Admission Year -->
                <div class="relative" id="home-year-combobox">
                  <label class="block text-xs font-semibold text-gray-400 light:text-gray-500 uppercase tracking-wider mb-2">
                    Admission Year
                  </label>
                  <div class="relative">
                    <input 
                      type="text" 
                      id="home-year-search" 
                      placeholder="Select Year"
                      readonly
                      required
                      class="w-full px-4 py-3 bg-white/[0.03] light:bg-gray-50 border border-white/[0.08] light:border-gray-300 rounded-xl text-white light:text-ink placeholder-gray-500 focus:outline-none focus:border-brand-blue focus:ring-1 focus:ring-brand-blue transition-all pr-10 cursor-pointer text-xs"
                    />
                    <input type="hidden" id="home-finder-year" name="admissionYear" />
                    <div class="absolute inset-y-0 right-0 flex items-center pr-3 pointer-events-none text-gray-500">
                      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                      </svg>
                    </div>
                  </div>
                  <!-- Dropdown Options List -->
                  <div 
                    id="home-year-dropdown" 
                    class="hidden absolute z-50 w-full mt-1 bg-[#121212]/95 light:bg-white/95 backdrop-blur-md border border-white/[0.1] light:border-gray-200 rounded-xl shadow-2xl max-h-60 overflow-y-auto"
                  >
                    <div class="p-1 space-y-0.5" id="home-year-list">
                      <button type="button" data-value="2025" class="w-full text-left px-3 py-2.5 rounded-lg text-xs text-gray-300 light:text-gray-700 hover:bg-brand-blue hover:text-white light:hover:bg-brand-blue light:hover:text-white transition-all cursor-pointer">2025</button>
                      <button type="button" data-value="2024" class="w-full text-left px-3 py-2.5 rounded-lg text-xs text-gray-300 light:text-gray-700 hover:bg-brand-blue hover:text-white light:hover:bg-brand-blue light:hover:text-white transition-all cursor-pointer">2024</button>
                      <button type="button" data-value="2023" class="w-full text-left px-3 py-2.5 rounded-lg text-xs text-gray-300 light:text-gray-700 hover:bg-brand-blue hover:text-white light:hover:bg-brand-blue light:hover:text-white transition-all cursor-pointer">2023</button>
                      <button type="button" data-value="2022" class="w-full text-left px-3 py-2.5 rounded-lg text-xs text-gray-300 light:text-gray-700 hover:bg-brand-blue hover:text-white light:hover:bg-brand-blue light:hover:text-white transition-all cursor-pointer">2022</button>
                      <button type="button" data-value="2021" class="w-full text-left px-3 py-2.5 rounded-lg text-xs text-gray-300 light:text-gray-700 hover:bg-brand-blue hover:text-white light:hover:bg-brand-blue light:hover:text-white transition-all cursor-pointer">2021</button>
                      <button type="button" data-value="2020" class="w-full text-left px-3 py-2.5 rounded-lg text-xs text-gray-300 light:text-gray-700 hover:bg-brand-blue hover:text-white light:hover:bg-brand-blue light:hover:text-white transition-all cursor-pointer">2020</button>
                      <button type="button" data-value="2019" class="w-full text-left px-3 py-2.5 rounded-lg text-xs text-gray-300 light:text-gray-700 hover:bg-brand-blue hover:text-white light:hover:bg-brand-blue light:hover:text-white transition-all cursor-pointer">2019</button>
                      <button type="button" data-value="2018" class="w-full text-left px-3 py-2.5 rounded-lg text-xs text-gray-300 light:text-gray-700 hover:bg-brand-blue hover:text-white light:hover:bg-brand-blue light:hover:text-white transition-all cursor-pointer">2018</button>
                    </div>
                  </div>
                </div>

                <!-- College (Prefilled & Readonly) -->
                <div>
                  <label class="block text-xs font-semibold text-gray-400 light:text-gray-500 uppercase tracking-wider mb-2">
                    College / Institute
                  </label>
                  <input 
                    type="text" 
                    id="home-college-search" 
                    value={`${college.name} (${college.code})`}
                    readonly
                    class="w-full px-4 py-3 bg-white/[0.03] light:bg-gray-100 border border-white/[0.08] light:border-gray-300 rounded-xl text-white light:text-ink text-xs focus:outline-none cursor-not-allowed opacity-80"
                  />
                  <input type="hidden" id="home-finder-college" name="collegeCode" value={college.code} />
                </div>

