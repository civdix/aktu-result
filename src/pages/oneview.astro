        if (adCountdownInterval) {
          clearInterval(adCountdownInterval);
          adCountdownInterval = null;
        }
        const adInterstitial = document.getElementById("oneview-ad-interstitial-state");
        if (adInterstitial) adInterstitial.classList.add("hidden");

        searchForm?.classList.remove("hidden");
        loaderState?.classList.add("hidden");
        if (captchaContainer) {
          captchaContainer.classList.add("hidden");
          captchaContainer.innerHTML = "";
        }
        if (profileContainer) {
          profileContainer.classList.add("hidden");
          profileContainer.innerHTML = "";
        }
        errorState?.classList.add("hidden");

        log1?.classList.add("hidden");
        log2?.classList.add("hidden");
        log3?.classList.add("hidden");
        log4?.classList.add("hidden");

        if (rollInput) {
          rollInput.value = "";
          rollInput.focus();
        }
      }

      retryBtn?.addEventListener("click", resetUI);

      let adCountdownInterval = null;

      function showOneViewAdInterstitialThen(data, onProceed) {
        loaderState?.classList.add("hidden");
        searchForm?.classList.add("hidden");
        errorState?.classList.add("hidden");
        if (captchaContainer) {
          captchaContainer.classList.add("hidden");
          captchaContainer.innerHTML = "";
        }
        if (profileContainer) {
          profileContainer.classList.add("hidden");
          profileContainer.innerHTML = "";
        }

        const interstitial = document.getElementById("oneview-ad-interstitial-state");
        if (!interstitial) {
          onProceed();
          return;
        }

        interstitial.classList.remove("hidden");
        try {
          (window.adsbygoogle = window.adsbygoogle || []).push({});
        } catch (e) {}

        let timeLeft = 5;
        const countdownText = document.getElementById("oneview-ad-countdown-text");
        const progressBar = document.getElementById("oneview-ad-progress-bar");
        if (countdownText) countdownText.textContent = `${timeLeft}s`;
        if (progressBar) progressBar.style.width = "0%";

        if (adCountdownInterval) clearInterval(adCountdownInterval);

        let finished = false;
        const finishAndShow = () => {
          if (finished) return;
          finished = true;
          if (adCountdownInterval) {
            clearInterval(adCountdownInterval);
            adCountdownInterval = null;
          }
          interstitial.classList.add("hidden");
          onProceed();
          try {
            (window.adsbygoogle = window.adsbygoogle || []).push({});
          } catch (e) {}
        };

        adCountdownInterval = setInterval(() => {
          timeLeft--;
          const pct = Math.min(100, Math.round(((5 - timeLeft) / 5) * 100));
          if (progressBar) progressBar.style.width = `${pct}%`;
          if (countdownText) countdownText.textContent = `${timeLeft}s`;
          if (timeLeft <= 0) {
            finishAndShow();
          }
        }, 1000);

        const viewBtn = document.getElementById("oneview-ad-view-result-btn");
        if (viewBtn) {
          viewBtn.onclick = (e) => {
            e.preventDefault();
            finishAndShow();
          };
        }
      }

