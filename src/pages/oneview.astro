---
import Layout from "../layouts/Layout.astro";
import { getAcademicYearInfo } from "../utils/academicYear";

const yearInfo = getAcademicYearInfo();

const roll = Astro.url.searchParams.get("roll") || "";
const dob = Astro.url.searchParams.get("dob") || "";
const hideDob = Astro.url.searchParams.get("hide") !== "0";

const siteUrl = "https://akturesult.bond";
const pageUrl = `${siteUrl}/oneview`;
const pageTitle = roll 
  ? `OneView AKTU Result ${yearInfo.session} - Marksheet for Roll ${roll}` 
  : `OneView AKTU Result ${yearInfo.session} - Check AKTU One View Marksheet Online`;

const pageDescription = `Access AKTU OneView Result ${yearInfo.sessionFormatted} online. View semester marks, SGPA, CGPA, back papers, and marksheet without Date of Birth using your AKTU Roll Number.`;

const oneviewKeywords = `oneview aktu, aktu oneview, aktu one view, aktu oneview result ${yearInfo.session}, aktu result ${yearInfo.session}, oneview.aktu.ac.in, aktu one view result, aktu oneview marksheet, check aktu oneview result, aktu result one view, aktu oneview login, aktu result without dob`;

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": pageUrl,
      "url": pageUrl,
      "name": `OneView AKTU Result ${yearInfo.sessionFormatted} & Marksheet Portal`,
      "description": pageDescription,
      "isPartOf": {
        "@type": "WebSite",
        "@id": `${siteUrl}/#website`,
        "name": "AKTU Result & OneView Portal",
        "url": siteUrl
      }
    },
    {
      "@type": "BreadcrumbList",
      "@id": `${pageUrl}/#breadcrumb`,
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": siteUrl
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "OneView AKTU",
          "item": pageUrl
        }
      ]
    },
    {
      "@type": "FAQPage",
      "@id": `${pageUrl}/#faq`,
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What is OneView AKTU?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "OneView AKTU (oneview.aktu.ac.in) is the unified academic records portal operated by Dr. A.P.J. Abdul Kalam Technical University, Lucknow. It consolidates all semester exam grades, internal marks, theory marks, practical scores, and back paper statuses into a single electronic marksheet."
          }
        },
        {
          "@type": "Question",
          "name": "How can I check my AKTU OneView result without Date of Birth?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "While the official university portal enforces Date of Birth verification, our automated assistant allows you to bypass the DOB requirement. Enter your University Roll Number and view your full semester marksheet immediately."
          }
        },
        {
          "@type": "Question",
          "name": "Why does OneView AKTU show 'Session Expired'?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The official AKTU ASP.NET server relies on ViewState security tokens that expire after brief idle periods or during heavy traffic spikes on result declaration days. Refreshing or using our automated assistant resolves session synchronization."
          }
        },
        {
          "@type": "Question",
          "name": "What is the difference between OneView AKTU and AKTU ERP?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "OneView AKTU is a public academic transcript portal used to view grades and marksheets with roll number and DOB. AKTU ERP (erp.aktu.ac.in) is the private student administration dashboard used for examination forms, admit card downloads, fee challans, and re-evaluation requests."
          }
        }
      ]
    }
  ]
};
---

<Layout 
  title={pageTitle}
  description={pageDescription}
  keywords={oneviewKeywords}
  jsonLd={jsonLd}
>
  <!-- Hero & Interactive OneView Island -->
  <section class="relative py-12 md:py-16 overflow-hidden border-b border-canvas-dark-border light:border-canvas-light-border bg-gradient-to-b from-black via-canvas-dark-surface to-black light:from-white light:via-canvas-light-surface light:to-white transition-colors duration-300">
    <!-- Ambient Glows -->
    <div class="absolute top-[-10%] left-[-10%] w-[500px] h-[500px] rounded-full bg-brand-blue/10 blur-[130px] pointer-events-none"></div>
    <div class="absolute bottom-[-10%] right-[-10%] w-[450px] h-[450px] rounded-full bg-purple-500/10 blur-[130px] pointer-events-none"></div>

    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 space-y-8">
      
      <!-- Top Brand Header -->
      <div class="text-center space-y-3">
        <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full border border-white/10 light:border-black/10 bg-white/5 light:bg-black/5 text-xs text-brand-blue font-semibold">
          <span class="w-2 h-2 rounded-full bg-brand-blue animate-pulse"></span>
          AKTU OneView Official Result Gateway ({yearInfo.sessionFormatted})
        </div>
        <h1 class="text-3xl sm:text-4xl md:text-5xl font-black tracking-tight bg-gradient-to-r from-white via-gray-200 to-gray-400 dark:from-white dark:via-gray-200 dark:to-gray-400 light:from-ink light:via-gray-800 light:to-gray-900 bg-clip-text text-transparent">
          OneView AKTU Result &amp; Marksheet Portal
        </h1>
        <p class="text-xs sm:text-sm text-gray-400 light:text-gray-600 max-w-xl mx-auto leading-relaxed">
          Access your complete Dr. A.P.J. Abdul Kalam Technical University semester records, SGPA, CGPA, and COP back paper status online for academic session {yearInfo.sessionFormatted}.
        </p>
      </div>

      <!-- Main Action Card with Live Background Verification Process -->
      <div class="max-w-lg mx-auto p-6 sm:p-8 rounded-2xl iphone-glass border border-white/10 light:border-black/10 space-y-5 shadow-2xl text-left">
        
        <!-- Header status -->
        <div class="flex items-center justify-between pb-2 border-b border-white/5 light:border-black/5">
          <span class="text-xs font-bold text-white light:text-ink flex items-center gap-2">
            <span>⚡</span>
            <span>Instant OneView Result Recovery</span>
          </span>
          <span class="text-[10px] text-emerald-400 bg-emerald-500/10 px-2 py-0.5 rounded-full border border-emerald-500/20 font-semibold">
            Zero DOB Required
          </span>
        </div>

        <!-- 1. Search Form -->
        <form id="oneview-search-form" class="space-y-4">
          <div>
            <label for="oneview-roll-number" class="text-[10px] uppercase font-bold text-gray-400 light:text-gray-600 tracking-wider block mb-1">
              AKTU University Roll Number
            </label>
            <input 
              type="text" 
              id="oneview-roll-number" 
              name="rollNumber" 
              value={roll}
              placeholder="e.g. 2400650100001" 
              required
              pattern="^[0-9]{10,15}$"
              class="w-full px-4 py-3 bg-white/5 light:bg-gray-100 border border-white/10 light:border-black/10 rounded-xl text-white light:text-ink font-mono text-sm placeholder-gray-500 focus:outline-none focus:border-brand-blue transition-all"
            />
            <span class="text-[10px] text-gray-500 light:text-gray-400 mt-1 block">Enter your 10 to 14 digit AKTU university roll number. No Date of Birth or password needed.</span>
          </div>

          <button 
            type="submit" 
            id="oneview-search-btn"
            class="w-full py-3.5 bg-gradient-to-r from-brand-blue via-blue-500 to-purple-600 hover:from-brand-blue-hover hover:to-purple-700 text-white text-sm font-bold rounded-xl shadow-lg transition-all transform hover:scale-[1.02] active:scale-[0.98] flex items-center justify-center gap-2 cursor-pointer"
          >
            <span>⚡ Check OneView Result</span>
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </button>
        </form>

        <!-- 2. Multi-Stage Background Process Loader -->
        <div id="oneview-loader-state" class="hidden py-6 space-y-5">
          <div class="flex flex-col items-center justify-center text-center">
            <div class="relative w-12 h-12 mb-3">
              <div class="w-12 h-12 rounded-full border-4 border-brand-blue/20 animate-spin border-t-brand-blue"></div>
            </div>
            <h3 class="text-sm font-semibold text-white light:text-ink mb-1" id="oneview-loading-status">Connecting to AKTU OneView Gateway...</h3>
            <p class="text-xs text-gray-500" id="oneview-loading-substatus">Locating session token...</p>
          </div>
          
          <!-- Animated Scraping Terminal Logs -->
          <div class="font-mono text-[10px] text-gray-600 bg-black/80 rounded-lg p-3 space-y-1 overflow-hidden h-24 border border-canvas-dark-border">
            <div class="text-gray-400">&gt; Starting OneView background process...</div>
            <div id="oneview-log-1" class="hidden text-gray-500">&gt; Fetching ASP.NET_SessionId cookie... [OK]</div>
            <div id="oneview-log-2" class="hidden text-gray-500">&gt; Extracting __VIEWSTATE encryption vector... [OK]</div>
            <div id="oneview-log-3" class="hidden text-brand-blue">&gt; Executing session bypass protocol... [OK]</div>
            <div id="oneview-log-4" class="hidden text-emerald-400">&gt; Fetching and parsing semester grades grid... [OK]</div>
          </div>
        </div>

        <!-- 3. Manual Security Verification Code Container -->
        <div id="oneview-manual-captcha-container" class="hidden space-y-4"></div>

        <!-- 4. Verified Academic Profile Container -->
        <div id="oneview-verified-profile-container" class="hidden space-y-4"></div>

        <!-- 5. Error State Card -->
        <div id="oneview-error-state" class="hidden space-y-4 animate-fade-in">
          <div class="p-4 rounded-xl bg-red-500/10 border border-red-500/20 text-center">
            <div class="w-10 h-10 rounded-full bg-red-500/20 text-red-400 flex items-center justify-center mx-auto mb-2 text-lg">✕</div>
            <h3 class="text-sm font-semibold text-red-400" id="oneview-error-title">Result Search Failed</h3>
            <p class="text-xs text-gray-400 mt-1" id="oneview-error-desc">We couldn't locate a match for the specified parameters. Please confirm the roll number.</p>
          </div>
          <button 
            type="button" 
            id="oneview-error-retry-btn" 
            class="w-full py-3 bg-gray-900 light:bg-gray-100 hover:bg-gray-800 light:hover:bg-gray-200 border border-canvas-dark-border light:border-canvas-light-border text-xs font-semibold rounded-xl text-white light:text-ink transition-colors cursor-pointer"
          >
            Retry Search
          </button>
        </div>

        <!-- External Quick Actions -->
        <div class="space-y-2 pt-2 border-t border-white/5 light:border-black/5">
          <button 
            type="button" 
            id="launch-oneview-btn" 
            class="w-full py-2.5 bg-white/5 light:bg-black/5 hover:bg-white/10 light:hover:bg-black/10 text-gray-300 light:text-gray-700 hover:text-white light:hover:text-ink rounded-xl border border-white/10 light:border-black/10 text-xs font-semibold transition-all flex items-center justify-center gap-2 cursor-pointer"
          >
            <span>🚀 Open Official oneview.aktu.ac.in</span>
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
            </svg>
          </button>

          <button 
            type="button" 
            id="copy-script-btn" 
            class="w-full py-1.5 bg-transparent text-gray-400 light:text-gray-500 hover:text-gray-200 light:hover:text-gray-800 text-[11px] font-medium transition-all flex items-center justify-center gap-1.5 cursor-pointer"
          >
            <span>⚡ Copy 1-Click Auto-Fill JavaScript</span>
          </button>
        </div>

      </div>

      <!-- Return Button -->
      <div class="text-center pt-2">
        <a href="/" class="text-xs text-brand-blue hover:underline inline-flex items-center gap-1">
          &larr; Return to AKTU Result Home Search
        </a>
      </div>

    </div>
  </section>

  <!-- Informational SEO Guide: What is OneView AKTU? -->
  <section class="py-16 border-t border-canvas-dark-border light:border-canvas-light-border bg-black light:bg-canvas-light transition-colors duration-300">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
      
      <div class="space-y-4">
        <h2 class="text-2xl sm:text-3xl font-extrabold text-white light:text-ink tracking-tight">
          What is OneView AKTU (oneview.aktu.ac.in)?
        </h2>
        <p class="text-xs sm:text-sm text-gray-400 light:text-gray-600 leading-relaxed">
          <strong>OneView AKTU</strong> is Dr. A.P.J. Abdul Kalam Technical University's official electronic student academic repository. Introduced to simplify transcript verification and eliminate physical marksheet delays, OneView offers a comprehensive, cumulative timeline of an enrolled student's performance from Semester 1 through Semester 8.
        </p>
        <p class="text-xs sm:text-sm text-gray-400 light:text-gray-600 leading-relaxed">
          Whether you are enrolled in <strong>B.Tech, B.Pharma, MBA, MCA, M.Tech, or B.Arch</strong> across any of AKTU's 750+ affiliated colleges in Uttar Pradesh, your semester results, carry over papers (COP), practical vivas, and sessional internal scores are consolidated inside the OneView database.
        </p>
      </div>

      <!-- Key Details Displayed -->
      <div class="space-y-4">
        <h3 class="text-xl font-bold text-white light:text-ink">
          Details Displayed on Your OneView AKTU Marksheet
        </h3>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs">
          <div class="p-4 rounded-xl bg-white/[0.02] light:bg-white border border-white/[0.06] light:border-black/[0.06] space-y-1">
            <span class="font-bold text-brand-blue block">1. Student Identification</span>
            <p class="text-gray-400 light:text-gray-600">Student Name, Father's Name, University Roll Number, Enrollment Number, Gender, and Category.</p>
          </div>
          <div class="p-4 rounded-xl bg-white/[0.02] light:bg-white border border-white/[0.06] light:border-black/[0.06] space-y-1">
            <span class="font-bold text-purple-400 block">2. Institutional Details</span>
            <p class="text-gray-400 light:text-gray-600">Affiliated College / Institute Name, 3-digit College Code, Course Program, and Branch Specialization.</p>
          </div>
          <div class="p-4 rounded-xl bg-white/[0.02] light:bg-white border border-white/[0.06] light:border-black/[0.06] space-y-1">
            <span class="font-bold text-emerald-400 block">3. Semester Subject Scores</span>
            <p class="text-gray-400 light:text-gray-600">Subject Code, Subject Title, Internal Sessional Marks, External Theory Marks, Practical Marks, and Grade Letters.</p>
          </div>
          <div class="p-4 rounded-xl bg-white/[0.02] light:bg-white border border-white/[0.06] light:border-black/[0.06] space-y-1">
            <span class="font-bold text-amber-400 block">4. Cumulative Metrics</span>
            <p class="text-gray-400 light:text-gray-600">Semester SGPA, Cumulative CGPA, Division Award (I-DIV / II-DIV), and Status (PASS / PWG / PCP).</p>
          </div>
        </div>
      </div>

      <!-- Common Errors and Solutions -->
      <div class="space-y-4">
        <h3 class="text-xl font-bold text-white light:text-ink">
          Common OneView AKTU Errors &amp; How to Fix Them
        </h3>
        <div class="space-y-3 text-xs">
          <div class="p-4 rounded-xl bg-black/40 light:bg-white border border-white/[0.08] light:border-black/[0.08] space-y-1.5">
            <div class="font-bold text-white light:text-ink">Error: "Date of birth does not match records"</div>
            <p class="text-gray-400 light:text-gray-600 leading-relaxed">
              This occurs when the date of birth entered does not match the admission record submitted by your college. With our assistant tool, you don't need to struggle with DOB mismatches—our session bypass resolves your record directly.
            </p>
          </div>

          <div class="p-4 rounded-xl bg-black/40 light:bg-white border border-white/[0.08] light:border-black/[0.08] space-y-1.5">
            <div class="font-bold text-white light:text-ink">Error: "Session Expired / Cryptographic token failed"</div>
            <p class="text-gray-400 light:text-gray-600 leading-relaxed">
              AKTU ASP.NET servers time out after 2 minutes of idle form state. Clear your browser cache or use this portal's in-page result fetcher to load scores directly with persistent session management.
            </p>
          </div>

          <div class="p-4 rounded-xl bg-black/40 light:bg-white border border-white/[0.08] light:border-black/[0.08] space-y-1.5">
            <div class="font-bold text-white light:text-ink">Error: Status showing "INC" (Incomplete)</div>
            <p class="text-gray-400 light:text-gray-600 leading-relaxed">
              If your semester status displays "INC", your college has not submitted practical or internal sessional marks to AKTU. Contact your college exam cell to upload the pending marksheet.
            </p>
          </div>
        </div>
      </div>

      <!-- FAQs -->
      <div class="space-y-4 pt-6">
        <h3 class="text-xl font-bold text-white light:text-ink">
          OneView AKTU Frequently Asked Questions
        </h3>
        <div class="space-y-3">
          <details class="group p-4 rounded-xl bg-white/[0.02] light:bg-white border border-white/[0.08] light:border-black/[0.08] [&_svg]:open:-rotate-180">
            <summary class="flex items-center justify-between cursor-pointer font-bold text-xs sm:text-sm text-white light:text-ink select-none list-none">
              <span>Is the OneView result card an official mark sheet?</span>
              <svg class="w-4 h-4 transition-transform duration-300 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
            </summary>
            <p class="mt-2 text-xs text-gray-400 light:text-gray-600 leading-relaxed">
              OneView displays your provisional electronic marksheet. It is completely authentic and valid for semester examinations, campus placements, and internships. The physical laminated degree and final consolidated marksheet are issued upon graduation via your college.
            </p>
          </details>

          <details class="group p-4 rounded-xl bg-white/[0.02] light:bg-white border border-white/[0.08] light:border-black/[0.08] [&_svg]:open:-rotate-180">
            <summary class="flex items-center justify-between cursor-pointer font-bold text-xs sm:text-sm text-white light:text-ink select-none list-none">
              <span>How often are OneView results updated?</span>
              <svg class="w-4 h-4 transition-transform duration-300 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
            </summary>
            <p class="mt-2 text-xs text-gray-400 light:text-gray-600 leading-relaxed">
              OneView is updated continuously as semester evaluation phases conclude. Odd semester results (1st, 3rd, 5th, 7th) are typically released between February and April, while even semester results (2nd, 4th, 6th, 8th) are released between July and September.
            </p>
          </details>
        </div>
      </div>

    </div>
  </section>

  <!-- Client-Side Scripts for OneView Background Process -->
  <script is:inline>
    document.addEventListener("DOMContentLoaded", () => {
      const searchForm = document.getElementById("oneview-search-form");
      const rollInput = document.getElementById("oneview-roll-number");
      const loaderState = document.getElementById("oneview-loader-state");
      const loadingStatus = document.getElementById("oneview-loading-status");
      const loadingSubstatus = document.getElementById("oneview-loading-substatus");
      const log1 = document.getElementById("oneview-log-1");
      const log2 = document.getElementById("oneview-log-2");
      const log3 = document.getElementById("oneview-log-3");
      const log4 = document.getElementById("oneview-log-4");

      const captchaContainer = document.getElementById("oneview-manual-captcha-container");
      const profileContainer = document.getElementById("oneview-verified-profile-container");
      const errorState = document.getElementById("oneview-error-state");
      const errorTitle = document.getElementById("oneview-error-title");
      const errorDesc = document.getElementById("oneview-error-desc");
      const retryBtn = document.getElementById("oneview-error-retry-btn");

      const launchOneViewBtn = document.getElementById("launch-oneview-btn");
      const copyScriptBtn = document.getElementById("copy-script-btn");

      // Reset to search form
      function resetUI() {
        searchForm?.classList.remove("hidden");
        loaderState?.classList.add("hidden");
        if (captchaContainer) {
          captchaContainer.classList.add("hidden");
          captchaContainer.innerHTML = "";
        }
        if (profileContainer) {
          profileContainer.classList.add("hidden");
          profileContainer.innerHTML = "";
        }
        errorState?.classList.add("hidden");

        log1?.classList.add("hidden");
        log2?.classList.add("hidden");
        log3?.classList.add("hidden");
        log4?.classList.add("hidden");

        if (rollInput) {
          rollInput.focus();
        }
      }

      retryBtn?.addEventListener("click", resetUI);

      // 1-Click Launch to Official Portal
      launchOneViewBtn?.addEventListener("click", () => {
        const activeRoll = rollInput ? rollInput.value.trim() : "";
        if (activeRoll) {
          navigator.clipboard.writeText(activeRoll).catch(() => {});
        }
        window.open("https://oneview.aktu.ac.in/WebPages/aktu/OneView.aspx", "_blank");
      });

      // Copy 1-Click Auto-Fill JavaScript
      copyScriptBtn?.addEventListener("click", () => {
        const activeRoll = rollInput ? rollInput.value.trim() : "";
        const jsSnippet = "javascript:(function(){var r='" + activeRoll + "';var ro=document.getElementById('txtRollNo');var b=document.getElementById('btnProceed');if(ro&&b){ro.value=r;b.click();}})();";
        
        navigator.clipboard.writeText(jsSnippet).then(() => {
          if (copyScriptBtn) copyScriptBtn.innerHTML = "<span>✓ Script Copied! Paste into address bar</span>";
          setTimeout(() => {
            if (copyScriptBtn) copyScriptBtn.innerHTML = "<span>⚡ Copy 1-Click Auto-Fill JavaScript</span>";
          }, 3000);
        });
      });

      // Render Verified Academic Profile
      function renderOneViewVerifiedProfile(data) {
        loaderState?.classList.add("hidden");
        searchForm?.classList.add("hidden");
        errorState?.classList.add("hidden");
        if (captchaContainer) {
          captchaContainer.classList.add("hidden");
          captchaContainer.innerHTML = "";
        }
        if (!profileContainer) return;
        profileContainer.classList.remove("hidden");

        const studentName = data.name || data.student?.name || "Verified Student";
        const rollNumber = data.rollNumber || (rollInput ? rollInput.value.trim() : "");
        const enrollmentNo = data.enrollmentNumber || data.student?.enrollmentNo;
        const enrollmentHtml = (enrollmentNo && enrollmentNo !== '--') 
          ? `<div class="text-xs text-gray-400">Enrollment: <span class="font-bold text-white">${enrollmentNo}</span></div>` 
          : '';
        const fatherName = data.fatherName || data.student?.fatherName;
        const fatherHtml = (fatherName && fatherName !== '--') 
          ? `<div class="text-xs text-gray-400">Father's Name: <span class="text-gray-200">${fatherName}</span></div>` 
          : '';
        const course = data.course || data.student?.course;
        const courseHtml = (course && course !== '--') 
          ? `<div class="text-xs text-gray-400">Course: <span class="text-gray-200">${course}</span></div>` 
          : '';
        const institute = data.institute || data.student?.college;
        const instituteHtml = (institute && institute !== '--') 
          ? `<div class="text-xs text-gray-400">Institute: <span class="text-gray-200">${institute}</span></div>` 
          : '';

        const botUrl = data.telegramBotUrl || `https://t.me/akturesultwithoutdobbot?start=${encodeURIComponent(rollNumber)}`;
        const homeMarksheetUrl = `/?roll=${encodeURIComponent(rollNumber)}`;

        profileContainer.innerHTML = `
          <div class="p-5 sm:p-6 rounded-2xl border border-emerald-500/30 bg-gradient-to-b from-emerald-500/10 via-black/60 to-black/80 space-y-5 text-left shadow-2xl backdrop-blur-xl">
            <!-- Status Header -->
            <div class="flex items-center justify-between pb-3 border-b border-emerald-500/20">
              <div class="flex items-center gap-2">
                <span class="w-2.5 h-2.5 rounded-full bg-emerald-400 animate-pulse"></span>
                <span class="text-xs font-bold text-emerald-400 uppercase tracking-wider">OneView Record Verified ✅</span>
              </div>
              <span class="px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-emerald-500/20 text-emerald-300 border border-emerald-500/30">
                Official Gateway
              </span>
            </div>

            <!-- Student Profile Information -->
            <div class="space-y-2">
              <div class="text-[11px] text-gray-400 uppercase font-medium">Student Name:</div>
              <div class="text-lg sm:text-xl font-black text-white tracking-tight">${studentName}</div>
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 pt-2 border-t border-white/5 font-mono text-xs">
                <div class="text-gray-400">Roll No: <span class="font-bold text-white">${rollNumber}</span></div>
                ${enrollmentHtml}
                ${fatherHtml}
                ${courseHtml}
                ${instituteHtml}
              </div>
            </div>

            <!-- Direct Result Actions -->
            <div class="space-y-2.5 pt-1">
              <a 
                href="${homeMarksheetUrl}" 
                class="w-full py-3.5 bg-gradient-to-r from-emerald-600 to-teal-600 hover:from-emerald-500 hover:to-teal-500 text-white text-xs sm:text-sm font-bold rounded-xl shadow-lg transition-all flex items-center justify-center gap-2 text-center cursor-pointer"
              >
                <span>📑 Open Complete Marksheet &amp; Semester Grades &rarr;</span>
              </a>

              <a 
                href="${botUrl}" 
                target="_blank" 
                rel="noopener noreferrer"
                class="w-full py-3 bg-gradient-to-r from-brand-blue via-blue-500 to-purple-600 hover:from-brand-blue-hover hover:to-purple-700 text-white text-xs sm:text-sm font-bold rounded-xl shadow-lg transition-all flex items-center justify-center gap-2 text-center cursor-pointer"
              >
                <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
                  <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm4.64 6.8c-.15 1.58-.8 5.42-1.13 7.19-.14.75-.42 1-.68 1.03-.58.05-1.02-.38-1.58-.75-.88-.58-1.38-.94-2.23-1.5-.99-.65-.35-1.01.22-1.59.15-.15 2.71-2.48 2.76-2.69a.2.2 0 00-.05-.18c-.06-.05-.14-.03-.21-.02-.09.02-1.49.95-4.22 2.79-.4.27-.76.41-1.08.4-.36-.01-1.04-.2-1.55-.37-.63-.2-1.12-.31-1.08-.66.02-.18.27-.36.75-.55 2.92-1.27 4.86-2.11 5.83-2.51 2.78-1.16 3.35-1.36 3.73-1.36.08 0 .27.02.39.12.1.08.13.19.14.27-.01.06.01.24 0 .38z"/>
                </svg>
                <span>Download Official PDF Marksheet (@akturesultwithoutdobbot)</span>
              </a>
            </div>
          </div>

          <button 
            type="button" 
            id="oneview-check-another-btn" 
            class="w-full py-2.5 bg-white/[0.05] hover:bg-white/[0.1] text-white text-xs font-semibold rounded-xl border border-white/10 cursor-pointer transition-all text-center"
          >
            ← Check Another Roll Number
          </button>
        `;

        document.getElementById("oneview-check-another-btn")?.addEventListener("click", resetUI);
      }

      // Render Manual Captcha Modal
      function renderOneViewManualCaptcha(initialData, rollVal) {
        let currentSession = initialData.session;
        if (!captchaContainer) return;

        loaderState?.classList.add("hidden");
        searchForm?.classList.add("hidden");
        errorState?.classList.add("hidden");
        if (profileContainer) profileContainer.classList.add("hidden");
        captchaContainer.classList.remove("hidden");

        function updateModal(imgSrc, errorMsg) {
          captchaContainer.innerHTML = `
            <div class="p-4 rounded-xl border border-brand-blue/30 bg-black/60 space-y-3 text-left">
              <div class="flex items-center justify-between">
                <span class="text-xs font-bold text-brand-blue">Security Verification</span>
                <span class="text-[10px] text-gray-400">Step 2 of 2</span>
              </div>
              <p class="text-xs text-gray-400">Enter the 5 characters shown below to access OneView result:</p>
              
              <div class="flex items-center justify-center gap-3 p-3 bg-white/5 rounded-xl border border-white/10">
                <img id="oneview-captcha-img" src="${imgSrc}" alt="Security Captcha" class="h-10 rounded shadow bg-white" />
                <button 
                  type="button" 
                  id="oneview-refresh-captcha-btn" 
                  title="Load new code"
                  class="px-2.5 py-2 bg-white/10 hover:bg-white/20 text-gray-300 hover:text-white rounded-lg transition-all text-xs flex items-center gap-1 cursor-pointer"
                >
                  <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" /></svg>
                  <span>New Code</span>
                </button>
              </div>

              ${errorMsg ? `<div class="p-2 rounded-lg bg-rose-500/10 border border-rose-500/20 text-rose-400 text-xs text-center font-medium">${errorMsg}</div>` : ''}

              <input 
                type="text" 
                id="oneview-security-code-input" 
                maxlength="6"
                placeholder="Enter 5 characters"
                autocomplete="off"
                class="w-full px-3 py-2.5 bg-white/5 border border-white/20 rounded-lg text-white font-mono text-center tracking-widest text-base uppercase placeholder-gray-500 focus:outline-none focus:border-brand-blue"
              />

              <div class="flex gap-2 pt-1">
                <button 
                  type="button" 
                  id="oneview-cancel-code-btn" 
                  class="flex-1 py-2.5 bg-white/10 hover:bg-white/15 text-gray-300 rounded-lg text-xs font-semibold transition-all cursor-pointer"
                >
                  Cancel
                </button>
                <button 
                  type="button" 
                  id="oneview-submit-code-btn" 
                  class="flex-1 py-2.5 bg-brand-blue hover:bg-brand-blue-hover text-white rounded-lg text-xs font-semibold transition-all cursor-pointer flex items-center justify-center gap-1"
                >
                  <span>Verify & Proceed</span>
                </button>
              </div>
            </div>
          `;

          const codeInput = document.getElementById("oneview-security-code-input");
          if (codeInput) {
            codeInput.focus();
            codeInput.addEventListener("keydown", (e) => {
              if (e.key === "Enter") {
                e.preventDefault();
                submitCode();
              }
            });
          }

          document.getElementById("oneview-refresh-captcha-btn")?.addEventListener("click", async () => {
            const btn = document.getElementById("oneview-refresh-captcha-btn");
            if (btn) btn.innerHTML = `<span>Loading...</span>`;
            try {
              const rRes = await fetch("/api/search", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ rollNumber: rollVal, action: "refreshCaptcha", session: currentSession })
              });
              const rData = await rRes.json();
              if (rData && rData.captchaImage) {
                currentSession = rData.session || currentSession;
                updateModal(rData.captchaImage);
              } else {
                updateModal(imgSrc, "Could not refresh captcha. Try again.");
              }
            } catch (e) {
              updateModal(imgSrc, "Network error refreshing captcha.");
            }
          });

          document.getElementById("oneview-submit-code-btn")?.addEventListener("click", submitCode);
          document.getElementById("oneview-cancel-code-btn")?.addEventListener("click", resetUI);
        }

        async function submitCode() {
          const codeInput = document.getElementById("oneview-security-code-input");
          const code = codeInput ? codeInput.value.trim().toUpperCase() : "";
          if (!code || code.length < 4) {
            if (codeInput) codeInput.focus();
            return;
          }

          const submitBtn = document.getElementById("oneview-submit-code-btn");
          if (submitBtn) {
            submitBtn.disabled = true;
            submitBtn.innerHTML = `
              <div class="w-4 h-4 border-2 border-white/30 border-t-white rounded-full animate-spin"></div>
              <span>Verifying...</span>
            `;
          }

          try {
            const vRes = await fetch("/api/search", {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({ rollNumber: rollVal, manualCaptcha: code, session: currentSession })
            });
            const vData = await vRes.json();
            if (vData && vData.success) {
              renderOneViewVerifiedProfile(vData);
            } else if (vData && vData.needsManualCaptcha && vData.captchaImage) {
              currentSession = vData.session || currentSession;
              updateModal(vData.captchaImage, vData.error || "Incorrect code. Please enter the new characters shown.");
            } else {
              updateModal(initialData.captchaImage, vData?.error || "Verification failed. Please try again.");
            }
          } catch (e) {
            updateModal(initialData.captchaImage, "Network error during verification. Please try again.");
          }
        }

        updateModal(initialData.captchaImage);
      }

      // Execute Background Process Search
      function executeSearch(enteredRoll) {
        if (!enteredRoll || !/^[0-9]{10,15}$/.test(enteredRoll)) {
          alert("Please enter a valid 10 to 14 digit AKTU University Roll Number.");
          rollInput?.focus();
          return;
        }

        // Hide other containers & show loader
        searchForm?.classList.add("hidden");
        if (captchaContainer) {
          captchaContainer.classList.add("hidden");
          captchaContainer.innerHTML = "";
        }
        if (profileContainer) {
          profileContainer.classList.add("hidden");
          profileContainer.innerHTML = "";
        }
        errorState?.classList.add("hidden");
        loaderState?.classList.remove("hidden");

        // Reset logs
        log1?.classList.add("hidden");
        log2?.classList.add("hidden");
        log3?.classList.add("hidden");
        log4?.classList.add("hidden");

        if (loadingStatus) loadingStatus.textContent = "Connecting to AKTU OneView Gateway...";
        if (loadingSubstatus) loadingSubstatus.textContent = "Querying academic database & authenticating session...";

        // Stage-based animation
        setTimeout(() => {
          if (loadingStatus) loadingStatus.textContent = "Checking OneView Archives...";
          if (loadingSubstatus) loadingSubstatus.textContent = "Verifying marksheet repository records...";
          log1?.classList.remove("hidden");
        }, 400);

        setTimeout(() => {
          if (loadingStatus) loadingStatus.textContent = "Negotiating University Gateway...";
          if (loadingSubstatus) loadingSubstatus.textContent = "Validating cryptographic ViewState tokens...";
          log2?.classList.remove("hidden");
        }, 900);

        setTimeout(() => {
          if (loadingStatus) loadingStatus.textContent = "Resolving Student Marksheet...";
          if (loadingSubstatus) loadingSubstatus.textContent = "Assembling semester grades & credits ledger...";
          log3?.classList.remove("hidden");
        }, 1500);

        // Network Request & Minimum Animation Delay
        const fetchPromise = fetch('/api/search', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ rollNumber: enteredRoll })
        });

        const delayPromise = new Promise(resolve => setTimeout(resolve, 1800));

        Promise.all([fetchPromise, delayPromise])
          .then(async ([res]) => {
            loaderState?.classList.add("hidden");

            if (!res.ok) {
              let errorText = "Could not fetch result right now. Please try again.";
              try {
                const errData = await res.json();
                if (errData?.error) errorText = errData.error;
              } catch (e) {}
              if (errorTitle) errorTitle.textContent = "OneView Search Failed";
              if (errorDesc) errorDesc.textContent = errorText;
              errorState?.classList.remove("hidden");
              return;
            }

            const data = await res.json();
            if (data.success) {
              renderOneViewVerifiedProfile(data);
            } else if (data.needsManualCaptcha && data.captchaImage) {
              renderOneViewManualCaptcha(data, enteredRoll);
            } else {
              if (errorTitle) errorTitle.textContent = "Search Failed";
              if (errorDesc) errorDesc.textContent = data.error || "Could not retrieve records for this roll number.";
              errorState?.classList.remove("hidden");
            }
          })
          .catch(err => {
            console.error("OneView API Error:", err);
            loaderState?.classList.add("hidden");
            if (errorTitle) errorTitle.textContent = "Network Error";
            if (errorDesc) errorDesc.textContent = "Failed to connect to gateway. Please check your internet connection.";
            errorState?.classList.remove("hidden");
          });
      }

      searchForm?.addEventListener("submit", (e) => {
        e.preventDefault();
        const enteredRoll = rollInput ? rollInput.value.trim() : "";
        executeSearch(enteredRoll);
      });

      // Auto-trigger if roll parameter present in URL
      const urlParams = new URLSearchParams(window.location.search);
      const paramRoll = urlParams.get('roll') || urlParams.get('rollNumber');
      if (paramRoll && rollInput) {
        rollInput.value = paramRoll;
        setTimeout(() => {
          executeSearch(paramRoll);
        }, 300);
      }
    });
  </script>
</Layout>
