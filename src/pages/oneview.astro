              <!-- Date of Birth Island -->
              ${resolvedDob ? `
                <div class="p-3.5 bg-white/5 light:bg-emerald-50/60 border border-emerald-500/25 light:border-emerald-200 rounded-xl flex items-center justify-between">
                  <div>
                    <span class="text-[10px] uppercase font-bold text-gray-400 light:text-gray-600 block mb-0.5">Registered Date of Birth:</span>
                    <div class="text-sm font-mono font-extrabold text-emerald-400 light:text-emerald-700 tracking-wider">
                      <span id="oneview-dob-display">${isDobHidden ? '••••••••' : resolvedDob}</span>
                    </div>
                  </div>
                  <div class="flex items-center gap-1.5">
                    <button 
                      type="button" 
                      id="oneview-toggle-dob-btn" 
                      class="px-2.5 py-1.5 bg-white/10 light:bg-gray-100 hover:bg-white/15 light:hover:bg-gray-200 text-xs text-gray-300 light:text-gray-700 hover:text-white light:hover:text-ink rounded-lg transition-all cursor-pointer select-none font-medium flex items-center gap-1 border border-transparent light:border-gray-200"
                      title="Toggle DOB display"
                    >
                      <span>👁️ Toggle</span>
                    </button>
                    <button 
                      type="button" 
                      id="oneview-copy-dob-btn" 
                      class="px-2.5 py-1.5 bg-emerald-500/20 light:bg-emerald-100 hover:bg-emerald-500/30 text-xs text-emerald-300 light:text-emerald-800 font-semibold rounded-lg transition-all cursor-pointer select-none flex items-center gap-1 border border-transparent light:border-emerald-200"
                      title="Copy DOB to clipboard"
                    >
                      <span>📋 Copy</span>
                    </button>
                  </div>
                </div>
              ` : ''}

              <!-- Sponsored Ad Unit -->
              <div class="p-3 rounded-xl border border-white/5 light:border-black/5 bg-white/[0.02] light:bg-black/[0.01] text-center overflow-hidden">
                <span class="text-[8px] uppercase font-bold text-gray-400 light:text-gray-500 tracking-wider block mb-1">Sponsored Advertisement</span>
                <ins class="adsbygoogle"
                     style="display:block; min-height: 90px;"
                     data-ad-client="ca-pub-5590747238948130"
                     data-ad-slot="default"
                     data-ad-format="auto"
                     data-full-width-responsive="true"></ins>
              </div>

              <!-- OneView Launch Actions -->
              <div class="space-y-2.5 pt-1">
                <button 
                  type="button" 
                  id="oneview-launch-official-btn" 
                  class="w-full py-3.5 bg-gradient-to-r from-brand-blue via-blue-500 to-purple-600 hover:from-brand-blue-hover hover:to-purple-700 text-white text-xs sm:text-sm font-bold rounded-xl shadow-lg transition-all transform hover:scale-[1.02] active:scale-[0.98] flex items-center justify-center gap-2 cursor-pointer"
                >
                  <span>🚀 Open Official OneView ${resolvedDob ? '(DOB Auto-Copied)' : ''}</span>
                  <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                  </svg>
                </button>

                <button 
                  type="button" 
                  id="oneview-copy-script-btn" 
                  class="w-full py-2.5 bg-white/10 light:bg-gray-100 hover:bg-white/15 light:hover:bg-gray-200 text-gray-200 light:text-gray-700 hover:text-white light:hover:text-ink rounded-xl border border-white/10 light:border-gray-200 text-xs font-semibold transition-all flex items-center justify-center gap-1.5 cursor-pointer"
                >
                  <span>⚡ Copy 1-Click Auto-Fill JavaScript</span>
                </button>

                <a 
                  href="${botUrl}" 
                  target="_blank" 
                  rel="noopener noreferrer" 
                  class="w-full py-2.5 bg-blue-500/10 light:bg-blue-50 hover:bg-blue-500/20 light:hover:bg-blue-100 text-blue-400 light:text-brand-blue text-xs font-semibold rounded-xl border border-blue-500/20 light:border-blue-200 transition-all flex items-center justify-center gap-1.5 text-center cursor-pointer"
                >
                  <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24">
                    <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm4.64 6.8c-.15 1.58-.8 5.42-1.13 7.19-.14.75-.42 1-.68 1.03-.58.05-1.02-.38-1.58-.75-.88-.58-1.38-.94-2.23-1.5-.99-.65-.35-1.01.22-1.59.15-.15 2.71-2.48 2.76-2.69a.2.2 0 00-.05-.18c-.06-.05-.14-.03-.21-.02-.09.02-1.49.95-4.22 2.79-.4.27-.76.41-1.08.4-.36-.01-1.04-.2-1.55-.37-.63-.2-1.12-.31-1.08-.66.02-.18.27-.36.75-.55 2.92-1.27 4.86-2.11 5.83-2.51 2.78-1.16 3.35-1.36 3.73-1.36.08 0 .27.02.39.12.1.08.13.19.14.27-.01.06.01.24 0 .38z"/>
                  </svg>
                  <span>Download Official PDF Marksheet (@akturesultwithoutdobbot)</span>
                </a>
              </div>
            </div>

            <button 
              type="button" 
              id="oneview-check-another-btn" 
              class="w-full py-2.5 bg-white/[0.05] light:bg-gray-100 hover:bg-white/[0.1] light:hover:bg-gray-200 text-white light:text-gray-800 text-xs font-semibold rounded-xl border border-white/10 light:border-gray-200 cursor-pointer transition-all text-center mt-3"
            >
              ← Check Another Roll Number
            </button>
          `;
        }

        // Common Events: Toggle DOB
        document.getElementById("oneview-toggle-dob-btn")?.addEventListener("click", () => {
          const dobDisplay = document.getElementById("oneview-dob-display");
          if (!dobDisplay) return;
          if (isDobHidden) {
            dobDisplay.textContent = resolvedDob;
            isDobHidden = false;
          } else {
            dobDisplay.textContent = "ÔÇóÔÇóÔÇóÔÇóÔÇóÔÇóÔÇóÔÇó";
            isDobHidden = true;
          }
        });

        // Common Events: Copy DOB
        document.getElementById("oneview-copy-dob-btn")?.addEventListener("click", () => {
          if (resolvedDob) {
            navigator.clipboard.writeText(resolvedDob).then(() => {
              const copyBtn = document.getElementById("oneview-copy-dob-btn");
              if (copyBtn) copyBtn.innerHTML = "<span>Ô£ô Copied!</span>";
              setTimeout(() => {
                const b = document.getElementById("oneview-copy-dob-btn");
                if (b) b.innerHTML = "<span>­ƒôï Copy</span>";
              }, 2000);
            });
          }
        });

        // Common Events: Launch Official OneView with auto-copied DOB
        document.getElementById("oneview-launch-official-btn")?.addEventListener("click", () => {
          if (resolvedDob) {
            navigator.clipboard.writeText(resolvedDob).catch(() => {});
          } else if (rollNumber) {
            navigator.clipboard.writeText(rollNumber).catch(() => {});
          }
          window.open("https://oneview.aktu.ac.in/WebPages/aktu/OneView.aspx", "_blank");
        });

        // Common Events: Copy 1-Click Auto-Fill JavaScript
        document.getElementById("oneview-copy-script-btn")?.addEventListener("click", () => {
          const jsSnippet = "javascript:(function(){var r='" + rollNumber + "',d='" + resolvedDob + "';var ro=document.getElementById('txtRollNo');var b=document.getElementById('btnProceed');if(ro&&b){ro.value=r;b.click();}if(d){var c=setInterval(function(){var di=document.getElementById('txtDOB');if(di&&di.offsetParent!==null){di.value=d;di.type='password';di.style.filter='blur(5px)';clearInterval(c);}},200);}})();";
          navigator.clipboard.writeText(jsSnippet).then(() => {
            const btn = document.getElementById("oneview-copy-script-btn");
            if (btn) btn.innerHTML = "<span>Ô£ô Script Copied! Paste into OneView address bar</span>";
            setTimeout(() => {
              const b = document.getElementById("oneview-copy-script-btn");
              if (b) b.innerHTML = "<span>ÔÜí Copy 1-Click Auto-Fill JavaScript</span>";
            }, 3000);
          });
        });

        document.getElementById("oneview-check-another-btn")?.addEventListener("click", resetUI);
      }

      // Render Manual Captcha Modal
      function renderOneViewManualCaptcha(initialData, rollVal) {
        let currentSession = initialData.session;
        if (!captchaContainer) return;

        loaderState?.classList.add("hidden");
        searchForm?.classList.add("hidden");
        errorState?.classList.add("hidden");
        if (profileContainer) profileContainer.classList.add("hidden");
        captchaContainer.classList.remove("hidden");

        function updateModal(imgSrc, errorMsg) {
          captchaContainer.innerHTML = `
            <div class="p-4 rounded-xl border border-brand-blue/30 light:border-gray-200 bg-black/60 light:bg-white space-y-3 text-left light:shadow-lg">
              <div class="flex items-center justify-between">
                <span class="text-xs font-bold text-brand-blue">Security Verification</span>
                <span class="text-[10px] text-gray-400 light:text-gray-500">Step 2 of 2</span>
              </div>
              <p class="text-xs text-gray-400 light:text-gray-600">Enter the 5 characters shown below to access OneView result:</p>
              
              <div class="flex items-center justify-center gap-3 p-3 bg-white/5 light:bg-gray-50 rounded-xl border border-white/10 light:border-gray-200">
                <img id="oneview-captcha-img" src="${imgSrc}" alt="Security Captcha" class="h-10 rounded shadow bg-white" />
                <button 
                  type="button" 
                  id="oneview-refresh-captcha-btn" 
                  title="Load new code"
                  class="px-2.5 py-2 bg-white/10 hover:bg-white/20 light:bg-gray-100 light:hover:bg-gray-200 text-gray-300 hover:text-white light:text-gray-700 light:hover:text-ink rounded-lg transition-all text-xs flex items-center gap-1 cursor-pointer border border-transparent light:border-gray-200"
                >
                  <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" /></svg>
                  <span>New Code</span>
                </button>
              </div>

              ${errorMsg ? `<div class="p-2 rounded-lg bg-rose-500/10 border border-rose-500/20 text-rose-400 text-xs text-center font-medium">${errorMsg}</div>` : ''}

              <input 
                type="text" 
                id="oneview-security-code-input" 
                maxlength="6"
                placeholder="Enter 5 characters"
                autocomplete="off"
                class="w-full px-3 py-2.5 bg-white/5 border border-white/20 light:bg-gray-50 light:border-gray-300 rounded-lg text-white light:text-ink light:placeholder-gray-400 font-mono text-center tracking-widest text-base uppercase placeholder-gray-500 focus:outline-none focus:border-brand-blue"
              />

              <!-- Sponsored Ad in Verification Step -->
              <div class="p-2.5 rounded-xl border border-white/5 light:border-black/5 bg-white/[0.02] light:bg-black/[0.01] text-center overflow-hidden">
                <span class="text-[8px] uppercase font-bold text-gray-400 light:text-gray-500 tracking-wider block mb-1">Sponsored Advertisement</span>
                <ins class="adsbygoogle"
                     style="display:block; min-height: 90px;"
                     data-ad-client="ca-pub-5590747238948130"
                     data-ad-slot="default"
                     data-ad-format="auto"
                     data-full-width-responsive="true"></ins>
              </div>

              <div class="flex gap-2 pt-1">
                <button 
                  type="button" 
                  id="oneview-cancel-code-btn" 
                  class="flex-1 py-2.5 bg-white/10 hover:bg-white/15 light:bg-gray-100 light:hover:bg-gray-200 text-gray-300 light:text-gray-700 rounded-lg text-xs font-semibold transition-all cursor-pointer border border-transparent light:border-gray-200"
                >
                  Cancel
                </button>
                <button 
                  type="button" 
                  id="oneview-submit-code-btn" 
                  class="flex-1 py-2.5 bg-brand-blue hover:bg-brand-blue-hover text-white rounded-lg text-xs font-semibold transition-all cursor-pointer flex items-center justify-center gap-1"
                >
                  <span>Verify & Proceed</span>
                </button>
              </div>
            </div>
          `;

          try {
            (window.adsbygoogle = window.adsbygoogle || []).push({});
          } catch (e) {}

          const codeInput = document.getElementById("oneview-security-code-input");
          if (codeInput) {
            codeInput.focus();
            codeInput.addEventListener("keydown", (e) => {
              if (e.key === "Enter") {
                e.preventDefault();
                submitCode();
              }
            });
          }

          document.getElementById("oneview-refresh-captcha-btn")?.addEventListener("click", async () => {
            const btn = document.getElementById("oneview-refresh-captcha-btn");
            if (btn) btn.innerHTML = `<span>Loading...</span>`;
            try {
              const rRes = await fetch("/api/search", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ rollNumber: rollVal, action: "refreshCaptcha", session: currentSession })
              });
              const rData = await rRes.json();
              if (rData && rData.captchaImage) {
                currentSession = rData.session || currentSession;
                updateModal(rData.captchaImage);
              } else {
                updateModal(imgSrc, "Could not refresh captcha. Try again.");
              }
            } catch (e) {
              updateModal(imgSrc, "Network error refreshing captcha.");
            }
          });

          document.getElementById("oneview-submit-code-btn")?.addEventListener("click", submitCode);
          document.getElementById("oneview-cancel-code-btn")?.addEventListener("click", resetUI);
        }

        async function submitCode() {
          const codeInput = document.getElementById("oneview-security-code-input");
          const code = codeInput ? codeInput.value.trim().toUpperCase() : "";
          if (!code || code.length < 4) {
            if (codeInput) codeInput.focus();
            return;
          }

          const submitBtn = document.getElementById("oneview-submit-code-btn");
          if (submitBtn) {
            submitBtn.disabled = true;
            submitBtn.innerHTML = `
              <div class="w-4 h-4 border-2 border-white/30 border-t-white rounded-full animate-spin"></div>
              <span>Verifying...</span>
            `;
          }

          try {
            const vRes = await fetch("/api/search", {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({ rollNumber: rollVal, manualCaptcha: code, session: currentSession })
            });
            const vData = await vRes.json();
            if (vData && vData.success) {
              showOneViewAdInterstitialThen(vData, () => {
                renderOneViewVerifiedProfile(vData);
              });
            } else if (vData && vData.needsManualCaptcha && vData.captchaImage) {
              currentSession = vData.session || currentSession;
              updateModal(vData.captchaImage, vData.error || "Incorrect code. Please enter the new characters shown.");
            } else {
              updateModal(initialData.captchaImage, vData?.error || "Verification failed. Please try again.");
            }
          } catch (e) {
            updateModal(initialData.captchaImage, "Network error during verification. Please try again.");
          }
        }

        updateModal(initialData.captchaImage);
      }

      // Execute Background Process Search
      function executeSearch(enteredRoll) {
        if (!enteredRoll || !/^[0-9]{10,15}$/.test(enteredRoll)) {
          alert("Please enter a valid 10 to 14 digit AKTU University Roll Number.");
          rollInput?.focus();
          return;
        }

        // Hide other containers & show loader
        searchForm?.classList.add("hidden");
        if (captchaContainer) {
          captchaContainer.classList.add("hidden");
          captchaContainer.innerHTML = "";
        }
        if (profileContainer) {
          profileContainer.classList.add("hidden");
          profileContainer.innerHTML = "";
        }
        errorState?.classList.add("hidden");
        loaderState?.classList.remove("hidden");

        // Reset logs
        log1?.classList.add("hidden");
        log2?.classList.add("hidden");
        log3?.classList.add("hidden");
        log4?.classList.add("hidden");

        if (loadingStatus) loadingStatus.textContent = "Connecting to AKTU OneView Gateway...";
        if (loadingSubstatus) loadingSubstatus.textContent = "Querying academic database & authenticating session...";

        // Stage-based animation
        setTimeout(() => {
          if (loadingStatus) loadingStatus.textContent = "Checking OneView Archives...";
          if (loadingSubstatus) loadingSubstatus.textContent = "Verifying marksheet repository records...";
          log1?.classList.remove("hidden");
        }, 400);

        setTimeout(() => {
          if (loadingStatus) loadingStatus.textContent = "Negotiating University Gateway...";
          if (loadingSubstatus) loadingSubstatus.textContent = "Validating cryptographic ViewState tokens...";
          log2?.classList.remove("hidden");
        }, 900);

        setTimeout(() => {
          if (loadingStatus) loadingStatus.textContent = "Resolving Student Marksheet...";
          if (loadingSubstatus) loadingSubstatus.textContent = "Assembling semester grades & credits ledger...";
          log3?.classList.remove("hidden");
        }, 1500);

        // Network Request & Minimum Animation Delay
        const fetchPromise = fetch('/api/search', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ rollNumber: enteredRoll })
        });

        const delayPromise = new Promise(resolve => setTimeout(resolve, 1800));

        Promise.all([fetchPromise, delayPromise])
          .then(async ([res]) => {
            loaderState?.classList.add("hidden");

            if (!res.ok) {
              let errorText = "Could not fetch result right now. Please try again.";
              try {
                const errData = await res.json();
                if (errData?.error) errorText = errData.error;
              } catch (e) {}
              if (errorTitle) errorTitle.textContent = "OneView Search Failed";
              if (errorDesc) errorDesc.textContent = errorText;
              errorState?.classList.remove("hidden");
              return;
            }

            const data = await res.json();
            if (data.success) {
              showOneViewAdInterstitialThen(data, () => {
                renderOneViewVerifiedProfile(data);
              });
            } else if (data.needsManualCaptcha && data.captchaImage) {
              renderOneViewManualCaptcha(data, enteredRoll);
            } else {
              if (errorTitle) errorTitle.textContent = "Search Failed";
              if (errorDesc) errorDesc.textContent = data.error || "Could not retrieve records for this roll number.";
              errorState?.classList.remove("hidden");
            }
          })
          .catch(err => {
            console.error("OneView API Error:", err);
            loaderState?.classList.add("hidden");
            if (errorTitle) errorTitle.textContent = "Network Error";
            if (errorDesc) errorDesc.textContent = "Failed to connect to gateway. Please check your internet connection.";
            errorState?.classList.remove("hidden");
          });
      }

      searchForm?.addEventListener("submit", (e) => {
        e.preventDefault();
        const enteredRoll = rollInput ? rollInput.value.trim() : "";
        executeSearch(enteredRoll);
      });

      // Auto-trigger if roll parameter present in URL
      const urlParams = new URLSearchParams(window.location.search);
      const paramRoll = urlParams.get('roll') || urlParams.get('rollNumber');
      if (paramRoll && rollInput) {
        rollInput.value = paramRoll;
        setTimeout(() => {
          executeSearch(paramRoll);
        }, 200);
      }
    };

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", initOneView);
    } else {
      initOneView();
    }
  </script>
</Layout>
