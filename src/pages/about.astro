---
import Layout from "../layouts/Layout.astro";

const aboutKeywords = "about aktu result helper, independent aktu student utility, aktu result without dob, aktu oneview helper, student portal disclaimer, aktu result inquiry";
const pageTitle = "About Us | Independent AKTU Student Utility";
const pageDescription = "Learn about akturesult.bond, our mission as an independent student utility for AKTU students, our strict data privacy policies, and our commitment to transparency.";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "AboutPage",
  "name": pageTitle,
  "description": pageDescription,
  "url": "https://akturesult.bond/about",
  "mainEntity": {
    "@type": "Organization",
    "name": "akturesult.bond (Independent Student Project)",
    "url": "https://akturesult.bond",
    "description": "An independent student-built academic search helper for students of Dr. A.P.J. Abdul Kalam Technical University.",
    "contactPoint": {
      "@type": "ContactPoint",
      "email": "support@akturesult.bond",
      "contactType": "customer support"
    }
  }
};
---

<Layout 
  title={pageTitle}
  description={pageDescription}
  keywords={aboutKeywords}
  jsonLd={jsonLd}
>
  <!-- Header Banner -->
  <section class="py-16 md:py-20 border-b border-canvas-dark-border light:border-canvas-light-border bg-gradient-to-b from-black to-canvas-dark-surface light:from-white light:to-canvas-light-surface text-center">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 space-y-4">
      <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full border border-brand-blue/30 bg-brand-blue/10 text-xs font-semibold text-brand-blue">
        <span>ℹ️ Transparency &amp; Project Mission</span>
      </div>
      <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold tracking-tight text-white light:text-ink">
        About akturesult.bond
      </h1>
      <p class="text-sm sm:text-base text-gray-400 light:text-gray-600 max-w-2xl mx-auto leading-relaxed">
        An independent, community-driven student utility built to help engineering and technical college students access academic grade information and navigate university procedures.
      </p>
    </div>
  </section>

  <!-- Prominent Independent Disclaimer Callout -->
  <section class="py-8 bg-black/60 light:bg-gray-50 border-b border-canvas-dark-border light:border-canvas-light-border">
    <div class="max-w-4xl mx-auto px-4 sm:px-6">
      <div class="p-5 rounded-2xl bg-amber-500/10 border border-amber-500/25 text-xs leading-relaxed space-y-2 text-left">
        <div class="flex items-center gap-2 font-bold text-amber-400 light:text-amber-800 uppercase tracking-wider text-xs">
          <span>⚠️</span>
          <span>Official Non-Affiliation Notice</span>
        </div>
        <p class="text-gray-300 light:text-gray-700">
          <strong>akturesult.bond is an independent student utility platform and is not affiliated with, endorsed by, or officially connected to Dr. A.P.J. Abdul Kalam Technical University (AKTU).</strong> We do not issue official degrees, modify university databases, or replace the registrar's office. For official degree certificates, grade verification, scrutiny, and migration documents, students must always use the official university portals (<a href="https://erp.aktu.ac.in" target="_blank" rel="noopener noreferrer" class="underline font-semibold text-brand-blue">erp.aktu.ac.in</a> / <a href="https://oneview.aktu.ac.in" target="_blank" rel="noopener noreferrer" class="underline font-semibold text-brand-blue">oneview.aktu.ac.in</a>).
        </p>
      </div>
    </div>
  </section>

  <!-- Main Content -->
  <section class="py-16 bg-black light:bg-white text-gray-400 light:text-gray-600">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 space-y-14 text-left">
      
      <!-- Section 1: Why Was This Platform Created? -->
      <div class="space-y-4">
        <h2 class="text-xl font-bold text-white light:text-ink tracking-tight border-l-4 border-brand-blue pl-3">
          1. Why Was This Utility Built?
        </h2>
        <div class="space-y-3 text-xs sm:text-sm leading-relaxed">
          <p>
            The official <strong>AKTU OneView</strong> portal is the university's primary electronic grade repository. To view semester marks, students must submit two credentials: their 10-to-14 digit <strong>University Roll Number</strong> and their registered <strong>Date of Birth (DOB)</strong>.
          </p>
          <p>
            However, thousands of students encounter situations where their registered Date of Birth is misplaced, misprinted on initial college registration records, or entered in an inverted format (e.g., MM/DD/YYYY instead of DD/MM/YYYY). Without the exact matching Date of Birth, students face severe anxiety during placement seasons, higher education admissions, and back paper application deadlines because they cannot view their own semester scores.
          </p>
          <p>
            We created this utility as an open-source educational helper. The system acts as a transient proxy that establishes a session handshake with the public university server, allowing students to check their provisional marksheet using solely their University Roll Number.
          </p>
        </div>
      </div>

      <hr class="border-canvas-dark-border light:border-canvas-light-border" />

      <!-- Section 2: What We Do vs What We Do Not Do -->
      <div class="space-y-4">
        <h2 class="text-xl font-bold text-white light:text-ink tracking-tight border-l-4 border-brand-blue pl-3">
          2. Clear Operational Boundaries
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 text-xs sm:text-sm">
          <div class="p-5 rounded-2xl bg-canvas-dark-tile light:bg-canvas-light-surface border border-emerald-500/20 space-y-2">
            <h3 class="font-bold text-emerald-400 light:text-emerald-700 flex items-center gap-1.5">
              <span>✓</span>
              <span>What This Platform Does</span>
            </h3>
            <ul class="list-disc pl-5 space-y-1.5 text-gray-300 light:text-gray-700">
              <li>Provides a convenient search interface for students to look up provisional semester scores.</li>
              <li>Publishes thorough student guides on SGPA/CGPA calculations, grading scales, and back paper rules.</li>
              <li>Maintains a college directory and roll number assistant to help students identify their roll format.</li>
              <li>Explains common portal error messages and directs students to official university resolution avenues.</li>
            </ul>
          </div>

          <div class="p-5 rounded-2xl bg-canvas-dark-tile light:bg-canvas-light-surface border border-rose-500/20 space-y-2">
            <h3 class="font-bold text-rose-400 light:text-rose-700 flex items-center gap-1.5">
              <span>✕</span>
              <span>What This Platform Does NOT Do</span>
            </h3>
            <ul class="list-disc pl-5 space-y-1.5 text-gray-300 light:text-gray-700">
              <li>We do <strong>not</strong> issue official transcripts or university degrees.</li>
              <li>We do <strong>not</strong> alter, modify, or create academic marks records.</li>
              <li>We do <strong>not</strong> bypass university security controls or engage in unauthorized system access.</li>
              <li>We do <strong>not</strong> charge students for academic queries; the tool is completely free.</li>
            </ul>
          </div>
        </div>
      </div>

      <hr class="border-canvas-dark-border light:border-canvas-light-border" />

      <!-- Section 3: Data Privacy & Security Commitments -->
      <div class="space-y-4">
        <h2 class="text-xl font-bold text-white light:text-ink tracking-tight border-l-4 border-brand-blue pl-3">
          3. Student Privacy &amp; Data Handling Principles
        </h2>
        <div class="space-y-3 text-xs sm:text-sm leading-relaxed">
          <p>
            Student privacy is central to our engineering decisions:
          </p>
          <ul class="list-disc pl-5 space-y-2">
            <li><strong>Zero Persistent Marksheet Storage:</strong> We do not operate a persistent database storing full student grade cards. Queries are processed in real time and displayed dynamically on your screen.</li>
            <li><strong>Encrypted Transport:</strong> All interactions with our servers use modern TLS/SSL 256-bit encryption.</li>
            <li><strong>No Sale of Student Data:</strong> We will never sell, rent, or trade student roll numbers, phone numbers, or academic records to third-party commercial marketing firms.</li>
          </ul>
        </div>
      </div>

      <hr class="border-canvas-dark-border light:border-canvas-light-border" />

      <!-- Section 4: Contact & Responsible Disclosure -->
      <div class="space-y-4">
        <h2 class="text-xl font-bold text-white light:text-ink tracking-tight border-l-4 border-brand-blue pl-3">
          4. Contact, Feedback &amp; Responsible Disclosure
        </h2>
        <p class="text-xs sm:text-sm leading-relaxed">
          If you have questions regarding this platform, spot an inaccuracy in any of our student guides, or represent an academic institution with inquiries, our engineering team welcomes direct communication.
        </p>
        <div class="flex items-center gap-4 flex-wrap pt-2">
          <a href="/contact" class="px-5 py-2.5 rounded-xl bg-brand-blue text-white text-xs font-bold hover:bg-brand-blue-hover transition-colors">
            Contact Support Desk
          </a>
          <a href="/guides" class="px-5 py-2.5 rounded-xl border border-white/15 light:border-gray-300 text-white light:text-ink text-xs font-semibold hover:bg-white/5 transition-colors">
            Browse Student Guides
          </a>
          <a href="mailto:support@akturesult.bond" class="text-xs text-brand-blue underline font-medium">
            support@akturesult.bond
          </a>
        </div>
      </div>

    </div>
  </section>
</Layout>
