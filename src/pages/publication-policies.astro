---
import Layout from "../layouts/Layout.astro";

const title = "Publication & Editorial Policies | AKTU Student News & Portal";
const description = "Read our comprehensive editorial guidelines, fact-checking policies, corrections procedures, and transparency disclosures for AKTU Student News.";
---

<Layout 
  title={title}
  description={description}
  canonicalUrl="https://akturesult.bond/publication-policies"
>
  <section class="py-16 md:py-24 bg-black light:bg-white text-gray-400 light:text-gray-600 text-left transition-colors duration-300">
    <div class="max-w-4xl mx-auto px-4 sm:px-6">
      
      <!-- Header -->
      <div class="border-b border-canvas-dark-border light:border-canvas-light-border pb-6 mb-8">
        <span class="text-xs font-semibold uppercase tracking-wider text-brand-blue">Journalistic Standards &amp; Transparency</span>
        <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-white light:text-ink mt-2">
          Publication &amp; Editorial Policies
        </h1>
        <p class="text-xs sm:text-sm text-gray-500 light:text-gray-500 mt-2">
          Compliant with Google News Standards • Effective Date: November 2026
        </p>
      </div>

      <!-- Independent Operation Disclaimer Notice -->
      <div class="p-4 rounded-xl border border-blue-500/30 bg-blue-500/10 text-blue-200 text-xs sm:text-sm leading-relaxed mb-8">
        <strong>Editorial Mandate &amp; Independent Disclaimer:</strong> <strong>akturesult.bond</strong> is an independent academic news and student utility portal. We are not officially affiliated with, endorsed by, or operated by Dr. A.P.J. Abdul Kalam Technical University (AKTU Lucknow). Our editorial mission is to provide accurate, timely, student-friendly reporting and practical guidance for engineering and management students across affiliated colleges in Uttar Pradesh.
      </div>

      <div class="space-y-10 text-xs sm:text-sm leading-relaxed">
        
        <!-- Section 1: Editorial Principles -->
        <div>
          <h2 class="text-lg font-bold text-white light:text-ink uppercase tracking-wider mb-3 flex items-center gap-2">
            <span class="text-brand-blue">01.</span> Editorial Principles &amp; Code of Ethics
          </h2>
          <p class="mb-3">
            Our news coverage focuses exclusively on topics of direct academic, administrative, and career relevance to AKTU students: examination schedules, result declarations, revaluation and challenge scrutiny windows, syllabus updates, placement drives, and government scholarship alerts (such as UP Scholarship and DigiShakti schemes).
          </p>
          <ul class="list-disc pl-5 space-y-1.5">
            <li><strong>Accuracy &amp; Truthfulness:</strong> Every article must accurately reflect university circulars and verified higher-education data. Sensationalism, clickbait headlines, and misleading speculation are strictly prohibited.</li>
            <li><strong>Student Advocacy:</strong> We aim to demystify complex academic circulars, grace marks bylaws, SGPA/CGPA evaluation guidelines, and carry-over examination procedures into clear, accessible language.</li>
            <li><strong>Impartiality:</strong> We do not accept sponsored editorial coverage that compromises reporting objectivity or endorses private colleges without full disclosure.</li>
          </ul>
        </div>

        <!-- Section 2: Fact-Checking Policy -->
        <div id="fact-checking">
          <h2 class="text-lg font-bold text-white light:text-ink uppercase tracking-wider mb-3 flex items-center gap-2">
            <span class="text-brand-blue">02.</span> Fact-Checking &amp; Verification Procedures
          </h2>
          <p class="mb-3">
            Due to the critical nature of university examination dates, admit card downloads, and result deadlines, our desk maintains a strict verification process:
          </p>
          <div class="grid grid-cols-1 md:grid-cols-3 gap-4 my-4">
            <div class="p-4 rounded-xl border border-canvas-dark-border light:border-canvas-light-border bg-canvas-dark-surface/50 light:bg-canvas-light-surface/50">
              <h3 class="font-bold text-white light:text-ink text-xs mb-1">1. Primary Source Cross-Check</h3>
              <p class="text-xs text-gray-500 light:text-gray-600">
                All examination alerts are matched against official circulars published on <code class="text-brand-blue">aktu.ac.in/circulars</code> or registrar notifications before reporting.
              </p>
            </div>
            <div class="p-4 rounded-xl border border-canvas-dark-border light:border-canvas-light-border bg-canvas-dark-surface/50 light:bg-canvas-light-surface/50">
              <h3 class="font-bold text-white light:text-ink text-xs mb-1">2. Gateway Validation</h3>
              <p class="text-xs text-gray-500 light:text-gray-600">
                Links to university OneView (<code class="text-brand-blue">oneview.aktu.ac.in</code>) and ERP portals are verified to ensure validity and prevent student phishing.
              </p>
            </div>
            <div class="p-4 rounded-xl border border-canvas-dark-border light:border-canvas-light-border bg-canvas-dark-surface/50 light:bg-canvas-light-surface/50">
              <h3 class="font-bold text-white light:text-ink text-xs mb-1">3. Circular Number Citations</h3>
              <p class="text-xs text-gray-500 light:text-gray-600">
                Where applicable, circular reference dispatch numbers and university issue dates are cited directly inside the coverage for verifiable student reference.
              </p>
            </div>
          </div>
        </div>

        <!-- Section 3: Corrections Policy -->
        <div id="corrections-policy">
          <h2 class="text-lg font-bold text-white light:text-ink uppercase tracking-wider mb-3 flex items-center gap-2">
            <span class="text-brand-blue">03.</span> Corrections &amp; Retractions Policy
          </h2>
          <p class="mb-3">
            We are dedicated to immediately correcting errors when they occur. Examination timetables and center lists can change on short notice due to revised university gazettes.
          </p>
          <ul class="list-disc pl-5 space-y-2">
            <li><strong>Immediate Rectification:</strong> If an error of fact, date, or procedure is identified, our editorial desk updates the article without delay.</li>
            <li><strong>Transparent Update Notices:</strong> Substantive revisions will include an editorial clarification note at the beginning or foot of the article specifying the date and nature of the correction (e.g., <em>"Updated on [Date]: Corrected examination submission deadline per revised AKTU Circular"</em>).</li>
            <li><strong>How to Report an Inaccuracy:</strong> Students, college administrators, or university staff can report any discrepancy directly to our editorial inbox at <a href="mailto:editor@akturesult.bond" class="text-brand-blue hover:underline font-semibold">editor@akturesult.bond</a> or through our <a href="/contact" class="text-brand-blue hover:underline font-semibold">Contact Desk</a>. Corrections are reviewed within 12–24 hours.</li>
          </ul>
        </div>

        <!-- Section 4: Authorship & Editorial Transparency -->
        <div>
          <h2 class="text-lg font-bold text-white light:text-ink uppercase tracking-wider mb-3 flex items-center gap-2">
            <span class="text-brand-blue">04.</span> Authorship, Bylines &amp; Editorial Oversight
          </h2>
          <p class="mb-3">
            Articles published on akturesult.bond carry transparent bylines indicating the desk, contributor, or editorial reviewer responsible for the content:
          </p>
          <ul class="list-disc pl-5 space-y-1.5">
            <li><strong>AKTU Student News Desk:</strong> Staff writers and academic researchers who monitor university circulars, technical education updates, and collegiate announcements.</li>
            <li><strong>Editorial Supervision:</strong> All articles undergo review for clarity, compliance with higher education policies, and factual fidelity before going live.</li>
            <li><strong>Student Feedback Integration:</strong> Reader queries regarding confusing university policies are routinely integrated into follow-up guides and FAQ updates.</li>
          </ul>
        </div>

        <!-- Section 5: AI & Automation Disclosure -->
        <div>
          <h2 class="text-lg font-bold text-white light:text-ink uppercase tracking-wider mb-3 flex items-center gap-2">
            <span class="text-brand-blue">05.</span> Artificial Intelligence (AI) &amp; Automation Transparency
          </h2>
          <p class="mb-3">
            In accordance with Google’s search and news transparency guidance:
          </p>
          <ul class="list-disc pl-5 space-y-1.5">
            <li>We utilize automated data tools and natural language models to monitor public university portals, extract circular metadata, and format structured student digests quickly.</li>
            <li><strong>Human Review:</strong> All automated summaries covering critical student actions—such as back paper registrations, scrutiny fees, and examination dates—are cross-referenced against authoritative university sources. Automated tools are strictly utilized to accelerate accessibility, never to fabricate unverified rumors.</li>
          </ul>
        </div>

        <!-- Section 6: Ownership & Funding -->
        <div id="ownership">
          <h2 class="text-lg font-bold text-white light:text-ink uppercase tracking-wider mb-3 flex items-center gap-2">
            <span class="text-brand-blue">06.</span> Ownership, Funding &amp; Reader Revenue
          </h2>
          <p class="mb-3">
            <strong>akturesult.bond</strong> is owned and operated by an independent educational technology team. Our operations, hosting infrastructure, and journalistic activities are sustained through:
          </p>
          <ul class="list-disc pl-5 space-y-1.5">
            <li><strong>Digital Advertising:</strong> Contextual and display advertising served via Google AdSense and accredited ad networks. Ads are clearly distinguished from editorial content.</li>
            <li><strong>Google Reader Revenue Manager / Subscribe with Google:</strong> Voluntary student contributions and support memberships processed securely through Google’s Reader Revenue platform.</li>
            <li><strong>Zero Commercial Influence:</strong> Advertisers and sponsors have zero influence over our editorial stance, result reporting, or university analysis.</li>
          </ul>
        </div>

        <!-- Section 7: Contact Editorial Team -->
        <div class="mt-8 p-6 rounded-2xl border border-canvas-dark-border light:border-canvas-light-border bg-canvas-dark-tile light:bg-canvas-light-tile">
          <h2 class="text-base font-bold text-white light:text-ink mb-2">Editorial Desk &amp; Inquiries</h2>
          <p class="text-xs text-gray-500 light:text-gray-600 mb-4">
            For editorial tips, press releases, official circular submissions, or correction requests, please reach our newsroom:
          </p>
          <div class="flex flex-wrap gap-4 text-xs font-semibold">
            <a href="mailto:editor@akturesult.bond" class="px-4 py-2 bg-brand-blue/15 text-brand-blue border border-brand-blue/30 rounded-lg hover:bg-brand-blue/25 transition-colors">
              📧 editor@akturesult.bond
            </a>
            <a href="/contact" class="px-4 py-2 bg-white/5 text-gray-300 light:text-gray-700 border border-white/10 rounded-lg hover:bg-white/10 transition-colors">
              💬 General Contact Desk
            </a>
            <a href="/privacy-policy" class="px-4 py-2 bg-white/5 text-gray-300 light:text-gray-700 border border-white/10 rounded-lg hover:bg-white/10 transition-colors">
              🔒 Privacy Policy
            </a>
          </div>
        </div>

      </div>

    </div>
  </section>
</Layout>
