  <!-- Client-side filtering script -->
  <script is:inline>
    window.addEventListener("DOMContentLoaded", () => {
      const searchInput = document.getElementById("cse-college-search");
      const filterPills = document.querySelectorAll(".filter-pill");
      const cards = document.querySelectorAll(".cse-college-card");

      let currentFilter = "all";

      function updateVisibility() {
        const query = (searchInput?.value || "").trim().toLowerCase();

        cards.forEach((card) => {
          const type = card.getAttribute("data-type") || "";
          const text = card.getAttribute("data-text") || "";

          const matchesType = currentFilter === "all" || type.toLowerCase().includes(currentFilter.toLowerCase());
          const matchesQuery = query === "" || text.includes(query);

          if (matchesType && matchesQuery) {
            card.classList.remove("hidden");
          } else {
            card.classList.add("hidden");
          }
        });
      }

      searchInput?.addEventListener("input", updateVisibility);

      filterPills.forEach((pill) => {
        pill.addEventListener("click", () => {
          filterPills.forEach((p) => {
            p.classList.remove("active", "bg-brand-blue", "text-white");
            p.classList.add("bg-black/40", "light:bg-white", "text-gray-400", "light:text-gray-700");
          });

          pill.classList.add("active", "bg-brand-blue", "text-white");
          pill.classList.remove("bg-black/40", "light:bg-white", "text-gray-400", "light:text-gray-700");

          currentFilter = pill.getAttribute("data-filter") || "all";
          updateVisibility();
        });
      });
    });
  </script>
