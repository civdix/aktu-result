// Specialization codes
const cseSpecializations = [
  { code: "10", name: "Computer Science and Engineering (Core)", description: "The flagship 4-year engineering program covering OS, Algorithms, DBMS, and Systems Architecture." },
  { code: "152", name: "CSE (Artificial Intelligence)", description: "Core CSE with dedicated specialization in Machine Learning, Deep Neural Networks, and NLP." },
  { code: "153", name: "CSE (AI & Machine Learning)", description: "High-demand branch focusing on Predictive Analytics, Autonomous Systems, and Applied AI." },
  { code: "154", name: "CSE (Data Science)", description: "Data Engineering, Big Data Frameworks, Statistical Modeling, and Business Intelligence." },
  { code: "155", name: "CSE (Internet of Things - IoT)", description: "Hardware-software integration, Embedded Systems, Smart Sensors, and Edge Computing." },
  { code: "156", name: "Computer Science & Business Systems (CSBS)", description: "Developed in collaboration with TCS, blending software design with finance, marketing, and agile management." },
  { code: "172", name: "CSE (Cyber Security)", description: "Information Assurance, Ethical Hacking, Cryptography, and Cloud Infrastructure Defense." },
  { code: "11", name: "Computer Science & Information Technology", description: "Comprehensive software engineering, network protocols, and distributed enterprise computing." }
];

const pageTitle = `Top AKTU Affiliated CSE Colleges 2026-2027 | Rankings, Codes & Cutoffs`;
const pageDescription = `Complete guide to the best AKTU affiliated CSE colleges in Uttar Pradesh. Check government and private college codes, Computer Science branch codes (10, 153), fee structures, placements, and roll marksheet lookup without Date of Birth.`;
const pageKeywords = `aktu affiliated cse college, aktu affiliated cse colleges, best aktu affiliated cse college, top aktu affiliated cse colleges in noida, top aktu affiliated cse colleges in ghaziabad, aktu cse branch code, aktu computer science engineering colleges list, iet lucknow cse code, jss noida cse code, akgec cse code, kiet cse branch code, gl bajaj cse, aktu affiliated colleges, aktu result without dob`;

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": pageUrl,
      "url": pageUrl,
      "name": pageTitle,
      "description": pageDescription,
      "isPartOf": {
        "@type": "WebSite",
        "@id": `${siteUrl}/#website`,
        "name": "AKTU Result & OneView Portal",
        "url": siteUrl
      }
    },
    {
      "@type": "BreadcrumbList",
      "@id": `${pageUrl}/#breadcrumb`,
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": siteUrl
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "AKTU Affiliated Colleges",
          "item": `${siteUrl}/colleges`
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": "AKTU Affiliated CSE College",
          "item": pageUrl
        }
      ]
    },
    {
      "@type": "ItemList",
      "@id": `${pageUrl}/#collegelist`,
      "name": "Best AKTU Affiliated CSE Colleges in Uttar Pradesh",
      "description": "Ranked directory of Dr. A.P.J. Abdul Kalam Technical University affiliated colleges offering B.Tech Computer Science and Engineering.",
      "itemListElement": topCseCollegeData.map((c, index) => ({
        "@type": "ListItem",
        "position": index + 1,
        "name": `${c.name} (Code: ${c.code})`,
        "url": `${siteUrl}/college/${slugifyCollege(c.name, c.code)}`
      }))
    },
    {
      "@type": "FAQPage",
      "@id": `${pageUrl}/#faq`,
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Which is the #1 best AKTU affiliated CSE college in Uttar Pradesh?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Institute of Engineering & Technology (IET Lucknow - College Code 052) is widely regarded as the top government AKTU affiliated CSE college. Among private affiliated colleges, JSS Academy of Technical Education (Noida - Code 091), Ajay Kumar Garg Engineering College (AKGEC Ghaziabad - Code 027), and KIET Group of Institutions (Ghaziabad - Code 029) are the highest-rated for Computer Science placements."
          }
        },
        {
          "@type": "Question",
          "name": "What is the AKTU branch code for Computer Science and Engineering (CSE)?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The primary branch code for core Computer Science & Engineering in AKTU is 10. Key specializations include 152 for CSE (AI), 153 for CSE (AI & Machine Learning), 154 for CSE (Data Science), 155 for CSE (IoT), 156 for CSBS, and 172 for CSE (Cyber Security)."
          }
        },
        {
          "@type": "Question",
          "name": "What is the average package for CSE graduates from top AKTU affiliated colleges?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Graduates from premier AKTU affiliated CSE colleges like IET Lucknow, JSS Noida, AKGEC, and GL Bajaj secure average packages between 6.0 LPA and 8.5 LPA, with highest domestic and international packages reaching up to 45 LPA to 58 LPA."
          }
        },
        {
          "@type": "Question",
          "name": "Can I check semester marksheet for any AKTU affiliated CSE college without Date of Birth?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes! On akturesult.bond/aktu-result-without-date-of-birth, you can enter any AKTU roll number from any affiliated CSE college to inspect full OneView scorecards, semester marks, SGPA, and carryover status without entering a Date of Birth."
          }
        },
        {
          "@type": "Question",
          "name": "How is the AKTU Roll Number formulated for a CSE student?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "An AKTU CSE roll number consists of 10 or 13 digits: 2 digits for Admission Year (e.g. 23) + 3 digits for College Code (e.g. 052) + 2/3 digits for Branch Code (10 for core CSE or 153 for AI/ML) + 3-digit serial sequence (001-240)."
          }
        }
      ]
    }
  ]
};
---

<Layout
  title={pageTitle}
  description={pageDescription}
  keywords={pageKeywords}
  jsonLd={jsonLd}
>
  <!-- Breadcrumbs & Hero Section -->
  <section class="py-12 sm:py-16 md:py-20 border-b border-canvas-dark-border light:border-canvas-light-border bg-gradient-to-b from-black via-canvas-dark-surface to-black light:from-white light:via-canvas-light-surface light:to-white">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      
      <!-- Breadcrumb Bar -->
      <nav aria-label="Breadcrumb" class="mb-6 flex items-center gap-2 text-xs text-gray-500 light:text-gray-500 font-medium">
        <a href="/" class="hover:text-white light:hover:text-ink transition-colors">Home</a>
        <span>/</span>
        <a href="/colleges" class="hover:text-white light:hover:text-ink transition-colors">AKTU Affiliated Colleges</a>
        <span>/</span>
        <span class="text-brand-blue font-semibold">AKTU Affiliated CSE College</span>
      </nav>

      <!-- Badge & H1 Header -->
      <div class="max-w-3xl">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold bg-brand-blue/10 text-brand-blue border border-brand-blue/20 mb-4">
          <span class="w-1.5 h-1.5 rounded-full bg-brand-blue animate-pulse"></span>
          <span>Official 2026-2027 Engineering Directory</span>
        </div>
        <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold tracking-tight text-white light:text-ink mb-4 leading-tight">
          Top AKTU Affiliated CSE Colleges in UP
        </h1>
        <p class="text-sm sm:text-base text-gray-400 light:text-gray-600 leading-relaxed mb-8">
          Detailed rankings, verified institute codes, B.Tech Computer Science branch codes (10, 153, 154), and placement records for premier Government and Private colleges affiliated with Dr. A.P.J. Abdul Kalam Technical University (AKTU Lucknow).
        </p>
      </div>

      <!-- Quick Highlights Grid -->
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 sm:gap-4 mt-6">
        <div class="p-4 rounded-2xl border border-canvas-dark-border light:border-canvas-light-border bg-canvas-dark-tile light:bg-white premium-shadow-dark light:premium-shadow-light">
          <div class="text-[10px] sm:text-xs text-gray-500 uppercase tracking-wider font-semibold">Affiliated Institutes</div>
          <div class="text-xl sm:text-2xl font-black text-white light:text-ink mt-1">120+ Colleges</div>
          <div class="text-[10px] text-emerald-400 font-medium mt-1">Across Noida, Ghaziabad & UP</div>
        </div>

        <div class="p-4 rounded-2xl border border-canvas-dark-border light:border-canvas-light-border bg-canvas-dark-tile light:bg-white premium-shadow-dark light:premium-shadow-light">
          <div class="text-[10px] sm:text-xs text-gray-500 uppercase tracking-wider font-semibold">Core Branch Code</div>
          <div class="text-xl sm:text-2xl font-black text-brand-blue mt-1">Branch 10</div>
          <div class="text-[10px] text-gray-400 light:text-gray-600 mt-1">CSE & 7 Specializations</div>
        </div>

        <div class="p-4 rounded-2xl border border-canvas-dark-border light:border-canvas-light-border bg-canvas-dark-tile light:bg-white premium-shadow-dark light:premium-shadow-light">
          <div class="text-[10px] sm:text-xs text-gray-500 uppercase tracking-wider font-semibold">Highest Package</div>
          <div class="text-xl sm:text-2xl font-black text-emerald-400 mt-1">58.0 LPA</div>
          <div class="text-[10px] text-gray-400 light:text-gray-600 mt-1">Offered On-Campus</div>
        </div>

        <div class="p-4 rounded-2xl border border-canvas-dark-border light:border-canvas-light-border bg-canvas-dark-tile light:bg-white premium-shadow-dark light:premium-shadow-light">
          <div class="text-[10px] sm:text-xs text-gray-500 uppercase tracking-wider font-semibold">Marksheet Scanner</div>
          <div class="text-xl sm:text-2xl font-black text-purple-400 mt-1">Zero DOB</div>
          <div class="text-[10px] text-gray-400 light:text-gray-600 mt-1">Direct OneView Access</div>
        </div>
      </div>

    </div>
  </section>

  <!-- Interactive Search & Filter Controls -->
  <section class="py-8 bg-canvas-dark-surface/60 light:bg-gray-50 border-b border-canvas-dark-border light:border-canvas-light-border">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 flex flex-col md:flex-row items-center justify-between gap-4">
      
      <!-- Search Input Island -->
      <div class="relative w-full md:max-w-md">
        <input 
          type="text" 
          id="cse-college-search" 
          placeholder="Search by college name, code (e.g. 052, 027, 091), or city..."
          class="w-full px-4 py-2.5 bg-black/60 light:bg-white border border-canvas-dark-border light:border-gray-200 rounded-xl text-white light:text-ink placeholder-gray-500 text-xs font-medium focus:outline-none focus:border-brand-blue"
        />
        <span class="absolute right-3.5 top-2.5 text-gray-500 text-xs">🔍</span>
      </div>

      <!-- Quick Filter Buttons -->
      <div class="flex items-center gap-2 overflow-x-auto w-full md:w-auto pb-1">
        <button class="filter-pill active px-3 py-1.5 rounded-lg text-xs font-semibold bg-brand-blue text-white transition-colors cursor-pointer shrink-0" data-filter="all">
          All Colleges (<span id="count-all">{topCseCollegeData.length}</span>)
        </button>
        <button class="filter-pill px-3 py-1.5 rounded-lg text-xs font-semibold bg-black/40 light:bg-white border border-canvas-dark-border light:border-gray-200 text-gray-400 light:text-gray-700 hover:text-white transition-colors cursor-pointer shrink-0" data-filter="Government">
          Government & RECs
        </button>
        <button class="filter-pill px-3 py-1.5 rounded-lg text-xs font-semibold bg-black/40 light:bg-white border border-canvas-dark-border light:border-gray-200 text-gray-400 light:text-gray-700 hover:text-white transition-colors cursor-pointer shrink-0" data-filter="Private">
          Top Private NCR
        </button>
      </div>

    </div>
  </section>

  <!-- Curated Colleges Cards Directory -->
  <section class="py-12 bg-black light:bg-white">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      
      <div class="flex items-center justify-between mb-6">
        <div>
          <h2 class="text-xl sm:text-2xl font-bold text-white light:text-ink">
            Premier AKTU Affiliated CSE Colleges Directory
          </h2>
          <p class="text-xs text-gray-400 light:text-gray-600 mt-1">
            Click any college to scan class roll numbers, check batch-wise results, and explore branch specializations.
          </p>
        </div>
        <a href="/colleges" class="text-xs font-bold text-brand-blue hover:underline hidden sm:inline-flex items-center gap-1">
          <span>View all 750+ AKTU colleges</span>
          <span>&rarr;</span>
        </a>
      </div>

      <!-- Grid of Ranked Colleges -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-5" id="cse-colleges-container">
        {topCseCollegeData.map((c) => {
          const collegeSlug = slugifyCollege(c.name, c.code);
          return (
            <div 
              class="cse-college-card p-6 rounded-2xl border border-canvas-dark-border light:border-canvas-light-border bg-canvas-dark-tile light:bg-white hover:border-brand-blue/40 transition-all premium-shadow-dark light:premium-shadow-light flex flex-col justify-between"
              data-type={c.type.includes("Government") ? "Government" : "Private"}
              data-text={`${c.name.toLowerCase()} ${c.code} ${c.city.toLowerCase()}`}
            >
              <div>
                <!-- Card Header -->
                <div class="flex items-start justify-between gap-3 mb-3">
                  <div class="flex items-center gap-2">
                    <span class="px-2.5 py-1 rounded-md bg-brand-blue/15 text-brand-blue text-xs font-black font-mono">
                      Code {c.code}
                    </span>
                    <span class="text-[11px] font-semibold px-2 py-0.5 rounded bg-white/5 light:bg-gray-100 text-gray-400 light:text-gray-600">
                      {c.city}
                    </span>
                  </div>
                  <span class="text-[10px] font-bold px-2 py-0.5 rounded-full bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">
                    {c.tag}
                  </span>
                </div>

                <!-- College Title -->
                <h3 class="text-base font-bold text-white light:text-ink leading-snug mb-2">
                  <a href={`/college/${collegeSlug}`} class="hover:text-brand-blue transition-colors">
                    {c.name}
                  </a>
                </h3>

                <!-- Key Specs Grid -->
                <div class="grid grid-cols-3 gap-2 my-4 p-3 rounded-xl bg-black/40 light:bg-gray-50 border border-canvas-dark-border/40 light:border-gray-200 text-center">
                  <div>
                    <span class="block text-[9px] text-gray-500 uppercase font-semibold">Institute Type</span>
                    <span class="text-xs font-bold text-white light:text-ink">{c.type.split(" ")[0]}</span>
                  </div>
                  <div>
                    <span class="block text-[9px] text-gray-500 uppercase font-semibold">Avg Package</span>
                    <span class="text-xs font-bold text-emerald-400">{c.avgPackage}</span>
                  </div>
                  <div>
                    <span class="block text-[9px] text-gray-500 uppercase font-semibold">Peak Package</span>
                    <span class="text-xs font-bold text-brand-blue">{c.highestPackage}</span>
                  </div>
                </div>

                <!-- Specializations Badges -->
                <div class="space-y-1.5 mb-4">
                  <span class="text-[10px] text-gray-500 uppercase font-bold tracking-wider">Available CSE Specializations:</span>
                  <div class="flex flex-wrap gap-1.5">
                    {c.specializations.map((spec) => (
                      <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-canvas-dark-surface light:bg-gray-100 border border-canvas-dark-border light:border-gray-200 text-gray-300 light:text-gray-700">
                        {spec}
                      </span>
                    ))}
                  </div>
                </div>
              </div>

              <!-- Action Links Footer -->
              <div class="pt-4 border-t border-canvas-dark-border/40 light:border-gray-100 flex items-center justify-between gap-3">
                <a 
                  href={`/college/${collegeSlug}`} 
                  class="text-xs font-bold text-brand-blue hover:text-brand-blue-hover flex items-center gap-1 cursor-pointer"
                >
                  <span>Scan Class Roll Numbers</span>
                  <span>&rarr;</span>
                </a>
                <a 
                  href="/aktu-result-without-date-of-birth" 
                  class="text-[11px] font-semibold text-gray-400 hover:text-white light:text-gray-500 light:hover:text-ink transition-colors"
                >
                  Check Result Without DOB
                </a>
              </div>
            </div>
          );
