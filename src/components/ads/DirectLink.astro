---
interface Props {
  variant?: 'button' | 'badge' | 'card' | 'inline';
  text?: string;
  class?: string;
}

const {
  variant = 'button',
  text,
  class: className = ""
} = Astro.props;

// Safe external fallback linking directly to official university records portal
const officialUrl = "https://oneview.aktu.ac.in";
---

{variant === 'button' && (
  <a 
    href={officialUrl}
    target="_blank"
    rel="noopener noreferrer"
    class={`inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-xl bg-white/[0.04] hover:bg-white/[0.08] light:bg-gray-100 light:hover:bg-gray-200 border border-white/10 light:border-gray-300 text-gray-300 light:text-gray-800 font-semibold text-xs transition-all cursor-pointer ${className}`}
    title="Visit official AKTU OneView portal (external university website)"
  >
    <span>🌐</span>
    <span>{text || "Visit Official AKTU OneView (External ↗)"}</span>
  </a>
)}

{variant === 'badge' && (
  <a 
    href={officialUrl}
    target="_blank"
    rel="noopener noreferrer"
    class={`inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-[11px] font-semibold bg-white/5 light:bg-gray-100 text-gray-300 light:text-gray-700 border border-white/10 light:border-gray-300 hover:text-white transition-all ${className}`}
    title="Official university portal link"
  >
    <span>🌐</span>
    <span>{text || "Official Portal (oneview.aktu.ac.in ↗)"}</span>
  </a>
)}

{variant === 'inline' && (
  <a 
    href={officialUrl}
    target="_blank"
    rel="noopener noreferrer"
    class={`text-brand-blue hover:text-brand-blue-hover underline font-medium text-xs inline-flex items-center gap-1 ${className}`}
  >
    <span>{text || "Official AKTU OneView Portal ↗"}</span>
  </a>
)}

{variant === 'card' && (
  <aside aria-label="Official University Portal Link" class={`p-4 rounded-2xl bg-white/[0.02] light:bg-gray-50 border border-white/10 light:border-gray-200 text-left flex flex-col sm:flex-row sm:items-center justify-between gap-3 ${className}`}>
    <div class="space-y-1">
      <div class="flex items-center gap-2">
        <span class="text-base">🏛️</span>
        <h4 class="text-xs font-bold text-white light:text-ink">{text || "Official AKTU OneView Portal"}</h4>
        <span class="text-[9px] font-mono px-1.5 py-0.5 rounded bg-brand-blue/20 text-brand-blue uppercase font-semibold">Official University Portal</span>
      </div>
      <p class="text-[11px] text-gray-400 light:text-gray-600 leading-relaxed">
        For authoritative university degree certificates, challenge evaluation status, and official marksheets, visit the university's electronic ledger directly.
      </p>
    </div>
    <a 
      href={officialUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="px-4 py-2 rounded-xl bg-brand-blue hover:bg-brand-blue-hover text-white font-bold text-xs transition-all text-center shrink-0 cursor-pointer"
    >
      Open oneview.aktu.ac.in ↗
    </a>
  </aside>
)}
