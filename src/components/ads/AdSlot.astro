---
// AdSlot.astro
// Clean In-Place Google AdSense ad unit.
// Strictly in-place, zero click-hijacking, zero popunders, zero auto-redirects.
interface Props {
  adKey?: string;
  width?: number;
  height?: number;
  class?: string;
  label?: boolean;
}

const {
  width = 300,
  height = 250,
  class: className = "",
  label = true,
} = Astro.props;

const uniqueSlotId = `ad-unit-${Math.random().toString(36).substring(2, 7)}`;
---

<div 
  id={uniqueSlotId}
  class={`ad-slot-wrapper flex flex-col items-center justify-center text-center my-3 overflow-hidden ${className}`}
>
  {label && (
    <div 
      class="flex items-center justify-between px-1 mb-1 text-gray-400 light:text-gray-500"
      style={`width: ${width}px; max-width: 100%;`}
    >
      <span class="text-[9px] uppercase font-bold tracking-wider">Sponsored Advertisement</span>
      <span class="text-[8px] font-mono uppercase bg-white/5 light:bg-gray-100 px-1 rounded">Ad</span>
    </div>
  )}

  <div 
    class="flex items-center justify-center bg-white/[0.02] light:bg-gray-50 rounded-xl overflow-hidden border border-white/10 light:border-black/5 shadow-sm max-w-full"
    style={`width: ${width}px; min-height: ${height}px;`}
  >
    <ins class="adsbygoogle"
         style={`display:inline-block;width:${width}px;height:${height}px`}
         data-ad-client="ca-pub-5590747238948130"
         data-ad-slot="default"></ins>
  </div>
</div>

<script is:inline>
  try {
    (window.adsbygoogle = window.adsbygoogle || []).push({});
  } catch (e) {}
</script>
