---
// AdSlot.astro
// High-performance isolated ad slot component for Adsterra / Bauval banner tags.
// Resolves CDN caching issues by isolating `atOptions` in independent friendly iframes,
// preventing global variable collisions, and providing cache-busting on page refresh / bfcache.

interface Props {
  adKey: string;
  width: number;
  height: number;
  class?: string;
  label?: boolean;
}

const {
  adKey,
  width,
  height,
  class: className = "",
  label = true,
} = Astro.props;

// Generate a unique ID per slot instance to prevent DOM collisions
const uniqueSlotId = `ad-unit-${adKey.slice(0, 8)}-${Math.random().toString(36).substring(2, 7)}`;

// Build the isolated iframe document with sandboxed window.atOptions
// This ensures multiple ads on the same page NEVER overwrite each other's atOptions
const iframeSrcDoc = `<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <base target="_blank">
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    html, body {
      width: 100%;
      height: 100%;
      overflow: hidden;
      background: transparent;
      display: flex;
      align-items: center;
      justify-content: center;
    }
  </style>
</head>
<body>
  <script>
    var atOptions = {
      'key' : '${adKey}',
      'format' : 'iframe',
      'height' : ${height},
      'width' : ${width},
      'params' : {}
    };
  <\/script>
  <script type="text/javascript" src="https://bauval.org/22/${adKey}"><\/script>
</body>
</html>`;
---

<div 
  id={uniqueSlotId}
  class={`ad-slot-wrapper flex flex-col items-center justify-center text-center my-3 overflow-hidden ${className}`}
  data-ad-key={adKey}
  data-ad-width={width}
  data-ad-height={height}
>
  {label && (
    <div 
      class="flex items-center justify-between px-1 mb-1 text-gray-400 light:text-gray-500"
      style={`width: ${width}px; max-width: 100%;`}
    >
      <span class="text-[9px] uppercase font-bold tracking-wider">Sponsored Advertisement</span>
      <span class="text-[8px] font-mono uppercase bg-white/5 light:bg-gray-100 px-1 rounded">Ad</span>
    </div>
  )}

  <div 
    class="flex items-center justify-center bg-white/[0.02] light:bg-gray-50 rounded-xl overflow-hidden border border-white/10 light:border-black/5 shadow-sm max-w-full"
    style={`width: ${width}px; height: ${height}px;`}
  >
    <iframe
      class="ad-isolated-frame"
      title="Advertisement"
      width={width}
      height={height}
      srcdoc={iframeSrcDoc}
      style={`width: ${width}px; height: ${height}px; border: 0; margin: 0; padding: 0; overflow: hidden; display: block;`}
      scrolling="no"
      loading="lazy"
    ></iframe>
  </div>
</div>
