---
interface Props {
  class?: string;
  label?: boolean;
}

const { class: className = "", label = true } = Astro.props;
---

<div class={`ad-container-320x50 flex flex-col items-center justify-center text-center my-3 overflow-hidden ${className}`}>
  {label && (
    <div class="flex items-center justify-between w-[320px] max-w-full px-1 mb-1">
      <span class="text-[9px] uppercase font-bold text-gray-400 light:text-gray-500 tracking-wider">Sponsored Advertisement</span>
      <span class="text-[8px] font-mono text-gray-500 uppercase">Ad</span>
    </div>
  )}
  <div class="w-[320px] h-[50px] max-w-full flex items-center justify-center bg-white/[0.02] light:bg-gray-50 rounded-xl overflow-hidden border border-white/10 light:border-black/5 shadow-sm">
    <script is:inline>
      atOptions = {
        'key' : 'eebf131cee0a8132343ab2da1e4b1b31',
        'format' : 'iframe',
        'height' : 50,
        'width' : 320,
        'params' : {}
      };
    </script>
    <script is:inline type="text/javascript" src="https://bauval.org/22/eebf131cee0a8132343ab2da1e4b1b31"></script>
  </div>
</div>
