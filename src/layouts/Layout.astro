---
import "../styles/global.css";
interface Props {
  title: string;
  description: string;
  keywords?: string;
  canonicalUrl?: string;
  ogType?: string;
  jsonLd?: Record<string, any>;
}

const {
  title,
  description,
  keywords = "aktu result without date of birth, aktu result without dob, aktu result, aktu result 2026, oneview aktu, erp aktu result, aktu erp result, aktu oneview, check aktu result, check aktu result without date of birth, aktu roll number finder, aktu marksheet online, oneview.aktu.ac.in, dr apj abdul kalam technical university result",
  canonicalUrl,
  ogType = "website",
  jsonLd
} = Astro.props;

const brandUrl = "https://akturesult.bond";
const authorName = "AKTU Student Portal";
const authorWebsite = "https://akturesult.bond";

// Normalize canonical URL to apex domain and strip query parameters unless explicitly provided
const cleanPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const resolvedCanonical = canonicalUrl || `${brandUrl}${cleanPath === '/' ? '/' : cleanPath}`;

// Compute active page status
const currentPath = Astro.url.pathname;
const isActive = (path: string) => {
  if (path === "/" && currentPath === "/") return true;
  if (path !== "/" && currentPath.startsWith(path)) return true;
  return false;
};
